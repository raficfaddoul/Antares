  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

  <!-- Fixed report imagery: the company mark and the venue figures. Embedded rather than copied so a
       deployment cannot lose them, and unpacked on demand by EmbeddedAssets. -->
  <ItemGroup>
    <EmbeddedResource Include="ScenarioHelpers\Report\Assets\*.png" />
    <EmbeddedResource Include="ScenarioHelpers\Report\Assets\*.jpg" />
  </ItemGroup>

  <!-- The optimiser's manual, as the prose it is. Embedded so the page that shows it and the Word file it
       exports read the same text, and so a deployment cannot ship the application without its manual. -->
  <ItemGroup>
    <EmbeddedResource Include="ScenarioHelpers\Manual\*.md" />
  </ItemGroup>

</Project>
