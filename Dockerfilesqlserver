FROM mcr.microsoft.com/mssql/server:2022-latest


# Copy the SQL script
COPY attach-db.sql /var/opt/mssql/data/attach-db.sql

# Copy the shell script
COPY --chmod=+x attach-db.sh /var/opt/mssql/data/attach-db.sh

# Run the shell script to attach the database at container startup
CMD /bin/bash /var/opt/mssql/data/attach-db.sh & /opt/mssql/bin/sqlservr

