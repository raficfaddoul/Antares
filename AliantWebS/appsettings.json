{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AliantWeb;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True; Encrypt=False;"
    //"DefaultConnection": "Server=localhost\\MSSQLSERVER01;Database=AliantWeb;Trusted_Connection=True;MultipleActiveResultSets=true; Encrypt=False"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  // Root of the per-event / per-scenario file tree. Absolute paths are used as-is; anything else is
  // resolved against the content root. The container overrides this with an environment variable so
  // it always matches the ScenariosData bind mount, whatever the environment name.
  "ScenariosDataPath": "/app/ScenariosData",

  // Lifetime of an administrator's invitation link, in days. Separate from Identity's 24 h default
  // so an invitation can survive a weekend; password-reset links are unaffected.
  "InvitationExpiryDays": 7
}
