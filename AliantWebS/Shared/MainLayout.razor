@code {



    public string displaySubmitButton = "none";
    private string colorSubmitButton = "#007c00";

    private string formId;
    public string FormId { get; set; }



    private string buttonText = "Updated";
    public string ButtonText
    {
        get => buttonText;
        set
        {

            //  if (buttonText == value) return;
            buttonText = value;

            //      AppData.NotifyStateChanged();
        }
    }

    private string structureName;
    public string StructureName
    {
        get => structureName;
        set
        {
            if (structureName == value) return;
            structureName = value;
            //AppData.NotifyStateChanged();
        }
    }
    private bool saveChanges;
    public bool SaveChanges
    {
        get => saveChanges;
        set
        {
            if (saveChanges == value) return;
            saveChanges = value;
            if (saveChanges == false)
            {
                colorSubmitButton = "#007c00";
                if (ButtonText.Trim().ToLower() == "update")
                {
                    ButtonText = "Updated";
                }

            }
            else
            {
                colorSubmitButton = "#ff4a4a";
                if (buttonText.Trim().ToLower() == "updated")
                {
                    buttonText = "Update";
                }
            }
            //AppData.NotifyStateChanged();
        }
    }

    private bool IsActive(string route)
    {
        return navigationManager.Uri.Contains(route);
    }


    protected override async Task OnInitializedAsync()
    {

        appData.OnSaveChange -= Change;
        appData.OnSaveChange += Change;

        appData.DisplaySubmitButtonChanged -= DisplayChanged;
        appData.DisplaySubmitButtonChanged += DisplayChanged;

        appData.ButtonTextChanged -= ButtonTextChanged;
        appData.ButtonTextChanged += ButtonTextChanged;

        appData.FormIdChanged -= FormIdChanged;
        appData.FormIdChanged += FormIdChanged;

        appData.StructureNameChanged -= StructureNameChanged;
        appData.StructureNameChanged += StructureNameChanged;


    }

    private void StructureNameChanged(string s)
    {
        StructureName = s;
        InvokeAsync(StateHasChanged); 
    }

    private void DisplayChanged(string s)
    {
        displaySubmitButton = s;
        InvokeAsync(StateHasChanged);
    }

    private void Change(bool b)
    {
        SaveChanges = b;
        InvokeAsync(StateHasChanged);
    }

    private void ButtonTextChanged(string s)
    {
        ButtonText = s;
        InvokeAsync(StateHasChanged);
    }


    private void FormIdChanged(string s)
    {
        FormId = s;
        InvokeAsync(StateHasChanged);
    }


    void IDisposable.Dispose()
    {
        // Unsubscribe from the event when our component is disposed
        appData.OnSaveChange -= Change;
        appData.DisplaySubmitButtonChanged -= DisplayChanged;
        appData.StructureNameChanged -= StructureNameChanged;
    }

    void SHMClick(MenuItemEventArgs args)
    {
        navigationManager.NavigateTo("SHM");
    }

    void DashClick(MenuItemEventArgs args)
    {

       
        if (appData.Structure.Name.Trim() == "Antares")
        {
            navigationManager.NavigateTo("DashBoard2");
        }
        else
        {
            navigationManager.NavigateTo("DashBoard");
        }


       
    }

    void EquipementClick(MenuItemEventArgs args)
    {

        navigationManager.NavigateTo("Equipement");
    }

    void StructuralResponseClick(MenuItemEventArgs args)
    {
        navigationManager.NavigateTo("StructuralResponse");
 
    }

    void StatisticsClick(MenuItemEventArgs args)
    {
        navigationManager.NavigateTo("Statistics");
    }

    void SPClick(MenuItemEventArgs args)
    {
        List<Guid?> listIDs;
        if (appData.CheckedNodeObjects is null || appData.CheckedNodeObjects.Count() == 0)
        {
          //  listIDs = AI.Helpers.GetTheChildren(appData.Structure.Elements);
          //  string param = JsonSerializer.Serialize(listIDs);


            navigationManager.NavigateTo("/SP2");


            // JsRuntime.InvokeVoidAsync("alert", "Please check one or more elements...");
            // listIDs = new List<Guid?>();
            // listIDs.Add(null);
        }
        else
        {
            listIDs = Helpers.Helpers.GetTheChildren(appData.CheckedNodeObjects);
            string param = JsonSerializer.Serialize(listIDs);


            navigationManager.NavigateTo("/SP2/" + param);
        }



    }

    void IdentificationClick(MenuItemEventArgs args)
    {

        navigationManager.NavigateTo("Identification");
    }

    void LearningClick(MenuItemEventArgs args)
    {
    
        navigationManager.NavigateTo("Learning");
    }


}
   