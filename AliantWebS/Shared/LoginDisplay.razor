@using AliantWebS.Pages
@inject IStringLocalizer<Languages> L
<AuthorizeView>
    <Authorized>
        <a href="Identity/Account/Manage">Hello, @context.User.Identity.Name!</a>
        <form method="post" action="Identity/Account/LogOut">
            <button type="submit" class="nav-link btn btn-link">@L["Log out"]</button>
        </form>
    </Authorized>
    <NotAuthorized>
        @* Registration is by administrator invitation only (UserManager.razor -> AcceptInvitation).
           /Account/Register still exists but demands a Token GUID that flow never issues, so this
           link led to a form that silently redisplayed itself. Hidden rather than deleted. *@
        <a href="Identity/Account/Login">@L["Log in"]</a>
    </NotAuthorized>
</AuthorizeView>
