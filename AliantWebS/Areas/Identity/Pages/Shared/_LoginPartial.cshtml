@using AliantWebS.Data
@using AliantWebS.Pages
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<Languages> L
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="@L["Manage"]">@L["Hello"] @User.Identity?.Name!</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
            <button type="submit" class="nav-link btn btn-link text-dark">@L["Log out"]</button>
        </form>
    </li>
}
else
{
    @* Registration is by administrator invitation only (UserManager.razor -> AcceptInvitation).
       /Account/Register still exists but demands a Token GUID that flow never issues, so this
       link led to a form that silently redisplayed itself. Hidden rather than deleted. *@
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">@L["Log in"]</a>
    </li>
}
</ul>
