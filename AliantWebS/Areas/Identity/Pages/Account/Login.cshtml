@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}
@* @{
    Layout = null;
} *@


<h1>@Model.L["Log in"]</h1>
<div class="row" >
    <div class="col-md-4" >
        <section>
            <form id="account" method="post">
                <h2>@Model.L[""]</h2>@* Use a local account to log in. *@
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">@Model.L["Email"]</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password" class="form-label">@Model.L["Password"]</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">@Model.L["Log in"]</button>
                </div>
                <div>
                    <p>
                        <a id="forgot-password" asp-page="./ForgotPassword">@Model.L["Forgot your password?"]</a>
                    </p>
                    @* Both links that stood here are hidden, not deleted: they belong to the old
                       self-registration flow that administrator invitations replaced.
                         - Register: demanded a Token GUID the invitation flow never issues, so the
                           form silently redisplayed itself.
                         - Resend email confirmation: sent a bare ConfirmEmail link, which confirms the
                           address WITHOUT setting a password. That leaves an account that still cannot
                           log in, and it sets EmailConfirmed = true, which hides the resend-invitation
                           button in UserManager.razor (shown only while EmailConfirmed is false).
                       An invited user who never activated asks the administrator to resend instead.
                       Current flow: UserManager.razor -> AcceptInvitation. *@
                </div>
            </form>
        </section>
    </div>
