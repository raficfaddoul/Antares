@page
@model LockoutModel
@using AliantWebS.Pages
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@inject IStringLocalizer<Languages> L
@inject IOptions<IdentityOptions> IdentityOptions
@{
    ViewData["Title"] = L["Account locked"].Value;

    // Read from the configured policy rather than repeating the number, so the page cannot
    // drift from Startup.cs if the lockout window is ever retuned.
    var lockoutMinutes = (int)Math.Ceiling(
        IdentityOptions.Value.Lockout.DefaultLockoutTimeSpan.TotalMinutes);
}

<header>
    <h1 class="text-danger">@ViewData["Title"]</h1>
    <p class="text-danger">
        @L["Too many failed sign-in attempts. This account has been temporarily locked."]
    </p>
    <p>
        @L["Try again in {0} minute(s), or contact your administrator.", lockoutMinutes]
    </p>
    <p>
        <a asp-page="./Login">@L["Log in"]</a>
    </p>
</header>
