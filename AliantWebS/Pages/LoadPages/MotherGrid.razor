@page "/MotherGrid/{EventMpscenarioId:guid}"
@using AliantWebS.Pages
@using Models
@using AliantWebS.Data

@inject AppData appData;
@inject EntitiesService entitiesService
@inject ScenarioStorageService scenarioStorage
@inject IJSRuntime js

@layout AntaresConceptionLayout

<style>
    .selected-background {
        background-color: rgba(0, 255, 0, 0.1);
    }
</style>

<RadzenSplitter Orientation="Radzen.Orientation.Vertical" Style="height:90vh; border: 1px solid rgba(0,0,0,.08);">
    <RadzenSplitterPane>
        <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" Style="height:100%; border: 1px solid rgba(0,0,0,.08);">
            @* MotherGrid *@
            <RadzenSplitterPane Style="overflow: auto;" Size="50%">
                @if (MList != null)
                {
                    <div class="@(palonnierComponentSelected ? "" : "selected-background" )" @onclick="MotherGridComponentEntered">
                        <MotherGridComponent @ref="MotherGridGridRef" ElementTypesList="ElementTypesList" MPList="MList" Title="MotherGrids"
                                           MPGridChanged="HandleMGridChanged" MotherGridPalonnierListChanged="HandleElementListChanged"
                                           RowSaved="HandleRowSaved"
                                           Famille="true" EventMpscenarioId="@EventMpscenarioId" @bind-SelectedMP="selectedMotherGrid"
                                           Inventory="inventory" InventoryError="@inventoryError">
                        </MotherGridComponent>
                    </div>
                }
            </RadzenSplitterPane>

            @* Palonnier *@
            <RadzenSplitterPane Style="overflow: auto;" Size="50%">
                @if (PList != null)
                {
                    <div class="@(palonnierComponentSelected ? "selected-background" : "")" @onclick="PalonnierComponentEntered">
                        <MotherGridComponent @ref="PalonnierGridRef" ElementTypesList="ElementTypesList" MPList="PList" Title="Palonniers"
                                           MPGridChanged="HandlePGridChanged" MotherGridPalonnierListChanged="HandleElementListChanged"
                                           RowSaved="HandleRowSaved"
                                           Famille="false" EventMpscenarioId="@EventMpscenarioId" @bind-SelectedMP="selectedPalonnier"
                                           Inventory="inventory" InventoryError="@inventoryError">
                        </MotherGridComponent>
                    </div>

                    @* Where the selected palonnier hangs, and hooking or unhooking a crossing by hand. *@
                    <PalonnierAccrochages Palonnier="selectedPalonnier" Palonniers="PList" MotherGrids="MList" OnChanged="HandleHooksChanged" />
                }
            </RadzenSplitterPane>
        </RadzenSplitter>
    </RadzenSplitterPane>

    <RadzenSplitterPane>
        <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
            @* Charge *@
            <RadzenSplitterPane Style="overflow: auto;" Size="50%">
                <ChargeMPComponent @ref="chargeMpComponent"
                    EventMpscenarioId="@EventMpscenarioId"
                    ChargeList="ChargeList"
                    Carrier="@(selectedMotherGrid ?? selectedPalonnier)"

                    ChargeListChanged="HandleChargeListChanged"
                    OnCalculCharpente="HandleCalculCharpente"
                    @bind-selectedChargeMP="selectedCharge" />
            </RadzenSplitterPane>

            @* SVG/CAD *@
            <RadzenSplitterPane Style="overflow: auto;" @onwheel:stopPropagation Size="50%">
                @* Draw lines, or select - the plan's Selection button switches between the two. The plan draws where the
                   selected palonnier hangs, as PalonnierHanging decides. *@
                @* The plan of this page's own scenario (here): its event's Point0 and names. Drawing waits until that is known -
                   a line snapped to a charpente point is stored relative to Point0. *@
                <AliantWebS.Pages.CADPages.SVGComponent @ref="svgComponent"
                                                        Mode="@(Here is null ? AliantWebS.Pages.CADPages.PlanMode.View : planMode)"
                                                        ModeChanged="@(m => planMode = m)"
                                                        HangingMarks="@AliantWebS.Plan.PlanHangingMarks.For(selectedPalonnier, MList)"
                                                        OnErase="HandleErase"
                                                        LineDrawn="HandleLineDrawn"
                                                        Palonniers="PList"
                                                        MotherGrids="MList"
                                                        IntersectionPoints="ShownIntersectionPoints"
                                                        CharpenteLoads="ShownCharpenteLoads"
                                                        CharpenteCapacities="charpenteCapacities"
                                                        PalonnierLoads="ChargeList"
                                                        Point0X="@(here?.Event.Point0X ?? 0)"
                                                        Point0Y="@(here?.Event.Point0Y ?? 0)"
                                                        EventName="@here?.Event.Name"
                                                        EventId="@here?.Event.EventId"
                                                        ScenarioName="@here?.Scenario.Name"
                                                        ScenarioId="@here?.Scenario.EventMpscenarioId"
                                                        ModuleName="Mother Grid"
                                                        SelectedPalonnier="selectedPalonnier"
                                                        SelectedPalonnierChanged="HandleSvgPalonnierSelected"
                                                        SelectedMotherGrid="selectedMotherGrid"
                                                        SelectedMotherGridChanged="HandleSvgMotherGridSelected"
                                                        SelectedCharge="selectedCharge"
                                                        SelectedChargeChanged="HandleSvgChargeSelected">
                </AliantWebS.Pages.CADPages.SVGComponent>
            </RadzenSplitterPane>
        </RadzenSplitter>
    </RadzenSplitterPane>
</RadzenSplitter>

@code {
    [CascadingParameter]
    public AntaresConceptionLayout Layout { get; set; }
    [Parameter]
    public Guid EventMpscenarioId { get; set; }

    List<MotherGridPalonnier> MList { get; set; } = new List<MotherGridPalonnier>();
    List<MotherGridPalonnier> PList { get; set; } = new List<MotherGridPalonnier>();

    MotherGridComponent MotherGridGridRef;
    MotherGridComponent PalonnierGridRef;
    AliantWebS.Pages.CADPages.SVGComponent svgComponent;
    AliantWebS.Pages.CADPages.PlanMode planMode = AliantWebS.Pages.CADPages.PlanMode.Draw;

    private MotherGridPalonnier selectedMotherGrid { get; set; }
    private MotherGridPalonnier selectedPalonnier { get; set; }
    private ChargeMp selectedCharge { get; set; }

    RadzenDataGrid<MotherGridPalonnier> MGrid { get; set; }
    RadzenDataGrid<MotherGridPalonnier> PGrid { get; set; }

    public List<ElementType> ElementTypesList { get; set; } = new List<ElementType>();

    bool palonnierComponentSelected = false;

    // Données de visualisation: what the last « Calcul Charpente » of this visit found - where load enters the mothers,
    // the load on every charpente point - and the venue load book the loads are coloured against. The plan shows them
    // only while the layout is still the one calculated (ShownCharpenteLoads), so it does not show loads that no longer
    // match what is drawn - as far as this page can see (calculatedLayout).
    private Dictionary<Guid, List<(double X, double Y)>> intersectionPoints = new Dictionary<Guid, List<(double X, double Y)>>();
    private Dictionary<string, double> charpenteLoads = new Dictionary<string, double>();
    private Dictionary<string, double> charpenteCapacities = new Dictionary<string, double>();

    //   Liste des charges sur les palonniers et sur les mothers
    private List<ChargeMp> ChargeList = new List<ChargeMp>();

    // ── Add alongside the other @ref fields ──────────────────────────────────
    ChargeMPComponent chargeMpComponent;

    // The truss inventory, MotherGrill.xlsx and Palonnier.xlsx: the scenario's copies first, then the shared
    // ones in _common/data, as Calcul Charpente and the study read them. Read once per scenario, for the
    // "Pièces" column of both lists, which proposes pieces from it and checks them against it.
    private RiggingOptimizer.IO.Inventory inventory;
    private string inventoryError;
    private Guid? inventoryScenarioId;

    // The scenario this page shows - its own id - and its event: the plan's Point0 and names, the inventory files, the
    // calculation check. Never the layout's dropdown, which after Back, or while a switch waits for its navigation, may
    // name another scenario. Resolved once per id, first thing in OnParametersSetAsync. `here` is the last one resolved
    // (the plan keeps drawing it while the next is looked up); Here is null unless it is this id's.
    private ConceptionScenario here;
    private Guid? hereFor;
    private ConceptionScenario Here => hereFor == EventMpscenarioId ? here : null;

    private async Task ResolveHereAsync()
    {
        Guid id = EventMpscenarioId;
        if (hereFor == id) return;
        try
        {
            var found = await ConceptionScenario.ResolveAsync(entitiesService, Layout, id);
            if (EventMpscenarioId != id) return;   // moved on meanwhile: that id's own pass resolves it
            here = found;
            hereFor = id;   // a scenario that no longer exists too (null): not looked up again at every redraw
        }
        catch (Exception ex)
        {
            // Tried again at the next pass. Meanwhile Here is null: the plan is in View mode, no line is stored, and it
            // shows no other scenario's Point0 or names. Unless a newer pass has already resolved the page's current id -
            // a late failure of an older pass must not wipe that. hereFor is cleared too: the scenario resolved before
            // (the one the page may come back to) is looked up again rather than taken as known with nothing kept.
            if (hereFor != EventMpscenarioId)
            {
                here = null;
                hereFor = null;
            }
            Console.Error.WriteLine($"MotherGrid : scénario {id} illisible : {ex.Message}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ElementTypesList = await entitiesService.GetFilteredEntitiesAsync<ElementType>(
            x => x.Category != null && x.Category.Name.ToLower() == "mothergridpalonnier", "Category");

        if (ElementTypesList.Count == 0)
        {
            await js.InvokeVoidAsync("alert", $"Aucun type d'élements n'a été défini pour la catégorie MotherGridPalonnier");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // After the calculation going, if any. This runs at every redraw of the layout - a pick in the scenario dropdown
        // redraws it while the calculation for the scenario being left runs - and the element types below are still read
        // through the circuit's shared context, as the calculation reads them: a query started during another of its
        // operations made EF refuse a second operation on it and ended the circuit.
        if (chargeMpComponent is { } charges)
            await charges.WhenIdle();

        await ResolveHereAsync();

        // The element types again, not only once in OnInitializedAsync: « Générer l'implantation » creates a
        // type for any model of the inventory the database does not have yet, and it lands on this very
        // URL - so the page is re-parameterised, never re-initialised, and the list the edit dropdown offers
        // would be missing exactly the types the layout just used.
        ElementTypesList = await entitiesService.GetFilteredEntitiesAsync<ElementType>(
            x => x.Category != null && x.Category.Name.ToLower() == "mothergridpalonnier", "Category");

        await ReadRowsAsync();

        inventoryStamp = InventoryStamp();

        await LoadInventoryAsync();
    }

    // What the lists hold - or are being read for: the scenario, and the layout's count of « Générer l'implantation »
    // runs (null outside the conception layout). And which read is the latest.
    private (Guid Scenario, int? Generations)? rowsReadFor;
    private int rowsReads;

    // The scenario's mothers, palonniers and every charge on them - on the palonniers, and on the mother lines they hang
    // from directly (a motor within 8 cm of a point line) - in one read through a context of their own, untracked
    // (EntitiesService.ReadScenarioElementsAsync, element types included: the grid prints them). The page holds them as
    // plain data and saves each change itself, through the owned methods.
    //
    // Read again only when the scenario shown changes, or after « Générer l'implantation » (which replaces every row,
    // whether it then succeeds or not). The layout draws this page again for many reasons - a save anywhere in the tab,
    // the unsaved-changes flag - and every read gives new objects: it replaced the rows the grids were editing. A read
    // that fails propagates, as before: an empty list would say the scenario has no elements.
    private async Task ReadRowsAsync()
    {
        var key = (EventMpscenarioId, Layout?.LayoutGenerations);
        if (rowsReadFor == key) return;
        rowsReadFor = key;
        int read = ++rowsReads;

        var (elements, charges) = key.EventMpscenarioId == Guid.Empty
            ? (new List<MotherGridPalonnier>(), new List<ChargeMp>())   // no scenario on screen: nothing to read
            : await entitiesService.ReadScenarioElementsAsync(key.EventMpscenarioId);

        // The latest read wins: a slower read of the scenario shown before must not replace this one's rows.
        if (read != rowsReads) return;
        MList = elements.Where(e => e.Famille).ToList();
        PList = elements.Where(e => !e.Famille).ToList();
        ChargeList = charges;
        RebindSelection();
    }

    private async Task LoadInventoryAsync()
    {
        if (inventoryScenarioId == EventMpscenarioId) return;
        // Kept for this id only once its scenario is known (a scenario that no longer exists counts): a pass whose lookup
        // failed loads the shared files for now - marked as nobody's, so the next pass for this id, or for the scenario
        // shown before, loads its own again.
        inventoryScenarioId = hereFor == EventMpscenarioId ? EventMpscenarioId : null;
        inventory = null;
        inventoryError = null;

        try
        {
            // This page's own scenario's folder (Here), else the shared files only.
            string dataDir = Here is { } shown
                ? scenarioStorage.GetScenarioPaths(shown.Event, shown.Scenario, create: false).DataDir
                : null;
            inventory = RiggingOptimizer.IO.InventoryFiles.Load(dataDir, scenarioStorage.CommonDataDir);
        }
        catch (Exception ex)
        {
            inventoryError = ex.Message;
        }
    }

    // « Calcul Charpente » has run (the button, or leaving the page): draw its results on the plan. The charges are
    // not reloaded - the calculation does not change them.
    private async Task HandleCalculCharpente(ChargeMPComponent.LoadTransmissionResult result)
    {
        // The load book first, read at every calculation from the database itself: the circuit's own context would hand
        // back the row it already tracks, and miss a capacity saved meanwhile from another tab or by another user.
        Tcharpente loadBook;
        using (var context = entitiesService.CreateOwnedContext())
        {
            loadBook = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.FirstOrDefaultAsync(
                Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.AsNoTracking(context.Tcharpentes));
        }

        // Then the result and its capacities together, with no await in between, so the plan never draws new loads
        // against old capacities. The inventory files are looked at again: one replaced since the calculation read it
        // hides the result. No signature, no layers.
        intersectionPoints = result.MotherGridLoads.ToDictionary(m => m.Key, m => m.Value.IntersectionPoints);
        charpenteLoads = result.CharpenteLoads;
        charpenteCapacities = AliantWebS.Plan.PlanData.CapacitiesOf(loadBook);
        inventoryStamp = InventoryStamp();
        calculatedLayout = result.InputSignature;

        StateHasChanged();
        if (svgComponent != null)
            await svgComponent.RefreshVisualization();
    }

    // A row of either list was saved (✓, or "Proposer" on a row not being edited, which stops the click reaching this
    // page): draw again, which checks the calculation against it.
    private void HandleRowSaved(MotherGridPalonnier row) => StateHasChanged();

    // What the last calculation was given (CalculationSignature). The results are shown only while the page still holds
    // that layout - the same rows, with the same values:
    // a change made on this page or through its layout to an element (ends, type, name, pieces, hooks), a charge, the
    // inventory files, the scenario or Point0 hides them - by the grids, a line drawn or erased on the plan, Proposer, an
    // import, the file manager or Générer l'implantation - and putting the old value back shows them again. A page merely
    // drawn again, with the same rows reloaded, keeps them. (The grids have no cancel: leaving an edit keeps what was
    // typed.) A change made from another tab or by another user is not seen: the check compares what this page holds,
    // and it looks at the inventory files again only when the page is given its parameters or a result arrives.
    private string calculatedLayout;

    // The inventory workbooks, as CalculationSignature.InventoryStamp gives them, from the same folders the calculation
    // reads (this page's scenario, else the shared ones). Read when the page is given its parameters (the layout draws it
    // again when its file manager closes) and when a result arrives, never at every render.
    private string inventoryStamp = "";

    private string InventoryStamp()
    {
        string dataDir;
        try
        {
            dataDir = Here is { } shown
                ? scenarioStorage.GetScenarioPaths(shown.Event, shown.Scenario, create: false).DataDir
                : null;
        }
        catch (Exception ex) when (ex is System.IO.IOException or UnauthorizedAccessException or ArgumentException)
        {
            return "unreadable";
        }
        return CalculationSignature.InventoryStamp(dataDir, scenarioStorage.CommonDataDir);
    }

    private bool CalculationCurrent => calculatedLayout != null && calculatedLayout == LayoutSignature();

    private Dictionary<Guid, List<(double X, double Y)>> ShownIntersectionPoints =>
        CalculationCurrent ? intersectionPoints : new Dictionary<Guid, List<(double X, double Y)>>();

    private Dictionary<string, double> ShownCharpenteLoads =>
        CalculationCurrent ? charpenteLoads : new Dictionary<string, double>();

    // What this page holds, signed as the calculation signs what it is given.
    private string LayoutSignature() =>
        CalculationSignature.Of(EventMpscenarioId, Here?.Event.Point0X, Here?.Event.Point0Y,
            inventoryStamp, (MList ?? new()).Concat(PList ?? new()), ChargeList);

    private void MotherGridComponentEntered(MouseEventArgs e)
    {
        palonnierComponentSelected = false;
        StateHasChanged();
    }

    private void PalonnierComponentEntered(MouseEventArgs e)
    {
        palonnierComponentSelected = true;
        StateHasChanged();
    }

    private void HandleMGridChanged(RadzenDataGrid<MotherGridPalonnier> grid)
    {
        MGrid = grid;
    }

    private void HandlePGridChanged(RadzenDataGrid<MotherGridPalonnier> grid)
    {
        PGrid = grid;
    }

    // A row of either list was added, deleted or opened for editing. The charges of an element no longer listed went with
    // it (the database deletes them: ON DELETE CASCADE): off the charge grid, its total and the plan - the plan draws the
    // same list. The others stay where they are, so a charge being edited keeps what was typed.
    private async Task HandleElementListChanged(List<MotherGridPalonnier> changed)
    {
        var listed = MList.Concat(PList).Select(e => e.MotherGridPalonnierId).ToHashSet();
        await chargeMpComponent.KeepChargesOf(listed);
        RebindSelection();
        StateHasChanged();
    }

    // « Erase Selected » on the plan: the row of whichever list holds it, by id (the plan draws the lists' own objects).
    private async Task HandleErase(MotherGridPalonnier mp)
    {
        if (MList.Any(m => m.MotherGridPalonnierId == mp.MotherGridPalonnierId))
        {
            await MotherGridGridRef.DeleteMP(mp);
        }

        if (PList.Any(p => p.MotherGridPalonnierId == mp.MotherGridPalonnierId))
        {
            await PalonnierGridRef.DeleteMP(mp);
        }
    }

    // A line drawn on the plan becomes a mother or a palonnier - of the list last entered - of the type last chosen in that
    // list, made of the pieces the stock can still make for it (MotherGridComponent.ProposeFor).
    private async Task HandleLineDrawn((double x1, double y1, double x2, double y2) line)
    {
        // Relative to Point0 of a scenario not known yet (the plan is in View mode then; a line already under way).
        if (Here is null) return;

        if (palonnierComponentSelected)
            await AddDrawnLineAsync(PalonnierGridRef, famille: false, line);
        else
            await AddDrawnLineAsync(MotherGridGridRef, famille: true, line);
    }

    private async Task AddDrawnLineAsync(MotherGridComponent grid, bool famille, (double x1, double y1, double x2, double y2) line)
    {
        if ((grid.lastSelectedElementType == null) || (grid.lastSelectedElementType.ElementTypeId == Guid.Empty))
        {
            if (ElementTypesList.Count == 0) return;
            grid.lastSelectedElementType = ElementTypesList.FirstOrDefault();
        }

        Guid scenarioId = EventMpscenarioId;

        // Ids only, no navigation: InsertOwnedAsync adds what the new row points to, and its type would be inserted again.
        MotherGridPalonnier mp = new MotherGridPalonnier();
        mp.EventMpscenarioId = scenarioId;
        mp.Famille = famille;
        mp.ElementTypeId = grid.lastSelectedElementType.ElementTypeId;
        mp.X1 = line.x1; mp.Y1 = line.y1;
        mp.X2 = line.x2; mp.Y2 = line.y2;

        var proposal = grid.ProposeFor(mp);
        mp.Composition = proposal.Composition;

        // A refused insert is shown by the service itself. Into the list only if the page still shows that scenario (Back,
        // or the dropdown, may have moved it meanwhile): the row would sit in another scenario's list.
        if (!await entitiesService.InsertOwnedAsync(mp) || EventMpscenarioId != scenarioId) return;

        (famille ? MList : PList).Add(mp);
        StateHasChanged();
        await grid.MPGrid.InsertRow(mp);
        await grid.MPGrid.UpdateRow(mp);
        grid.ShowStatus(ProposalNote(proposal));
    }

    // What to tell about the pieces of a line just drawn: why the stock proposed none, or a caveat about the
    // ones it proposed; nothing when it made them without one.
    private static string ProposalNote(TrussPieces.Proposal proposal) =>
        proposal.Composition is null
            ? $"Ligne dessinée : aucune pièce proposée. {proposal.Message}"
            : proposal.Message;

    private void HandleChargeListChanged()
    {
        StateHasChanged();
    }

    // Every read gives new instances, and Generate Layout replaces every row. A selection still pointing at an old
    // instance had the Accrochages panel show - and try to save - a row that no longer exists. So the selection follows
    // its row by id, and is dropped when the row is gone; the selected charge too.
    private void RebindSelection()
    {
        if (selectedPalonnier is not null)
            selectedPalonnier = PList.FirstOrDefault(p => p.MotherGridPalonnierId == selectedPalonnier.MotherGridPalonnierId);
        if (selectedMotherGrid is not null)
            selectedMotherGrid = MList.FirstOrDefault(m => m.MotherGridPalonnierId == selectedMotherGrid.MotherGridPalonnierId);
        if (selectedCharge is not null)
            selectedCharge = ChargeList.FirstOrDefault(c => c.ChargeMpid == selectedCharge.ChargeMpid);
    }

    // A crossing hooked or unhooked by hand: redraw the plan, whose markers show where the palonnier hangs.
    private async Task HandleHooksChanged(MotherGridPalonnier palonnier)
    {
        StateHasChanged();
        if (svgComponent != null)
            await svgComponent.RefreshVisualization();
    }

    // ── Add these three handlers anywhere in @code ────────────────────────────
    private void HandleSvgPalonnierSelected(MotherGridPalonnier mp)
    {
        selectedPalonnier = mp;
        if (mp != null)
        {
            selectedMotherGrid = null;
            selectedCharge = null;
            palonnierComponentSelected = true;
        }
        StateHasChanged();
    }

    private void HandleSvgMotherGridSelected(MotherGridPalonnier mp)
    {
        selectedMotherGrid = mp;
        if (mp != null)
        {
            selectedPalonnier = null;
            selectedCharge = null;
            palonnierComponentSelected = false;
        }
        StateHasChanged();
    }

    private void HandleSvgChargeSelected(ChargeMp charge)
    {
        selectedCharge = charge;
        if (charge != null)
        {
            selectedPalonnier = null;
            selectedMotherGrid = null;
        }
        StateHasChanged();
    }
}
