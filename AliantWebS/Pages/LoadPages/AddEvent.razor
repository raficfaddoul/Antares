@page "/AddEvent"
@using AliantWebS.Data
@using AliantWebS.Models
@inject EntitiesService entitiesService
@inject NavigationManager NavigationManager
@inject AppData appData
@inject ScenarioStorageService scenarioStorage

<NavigationLock OnBeforeInternalNavigation="appData.OnBeforeInternalNavigation" ConfirmExternalNavigation="appData.SaveConfirmation&& appData.SaveChanges" />


<EventForm EditContext="@EditContext" ButtonText="Create" Eventt="@eventt"
           OnValidSubmit="@CreateEvent"
                   Title="Add Event" />

@code {
    [Parameter]
    public EditContext EditContext { get; set; }

    Event eventt = new Event();

    bool initialized = false;

    protected override async Task OnInitializedAsync()
    {
        eventt.StructureId = appData.Structure.StructureId;
        eventt.Structure = appData.Structure;
        EditContext = new EditContext(eventt);
    }

    protected async void CreateEvent()
    {
        await entitiesService.InsertEntityAsync(eventt);

        // Create the event's base folder. It carries the event id as well as its name, so renaming the
        // event later moves this folder instead of stranding it.
        try
        {
            scenarioStorage.GetEventDir(eventt);
        }
        catch (Exception ex)
        {
            // This method is async void, so a throw here would be unobservable. The event itself is
            // already saved and the folder is recreated on demand, so a warning is enough.
            Console.Error.WriteLine($"ScenariosData: création du dossier de l'événement impossible: {ex.Message}");
        }

        NavigationManager.NavigateTo("Events");
    }
}
