@page "/Equipements"
@using AliantWebS.Data
@inject EntitiesService entitiesService
@using Models
@inject NavigationManager navigationManager
@inject AppData appData;
@inject IJSRuntime js
@inject IStringLocalizer<Languages> L




<Div Style="display: flex">
    <h3>@L["Equipment list"]</h3>
    <div style="margin-left: auto; ">
        <Label> @L["Page Size"]: &nbsp;&nbsp;</Label>
        <RadzenNumeric @bind-Value="PageSize" Style="width:60px"></RadzenNumeric>
    </div>
</Div>
@if (equipementsList is null)
{
    <p><em>@L["Loading"]... !</em></p>
}
else
{
    <Div Style="display: flex">
        <NavLink class="nav-link" href="AddEquipement">
            <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
        </NavLink>
    </Div>
    <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
        <RadzenSplitterPane Size="50%">

            <RadzenSplitter Orientation="Radzen.Orientation.Vertical" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
                <RadzenSplitterPane Size="auto">


                    <RadzenDataGrid class="RadzenDataGrid" @ref="equipementsGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize" RowSelect=@RowSelect
                                    Data="@equipementsList" TItem="Equipement" ColumnWidth="150px">
                        <Columns>
                            <RadzenDataGridColumn TItem="Equipement" Property="Name" Title="@L["Name"]"></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="Equipement" Property="Description" Title="@L["Description"]"></RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="Equipement" Property="Name" Title="@L["Action"]" Filterable="false" Sortable="false">
                                <Template Context="data">
                                    <Div Style="display: flex">
                                        <a title="@L["Edit"]" class="nav-link" href="EditEquipement/@data.EquipementId">
                                            <span class="oi oi-pencil" aria-hidden="true"></span>
                                        </a>
                                        <a title="@L["Delete"]" @onclick="@(() => DeleteEvent(data))" @onclick:preventDefault="true" href="">
                                            <span class="oi oi-trash" aria-hidden="true"></span>
                                        </a>
                                    </Div>
                                </Template>

                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>

                </RadzenSplitterPane>
                <RadzenSplitterPane>
                    @if (selectedEquipement != null)
                    {
                        <MediaComponent selectedObject="selectedEquipement"></MediaComponent>

                    }


                </RadzenSplitterPane>

            </RadzenSplitter>
        </RadzenSplitterPane>
        <RadzenSplitterPane>

        </RadzenSplitterPane>
    </RadzenSplitter>



}


@code {


    List<Equipement> equipementsList;


    Equipement selectedEquipement;

    int PageSize { get; set; } = 10;

    RadzenDataGrid<Equipement> equipementsGrid;


    protected override async Task OnInitializedAsync()
    {
        appData.Structure = null;
        equipementsList = await entitiesService.GetAllEntitiesAsync<Equipement>();

    }

    async Task RowSelect(Equipement equipement)
    {
        //   navigationManager.NavigateTo(@"/defects");
        selectedEquipement = equipement;
        //   StateHasChanged();

    }

    async Task DeleteEvent(Equipement equipement)
    {
        var isConfirmed = await js.InvokeAsync<bool>("confirm", L["Delete this equipment?"].Value);

        if (isConfirmed)
        {
            try
            {
                if (await entitiesService.DeleteEntityAsync(equipement))
                {
                    if (equipementsList.Remove(equipement))
                    {
                        await equipementsGrid.Reload();

                    }
                }
            }
            catch (Exception ex)
            {
                await js.InvokeVoidAsync("alert", "Error: " + ex.Message);
            }
        }
    }



}
