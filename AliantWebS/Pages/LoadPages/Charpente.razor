                    var match = Regex.Match(property.Name, @"([A-Z]+)(\d+)");
                    if (match.Success)
                    {
                        string letter = match.Groups[1].Value;
                        string number = match.Groups[2].Value;

                        // Add the (number, letter) pair and value to the dictionary
                        result.Add((number, letter), value);
                    }
                }
                else
                {
                    // Safely cast the non-null value to double
                    double value = 0;

                    // Use regex to split the property name into letter and number
                    var match = Regex.Match(property.Name, @"([A-Z]+)(\d+)");
                    if (match.Success)
