@page "/Charpente/{EventMpscenarioId:guid}"

@using AliantWebS.Data
@using Models
@using Microsoft.EntityFrameworkCore
@inject IStringLocalizer<Languages> L
@inject EntitiesService entitiesService
@inject AppData appData;
@inject IJSRuntime js

@layout AntaresConceptionLayout
@implements IAsyncDisposable

@* Importing necessary namespaces *@
@using System.Collections.Generic
@using System.Reflection
@using System.Text.RegularExpressions
@using System.Data;

<style>
    .small-cell {
    width: 100px !important; /* Adjust the width as needed */
    height: 50px; /* Adjust the height as needed */
    padding: 0; /* Remove padding to make cells smaller */
    text-align: center; /* Center-align the text */
    }

    .small-input {
    width: 100% !important; /* Make the input take full width of the cell */
    height: 50%; /* Make the input take full height of the cell */
    box-sizing: border-box; /* Include padding and border in the element's total width and height */
    font-size: 12px; /* Adjust the font size as needed */
    padding: 0; /* Remove padding for the input */
    }

    .fixed-table {
    table-layout: fixed;
    width: auto; /* Set to auto to prevent expanding to full width */
    }

    .center-text {
    text-align: center;
    }

    /* Alternating row colors */
    .table tbody tr:nth-child(even) {
    background-color: #e0f7fa !important; /* Light cyan */
    }

    .table tbody tr:nth-child(odd) {
    background-color: #ffffff !important; /* White */
    }

    /* Alternating column colors within alternating rows */
    .table tbody tr:nth-child(even) td:nth-child(even),
    .table tbody tr:nth-child(odd) td:nth-child(even),
    .table tbody tr:nth-child(even) th:nth-child(even),
    .table tbody tr:nth-child(odd) th:nth-child(even) {
    background-color: rgba(255, 255, 153, 0.5) !important; /* Lighter yellow with transparency */
    }

    .table tbody tr:nth-child(even) td:nth-child(odd),
    .table tbody tr:nth-child(odd) td:nth-child(odd),
    .table tbody tr:nth-child(even) th:nth-child(odd),
    .table tbody tr:nth-child(odd) th:nth-child(odd) {
    background-color: inherit; /* Keep the row background color */
    }

    /* Ensure input fields inherit background color */
    .table tbody tr td.small-cell input {
    background-color: inherit;
    }

    .legend-box {
    display: inline-block;
    width: 20px;
    height: 20px;
    margin-right: 5px;
    vertical-align: middle;
    }

    .white-background {
    background-color: #ffffff; /* White */
    border: 1px solid #aaaaaa;
    }

    .faint-magenta-background {
    background-color: #fde4f9; /* Faint magenta */
    border: 1px solid #aaaaaa;
    }

    .legend-text {
    vertical-align: middle;
    }

    /* Boutons, interrupteurs de charges et légende sur une seule ligne ; retour à la ligne seulement
       si le volet est trop étroit pour tout contenir. */
    .controls-container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    }

    .buttons-container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    }

    .buttons-container .btn {
    white-space: nowrap;
    }

    .charges-options {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 16px;
    }

    .charge-option {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    }

    .charge-label {
    font-weight: 600;
    }

    .charge-param, .charge-unit {
    color: #555;
    }

    .legend-container {
    display: flex;
    align-items: center;
    gap: 14px;
    white-space: nowrap;
    }

    .tooltip-container {
    position: relative;
    display: inline-block;
    }

    .tooltip-text {
    visibility: hidden;
    width: 120px;
    background-color: #f9f9f9;
    color: #fff;
    text-align: center;
    border-radius: 6px;
    padding: 5px 0;
    position: absolute;
    z-index: 1;
    bottom: 100%;
    left: 50%;
    margin-left: -60px;
    }

    .tooltip-container:hover .tooltip-text {
    visibility: visible;
    }

    .tooltip-text::before {
    display: none;
    }

    /* ---- Compte rendu + datagrid cards ---- */
    .cr-card, .grid-card {
        background: #fff;
        border: 1px solid #e6e6ef;
        border-radius: 10px;
        box-shadow: 0 1px 4px rgba(20, 30, 60, 0.07);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        margin: 6px;
    }

    .cr-card {
        height: calc(100% - 12px);   /* 100 % moins la marge de 6px haut et bas : pas de débordement du volet */
        box-sizing: border-box;
    }

    .grid-card {
        height: auto;
        margin-top: 16px;
    }

    .cr-card-header, .grid-card-header {
        background: linear-gradient(90deg, #2c3e50, #46637f);
        color: #fff;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.2px;
        padding: 9px 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cr-icon { font-size: 1.05rem; line-height: 1; }

    .cr-body {
        flex: 1 1 0;
        min-height: 0;          /* sans cela, un enfant flex grandit avec son contenu au lieu de défiler */
        overflow: auto;
        padding: 12px 14px;
        font-size: 0.85rem;
        line-height: 1.5;
        color: #2c3e50;
        background: #fbfbfd;
    }

    .cr-body .cr-titre {
        text-align: center;
        font-size: 1.1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0 0 10px;
        padding-bottom: 6px;
        border-bottom: 2px solid #2c3e50;
    }

    .cr-body h5 {
        font-size: 0.95rem;
        font-weight: 600;
        color: #46637f;
        margin: 16px 0 6px;
        border-bottom: 1px solid #e6e6ef;
        padding-bottom: 3px;
    }

    .cr-body .cr-info td { padding: 1px 0; }
    .cr-body .cr-info td:first-child { font-weight: 600; padding-right: 2em; }  /* tabulation label / valeur */

    .cr-body .cr-table {
        border-collapse: collapse;
        width: 100%;
        font-variant-numeric: tabular-nums;
    }

    .cr-body .cr-table th {
        background: #ecedf3;
        text-align: center;
        padding: 4px 8px;
    }

    .cr-body .cr-table td {
        padding: 3px 8px;
        border-bottom: 1px solid #ecedf3;
        text-align: right;
    }

    .cr-body .cr-table td:first-child { text-align: left; }
    .cr-body .cr-table tr.cr-total td { font-weight: 700; border-top: 2px solid #2c3e50; }
    .cr-body .cr-note { font-size: 0.78rem; color: #666; margin: 4px 0 0; }

    .cr-body .cr-table td.cr-taux {
        text-align: center;
        color: #fff;
        font-weight: 600;
    }

    .cr-body .cr-etat {
        text-align: center;
        font-weight: 700;
        color: #fff;
        padding: 8px;
        border-radius: 6px;
        margin: 6px 0;
    }

    /* Bandeau d'état en tête du compte rendu : plus gros que le texte courant (0.85rem) */
    .cr-body .cr-bandeau {
        text-align: center;
        color: #fff;
        font-size: 1.4rem;
        font-weight: 700;
        padding: 12px 10px;
        border-radius: 8px;
        margin-bottom: 14px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    }

    .cr-body .cr-bandeau-message {
        font-weight: 800;
        letter-spacing: 0.5px;
    }

    .cr-body .cr-bandeau-taux {
        display: block;
        font-size: 1.1rem;
        font-weight: 700;
        margin-top: 2px;
        opacity: 0.95;
    }

    .cr-body .cr-oui    { color: #388e3c; font-weight: 700; }
    .cr-body .cr-non    { color: #888; font-style: italic; }
    .cr-body .cr-info td.cr-detail { font-weight: 400; padding-left: 1.5em; color: #666; }

    .cr-body .cr-alerte {
        background: #fff3e0;
        border-left: 4px solid #f57c00;
        color: #8a4b00;
        padding: 6px 10px;
        margin: 8px 0;
        border-radius: 4px;
    }

    .cr-body .cr-rouge  { background: #d32f2f; }
    .cr-body .cr-orange { background: #f57c00; }
    .cr-body .cr-vert   { background: #388e3c; }
    .cr-body .cr-vide   { color: #888; font-style: italic; text-align: center; }

    .taux-bar-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .taux-bar-track {
        flex: 1;
        height: 14px;
        background: #ecedf3;
        border-radius: 7px;
        overflow: hidden;
    }

    .taux-bar-fill {
        height: 100%;
        border-radius: 7px;
        transition: width 0.3s ease;
    }

    .taux-pct {
        min-width: 56px;
        text-align: right;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        color: #2c3e50;
    }
</style>




<RadzenSplitter>
    <RadzenSplitterPane>
        @* Hauteur explicite et tailles fixes : le compte rendu défile dans son cadre au lieu d'agrandir
           son volet, ce qui réduisait le plan au-dessus à chaque calcul. La hauteur du conteneur est
           alignée par charpente-layout.js sur le bas du contenu de droite (90vh avant le premier rendu). *@
        <div @ref="colonneGauche" style="height: 90vh;">
        <RadzenSplitter Orientation="Radzen.Orientation.Vertical" Style="height: 100%;">
            <RadzenSplitterPane Size="50%">
                <AliantWebS.Pages.CADPages.SVGComponent Mode="AliantWebS.Pages.CADPages.PlanMode.View"
                                                        Point0X="@(Layout?.selectedEvent?.Point0X ?? 0)"
                                                        Point0Y="@(Layout?.selectedEvent?.Point0Y ?? 0)"
                                                        EventName="@Layout?.selectedEvent?.Name"
                                                        EventId="@Layout?.selectedEvent?.EventId"
                                                        ScenarioName="@Layout?.selectedScenario?.Name"
                                                        ScenarioId="@Layout?.selectedScenario?.EventMpscenarioId"
                                                        StructureName="@appData.Structure?.Name"
                                                        ModuleName="Charpente"></AliantWebS.Pages.CADPages.SVGComponent>
            </RadzenSplitterPane>
             <RadzenSplitterPane Size="50%" Style="overflow: hidden;">
                <div class="cr-card">
                    <div class="cr-card-header">
                        <span class="cr-icon">📋</span> @L["Compte Rendu"]
                    </div>
                    <div class="cr-body">
                        @if (string.IsNullOrEmpty(compteRendu))
                        {
                            <p class="cr-vide">@L["Lancer « Calcul Charpente » pour obtenir le compte rendu."]</p>
                        }
                        else
                        {
                            @((MarkupString)compteRendu)
                        }
                    </div>
                </div>
             </RadzenSplitterPane>
        </RadzenSplitter>
        </div>
    </RadzenSplitterPane>
    <RadzenSplitterPane>
        <div @ref="colonneDroite">
        <div class="form-group">
            <div class="controls-container">
                <!-- Buttons Container -->
                <div class="buttons-container">
                    <button type="button" class="btn btn-success" @onclick="Calcul" disabled="@isCalculating">
                        @if (isCalculating)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>@L["Calcul en cours..."]</span>
                        }
                        else
                        {
                            @L["Calcul Charpente"]
                        }
                    </button>
                    @if (canEditLimits)
                    {
                        <button type="button" class="btn btn-success" @onclick="saveLimitstodatabase">
                            @L["Save Critical Loads"]
                        </button>
                    }
                    <div class="charges-options">
                        <div class="charge-option">
                            <RadzenSwitch @bind-Value="poidsPropre" Disabled="@isCalculating" />
                            <span class="charge-label">@L["Poids propre"]</span>
                            <span class="charge-param">q =</span>
                            <RadzenNumeric TValue="double" @bind-Value="chargeQ" Min="0" Step="5" Format="0"
                                           Disabled="@(!poidsPropre || isCalculating)" Style="width:75px" />
                            <span class="charge-unit">kg/m²</span>
                            <span class="charge-param">q1 =</span>
                            <RadzenNumeric TValue="double" @bind-Value="chargeQ1" Min="0" Step="5" Format="0"
                                           Disabled="@(!poidsPropre || isCalculating)" Style="width:75px" />
                            <span class="charge-unit">kg/m²</span>
                        </div>
                        <div class="charge-option">
                            <RadzenSwitch @bind-Value="neige" Disabled="@isCalculating" />
                            <span class="charge-label">@L["Neige"]</span>
                            <span class="charge-param">épaisseur =</span>
                            <RadzenNumeric TValue="double" @bind-Value="epaisseurNeige" Min="0" Step="1" Format="0"
                                           Disabled="@(!neige || isCalculating)" Style="width:75px" />
                            <span class="charge-unit">cm</span>
                        </div>
                    </div>
                </div>
                <!-- Legend Container -->
                @* Listed in the order the two inputs appear inside each cell: the white box on top is
                   the load computed by Calcul Charpente, the magenta box below it is the capacity from
                   the venue load book. The two labels were the wrong way round, which made the whole
                   grid read backwards. *@
                <div class="legend-container">
                    <div>
                        <span class="legend-box white-background"></span>
                        <span class="legend-text">@L["Calculated Values"]</span>
                    </div>
                    <div>
                        <span class="legend-box faint-magenta-background"></span>
                        <span class="legend-text">@L["Limit values"]</span>
                    </div>
                </div>
            </div>
        </div>

        <table class="table table-bordered fixed-table">
            <thead>
                <tr>
                    <th class="small-cell"></th>
                    @foreach (var col in columns)
                    {
                        <th class="small-cell">@col</th>
                    }
                </tr>

            </thead>
            <tbody>
                @for (int i = 0; i < rows.Count(); i++)
                {
                    var row = rows[i];
                    <tr>
                        <th class="small-cell">@row</th>
                        @foreach (var col in columns)
                        {
                            <td class="small-cell">
                                <div class ="tooltip-container">
                                    <span class="tooltip-text" style="@RatioStyle(CalculateRatio(row, col))">@TauxText("Taux de charge", CalculateRatio(row, col))</span>
                                    @* The calculated cell carries the same colour as its tooltip, so the
                                       whole grid can be read at a glance without hovering ninety cells. *@
                                    <input type="number" step="any" class="form-control small-input center-text" value="@(GetCellValue(row, col).ToString(System.Globalization.CultureInfo.InvariantCulture))" @onchange="e => UpdateCellValue(row, col, e)"
                                    style="@RatioStyle(CalculateRatio(row, col))" />
                                    <input type="number" step="any"
                                    class="form-control small-input center-text"
                                    value="@(GetCellValue(row, col, false).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                    @onchange="e => UpdateCellValue(row, col, e, false)"
                                    disabled="@(!canEditLimits)"
                                    style="background-color: #fde4f9;" />
                                </div>
                            </td>
                        }
                    </tr>
                }
                @* Total row: the summed load on a beam over that beam's own capacity.
                   The beam limit is NOT the sum of its nine point limits — it is considerably lower,
                   and it is usually the constraint that actually binds — so it is entered here rather
                   than derived. It comes from the beamCapacity vector (9000 kg per beam by default). *@
                <tr>
                    <th class="small-cell">Total</th>
                    @foreach (var col in columns)
                    {
                        <td class="small-cell">
                            <div class="tooltip-container">
                                <span class="tooltip-text" style="@RatioStyle(CalculateBeamRatio(col))">
                                    @TauxText("Taux de charge poutre", CalculateBeamRatio(col))
                                </span>
                                @* Read-only: this is a computed sum. It was rendered as an editable
                                   input with no change handler, so anything typed in was discarded. *@
                                <input type="number" step="any" class="form-control small-input center-text" readonly
                                       value="@(GetSumValue(col).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                       style="@RatioStyle(CalculateBeamRatio(col))" />
                                <input type="number" step="any"
                                       class="form-control small-input center-text"
                                       value="@(GetBeamCapacity(col).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                       @onchange="e => UpdateBeamCapacity(col, e)"
                                       disabled="@(!canEditLimits)"
                                       style="background-color: #fde4f9;" />
                            </div>
                        </td>
                    }
                </tr>
            </tbody>
        </table>
        <Label>Charge Totale</Label>
        <input disabled value="@(GetGrandSumValue().ToString(System.Globalization.CultureInfo.InvariantCulture))" />
        <div class="grid-card">
            <div class="grid-card-header">
                <span class="cr-icon">📊</span> @L["Taux de travail par élément"]
            </div>
            <RadzenDataGrid Data="@elementsSortedByTaux" TItem="Element"
                            AllowSorting="true" AllowPaging="true" PageSize="10"
                            AllowColumnResize="true">
                <Columns>
                    <RadzenDataGridColumn TItem="Element" Property="Name" Title="@L["Nom de l'élément"]" />
                    <RadzenDataGridColumn TItem="Element" Title="@L["Taux de travail"]" Width="240px" Sortable="false">
                        <Template Context="element">
                            @{
                                var _t = GetTauxTravail(element.ElementId);
                                var _pct = _t * 100;
                                var _c = TauxColor.ToColor(_t);
                                var _w = (int)Math.Round(Math.Clamp(_pct, 0, 100));
                                var _rgb = $"rgb({_c.R},{_c.G},{_c.B})";
                            }
                            <div class="taux-bar-wrap">
                                <div class="taux-bar-track">
                                    <div class="taux-bar-fill" style="width:@(_w)%; background:@_rgb;"></div>
                                </div>
                                <span class="taux-pct">@_pct.ToString("F1") %</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
        </div>
    </RadzenSplitterPane>
</RadzenSplitter>



@code {

    [Parameter]
    public Guid EventMpscenarioId { get; set; }

    [CascadingParameter]
    public AntaresConceptionLayout Layout { get; set; }

    // Alignement du bas de la colonne gauche (plan + compte rendu) sur celui du contenu de droite.
    private ElementReference colonneGauche;
    private ElementReference colonneDroite;
    private IJSObjectReference layoutModule;
    private IJSObjectReference alignementHandle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            layoutModule = await js.InvokeAsync<IJSObjectReference>("import", "./js/charpente-layout.js");
            alignementHandle = await layoutModule.InvokeAsync<IJSObjectReference>("alignerHauteur", colonneGauche, colonneDroite);
        }
        catch (JSDisconnectedException) { }   // circuit fermé pendant le chargement : rien à aligner
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (layoutModule != null) await layoutModule.InvokeVoidAsync("liberer", alignementHandle);
            if (alignementHandle != null) await alignementHandle.DisposeAsync();
            if (layoutModule != null) await layoutModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }   // onglet fermé : le navigateur a déjà tout libéré
    }

    // Define the columns and rows — display order: columns J→A (left→right), rows 9→1 (top→bottom).
    private readonly string[] columns = { "J", "I", "H", "G", "F", "E", "D", "C", "B", "A" };
    private readonly string[] rows = { "9", "8", "7", "6", "5", "4", "3", "2", "1" };

    // Capacité propre de chaque poutre A→J (kg), comparée à la somme de ses charges sur la ligne Total.
    // Elle n'est PAS la somme des capacités de ses neuf points d'accroche : elle est nettement plus
    // faible, et c'est en général elle qui dimensionne.
    private readonly Dictionary<string, double> beamCapacity = new()
    {
        ["A"] = 9000, ["B"] = 9000, ["C"] = 9000, ["D"] = 9000, ["E"] = 9000,
        ["F"] = 9000, ["G"] = 9000, ["H"] = 9000, ["I"] = 9000, ["J"] = 9000,
    };

    private double GetBeamCapacity(string col) => beamCapacity.TryGetValue(col, out double c) ? c : 0;

    // Modifiable par les administrateurs pour la session ; non enregistrée en base.
    private void UpdateBeamCapacity(string col, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
                            System.Globalization.CultureInfo.InvariantCulture, out double value))
            beamCapacity[col] = value;
    }

    // ---- Vérification RDM : poutre simplement appuyée sous les charges ponctuelles de la grille ----
    // Valeurs par défaut calées sur la capacité de 9000 kg : 9 × 1000 kg aux points 1..9 donnent
    // V = 44,1 kN et M = 122,6 kN·m sur 10 m. À remplacer par les valeurs réelles de chaque poutre.
    private readonly Dictionary<string, double> beamSpan = columnsDefault(10);    // portée L, m
    private readonly Dictionary<string, double> beamMRd = columnsDefault(125);    // moment résistant, kN·m
    private readonly Dictionary<string, double> beamVRd = columnsDefault(45);     // effort tranchant résistant, kN

    private static Dictionary<string, double> columnsDefault(double v) =>
        new[] { "A", "B", "C", "D", "E", "F", "G", "H", "I", "J" }.ToDictionary(c => c, _ => v);

    private const double Gravite = 9.81;   // kg → N

    /// <summary>Résultat RDM d'une poutre. Charges additionnelles en kg ; null si MRd/VRd/L non renseignés.</summary>
    private record BeamRdm(double MEd, double VEd, double? Taux, double? AjoutMiTravee, double? AjoutQuart);

    /// <summary>
    /// Position du point d'accroche le long de la poutre : les points 1..9 sont supposés équidistants,
    /// à i·L/10 de l'appui gauche.
    /// </summary>
    private static double PositionPoint(string row, double portee) => int.Parse(row) * portee / 10;

    /// <summary>
    /// Poutre simplement appuyée de portée L, charges ponctuelles P_i (kg de la grille → kN) en a_i.
    ///   R_A = Σ P_i (L − a_i) / L,  R_B = Σ P_i a_i / L
    ///   V_Ed = max(R_A, R_B) (effort tranchant maximal, aux appuis)
    ///   M(x) = R_A x − Σ_{a_i < x} P_i (x − a_i), maximal sous une charge → M_Ed = max M(a_i)
    ///   Taux = max(M_Ed / MRd, V_Ed / VRd)
    /// Charge additionnelle admissible ΔP en ξ (mi-travée ξ = L/2 ; quart de travée ξ = L/4 et 3L/4, la
    /// plus défavorable) : plus grande ΔP telle que M(x) + ΔP·G(x, ξ) ≤ MRd en tout point et que les
    /// réactions restent ≤ VRd, avec G la ligne d'influence du moment :
    ///   G(x, ξ) = x (L − ξ) / L si x ≤ ξ,  ξ (L − x) / L sinon.
    /// </summary>
    private BeamRdm CalculateBeamRdm(string col)
    {
        double L = beamSpan.GetValueOrDefault(col);
        double mRd = beamMRd.GetValueOrDefault(col);
        double vRd = beamVRd.GetValueOrDefault(col);

        var charges = rows
            .Select(r => (a: PositionPoint(r, L), P: GetCellValue(r, col) * Gravite / 1000))   // kN
            .Where(c => c.P != 0)
            .ToList();

        double rA = charges.Sum(c => c.P * (L - c.a)) / (L > 0 ? L : 1);
        double rB = charges.Sum(c => c.P * c.a) / (L > 0 ? L : 1);

        double Moment(double x) => rA * x - charges.Where(c => c.a < x).Sum(c => c.P * (x - c.a));

        double vEd = Math.Max(Math.Abs(rA), Math.Abs(rB));
        double mEd = charges.Select(c => Moment(c.a)).DefaultIfEmpty(0).Max();

        if (L <= 0 || mRd <= 0 || vRd <= 0)
            return new BeamRdm(mEd, vEd, null, null, null);

        double taux = Math.Max(mEd / mRd, vEd / vRd);

        double? Ajout(double xi)
        {
            double G(double x) => x <= xi ? x * (L - xi) / L : xi * (L - x) / L;

            double dp = double.MaxValue;
            foreach (double x in charges.Select(c => c.a).Append(xi))
            {
                double g = G(x);
                if (g > 0) dp = Math.Min(dp, (mRd - Moment(x)) / g);
            }
            dp = Math.Min(dp, (vRd - rA) / ((L - xi) / L));
            dp = Math.Min(dp, (vRd - rB) / (xi / L));

            return Math.Max(0, dp) * 1000 / Gravite;   // kN → kg
        }

        double? ajoutQuart = Math.Min(Ajout(L / 4) ?? 0, Ajout(3 * L / 4) ?? 0);
        return new BeamRdm(mEd, vEd, taux, Ajout(L / 2), ajoutQuart);
    }

