    /// <summary>
    /// Blue through red by load ratio, solid red above 1, grey when no capacity is on record.
    /// Used by both the tooltip and the calculated cell behind it so the two can never disagree.
    /// </summary>
    private static string RatioStyle(double? ratio)
    {
        // No capacity on record. Grey, because this is "unknown", not "lightly loaded" — the old code
        // returned 0 here and painted it the same blue as a genuinely unloaded point.
        if (ratio is not { } r)
            return "background-color: #757575; color: white;";

        if (r > 1)
            return "background-color: red; color: white;";

        // Calculate color gradient from blue to red
        int red = (int)(255 * r); // Increases as ratio approaches 1
        int blue = 255 - red; // Decreases as ratio approaches 1
        return $"background-color: rgb({red}, 0, {blue}); color: white;";
    }

    /// <summary>Tooltip text for a ratio, distinguishing an unknown capacity from a zero load.</summary>
    private static string TauxText(string label, double? ratio) =>
        ratio is { } r ? $"{label} : {r:F2}" : $"{label} : capacité non renseignée";

    /// <summary>
    /// Load over capacity for one attachment point, or null when the cahier des charges has no
    /// capacity for it. Null rather than 0: a missing limit is not a comfortable one.
    /// </summary>
    private double? CalculateRatio(string row, string col)
    {
        double capacity = GetCellValue(row, col, false);
        if (capacity == 0) return null;

        return GetCellValue(row, col) / capacity;
    }

    /// <summary>
    /// Taux de charge d'une poutre : somme de ses charges / sa capacité (beamCapacity). Null quand la
    /// capacité est nulle : une capacité manquante n'est pas une poutre peu chargée.
    /// </summary>
    private double? CalculateBeamRatio(string col)
    {
        double capacity = GetBeamCapacity(col);
        if (capacity == 0) return null;

        return GetSumValue(col) / capacity;
    }

    private Dictionary<Guid, (int dof, double value)> GetChargeNodale(AliantWebS.Models.Charpente charpente, Tcharpente tCharpente)
    {
        // Load chargeNodale using Tcharpente mappings and Charpente values
        var chargeNodale = new Dictionary<Guid, (int dof, double value)>();

        Models.Charpente charpente1 = new Models.Charpente();


        // Use reflection to iterate through all properties
        var charpenteProperties = typeof(Models.Charpente).GetProperties()
            .Where(p => p.PropertyType == typeof(double?) && Regex.IsMatch(p.Name, @"^[A-J]\d+$"))
            .ToList();

        foreach (var charpenteProp in charpenteProperties)
        {
            // Get the value from Charpente
            var chargeValue = charpenteProp.GetValue(charpente) as double?;

            if (chargeValue.HasValue && chargeValue.Value != 0)
            {
                // Get the corresponding map property from Tcharpente (e.g., "A1" -> "A1map")
                var mapPropertyName = $"{charpenteProp.Name}map";
                var mapProperty = typeof(Models.Tcharpente).GetProperty(
                    mapPropertyName,
                    BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase
                );

                if (mapProperty != null)
                {
                    var elementGuid = mapProperty.GetValue(tCharpente) as Guid?;

                    // If mapping exists and is not empty, add to chargeNodale
                    if (elementGuid.HasValue && elementGuid.Value != Guid.Empty)
                    {
                        // dof = 2: vertical load (Z axis, upwards). Gravity loads are passed negative, like the self-weight
                        // and snow that CharpenteFEHelper.AjouterChargesComplementaires adds.
                        chargeNodale[elementGuid.Value] = (dof: 2, value: -chargeValue.Value);
                    }
                }
            }
        }

        return chargeNodale;

    }

    private async void Calcul()
    {
        // async void: nothing above catches what escapes it - it would end the circuit. The scenario's row and its grid as
        // the click found them: a navigation during the calculation (to Charpente/0000, or to another scenario) replaces
        // the page's fields, and one scenario's row must never be saved with another's grid.
        var charpente = this.charpente;
        var grid = tableData;
        if (charpente is null)
        {
            await js.InvokeVoidAsync("alert", "Aucun scénario sélectionné : rien à calculer.");
            return;
        }

        isCalculating = true;
        StateHasChanged();
        try
        {
            await CalculFor(charpente, grid);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException)
        {
            // Its row no longer exists: the scenario was deleted, from another tab.
            await js.InvokeVoidAsync("alert", "Ce scénario n'existe plus : le calcul n'est pas enregistré.");
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", $"❌ ERREUR lors du calcul : {ex.GetBaseException().Message}");
            Console.WriteLine($"Charpente.Calcul : {ex}");
        }
        finally
        {
            isCalculating = false;
            StateHasChanged();
        }
    }

    private async Task CalculFor(Models.Charpente charpente, Dictionary<(string, string), double> grid)
    {
        await Task.Yield(); // let the spinner paint before the (heavy, synchronous) FE solve
        if (appData.Structure == null)
        {
            Structure structure = await entitiesService.GetFilteredFirstEntityAsync<Structure>(x => x.StructureId.ToString() == "84028ce7-6e17-ef11-ab4f-3c557678c0f7");
            appData.Structure = structure;
        }

        Dictionary<LoadCase, double> selectedLoadCases = new Dictionary<LoadCase, double>();

        List<LoadCase> loadCases = await entitiesService.GetFilteredEntitiesAsync<LoadCase>(x => x.StructureId == appData.Structure.StructureId);

        selectedLoadCases = loadCases.ToDictionary(lc => lc, lc => 1.0); // Assuming all load cases are selected with a factor of 1.0


        var chargeNodale = GetChargeNodale(charpente, tcharpente);

        // Beam3d elements (for the datagrid sort + the 3D BimId map below).


        //****** Alaa : début ********/

        List<Element> elements =  entitiesService.GetFilteredEntitiesAsync<Element>(
            a => ((a.StructureId == appData.Structure.StructureId)
            && ((a.ElementType != null && (a.ElementType.Name == "Beam3d" || a.ElementType.Name == "Elem3d")
            && a.Structural == 1))),
            "ElementType", "AttributeElements.AttributeType").Result;

        List<Element> nodes = entitiesService.GetFilteredEntitiesAsync<Element>(
            a => ((a.StructureId == appData.Structure.StructureId) 
             && ((a.ElementType?.Name == "Noeud3d"))),
            "ElementType", "AttributeElements.AttributeType").Result;

        // Poids propre (Rho × S × L + q × surface) et neige (s × surface), selon les interrupteurs.
        var chargesComplementaires = CharpenteFEHelper.AjouterChargesComplementaires(
            chargeNodale, appData.Structure.StructureId, elements, nodes, poidsPropre, chargeQ, chargeQ1, neige, epaisseurNeige);

        VerificationCalculMEF(elements, nodes, chargeNodale);
        
        //****** Alaa : fin ********/

        // FE solve (extracted to CharpenteFEHelper so SurveillanceAntares runs the SAME solve
        // with measured loads). Here the loads are the calculated ones (chargeNodale above).
        var (beamTaux, componentTaux) = await CharpenteFEHelper.ComputeAsync(appData.Structure, selectedLoadCases, chargeNodale, entitiesService);

        tauxTravail.Clear();
        foreach (var bt in beamTaux)
            tauxTravail[bt.ElementId] = bt.Taux;

        compteRendu = ConstruireCompteRendu(beamTaux, componentTaux, chargesComplementaires);

        //TauxGroupe[]={Nom,charge totale, tauxTravail max,  Effortcritique}
        // Message : état de la structure "Charges validées", Charges inadmissible, diminuer les charges sur poutre E
        // Flag du message : rouge, orange, vert
        // Compte rendu

        // Sort elements by taux de travail descending
        elementsSortedByTaux = elements
            .Where(e => tauxTravail.ContainsKey(e.ElementId))
            .OrderByDescending(e => tauxTravail[e.ElementId])
            .ToList();

        // Per-BimId taux for the 3D model (the Modèle 3D page derives colours + tooltip from it).
        appData.CharpenteTauxByBimId = elements
            .Where(e => e.BimId.HasValue && tauxTravail.ContainsKey(e.ElementId))
            .GroupBy(e => e.BimId.Value)
            .ToDictionary(g => g.Key, g => tauxTravail[g.First().ElementId]);

        await savetodatabase(charpente, grid);
    }


    // Seuil au-delà duquel un taux est signalé « à surveiller » (orange) avant de devenir inadmissible (> 1).
    private const double SeuilVigilance = 0.8;

    /// <summary>
    /// Compte rendu HTML du calcul, affiché en lecture seule dans le panneau « Compte Rendu ».
    /// Les noms venant de la base passent par Enc() : un « < » ou un « & » ne doit pas casser le rendu.
    /// </summary>
    private string ConstruireCompteRendu(List<BeamTaux> beamTaux, List<ComponentTaux> componentTaux, ChargesComplementaires charges)
    {
        var sb = new System.Text.StringBuilder();

        // ---- Bilan, calculé d'abord : il alimente le bandeau du haut et la conclusion ----
        var elementsTries = beamTaux.OrderByDescending(b => b.Taux).ToList();
        var rdm = columns.ToDictionary(c => c, CalculateBeamRdm);
        // Une poutre est hors limite si elle dépasse sa capacité globale OU sa vérification RDM (MRd, VRd).
        double? TauxPoutre(string c) =>
            new[] { CalculateBeamRatio(c), rdm[c].Taux }.Where(t => t.HasValue).Select(t => t.Value).DefaultIfEmpty().Max();
        var poutresKo = Enumerable.Reverse(columns).Where(c => TauxPoutre(c) > 1).ToList();
        var elementsKo = elementsTries.Where(b => b.Taux > 1).Select(b => Enc(b.Name)).ToList();

        // Taux maximal sur les éléments ET sur les poutres : une poutre au-delà de sa capacité suffit
        // à rendre la structure trop chargée, le bandeau doit alors afficher un taux > 100 %.
        double tauxMax = elementsTries.Select(b => b.Taux)
            .Concat(columns.Select(c => TauxPoutre(c) ?? 0))
            .DefaultIfEmpty(0)
            .Max();

        string classeEtat = tauxMax > 1 ? "cr-rouge" : tauxMax > SeuilVigilance ? "cr-orange" : "cr-vert";
        string messageEtat = tauxMax > 1 ? "Structure trop chargée" : "Structure vérifiée";

        // ---- Bandeau d'état ----
        sb.Append($"<div class='cr-bandeau {classeEtat}'><strong class='cr-bandeau-message'>{messageEtat}</strong><span class='cr-bandeau-taux'>Taux maximal : {tauxMax * 100:F1} %</span></div>");

        // ---- En-tête ----
        sb.Append("<h4 class='cr-titre'>Compte rendu &ndash; Calcul de la charpente</h4>");
        sb.Append("<table class='cr-info'>");
        sb.Append($"<tr><td>Date</td><td>{DateTime.Now:dd/MM/yyyy HH:mm}</td></tr>");
        sb.Append($"<tr><td>Événement</td><td>{Enc(Layout?.selectedEvent?.Name)}</td></tr>");
        sb.Append($"<tr><td>Scénario</td><td>{Enc(Layout?.selectedScenario?.Name)}</td></tr>");
        sb.Append($"<tr><td>Structure</td><td>{Enc(appData.Structure?.Name)}</td></tr>");
        sb.Append("</table>");

        // ---- Hypothèses de calcul : poids propre et neige ----
        // Les charges de la grille sont passées au calcul en négatif (GetChargeNodale) : leur poids est l'opposé de leur somme.
        double chargesSceniques = -charges.ChargesAppliquees;
        sb.Append("<h5>Hypothèses de calcul</h5>");
        sb.Append("<table class='cr-info'>");
        sb.Append($"<tr><td>Charges scéniques appliquées</td><td><b>{chargesSceniques:N0} kg</b></td></tr>");
        if (charges.PoidsPropre)
        {
            sb.Append("<tr><td>Poids propre</td><td><span class='cr-oui'>pris en compte</span></td></tr>");
            sb.Append($"<tr><td class='cr-detail'>Charpente</td><td>{charges.PoidsElements:N0} kg</td></tr>");
            sb.Append($"<tr><td class='cr-detail'>Toiture = {charges.Q:N0} kg/m²</td><td>{charges.ChargeQ:N0} kg</td></tr>");
            sb.Append($"<tr><td class='cr-detail'>Surcharge q1 = {charges.Q1:N0} kg/m²</td><td>{charges.ChargeQ1:N0} kg</td></tr>");
        }
        else
        {
            sb.Append("<tr><td>Poids propre</td><td><span class='cr-non'>non pris en compte</span></td></tr>");
        }
        if (charges.Neige)
        {
            sb.Append("<tr><td>Neige</td><td><span class='cr-oui'>prise en compte</span></td></tr>");
            sb.Append($"<tr><td class='cr-detail'>{charges.EpaisseurNeige:N0} cm → s = {charges.S:N0} kg/m²</td><td>{charges.ChargeNeige:N0} kg</td></tr>");
        }
        else
        {
            sb.Append("<tr><td>Neige</td><td><span class='cr-non'>non prise en compte</span></td></tr>");
        }
        sb.Append("</table>");

        // Un point de la grille sans nœud associé (TCharpente « …map ») n'entre pas dans le calcul, et deux
        // points associés au même nœud n'en font compter qu'un (GetChargeNodale écrase) : le signaler
        // plutôt que de laisser croire que toute la charge saisie a été vérifiée.
        double chargeGrille = GetGrandSumValue();
        if (Math.Abs(chargeGrille - chargesSceniques) > 0.5)
            sb.Append($"<div class='cr-alerte'>La grille totalise {chargeGrille:N0} kg, mais seuls {chargesSceniques:N0} kg sont appliqués : certains points chargés n'ont pas de nœud associé, ou partagent le même nœud.</div>");

        // q et s ne s'appliquent qu'à la surface affectée aux nœuds : sans elle, ils ne pèsent rien.
        bool chargeSurfacique = (charges.PoidsPropre && (charges.Q > 0 || charges.Q1 > 0)) || (charges.Neige && charges.S > 0);
        if (chargeSurfacique && charges.SurfaceTotale <= 0)
            sb.Append("<div class='cr-alerte'>Aucune surface de toiture n'a pu être affectée aux nœuds : q, q1 et s n'ont pas été appliqués.</div>");

        // ---- Charges par poutre ----
        sb.Append("<h5>1. Charges par poutre</h5>");
        sb.Append("<table class='cr-table'><tr><th>Poutre</th><th>Charge (kg)</th><th>Capacité (kg)</th><th>Taux</th>"
                + "<th>Taux RDM</th>"
                + "<th>+ mi-travée (kg)</th><th>+ quart (kg)</th></tr>");
        foreach (var col in Enumerable.Reverse(columns))   // A → J
        {
            var r = rdm[col];
            string Ajout(double? kg) => kg is { } v ? $"{v:N0}" : "n.r.";
            sb.Append($"<tr><td>{col}</td><td>{GetSumValue(col):N0}</td><td>{GetBeamCapacity(col):N0}</td>{CelluleTaux(CalculateBeamRatio(col))}"
                    + CelluleTaux(r.Taux)
                    + $"<td>{Ajout(r.AjoutMiTravee)}</td><td>{Ajout(r.AjoutQuart)}</td></tr>");
        }
        sb.Append($"<tr class='cr-total'><td>Total</td><td>{GetGrandSumValue():N0}</td><td colspan='5'></td></tr>");
        sb.Append("</table>");

        // Hypothèses RDM, regroupées quand plusieurs poutres ont les mêmes valeurs.
        var hypotheses = Enumerable.Reverse(columns)
            .GroupBy(c => (L: beamSpan.GetValueOrDefault(c), M: beamMRd.GetValueOrDefault(c), V: beamVRd.GetValueOrDefault(c)))
            .Select(g => $"{string.Join(", ", g)} : L = {g.Key.L:0.##} m, M<sub>Rd</sub> = {g.Key.M:0.#} kN·m, V<sub>Rd</sub> = {g.Key.V:0.#} kN");
        sb.Append("<p class='cr-note'>RDM : poutre simplement appuyée, points 1 à 9 à L/10 … 9L/10, g = 9,81 m/s². "
                + "Charge additionnelle : la plus grande charge ponctuelle ajoutable à mi-travée, ou au quart de travée "
                + "(L/4 ou 3L/4, le plus défavorable), sans dépasser M<sub>Rd</sub> ni V<sub>Rd</sub>.<br/>"
                + string.Join("<br/>", hypotheses) + "</p>");

        // ---- Poutres ----
        sb.Append("<h5>2. Poutres</h5>");
        if (componentTaux.Count == 0)
        {
            sb.Append("<p class='cr-vide'>Aucun composant calculé.</p>");
        }
        else
        {
            sb.Append("<table class='cr-table'><tr><th>Composant</th><th>Sigma</th><th>Tau</th><th>Taux</th></tr>");
            foreach (var c in componentTaux.OrderByDescending(c => c.Taux))
                sb.Append($"<tr><td>{Enc(c.Name)}</td><td>{c.Sigma:N2}</td><td>{c.Tau:N2}</td>{CelluleTaux(c.Taux)}</tr>");
            sb.Append("</table>");
        }

        // ---- Éléments les plus sollicités ----
        sb.Append("<h5>3. Éléments les plus sollicités</h5>");
        if (elementsTries.Count == 0)
        {
            sb.Append("<p class='cr-vide'>Aucun élément calculé.</p>");
        }
        else
        {
            sb.Append("<table class='cr-table'><tr><th>Élément</th><th>Sigma</th><th>Tau</th><th>Taux</th></tr>");
            foreach (var b in elementsTries.Take(10))
                sb.Append($"<tr><td>{Enc(b.Name)}</td><td>{b.Sigma:N2}</td><td>{b.Tau:N2}</td>{CelluleTaux(b.Taux)}</tr>");
            sb.Append("</table>");
        }

        // ---- Conclusion ----
        sb.Append("<h5>4. Conclusion</h5>");
        sb.Append($"<p>Taux de travail maximal : <b>{tauxMax * 100:F1} %</b></p>");
        if (tauxMax > 1)
        {
            sb.Append("<div class='cr-etat cr-rouge'>Charges inadmissibles</div>");
            sb.Append("<ul>");
            if (poutresKo.Count > 0)
                sb.Append($"<li>Diminuer les charges sur la/les poutre(s) : <b>{string.Join(", ", poutresKo)}</b></li>");
            if (elementsKo.Count > 0)
                sb.Append($"<li>Éléments surchargés : <b>{string.Join(", ", elementsKo)}</b></li>");
            sb.Append("</ul>");
        }
        else if (tauxMax > SeuilVigilance)
        {
            sb.Append($"<div class='cr-etat cr-orange'>Charges admissibles &ndash; taux supérieur à {SeuilVigilance * 100:F0} % : à surveiller</div>");
        }
        else
        {
            sb.Append("<div class='cr-etat cr-vert'>Charges validées</div>");
        }

        return sb.ToString();
    }

    /// <summary>Cellule « Taux » colorée comme la grille et le datagrid (TauxColor) ; grise si capacité non renseignée.</summary>
    private static string CelluleTaux(double? taux)
    {
        if (taux is not { } t)
            return "<td class='cr-taux' style='background:#757575'>n.r.</td>";

        var (r, g, b) = TauxColor.ToColor(t);
        return $"<td class='cr-taux' style='background:rgb({r},{g},{b})'>{t * 100:F1} %</td>";
    }

    private static string Enc(string s) => System.Net.WebUtility.HtmlEncode(s ?? "");

