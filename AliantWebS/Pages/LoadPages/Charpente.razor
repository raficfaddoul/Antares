    private string GetTooltipStyle(double ratio)
    {
        if (ratio > 1)
            return "background-color: red; color: white;";

        // Calculate color gradient from blue to red
        int red = (int)(255 * ratio); // Increases as ratio approaches 1
        int blue = 255 - red; // Decreases as ratio approaches 1
        return $"background-color: rgb({red}, 0, {blue}); color: white;";
    }

    private double CalculateRatio(string row, string col)
    {
        double numerator = GetCellValue(row, col);
        double denominator = GetCellValue(row, col, false);

        if (denominator == 0) return 0; // Prevent division by zero

        return numerator / denominator;
    }

