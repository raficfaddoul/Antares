    /// <summary>
    /// Blue through red by load ratio, solid red above 1, grey when no capacity is on record.
    /// Used by both the tooltip and the calculated cell behind it so the two can never disagree.
    /// </summary>
    private static string RatioStyle(double? ratio)
    {
        // No capacity on record. Grey, because this is "unknown", not "lightly loaded" — the old code
        // returned 0 here and painted it the same blue as a genuinely unloaded point.
        if (ratio is not { } r)
            return "background-color: #757575; color: white;";

        if (r > 1)
            return "background-color: red; color: white;";

        // Calculate color gradient from blue to red
        int red = (int)(255 * r); // Increases as ratio approaches 1
        int blue = 255 - red; // Decreases as ratio approaches 1
        return $"background-color: rgb({red}, 0, {blue}); color: white;";
    }

    /// <summary>Tooltip text for a ratio, distinguishing an unknown capacity from a zero load.</summary>
    private static string TauxText(string label, double? ratio) =>
        ratio is { } r ? $"{label} : {r:F2}" : $"{label} : capacité non renseignée";

    /// <summary>
    /// Load over capacity for one attachment point, or null when the cahier des charges has no
    /// capacity for it. Null rather than 0: a missing limit is not a comfortable one.
    /// </summary>
    private double? CalculateRatio(string row, string col)
    {
        double capacity = GetCellValue(row, col, false);
        if (capacity == 0) return null;

        return GetCellValue(row, col) / capacity;
    }

    /// <summary>
    /// How hard a whole beam is working: its summed load against its own capacity from row 10. Kept
    /// separate from CalculateRatio because the numerator is a sum, not a stored cell.
    /// </summary>
    private double? CalculateBeamRatio(string col)
    {
        double capacity = GetCellValue(BeamCapacityRow, col, false);
        if (capacity == 0) return null;

        return GetSumValue(col) / capacity;
    }

    private Dictionary<Guid, (int dof, double value)> GetChargeNodale(AliantWebS.Models.Charpente charpente, Tcharpente tCharpente)
    {
        // Load chargeNodale using Tcharpente mappings and Charpente values
        var chargeNodale = new Dictionary<Guid, (int dof, double value)>();

        Models.Charpente charpente1 = new Models.Charpente();
        

        // Use reflection to iterate through all properties
        var charpenteProperties = typeof(Models.Charpente).GetProperties()
            .Where(p => p.PropertyType == typeof(double?) && Regex.IsMatch(p.Name, @"^[A-J]\d+$"))
            .ToList();

        foreach (var charpenteProp in charpenteProperties)
        {
            // Get the value from Charpente
            var chargeValue = charpenteProp.GetValue(charpente) as double?;

            if (chargeValue.HasValue && chargeValue.Value != 0)
            {
                // Get the corresponding map property from Tcharpente (e.g., "A1" -> "A1map")
                var mapPropertyName = $"{charpenteProp.Name}map";
                var mapProperty = typeof(Models.Tcharpente).GetProperty(
                    mapPropertyName,
                    BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase
                );

                if (mapProperty != null)
                {
                    var elementGuid = mapProperty.GetValue(tCharpente) as Guid?;

                    // If mapping exists and is not empty, add to chargeNodale
                    if (elementGuid.HasValue && elementGuid.Value != Guid.Empty)
                    {
                        // dof = 2 for vertical load (Z-axis in 3D), adjust as needed
                        chargeNodale[elementGuid.Value] = (dof: 2, value: chargeValue.Value);
                    }
                }
            }
        }

        return chargeNodale;

    }

    private async void Calcul()
    {
        isCalculating = true;
        StateHasChanged();
        await Task.Yield(); // let the spinner paint before the (heavy, synchronous) FE solve
        if (appData.Structure == null)
        {
            Structure structure = await entitiesService.GetFilteredFirstEntityAsync<Structure>(x => x.StructureId.ToString() == "84028ce7-6e17-ef11-ab4f-3c557678c0f7");
            appData.Structure = structure;
        }

        Dictionary<LoadCase, double> selectedLoadCases = new Dictionary<LoadCase, double>();

        List<LoadCase> loadCases = await entitiesService.GetFilteredEntitiesAsync<LoadCase>(x => x.StructureId == appData.Structure.StructureId);

        selectedLoadCases = loadCases.ToDictionary(lc => lc, lc => 1.0); // Assuming all load cases are selected with a factor of 1.0


        var chargeNodale = GetChargeNodale(charpente, tcharpente);

        // FE solve (extracted to CharpenteFEHelper so SurveillanceAntares runs the SAME solve
        // with measured loads). Here the loads are the calculated ones (chargeNodale above).
        var beamTaux = await CharpenteFEHelper.ComputeAsync(appData.Structure, selectedLoadCases, chargeNodale, entitiesService);

        // Beam3d elements (for the datagrid sort + the 3D BimId map below).
        List<Element> elements = await entitiesService.GetFilteredEntitiesAsync<Element>(
            a => a.StructureId == appData.Structure.StructureId && a.ElementType != null && a.ElementType.Name == "Beam3d");

        compteRendu = "";
        tauxTravail.Clear();
        foreach (var bt in beamTaux)
        {
            tauxTravail[bt.ElementId] = bt.Taux;
            compteRendu += bt.Name + " : Sigma = " + bt.Sigma.ToString("N2") + " : Tau = " + bt.Tau.ToString("N2") + "\n";
        }


        //TauxGroupe[]={Nom,charge totale, tauxTravail max,  Effortcritique}
        // Message : état de la structure "Charges validées", Charges inadmissible, diminuer les charges sur poutre E
        // Flag du message : rouge, orange, vert
        // Compte rendu

        // Sort elements by taux de travail descending
        elementsSortedByTaux = elements
            .Where(e => tauxTravail.ContainsKey(e.ElementId))
            .OrderByDescending(e => tauxTravail[e.ElementId])
            .ToList();

        // Per-BimId taux for the 3D model (the Modèle 3D page derives colours + tooltip from it).
        appData.CharpenteTauxByBimId = elements
            .Where(e => e.BimId.HasValue && tauxTravail.ContainsKey(e.ElementId))
            .GroupBy(e => e.BimId.Value)
            .ToDictionary(g => g.Key, g => tauxTravail[g.First().ElementId]);

        await savetodatabase();

        isCalculating = false;
        StateHasChanged();
    }
