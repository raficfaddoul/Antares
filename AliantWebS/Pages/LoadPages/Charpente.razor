@page "/Charpente/{EventMpscenarioId:guid}"

@using AliantWebS.Data
@using Models
@inject IStringLocalizer<Languages> L
@inject EntitiesService entitiesService
@inject AppData appData;

@layout AntaresConceptionLayout

@* Importing necessary namespaces *@
@using System.Collections.Generic
@using System.Reflection
@using System.Text.RegularExpressions
@using System.Data;

<style>
    .small-cell {
    width: 100px !important; /* Adjust the width as needed */
    height: 50px; /* Adjust the height as needed */
    padding: 0; /* Remove padding to make cells smaller */
    text-align: center; /* Center-align the text */
    }

    .small-input {
    width: 100% !important; /* Make the input take full width of the cell */
    height: 50%; /* Make the input take full height of the cell */
    box-sizing: border-box; /* Include padding and border in the element's total width and height */
    font-size: 12px; /* Adjust the font size as needed */
    padding: 0; /* Remove padding for the input */
    }

    .fixed-table {
    table-layout: fixed;
    width: auto; /* Set to auto to prevent expanding to full width */
    }

    .center-text {
    text-align: center;
    }

    /* Alternating row colors */
    .table tbody tr:nth-child(even) {
    background-color: #e0f7fa !important; /* Light cyan */
    }

    .table tbody tr:nth-child(odd) {
    background-color: #ffffff !important; /* White */
    }

    /* Alternating column colors within alternating rows */
    .table tbody tr:nth-child(even) td:nth-child(even),
    .table tbody tr:nth-child(odd) td:nth-child(even),
    .table tbody tr:nth-child(even) th:nth-child(even),
    .table tbody tr:nth-child(odd) th:nth-child(even) {
    background-color: rgba(255, 255, 153, 0.5) !important; /* Lighter yellow with transparency */
    }

    .table tbody tr:nth-child(even) td:nth-child(odd),
    .table tbody tr:nth-child(odd) td:nth-child(odd),
    .table tbody tr:nth-child(even) th:nth-child(odd),
    .table tbody tr:nth-child(odd) th:nth-child(odd) {
    background-color: inherit; /* Keep the row background color */
    }

    /* Ensure input fields inherit background color */
    .table tbody tr td.small-cell input {
    background-color: inherit;
    }

    .legend-box {
    display: inline-block;
    width: 20px;
    height: 20px;
    margin-right: 5px;
    vertical-align: middle;
    }

    .white-background {
    background-color: #ffffff; /* White */
    border: 1px solid #aaaaaa;
    }

    .faint-magenta-background {
    background-color: #fde4f9; /* Faint magenta */
    border: 1px solid #aaaaaa;
    }

    .legend-text {
    vertical-align: middle;
    }

    .controls-container {
    display: flex;
    justify-content: start;
    align-items: flex-start;
    }

    .buttons-container {
    flex-grow: 1;
    }

    .legend-container {
    margin-left: 20px; /* Adjust spacing between buttons and legend as needed */
    }

    .tooltip-container {
    position: relative;
    display: inline-block;
    }

    .tooltip-text {
    visibility: hidden;
    width: 120px;
    background-color: #f9f9f9;
    color: #fff;
    text-align: center;
    border-radius: 6px;
    padding: 5px 0;
    position: absolute;
    z-index: 1;
    bottom: 100%;
    left: 50%;
    margin-left: -60px;
    }

    .tooltip-container:hover .tooltip-text {
    visibility: visible;
    }

    .tooltip-text::before {
    display: none;
    }

    /* ---- Compte rendu + datagrid cards ---- */
    .cr-card, .grid-card {
        background: #fff;
        border: 1px solid #e6e6ef;
        border-radius: 10px;
        box-shadow: 0 1px 4px rgba(20, 30, 60, 0.07);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        margin: 6px;
    }

    .grid-card {
        height: auto;
        margin-top: 16px;
    }

    .cr-card-header, .grid-card-header {
        background: linear-gradient(90deg, #2c3e50, #46637f);
        color: #fff;
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.2px;
        padding: 9px 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cr-icon { font-size: 1.05rem; line-height: 1; }

    .cr-textarea {
        flex: 1 1 auto;
        width: 100%;
        min-height: 200px;
        border: none;
        resize: none;
        padding: 12px 14px;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 0.85rem;
        line-height: 1.55;
        color: #2c3e50;
        background: #fbfbfd;
        outline: none;
    }

    .taux-bar-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .taux-bar-track {
        flex: 1;
        height: 14px;
        background: #ecedf3;
        border-radius: 7px;
        overflow: hidden;
    }

    .taux-bar-fill {
        height: 100%;
        border-radius: 7px;
        transition: width 0.3s ease;
    }

    .taux-pct {
        min-width: 56px;
        text-align: right;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        color: #2c3e50;
    }
</style>




<RadzenSplitter>
    <RadzenSplitterPane>
        <RadzenSplitter Orientation="Radzen.Orientation.Vertical">
            <RadzenSplitterPane>
                <AliantWebS.Pages.CADPages.SVGComponent Point0X="@(Layout?.selectedEvent?.Point0X ?? 0)"
                                                        Point0Y="@(Layout?.selectedEvent?.Point0Y ?? 0)"
                                                        EventName="@Layout?.selectedEvent?.Name"
                                                        EventId="@Layout?.selectedEvent?.EventId"
                                                        ScenarioName="@Layout?.selectedScenario?.Name"
                                                        ScenarioId="@Layout?.selectedScenario?.EventMpscenarioId"
                                                        StructureName="@appData.Structure?.Name"
                                                        ModuleName="Charpente"></AliantWebS.Pages.CADPages.SVGComponent>
            </RadzenSplitterPane>
             <RadzenSplitterPane>
                <div class="cr-card">
                    <div class="cr-card-header">
                        <span class="cr-icon">📋</span> @L["Compte Rendu"]
                    </div>
                    <InputTextArea @bind-Value="compteRendu" class="cr-textarea"></InputTextArea>
                </div>
             </RadzenSplitterPane>
        </RadzenSplitter>
    </RadzenSplitterPane>
    <RadzenSplitterPane>
        <div class="form-group">
            <div class="controls-container">
                <!-- Buttons Container -->
                <div class="buttons-container">
                    <button type="button" class="btn btn-success" @onclick="Calcul" disabled="@isCalculating">
                        @if (isCalculating)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>@L["Calcul en cours..."]</span>
                        }
                        else
                        {
                            @L["Calcul Charpente"]
                        }
                    </button>
                    @if (canEditLimits)
                    {
                        <button type="button" class="btn btn-success" @onclick="saveLimitstodatabase" style="margin-left: 10px;">
                            @L["Save Critical Loads"]
                        </button>
                    }
                </div>
                <!-- Legend Container -->
                @* Listed in the order the two inputs appear inside each cell: the white box on top is
                   the load computed by Calcul Charpente, the magenta box below it is the capacity from
                   the venue load book. The two labels were the wrong way round, which made the whole
                   grid read backwards. *@
                <div class="legend-container">
                    <div>
                        <span class="legend-box white-background"></span>
                        <span class="legend-text">@L["Calculated Values"]</span>
                    </div>
                    <div>
                        <span class="legend-box faint-magenta-background"></span>
                        <span class="legend-text">@L["Limit values"]</span>
                    </div>
                </div>
            </div>
        </div>

        <table class="table table-bordered fixed-table">
            <thead>
                <tr>
                    <th class="small-cell"></th>
                    @foreach (var col in columns)
                    {
                        <th class="small-cell">@col</th>
                    }
                </tr>

            </thead>
            <tbody>
                @for (int i = 0; i < rows.Count(); i++)
                {
                    var row = rows[i];
                    <tr>
                        <th class="small-cell">@row</th>
                        @foreach (var col in columns)
                        {
                            <td class="small-cell">
                                <div class ="tooltip-container">
                                    <span class="tooltip-text" style="@RatioStyle(CalculateRatio(row, col))">@TauxText("Taux de charge", CalculateRatio(row, col))</span>
                                    @* The calculated cell carries the same colour as its tooltip, so the
                                       whole grid can be read at a glance without hovering ninety cells. *@
                                    <input type="number" step="any" class="form-control small-input center-text" value="@(GetCellValue(row, col).ToString(System.Globalization.CultureInfo.InvariantCulture))" @onchange="e => UpdateCellValue(row, col, e)"
                                    style="@RatioStyle(CalculateRatio(row, col))" />
                                    <input type="number" step="any"
                                    class="form-control small-input center-text"
                                    value="@(GetCellValue(row, col, false).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                    @onchange="e => UpdateCellValue(row, col, e, false)"
                                    disabled="@(!canEditLimits)"
                                    style="background-color: #fde4f9;" />
                                </div>
                            </td>
                        }
                    </tr>
                }
                @* Total row: the summed load on a beam over that beam's own capacity.
                   The beam limit is NOT the sum of its nine point limits — it is considerably lower,
                   and it is usually the constraint that actually binds — so it is entered here rather
                   than derived. It lives in row 10 of TCharpente, which the grid above does not show. *@
                <tr>
                    <th class="small-cell">Total</th>
                    @foreach (var col in columns)
                    {
                        <td class="small-cell">
                            <div class="tooltip-container">
                                <span class="tooltip-text" style="@RatioStyle(CalculateBeamRatio(col))">
                                    @TauxText("Taux de charge poutre", CalculateBeamRatio(col))
                                </span>
                                @* Read-only: this is a computed sum. It was rendered as an editable
                                   input with no change handler, so anything typed in was discarded. *@
                                <input type="number" step="any" class="form-control small-input center-text" readonly
                                       value="@(GetSumValue(col).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                       style="@RatioStyle(CalculateBeamRatio(col))" />
                                <input type="number" step="any"
                                       class="form-control small-input center-text"
                                       value="@(GetCellValue(BeamCapacityRow, col, false).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                       @onchange="e => UpdateCellValue(BeamCapacityRow, col, e, false)"
                                       disabled="@(!canEditLimits)"
                                       style="background-color: #fde4f9;" />
                            </div>
                        </td>
                    }
                </tr>
            </tbody>
        </table>
        <Label>Charge Totale</Label>
        <input disabled value="@(GetGrandSumValue().ToString(System.Globalization.CultureInfo.InvariantCulture))" />
        <div class="grid-card">
            <div class="grid-card-header">
                <span class="cr-icon">📊</span> @L["Taux de travail par élément"]
            </div>
            <RadzenDataGrid Data="@elementsSortedByTaux" TItem="Element"
                            AllowSorting="true" AllowPaging="true" PageSize="10"
                            AllowColumnResize="true">
                <Columns>
                    <RadzenDataGridColumn TItem="Element" Property="Name" Title="@L["Nom de l'élément"]" />
                    <RadzenDataGridColumn TItem="Element" Title="@L["Taux de travail"]" Width="240px" Sortable="false">
                        <Template Context="element">
                            @{
                                var _t = GetTauxTravail(element.ElementId);
                                var _pct = _t * 100;
                                var _c = TauxColor.ToColor(_t);
                                var _w = (int)Math.Round(Math.Clamp(_pct, 0, 100));
                                var _rgb = $"rgb({_c.R},{_c.G},{_c.B})";
                            }
                            <div class="taux-bar-wrap">
                                <div class="taux-bar-track">
                                    <div class="taux-bar-fill" style="width:@(_w)%; background:@_rgb;"></div>
                                </div>
                                <span class="taux-pct">@_pct.ToString("F1") %</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </RadzenSplitterPane>
</RadzenSplitter>



@code {

    [Parameter]
    public Guid EventMpscenarioId { get; set; }

    [CascadingParameter]
    public AntaresConceptionLayout Layout { get; set; }

    // Define the columns and rows — display order: columns J→A (left→right), rows 9→1 (top→bottom).
    private readonly string[] columns = { "J", "I", "H", "G", "F", "E", "D", "C", "B", "A" };
    private readonly string[] rows = { "9", "8", "7", "6", "5", "4", "3", "2", "1" };

    // Row 10 is not an attachment point: it holds each beam's own capacity, shown on the Total row.
    private const string BeamCapacityRow = "10";

    // Resolved once per parameter set. The limit inputs used to call appData.GetRole().Result inline,
    // which blocks the circuit's thread ninety times per render just to decide a disabled attribute.
    private bool canEditLimits;

    // Dictionary to store cell values
    private Dictionary<(string, string), double> tableData = new Dictionary<(string, string), double>();
    private Dictionary<(string, string), double> ttableData = new Dictionary<(string, string), double>();

    Models.Charpente charpente;
    Models.Tcharpente tcharpente;

    bool isCalculating = false;

    string compteRendu = "epsom loren";

    // Store tauxTravail at class level for grid access
    private Dictionary<Guid, double> tauxTravail = new Dictionary<Guid, double>();

    // Elements sorted by taux de travail (descending)
    private List<Element> elementsSortedByTaux = new List<Element>();

    // Helper method to get taux de travail for an element
    private double GetTauxTravail(Guid elementId)
    {
        return tauxTravail.TryGetValue(elementId, out double value) ? value : 0;
    }


    protected override async Task OnParametersSetAsync()
    {
        var role = await appData.GetRole();
        canEditLimits = role is "Administrator" or "Developer";

        charpente = await entitiesService.GetFilteredFirstEntityAsync<Models.Charpente>(x => (x.EventMpscenarioId == Layout.selectedScenario.EventMpscenarioId));
        if (charpente == null)
        {
            charpente = new Models.Charpente();
            charpente.EventMpscenarioId = Layout.selectedScenario.EventMpscenarioId;
        }


        tableData = ReadCharpenteData(charpente);


        var tcharpentes = await entitiesService.GetAllEntitiesAsync<Models.Tcharpente>();
        tcharpente = tcharpentes?.FirstOrDefault();
        if (tcharpente == null)
        {
            tcharpente = new Models.Tcharpente();
        }
        else
        {
            ttableData = ReadTCharpenteData(tcharpente);
        }
    }

    // Method to update cell values
    private void UpdateCellValue(string row, string column, ChangeEventArgs e, bool Calculated = true)
    {
        // Parsed as a double, invariant, to match how the cells are rendered. int.TryParse used to
        // reject every calculated value, which are decimals like 54.8139, so editing one silently
        // discarded the entry and left the old number on screen.
        if (!double.TryParse(
                e.Value?.ToString(),
                System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture,
                out double value))
        {
            return;
        }

        if (Calculated)
        {
            tableData[(row, column)] = value;
        }
        else
        {
            ttableData[(row, column)] = value;
        }
    }

    private double GetCellValue(string row, string column, bool Calculated = true)
    {
        if (Calculated)
        {
            if (tableData.TryGetValue((row, column), out double value))
            {
                return value;
            }
        }
        else
        {
            if (ttableData.TryGetValue((row, column), out double value))
            {
                return value;
            }
        }
        return 0;
    }


    private double GetSumValue(string column)
    {
        double sum = 0;
        foreach (var row in rows)
        {
            if (tableData.TryGetValue((row, column), out double value))
            {
                sum += value;
            }
        }

        return sum;
    }

    private double GetGrandSumValue()
    {
        double sum = 0;
        foreach (var column in columns)
        {
            foreach (var row in rows)
            {
                if (tableData.TryGetValue((row, column), out double value))
                {
                    sum += value;
                }
            }
        }

        return sum;
    }

    public static Dictionary<(string, string), double> ReadCharpenteData(Models.Charpente charpente)
    {
        var result = new Dictionary<(string, string), double>();

        // Use reflection to get properties of Charpente
        PropertyInfo[] properties = typeof(Models.Charpente).GetProperties();
        foreach (PropertyInfo property in properties)
        {
            // Check if the property is of type double or nullable double
            if (property.PropertyType == typeof(double) || property.PropertyType == typeof(double?))
            {
                // Obtain the property value
                object valueObj = property.GetValue(charpente);

                // Check if the value is not null
                if (valueObj != null)
                {
                    // Safely cast the non-null value to double
                    double value = (double)valueObj;

                    // Use regex to split the property name into letter and number
                    var match = Regex.Match(property.Name, @"([A-Z]+)(\d+)");
                    if (match.Success)
                    {
                        string letter = match.Groups[1].Value;
                        string number = match.Groups[2].Value;

                        // Add the (number, letter) pair and value to the dictionary
                        result.Add((number, letter), value);
                    }
                }
            }
        }
        return result;
    }

    public static Dictionary<(string, string), double> ReadTCharpenteData(Models.Tcharpente Tcharpente)
    {
        var result = new Dictionary<(string, string), double>();

        // Use reflection to get properties of Charpente
        PropertyInfo[] properties = typeof(Models.Tcharpente).GetProperties();
        foreach (PropertyInfo property in properties)
        {
            // Check if the property is of type double or nullable double
            if (property.PropertyType == typeof(double) || property.PropertyType == typeof(double?))
            {
                // Obtain the property value
                object valueObj = property.GetValue(Tcharpente);

                // Check if the value is not null
                if (valueObj != null)
                {
                    // Safely cast the non-null value to double
                    double value = (double)valueObj;

                    // Use regex to split the property name into letter and number
                    var match = Regex.Match(property.Name, @"([A-Z]+)(\d+)");
                    if (match.Success)
                    {
                        string letter = match.Groups[1].Value;
                        string number = match.Groups[2].Value;

                        // Add the (number, letter) pair and value to the dictionary
                        result.Add((number, letter), value);
                    }
                }
                else
                {
                    // Safely cast the non-null value to double
                    double value = 0;

                    // Use regex to split the property name into letter and number
                    var match = Regex.Match(property.Name, @"([A-Z]+)(\d+)");
                    if (match.Success)
                    {
                        string letter = match.Groups[1].Value;
                        string number = match.Groups[2].Value;

                        // Add the (number, letter) pair and value to the dictionary
                        result.Add((number, letter), value);
                    }
                }
            }
        }
        return result;
    }


    public async Task saveLimitstodatabase()
    {
        foreach (var entry in ttableData)
        {
            // Create the combined key in the format "LetterNumber"
            string ck = entry.Key.Item2 + entry.Key.Item1;

            switch (ck)
            {
                case "A1": tcharpente.A1 = entry.Value; break;
                case "A2": tcharpente.A2 = entry.Value; break;
                case "A3": tcharpente.A3 = entry.Value; break;
                case "A4": tcharpente.A4 = entry.Value; break;
