@page "/Charpente/{EventID:guid}"

@using AliantWebS.Data
@using Models
@inject IStringLocalizer<Languages> L
@inject EntitiesService entitiesService
@inject AppData appData;

@layout AntaresConceptionLayout

@* Importing necessary namespaces *@
@using System.Collections.Generic
@using System.Reflection
@using System.Text.RegularExpressions
@using System.Data;

<style>
    .small-cell {
    width: 100px !important; /* Adjust the width as needed */
    height: 50px; /* Adjust the height as needed */
    padding: 0; /* Remove padding to make cells smaller */
    text-align: center; /* Center-align the text */
    }

    .small-input {
    width: 100% !important; /* Make the input take full width of the cell */
    height: 50%; /* Make the input take full height of the cell */
    box-sizing: border-box; /* Include padding and border in the element's total width and height */
    font-size: 12px; /* Adjust the font size as needed */
    padding: 0; /* Remove padding for the input */
    }

    .fixed-table {
    table-layout: fixed;
    width: auto; /* Set to auto to prevent expanding to full width */
    }

    .center-text {
    text-align: center;
    }

    /* Alternating row colors */
    .table tbody tr:nth-child(even) {
    background-color: #e0f7fa !important; /* Light cyan */
    }

    .table tbody tr:nth-child(odd) {
    background-color: #ffffff !important; /* White */
    }

    /* Alternating column colors within alternating rows */
    .table tbody tr:nth-child(even) td:nth-child(even),
    .table tbody tr:nth-child(odd) td:nth-child(even),
    .table tbody tr:nth-child(even) th:nth-child(even),
    .table tbody tr:nth-child(odd) th:nth-child(even) {
    background-color: rgba(255, 255, 153, 0.5) !important; /* Lighter yellow with transparency */
    }

    .table tbody tr:nth-child(even) td:nth-child(odd),
    .table tbody tr:nth-child(odd) td:nth-child(odd),
    .table tbody tr:nth-child(even) th:nth-child(odd),
    .table tbody tr:nth-child(odd) th:nth-child(odd) {
    background-color: inherit; /* Keep the row background color */
    }

    /* Ensure input fields inherit background color */
    .table tbody tr td.small-cell input {
    background-color: inherit;
    }

    .legend-box {
    display: inline-block;
    width: 20px;
    height: 20px;
    margin-right: 5px;
    vertical-align: middle;
    }

    .white-background {
    background-color: #ffffff; /* White */
    }

    .faint-magenta-background {
    background-color: #fde4f9; /* Faint magenta */
    }

    .legend-text {
    vertical-align: middle;
    }

    .controls-container {
    display: flex;
    justify-content: start;
    align-items: flex-start;
    }

    .buttons-container {
    flex-grow: 1;
    }

    .legend-container {
    margin-left: 20px; /* Adjust spacing between buttons and legend as needed */
    }

    .tooltip-container {
    position: relative;
    display: inline-block;
    }

    .tooltip-text {
    visibility: hidden;
    width: 120px;
    background-color: #f9f9f9;
    color: #fff;
    text-align: center;
    border-radius: 6px;
    padding: 5px 0;
    position: absolute;
    z-index: 1;
    bottom: 100%;
    left: 50%;
    margin-left: -60px;
    }

    .tooltip-container:hover .tooltip-text {
    visibility: visible;
    }

    .tooltip-text::before {
    display: none;   
    }
</style>




<RadzenSplitter>
    <RadzenSplitterPane>
        <AliantWebS.Pages.CADPages.SVGComponent></AliantWebS.Pages.CADPages.SVGComponent>
    </RadzenSplitterPane>
    <RadzenSplitterPane>
        <div class="form-group">
            <div class="controls-container">
                <!-- Buttons Container -->
                <div class="buttons-container">
                    <button type="button" class="btn btn-success" @onclick="Calcul">
                        @if (isCalculating)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                        }
                        @L["Calcul Charpente"]
                    </button>
                    @if ((appData.GetRole().Result == "Administrator") || (appData.GetRole().Result == "Developer"))
                    {
                        <button type="button" class="btn btn-success" @onclick="saveLimitstodatabase" style="margin-left: 10px;">
                            @L["Save Critical Loads"]
                        </button>
                    }
                </div>
                <!-- Legend Container -->
                <div class="legend-container">
                    <div>
                        <span class="legend-box faint-magenta-background"></span>
                        <span class="legend-text">Calculated Values</span>
                    </div>
                    <div>
                        <span class="legend-box white-background"></span>
                        <span class="legend-text">Limit values</span>
                    </div>
                </div>
            </div>
        </div>

        <table class="table table-bordered fixed-table">
            <thead>
                <tr>
                    <th class="small-cell"></th>
                    @foreach (var col in columns)
                    {
                        <th class="small-cell">@col</th>
                    }
                </tr>

            </thead>
            <tbody>
                @for (int i = 0; i < rows.Count(); i++)
                {
                    var row = rows[i];
                    <tr>
                        <th class="small-cell">@row</th>
                        @foreach (var col in columns)
                        {
                            <td class="small-cell">
                                <div class ="tooltip-container">
                                    <span class="tooltip-text" style="@GetTooltipStyle(CalculateRatio(row, col))">@($"Taux de charge: {CalculateRatio(row, col):F2}")</span>
                                    <input type="number" class="form-control small-input center-text" value="@GetCellValue(row, col)" @onchange="e => UpdateCellValue(row, col, e)"
                                    style="background-color: #ffffff;" />
                                    <input type="number"
                                    class="form-control small-input center-text"
                                    value="@GetCellValue(row, col, false)"
                                    @onchange="e => UpdateCellValue(row, col, e, false)"
                                    disabled="@(appData.GetRole().Result != "Administrator" && appData.GetRole().Result != "Developer")"
                                    style="background-color: #fde4f9;" />
                                </div>
                            </td>
                        }
                    </tr>
                }
                <tr>
                    <th class="small-cell">Total</th>
                    @foreach (var col in columns)
                    {
                        <td class="small-cell">
                            <input type="number" class="form-control small-input center-text" value="@GetSumValue(col)" />
                        </td>
                    }
                </tr>
            </tbody>
        </table>
        <Label>Charge Totale</Label>
        <input disabled value="@GetGrandSumValue()" />
        <div>
            <Label>Compte Rendu</Label>
            <InputTextArea @bind-Value=compteRendu style="width:100%"></InputTextArea>
        </div>
    </RadzenSplitterPane>
</RadzenSplitter>



@code {

    [Parameter]
    public Guid EventID { get; set; }
    // Define the columns and rows
    private readonly string[] columns = { "A", "B", "C", "D", "E", "F", "G", "H", "I", "J" };
    private readonly string[] rows = { "1", "2", "3", "4", "5", "6", "7", "8", "9" };

    // Dictionary to store cell values
    private Dictionary<(string, string), double> tableData = new Dictionary<(string, string), double>();
    private Dictionary<(string, string), double> ttableData = new Dictionary<(string, string), double>();

    Models.Charpente charpente;
    Models.Tcharpente tcharpente;

    bool isCalculating = false;

    string compteRendu = "epsom loren";

    protected override async Task OnInitializedAsync()
    {
        charpente = await entitiesService.GetFilteredFirstEntityAsync<Models.Charpente>(x => (x.EventId == EventID));
        if (charpente == null)
        {
            charpente = new Models.Charpente();
            charpente.EventId = EventID;
        }
        else
        {
            tableData = ReadCharpenteData(charpente);
        }

        var tcharpentes = await entitiesService.GetAllEntitiesAsync<Models.Tcharpente>();
        tcharpente = tcharpentes?.FirstOrDefault();
        if (tcharpente == null)
        {
            tcharpente = new Models.Tcharpente();
        }
        else
        {
            ttableData = ReadTCharpenteData(tcharpente);
        }
    }

    // Method to update cell values
    private void UpdateCellValue(string row, string column, ChangeEventArgs e, bool Calculated = true)
    {
        if (Calculated)
        {
            if (int.TryParse(e.Value.ToString(), out int value))
            {
                tableData[(row, column)] = value;
            }
        }
        else
        {
            if (int.TryParse(e.Value.ToString(), out int value))
            {
                ttableData[(row, column)] = value;
            }

        }
    }

    // Method to get cell value
    private double GetCellValue(string row, string column, bool Calculated = true)
    {
        if (Calculated)
        {
            if (tableData.TryGetValue((row, column), out double value))
            {
                return value;
            }
        }
        else
        {
            if (ttableData.TryGetValue((row, column), out double value))
            {
                return value;
            }
        }
        return 0;
    }


    private double GetSumValue(string column)
    {
        double sum = 0;
        foreach (var row in rows)
        {
            if (tableData.TryGetValue((row, column), out double value))
            {
                sum += value;
            }
        }

        return sum;
    }

    private double GetGrandSumValue()
    {
        double sum = 0;
        foreach (var column in columns)
        {
            foreach (var row in rows)
            {
                if (tableData.TryGetValue((row, column), out double value))
                {
                    sum += value;
                }
            }
        }

        return sum;
    }

    public static Dictionary<(string, string), double> ReadCharpenteData(Models.Charpente charpente)
    {
        var result = new Dictionary<(string, string), double>();

        // Use reflection to get properties of Charpente
        PropertyInfo[] properties = typeof(Models.Charpente).GetProperties();
        foreach (PropertyInfo property in properties)
        {
            // Check if the property is of type double or nullable double
            if (property.PropertyType == typeof(double) || property.PropertyType == typeof(double?))
            {
                // Obtain the property value
                object valueObj = property.GetValue(charpente);

                // Check if the value is not null
                if (valueObj != null)
                {
                    // Safely cast the non-null value to double
                    double value = (double)valueObj;

                    // Use regex to split the property name into letter and number
                    var match = Regex.Match(property.Name, @"([A-Z]+)(\d+)");
                    if (match.Success)
                    {
                        string letter = match.Groups[1].Value;
                        string number = match.Groups[2].Value;

                        // Add the (number, letter) pair and value to the dictionary
                        result.Add((number, letter), value);
                    }
                }
            }
        }
        return result;
    }

    public static Dictionary<(string, string), double> ReadTCharpenteData(Models.Tcharpente Tcharpente)
    {
        var result = new Dictionary<(string, string), double>();

