@implements IDisposable
@using AliantWebS.Models
@using AliantWebS.Data
@using System.Text.Json
@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject AppData appData;
@inject IStringLocalizer<Languages> L
@inject IJSRuntime js

@if (EditContext == null)
{
    <p><em>@L["Loading"]... !</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(Title))
    {
        <h2>@Title</h2>
    }
    <hr />

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger equipement-error" role="alert">@Error</div>
    }

    <EditForm EditContext="@EditContext" id="EquipementFormId" OnValidSubmit="@OnValidSubmit">
        <DataAnnotationsValidator />
        <Blazorise.Row>
            <Column ColumnSize="ColumnSize.Is6">
                <div class="form-group">
                    <label>@L["Equipment Name"] :</label>
                    <div>
                        <InputText @bind-Value="@Equipement.Name" @oninput='(() =>areachanged("Name"))' />
                        <ValidationMessage For="@(() => Equipement.Name)" />
                    </div>
                </div>
                <div class="form-group">
                    <label>@L["Description"] :</label>
                    <div>
                        <textarea style="height:150px" @bind="@Equipement.Description" @oninput='(() =>areachanged("Description"))' class="form-control"></textarea>
                        <ValidationMessage For="@(() => Equipement.Description)" />
                    </div>
                </div>

            </Column>
            <Column ColumnSize="ColumnSize.Is6">
                <div class="form-group">
                    <label for="equipement-type">@L["Equipment type"] :</label>
                    <div>
                        @if (equipementTypes == null)
                        {
                            <em>@L["Loading"]...</em>
                        }
                        else if (equipementTypes.Count == 0)
                        {
                            <p class="text-danger no-equipement-type">
                                @L["There is no equipment type yet: create one in Equipement Types first."]
                                <a href="EquipementTypes">@L["Equipement Types"]</a>
                            </p>
                        }
                        else
                        {
                            @* An equipment cannot exist without a type (EquipementTypeID is required in the database). *@
                            <select id="equipement-type" class="form-control" value="@(Equipement.EquipementTypeId == Guid.Empty ? "" : Equipement.EquipementTypeId.ToString())" @onchange="TypeChanged">
                                @if (Equipement.EquipementTypeId == Guid.Empty)
                                {
                                    @* A new equipment, or one whose type was deleted meanwhile (ReloadTypesAsync). *@
                                    <option value="">@L["Choose a type"]</option>
                                }
                                @foreach (var type in equipementTypes)
                                {
                                    <option value="@type.EquipementTypeId">@(string.IsNullOrWhiteSpace(type.Name) ? L["(no name)"] : type.Name)</option>
                                }
                            </select>
                        }
                        <ValidationMessage For="@(() => Equipement.EquipementTypeId)" />
                    </div>
                </div>


            </Column>
        </Blazorise.Row>
        <Blazorise.Row>
            <Column ColumnSize="ColumnSize.Is6">



            </Column>
            <Column ColumnSize="ColumnSize.Is6">
                <br />
                <MediaComponent selectedObject="Equipement"></MediaComponent>

            </Column>
        </Blazorise.Row>
        <br />
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <button type="button" class="btn btn-success" @onclick="@Cancel">
                        @L["Cancel"]
                    </button>
                </div>
            </div>
        </div>

    </EditForm>
}


@code {

    [Parameter] public string ButtonText { get; set; } = "Save";

    [Parameter]
    public EditContext EditContext { get; set; }

    [Parameter] public string Title { get; set; }

    /// <summary>Why the last save failed, shown above the form (the page that saves sets it).</summary>
    [Parameter] public string Error { get; set; }

    [Parameter] public EventCallback OnValidSubmit { get; set; }

    [Parameter] public Equipement Equipement { get; set; }

    private List<EquipementType> equipementTypes;

    // The context the handlers below are attached to, and the "choose a type" message kept in it.
    private EditContext subscribed;
    private ValidationMessageStore typeMessages;


    public override async Task SetParametersAsync(ParameterView parameters)
    {
        await base.SetParametersAsync(parameters);
        // No redirect when there is no EditContext yet: the pages render this form once their equipment is loaded,
        // and until then it says "Loading" (redirecting here sent a freshly opened Edit page back to the list).
        if (EditContext == null || ReferenceEquals(subscribed, EditContext)) return;

        Unsubscribe();
        subscribed = EditContext;
        typeMessages = new ValidationMessageStore(EditContext);
        EditContext.OnFieldChanged += FieldChanged;
        EditContext.OnValidationRequested += ValidateType;
    }

    protected override async Task OnInitializedAsync()
    {

        appData.ButtonText = ButtonText;

        appData.FormId = "EquipementFormId";
        appData.DisplaySubmitButton = true;

        equipementTypes = (await entitiesService.GetAllEntitiesAsync<EquipementType>()).OrderBy(t => t.Name).ToList();
    }



    private void areachanged(string s)
    {
        EditContext.NotifyFieldChanged(EditContext.Field(s));
    }

    /// <summary>
    /// Reads the types again, after a refused save: a type deleted meanwhile (by another tab or user) leaves the list, and
    /// an equipment that had it is back to "Choose a type".
    /// </summary>
    public async Task ReloadTypesAsync()
    {
        equipementTypes = (await entitiesService.GetAllEntitiesAsync<EquipementType>()).OrderBy(t => t.Name).ToList();
        if (Equipement != null && Equipement.EquipementTypeId != Guid.Empty
            && !equipementTypes.Any(t => t.EquipementTypeId == Equipement.EquipementTypeId))
            Equipement.EquipementTypeId = Guid.Empty;
        StateHasChanged();
    }

    private void TypeChanged(ChangeEventArgs e)
    {
        var type = equipementTypes?.FirstOrDefault(t => t.EquipementTypeId.ToString() == e.Value?.ToString());
        if (type == null) return;
        // The key only: the pages hold the equipment as plain data and save it through a context of their own
        // (SaveOwnedAsync / UpdateOwnedAsync), where a type object of this circuit's context would be inserted again.
        Equipement.EquipementTypeId = type.EquipementTypeId;
        var field = EditContext.Field(nameof(Equipement.EquipementTypeId));
        typeMessages.Clear(field);
        EditContext.NotifyFieldChanged(field);
        EditContext.NotifyValidationStateChanged();
    }

    private void ValidateType(object sender, ValidationRequestedEventArgs e)
    {
        typeMessages.Clear();
        if (Equipement.EquipementTypeId == Guid.Empty)
            typeMessages.Add(EditContext.Field(nameof(Equipement.EquipementTypeId)), L["Choose the equipment's type."]);
    }

    private void FieldChanged(object sender, FieldChangedEventArgs arg)
    {
        appData.SaveChanges = true;
    }

    void Cancel()
    {
        navigationManager.NavigateTo("Equipements");
    }


    private void Unsubscribe()
    {
        if (subscribed == null) return;
        subscribed.OnFieldChanged -= FieldChanged;
        subscribed.OnValidationRequested -= ValidateType;
        subscribed = null;
    }

    void IDisposable.Dispose()
    {
        // Unsubscribe from the events when our component is disposed
        Unsubscribe();
    }


}
