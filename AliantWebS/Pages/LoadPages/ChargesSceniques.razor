@page "/ChargesSceniques/{EventId:guid}"

@using AliantWebS.Data
@inject AppData appData;
@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject IJSRuntime js
@inject AliantWebS.Data.AppData AppData
@using Models
@using Microsoft.EntityFrameworkCore
@using RiggingOptimizer.IO
@inject IStringLocalizer<Languages> L

@layout AntaresConceptionLayout

<EditForm Model="@chargeSceniqueList">
    <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" Style="height: 90vh; border: 1px solid rgba(0,0,0,.08);">
        <RadzenSplitterPane Size="50%">


            @if (chargeSceniqueList is null)
            {
                <p><em>@L["Loading"]... !</em></p>
            }
            else
            {
     
                <Div Style="display: flex; align-items: center;">
                    <h3 style="margin: 0; padding: 0; line-height: 1.5;">@L["Charges Scéniques"]</h3>
                    <a class="nav-link" @onclick="@(args => InsertChargeScenique())" @onclick:preventDefault="true" href="">
                        <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
                    </a>
                    <a class="nav-link" @onclick="@(args => DeleteAllChargesSceniques())" @onclick:preventDefault="true" href="" title="@L["Delete All"]">
                        <span class="oi oi-trash" aria-hidden="true"> @L["Delete All"]</span>
                    </a>
                    @if (isImporting)
                    {
                        <span class="spinner-border spinner-border-sm text-primary ms-2" role="status" aria-hidden="true"></span>
                        <span class="ms-1">@L["Importing..."]</span>
                    }
                    else
                    {
                        <a class="nav-link" @onclick="TriggerExcelImport" @onclick:preventDefault="true" href="" title="@L["Import from Excel"]">
                            <span class="oi oi-data-transfer-upload" aria-hidden="true"> @L["Import Excel"]</span>
                        </a>
                    }
                    <InputFile id="excelFileInput" OnChange="ImportChargesFromExcel" accept=".xlsx" style="display:none" />
                <div style="margin-left: auto; display: flex; align-items: center; gap: 10px;">
                    <Label>@L["Page Size"]: &nbsp;&nbsp;</Label>
                    <RadzenNumeric @bind-Value="PageSize" Style="width:60px"></RadzenNumeric>
                    <a class="nav-link" title="@L["Display Settings"]" @onclick="() => showDecimalSettings = !showDecimalSettings" @onclick:preventDefault="true" href="">
                        <span class="oi oi-cog" aria-hidden="true"></span>
                    </a>
                    @if (showDecimalSettings)
                    {
                        <div style="display: flex; align-items: center; gap: 6px; background: #f0f4ff; border: 1px solid #667eea; border-radius: 8px; padding: 4px 10px;">
                            <span style="font-size: 12px; color: #4a5568;">@L["Decimals"]:</span>
                            <RadzenNumeric @bind-Value="decimalPlaces" Min="0" Max="6" Style="width:55px;" />
                        </div>
                    }
                </div>
            </Div>
  
                <RadzenDataGrid @ref="chargeSceniqueGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize"
                                Data="@chargeSceniqueList" TItem="ChargesScenique" ColumnWidth="150px" @bind-Value="@SelectedChargesSceniques">
                    <Columns>

                        <RadzenDataGridColumn Width="50" TItem="ChargesScenique" Property="Name">
                            <HeaderTemplate>
                                <span class="gridColumndStyle">@L["Nom"]</span>  
                                </HeaderTemplate>
                            <EditTemplate Context="chargesScenique">
                                <InputTextArea @bind-Value="chargesScenique.Name" Style="width:100%" />
                            </EditTemplate>
                        </RadzenDataGridColumn>

                        @* X and Y in the studies' axes (StudyX, StudyY): metres from Point0 (E5), X along the beams
                           towards point 9, Y across them towards J. The stored X and Y stay in the grid's axes. *@
                        <RadzenDataGridColumn Width="50" TItem="ChargesScenique" Property="StudyX" TextAlign="TextAlign.Center" FormatString="@($"{{0:N{decimalPlaces}}}")">
                            <HeaderTemplate>
                                <span class="gridColumndStyle">@L["X"]</span>               
                            </HeaderTemplate>
                            <EditTemplate Context="chargesScenique">
                                <InputNumber @bind-Value="chargesScenique.StudyX" Style="width:100%" />
                            </EditTemplate>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Width="50" TItem="ChargesScenique" Property="StudyY" TextAlign="TextAlign.Center" FormatString="@($"{{0:N{decimalPlaces}}}")">
                            <HeaderTemplate>
                                <span class="gridColumndStyle">@L["Y"]</span>                  
                            </HeaderTemplate>
                            <EditTemplate Context="chargesScenique">
                                <InputNumber @bind-Value="chargesScenique.StudyY" Style="width:100%" />
                            </EditTemplate>
                        </RadzenDataGridColumn>


                        <RadzenDataGridColumn Width="50" TItem="ChargesScenique" Property="Charge" TextAlign="TextAlign.Center" FormatString="@($"{{0:N{decimalPlaces}}}")">
                            <HeaderTemplate>
                                <span class="gridColumndStyle">@L["Charge"]</span>                                              </HeaderTemplate>
                            <EditTemplate Context="chargesScenique">
                                <InputNumber @bind-Value="chargesScenique.Charge" Style="width:100%" />
                            </EditTemplate>
                        </RadzenDataGridColumn>


                        <RadzenDataGridColumn Width="15em" TItem="ChargesScenique" Property="PULMONARY_TOXICITY" Title="@L["Action"]" Filterable="false" Sortable="false">
                            <Template Context="data">
                                <Div Style="display: flex">
                                    <a title="@L["Edit"]" class="nav-link" @onclick="@(args => EditRow(data))" @onclick:preventDefault="true" href="">
                                        <span class="oi oi-pencil" aria-hidden="true"></span>
                                    </a>
                                    <a title="@L["End Edit"]" class="nav-link" @onclick="@(args => UpdateRow(data))" @onclick:preventDefault="true" href="">
                                        <span class="oi oi-check" aria-hidden="true"></span>
                                    </a>
                                    <a title="@L["Delete"]" class="nav-link" @onclick="@(() => DeleteChargeScenique(data))" @onclick:preventDefault="true" href="">
                                        <span class="oi oi-trash" aria-hidden="true"></span>
                                    </a>
                                </Div>

                            </Template>

                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </RadzenSplitterPane>
        <RadzenSplitterPane Size="50%">


            <RadzenSplitter Orientation="Radzen.Orientation.Vertical" Style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
                <RadzenSplitterPane Size="20">
                    <div style="display: flex">
                        <div class="form-group " style="margin-right: 50px;">
                            <div>
                                <label>@L["Charge Totale"] :</label>
                                <div>
                                    <InputNumber disabled="true" @bind-Value="@ChargeTotale" />
                                </div>
                            </div>
                        </div>
                    </div>

                </RadzenSplitterPane>
                <RadzenSplitterPane Size="80">
                    <AliantWebS.Pages.CADPages.SVGComponent Mode="AliantWebS.Pages.CADPages.PlanMode.View"
                                                            ChargesSceniques="chargeSceniqueList"
                                                            Point0X="@(Layout?.selectedEvent?.Point0X ?? 0)"
                                                            Point0Y="@(Layout?.selectedEvent?.Point0Y ?? 0)"
                                                            EventName="@Layout?.selectedEvent?.Name"
                                                            EventId="@Layout?.selectedEvent?.EventId"
                                                            ScenarioName="@Layout?.selectedScenario?.Name"
                                                            ScenarioId="@Layout?.selectedScenario?.EventMpscenarioId"
                                                            ModuleName="Charges Scéniques"></AliantWebS.Pages.CADPages.SVGComponent>

                </RadzenSplitterPane>
            </RadzenSplitter>

        </RadzenSplitterPane>
    </RadzenSplitter>

</EditForm>

@code {
    int PageSize { get; set; } = 10;

    [CascadingParameter]
    public AntaresConceptionLayout Layout { get; set; }

    IList<ChargesScenique> SelectedChargesSceniques { get; set; }

    RadzenDataGrid<ChargesScenique> chargeSceniqueGrid;

    List<ChargesScenique> chargeSceniqueList = new List<ChargesScenique>();

    [Parameter]
    public Guid EventId { get; set; }

    double ChargeTotale { get; set; }

    bool isImporting = false;

    private int decimalPlaces = 3;
private bool showDecimalSettings = false;

    // The scenario whose charges the list holds - or is being read - and which read is the latest.
    Guid? listScenarioId;
    bool listRead;
    int listReads;

    protected override async Task OnParametersSetAsync()
    {
        // The scenario's charges, read through a context of their own and not tracked: the page holds them as plain data
        // and saves each change itself (UpdateOwnedAsync...), so none is left behind in the circuit's shared context when
        // the scenario is deleted. The filter runs in the database: GetFilteredEntitiesAsync took a C# function and read
        // every charge scénique of every scenario.
        //
        // Read again only when the scenario shown changes. The layout re-renders this page for many reasons - a save
        // anywhere in the tab, the unsaved-changes flag - and every read gives new objects: it replaced the rows the grid
        // was editing, and listed a row just added a second time. The page keeps its list in step itself.
        var scenarioId = Layout?.selectedScenario?.EventMpscenarioId;
        if (listRead && scenarioId == listScenarioId) return;
        listRead = true;
        listScenarioId = scenarioId;
        int read = ++listReads;

        var rows = new List<ChargesScenique>();
        if (scenarioId is { } id)
        {
            await using var db = entitiesService.CreateOwnedContext();
            rows = await db.ChargesSceniques.AsNoTracking().Where(c => c.EventMpscenarioId == id).ToListAsync();
        }

        // The latest read wins: a slower read of the scenario shown before must not replace this one's rows.
        if (read != listReads) return;
        chargeSceniqueList = rows;
        CalculateChargeTotale();
    }

    async Task DeleteChargeScenique(ChargesScenique chargesScenique)
    {
        if (await entitiesService.DeleteOwnedAsync(chargesScenique))
        {
            if (chargeSceniqueList.RemoveAll(c => c.ChargesSceniqueId == chargesScenique.ChargesSceniqueId) > 0)
            {
                await chargeSceniqueGrid.Reload();
            }
        }
        CalculateChargeTotale();
    }

    void EditRow(ChargesScenique chargeScenique)
    {
        chargeSceniqueGrid.EditRow(chargeScenique);
    }

    async Task InsertChargeScenique()
    {
        if (Layout?.selectedScenario is null)
        {
            await js.InvokeVoidAsync("alert",
                L["No scenario selected. Please select a scenario before adding a charge."].ToString());
            return;
        }

        ChargesScenique chargeScenique = new ChargesScenique();
        chargeScenique.EventMpscenarioId = Layout.selectedScenario.EventMpscenarioId;

        // The row is persisted before it is opened for editing, so UpdateRow's checks never see it: a stray
        // click, or adding a row and leaving the page, used to leave a nameless charge behind and
        // « Générer l'implantation » then refused the whole plan naming a row nobody could pick out. Name it
        // here instead — the user has only its position and its weight left to fill in.
        chargeScenique.Name = NextFreeChargeName(chargeScenique.EventMpscenarioId);

        // A refused insert is shown by the service itself.
        if (await entitiesService.InsertOwnedAsync(chargeScenique))
        {
            // Into the grid only if it still shows that scenario (Back, or the dropdown, may have moved it meanwhile).
            if (Layout?.selectedScenario?.EventMpscenarioId == chargeScenique.EventMpscenarioId)
            {
                chargeSceniqueList.Add(chargeScenique);
                await chargeSceniqueGrid.InsertRow(chargeScenique);
            }
        }

        CalculateChargeTotale();
    }

    // « Charge 1 », « Charge 2 », … : the first number this scenario does not already use. Compared trimmed
    // and ignoring case, the way UpdateRow and the optimiser compare names, so the name handed out here can
    // never be the duplicate UpdateRow would refuse — even though the database would take it.
    string NextFreeChargeName(Guid scenarioId)
    {
        int n = 1;

        while (chargeSceniqueList.Any(c =>
            c.EventMpscenarioId == scenarioId
            && string.Equals((c.Name ?? string.Empty).Trim(), $"Charge {n}", StringComparison.OrdinalIgnoreCase)))
        {
            n++;
        }

        return $"Charge {n}";
    }

    private void CalculateChargeTotale()
    {
        ChargeTotale = 0;
        foreach (var v in chargeSceniqueList)
        {
            ChargeTotale += v.Charge ?? 0;
        }
    }

    // « Générer l'implantation » now reads these rows instead of Charges.xlsx, and it refuses a plan whose
    // load names are empty or duplicated — the optimiser and the study match a load to its row by name.
    // Checking here tells the person at the moment they typed the name, rather than several screens later
    // when the placement stops on a table they can no longer relate to what they did.
    async Task UpdateRow(ChargesScenique chargeScenique)
    {
        var name = (chargeScenique.Name ?? string.Empty).Trim();

        if (name.Length == 0)
        {
            await js.InvokeVoidAsync("alert",
                "Le nom de la charge est obligatoire : l'implantation identifie chaque charge par son nom.");
            return;
        }

        if (name.Length > 50)
        {
            await js.InvokeVoidAsync("alert",
                $"Le nom « {name} » fait {name.Length} caractères ; 50 au maximum. Raccourcissez-le avant d'enregistrer.");
            return;
        }

        // Trimmed and ignoring case — that is how the optimiser and the study match the names, so two rows
        // the database would happily keep side by side would still be one single load for the placement.
        bool duplicate = chargeSceniqueList.Any(c =>
            c.ChargesSceniqueId != chargeScenique.ChargesSceniqueId
            && c.EventMpscenarioId == chargeScenique.EventMpscenarioId
            && string.Equals((c.Name ?? string.Empty).Trim(), name, StringComparison.OrdinalIgnoreCase));

        if (duplicate)
        {
            await js.InvokeVoidAsync("alert",
                $"Le nom « {name} » est déjà utilisé par une autre charge de ce scénario. Les noms doivent être uniques.");
            return;
        }

        chargeScenique.Name = name;

        try
        {
            if (await entitiesService.UpdateOwnedAsync(chargeScenique))
            {
                await chargeSceniqueGrid.UpdateRow(chargeScenique);
            }
            else
            {
                await js.InvokeVoidAsync("alert",
                    "L'enregistrement a échoué. La ligne reste en édition, rien n'est perdu.");
            }
        }
        catch (Exception ex)
        {
            // UpdateOwnedAsync throws when the save fails. Unhandled here it kills the Blazor circuit, so a
            // name the column cannot hold used to blank the whole page and take the other rows' edits with it.
            await js.InvokeVoidAsync("alert",
                $"L'enregistrement a échoué : {ex.GetBaseException().Message}\nLa ligne reste en édition, rien n'est perdu.");
        }

        CalculateChargeTotale();
    }

    async Task DeleteAllChargesSceniques()
    {
        // The rows on screen when asked, not whatever list the page holds once the dialog is answered: the layout follows
        // the address and can switch the page to another scenario meanwhile.
        var toDelete = chargeSceniqueList.ToList();

        bool confirmed = await js.InvokeAsync<bool>("confirm", L["Are you sure you want to delete all charges scéniques?"].ToString());
        if (!confirmed) return;

        foreach (var item in toDelete)
        {
            // Off the list only once deleted (a row another tab already deleted counts as deleted): a refused delete
            // is undone in memory too, and the row stays. Stopped at the first refusal, which the service has already
            // shown - one alert, not one per row.
            if (!await entitiesService.DeleteOwnedAsync(item)) break;
            chargeSceniqueList.RemoveAll(c => c.ChargesSceniqueId == item.ChargesSceniqueId);
        }

        await chargeSceniqueGrid.Reload();
        CalculateChargeTotale();
    }

    async Task TriggerExcelImport()
    {
        // Checked before the file dialog opens, as "Add New" does: the loads belong to a scenario, and
        // there is none while the event has no scenario or the selected one was just deleted.
        if (Layout?.selectedScenario is null)
        {
            await js.InvokeVoidAsync("alert",
                L["No scenario selected. Please select or create a scenario before importing charges."].ToString());
            return;
        }
        await js.InvokeVoidAsync("eval", "document.getElementById('excelFileInput').click()");
    }

    async Task ImportChargesFromExcel(InputFileChangeEventArgs e)
    {
        // Read once, up front. Reading it unchecked was the "Object reference not set to an instance of
        // an object" the import showed when no scenario was selected.
        var scenarioId = Layout?.selectedScenario?.EventMpscenarioId;
        var scenarioName = Layout?.selectedScenario?.Name;
        if (scenarioId is null)
        {
            await js.InvokeVoidAsync("alert",
                L["No scenario selected. Please select or create a scenario before importing charges."].ToString());
            return;
        }

        // Its names too, with the id and before the upload: the page may be moved to another scenario while the file
        // comes, and the import must compare with the scenario it writes to.
        var existingNames = chargeSceniqueList.Select(x => x.Name).ToList();

        isImporting = true;
        StateHasChanged();
        try
        {
            using var mem = new System.IO.MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(mem);
            mem.Position = 0;

            // ── Directly reuse Pipeline's function ───────────────────
            // The reader says what it made of the file — a first line taken as a header, columns read in
            // order for want of one, a row it could not use. Silently, the only sign of a misread header
            // was a load missing from the grid, which nobody looks for.
            var warnings = new List<string>();
            var toInsert = await RiggingOptimizer.Pipeline.ImportChargesSceniquesFromStream(
                mem,
                scenarioId.Value,
                existingNames,
                warnings);

            // ── Show what the reader noticed ──────────────────────────
            if (warnings.Any())
            {
                string msg = string.Join("\n", warnings);
                await js.InvokeVoidAsync("alert", $"⚠️ Lecture du fichier :\n\n{msg}");
            }

            if (toInsert.Count == 0)
            {
                await js.InvokeVoidAsync("alert", L["All charges already exist, import ignored."].ToString());
                return;
            }

            if (await entitiesService.InsertOwnedRangeAsync(toInsert))
            {
                // Into the list on screen only if it is still that scenario's: Back, or the dropdown, may have moved the
                // page to another scenario while the file was read, and its list was reloaded then - « Tout supprimer »
                // would otherwise delete these rows from the other scenario.
                bool stillShown = Layout?.selectedScenario?.EventMpscenarioId == scenarioId;
                if (stillShown)
                    chargeSceniqueList.AddRange(toInsert);
                await chargeSceniqueGrid.Reload();
                CalculateChargeTotale();
                await js.InvokeVoidAsync("alert", stillShown
                    ? L["{0} charge(s) imported successfully.", toInsert.Count].ToString()
                    : $"{toInsert.Count} charge(s) importée(s) dans « {scenarioName} », le scénario où l'import a été lancé "
                      + "- la page n'affiche plus ce scénario.");
            }
            else
            {
                await js.InvokeVoidAsync("alert", L["Import failed."].ToString());
            }
        }
        catch (Exception ex)
        {
            // The reason the database gave, not EF's "see the inner exception".
            await js.InvokeVoidAsync("alert", L["Error: {0}", ex.GetBaseException().Message].ToString());
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }

    // « Calcul MotherGrid » removed with its button: it was debug scaffolding on a production page. It put a
    // scenario id into EventMpscenario.EventId — a foreign key to Event — so the insert could only be
    // rejected, then inserted a hard-coded MotherGridPalonnier; and being « async void » it took the circuit
    // down with it. The loads it was meant to compute are what « Générer l'implantation » does properly.
}

