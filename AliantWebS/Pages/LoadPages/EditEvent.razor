@page "/EditEvent/{EventID:guid}"
@using AliantWebS.Data
@using AliantWebS.Models
@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject AppData appData
@inject IJSRuntime js


<NavigationLock OnBeforeInternalNavigation="appData.OnBeforeInternalNavigation" ConfirmExternalNavigation="appData.SaveConfirmation&& appData.SaveChanges" />

<h2>Edit Event</h2>
<hr />
<EventForm EditContext="@EditContext" ButtonText=@buttonText Eventt="@eventt"
                   OnValidSubmit="@UpdateEvent" />





@code {
    string buttonText = "Updated";

    [Parameter]
    public EditContext EditContext { get; set; }

    [Parameter]
    public Guid EventID { get; set; }

    Event eventt = new Event();

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        await base.SetParametersAsync(parameters);

        await Task.WhenAll(entitiesService.tasksList);
        eventt = await entitiesService.GetEntityAsync<Event>(EventID);
        EditContext = new EditContext(eventt);
    }


    protected async void UpdateEvent()
    {
        await entitiesService.UpdateEntityAsync(eventt);
        //navigationManager.NavigateTo("Structures");
    }




}