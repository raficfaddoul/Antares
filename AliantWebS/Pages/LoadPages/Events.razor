@page "/Events/{StructureID:guid}"
@page "/Events"

@using AliantWebS.Data
@inject EntitiesService entitiesService
@using Models
@inject NavigationManager navigationManager
@inject AppData appData;
@inject IJSRuntime js
@inject ScenarioStorageService scenarioStorage
@inject IStringLocalizer<Languages> L




<Div Style="display: flex">
    <h3>@L["Events Information"]</h3>
    <div style="margin-left: auto; ">
        <Label> @L["Page Size"]: &nbsp;&nbsp;</Label>
        <RadzenNumeric @bind-Value="PageSize" Style="width:60px"></RadzenNumeric>
    </div>
</Div>
@if (eventsList is null)
{
    <p><em>@L["Loading"]... !</em></p>
}
else
{
    <Div Style="display: flex">
        <NavLink class="nav-link" href="AddEvent">
            <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
        </NavLink>
    </Div>
    <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
        <RadzenSplitterPane Size="50%">

        


                    <RadzenDataGrid class="RadzenDataGrid" @ref="eventsGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize" RowSelect=@RowSelect
                                    Data="@eventsList" TItem="Event" ColumnWidth="150px">
                        <Columns>
                            <RadzenDataGridColumn TItem="Event" Property="Name" Title="@L["Name"]"></RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="Event" Property="Description" Title="@L["Description"]"></RadzenDataGridColumn>

                            <RadzenDataGridColumn TItem="Event" Property="Name" Title="@L["Action"]" Filterable="false" Sortable="false">
                                <Template Context="data">
                                    <Div Style="display: flex">
                                        <a title="@L["Edit"]" class="nav-link" href="EditEvent/@data.EventId">
                                            <span class="oi oi-pencil" aria-hidden="true"></span>
                                        </a>
                                        <a title="@L["Delete"]" @onclick="@(() => DeleteEvent(data))" @onclick:preventDefault="true" href="">
                                            <span class="oi oi-trash" aria-hidden="true"></span>
                                        </a>
                                        <a title="@L["Charges"]" class="nav-link" @onclick="@(args => Charges(data))" @onclick:preventDefault="true" href="">
                                            <span class="oi oi-document" aria-hidden="true"></span>
                                        </a>
                                    </Div>
                                </Template>

                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>

  
        </RadzenSplitterPane>
        <RadzenSplitterPane>
            <div>
            @if (selectedEvent != null)
            {
                <MediaComponent selectedObject="selectedEvent"></MediaComponent>

            }
            </div>
        </RadzenSplitterPane>
    </RadzenSplitter>



}


@code {


    List<Event> eventsList;


    Event selectedEvent;

    int PageSize { get; set; } = 10;

    RadzenDataGrid<Event> eventsGrid;

    [Parameter]
    public Guid? StructureID { get; set; }


    protected override async Task OnInitializedAsync()
    {
        if (appData.Structure == null)
        {
            if (StructureID != null)
            {
                appData.Structure = await entitiesService.GetFilteredFirstEntityAsync<Structure>(x => x.StructureId.ToString() == StructureID.ToString());
            }
            if (appData.Structure == null)
            {
                navigationManager.NavigateTo(@"Structures");
            }
        }

        eventsList = await entitiesService.GetFilteredEntitiesAsync<Event>(x => x.StructureId == appData.Structure.StructureId);

    }

    async Task RowSelect(Event eventt)
    {

        selectedEvent = eventt;


    }

    async Task DeleteEvent(Event eventt)
    {
        var isConfirmed = await js.InvokeAsync<bool>("confirm",
            $"Supprimer l'événement « {eventt.Name} » ?\n"
            + "Ses scénarios (charges scéniques, mother grids et palonniers, leurs charges, charpentes), ses équipements, "
            + "ses axes et ses liens aux cas de charge sont supprimés avec lui.\n"
            + "Ses fichiers seront déplacés dans la corbeille, pas effacés.");
        if (!isConfirmed) return;

        var eventId = eventt.EventId;
        var eventName = eventt.Name;

        // Through a context of its own, children first, in one transaction (EntitiesService.DeleteEventAsync): the event
        // alone was refused as soon as one of its scenarios had charges scéniques. The event's folder - its scenarios'
        // files, uploaded by hand - goes to the trash only once the rows are gone, so a refused delete cannot strand it.
        bool hadFolder = false;
        string moved = null;
        var deleted = await entitiesService.DeleteEventAsync(eventt, afterDelete: () =>
        {
            hadFolder = scenarioStorage.HasEventFolder(eventId, eventName);
            moved = hadFolder ? scenarioStorage.TrashEventFolder(eventId, eventName) : null;
            return !hadFolder ? "aucun dossier" : moved is null ? "dossier non déplacé" : $"dossier déplacé dans {moved}";
        });
        if (deleted is null) return;

        eventsList.RemoveAll(e => e.EventId == eventId);
        // Nothing may go on pointing at the deleted event: its photos pane, and the event the conception and
        // monitoring pages open (they treat none as "choose an event").
        if (selectedEvent?.EventId == eventId) selectedEvent = null;
        if (appData.EventID == eventId)
        {
            appData.EventID = Guid.Empty;
            appData.CharpenteTauxByBimId = new();   // the 3D model's colours came from its calculations
        }
        await eventsGrid.Reload();
        StateHasChanged();

        if (hadFolder && moved is null)
            await js.InvokeVoidAsync("alert",
                $"L'événement « {eventName} » est supprimé, mais son dossier n'a pas pu être déplacé dans la corbeille : "
                + "ses fichiers sont restés en place.");
    }

    async Task Charges(Event eventt)
    {
        appData.EventID = eventt.EventId;
        navigationManager.NavigateTo(@"ChargesSceniques/" + eventt.EventId);
    }


}
