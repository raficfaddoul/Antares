@page "/AddEquipement"
@using AliantWebS.Data
@using AliantWebS.Models
@inject EntitiesService entitiesService
@inject NavigationManager NavigationManager
@inject AppData appData

<NavigationLock OnBeforeInternalNavigation="appData.OnBeforeInternalNavigation" ConfirmExternalNavigation="appData.SaveConfirmation&& appData.SaveChanges" />


<EquipementForm EditContext="@EditContext" ButtonText="Create" Equipement="@equipement"
           OnValidSubmit="@CreateEquipement"
           Title="Add Equipement" />

@code {
    [Parameter]
    public EditContext EditContext { get; set; }

    Equipement equipement = new Equipement();

    protected override async Task OnInitializedAsync()
    {
        EditContext = new EditContext(equipement);
    }

    protected async void CreateEquipement()
    {
        await entitiesService.InsertEntityAsync(equipement);

        NavigationManager.NavigateTo("Equipements");
    }

}
