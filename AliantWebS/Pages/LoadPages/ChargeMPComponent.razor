@using AliantWebS.Data
@using AliantWebS.Reporting
@inject EntitiesService entitiesService
@inject ScenarioStorageService scenarioStorage
@inject NavigationManager navigationManager
@inject IJSRuntime js
@inject AliantWebS.Data.AppData AppData
@using Models
@using Helpers
@using Microsoft.EntityFrameworkCore
@inject IStringLocalizer<Languages> L
@inject NotificationService notifications

@* Leaving the page that shows these charges stores their loads first (CalculateBeforeLeaving). *@
<NavigationLock OnBeforeInternalNavigation="CalculateBeforeLeaving" />

@* ChargeList is required: the page reads the charges and hands them over, and OnParametersSet refuses null. *@
<Div Style="display: flex; align-items: center;">

    <a class="nav-link" @onclick="@(args => Insertmp())" @onclick:preventDefault="true" href="">
        <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
    </a>
        @if (isImportingCharges)
        {
            <span class="spinner-border spinner-border-sm text-primary ms-2" role="status"></span>
            <span class="ms-1">@L["Importing..."]</span>
        }
        else
        {
            <a class="nav-link" @onclick="TriggerChargeExcelImport" @onclick:preventDefault="true" href="" title="@L["Import from Excel"]">
                <span class="oi oi-data-transfer-upload" aria-hidden="true"> @L["Import Excel"]</span>
            </a>
        }
        <InputFile id="chargeImport" OnChange="ImportChargesFromExcel" accept=".xlsx" style="display:none" />
    <div class="form-group " style="margin-right: 50px;">
        <div>
            <label>@L["Charge Totale"] :</label>
            <div>
                <InputNumber disabled="true" @bind-Value="@ChargeTotale" />
            </div>
        </div>
    </div>
<div style="display: flex; align-items: center;">
    @* Also runs automatically when leaving /MotherGrid. The button matters because the calculation
       depends on the truss masses in MotherGrill.xlsx and Palonnier.xlsx: after filling one in there is
       otherwise no way to ask for a recompute except to navigate away and back. *@
    <Blazorise.Button Color="Blazorise.Color.Primary" Clicked="CalculCharpenteClicked" Disabled="@isCalculating">@L["Calcul Charpente"]</Blazorise.Button>
</div>
    <div style="margin-left: auto; display: flex; align-items: center; gap: 10px;">
        <Label>@L["Page Size"]: &nbsp;&nbsp;</Label>
        <RadzenNumeric @bind-Value="PageSize" Style="width:60px"></RadzenNumeric>
        <a class="nav-link" title="@L["Display Settings"]" @onclick="() => showDecimalSettings = !showDecimalSettings" @onclick:preventDefault="true" href="">
            <span class="oi oi-cog" aria-hidden="true"></span>
        </a>
        @if (showDecimalSettings)
        {
            <div style="display: flex; align-items: center; gap: 6px; background: #f0f4ff; border: 1px solid #667eea; border-radius: 8px; padding: 4px 10px;">
                <span style="font-size: 12px; color: #4a5568;">@L["Decimals"]:</span>
                <RadzenNumeric @bind-Value="decimalPlaces" Min="0" Max="6" Style="width:55px;" />
            </div>
        }
    </div>

</Div>

    <EditForm Model="@ChargeList">
        <RadzenDataGrid @ref="chargeGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize"
                        Data="@ChargeList" TItem="ChargeMp" ColumnWidth="150px" SelectionMode="DataGridSelectionMode.Single" @bind-Value="@SelectedMPList">
            <Columns>

                <RadzenDataGridColumn Width="50" TItem="ChargeMp" Property="Name">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Nom"]</span>                    <br />
                    </HeaderTemplate>
                    <EditTemplate Context="mp">
                        <InputTextArea @bind-Value="mp.Name" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="50" TItem="ChargeMp" Property="MotherGridPalonnierId" TextAlign="TextAlign.Center">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["MotherGrid/Palonnier"]</span><br />
                    </HeaderTemplate>
                    <EditTemplate Context="mp">
                        @((mp?.MotherGridPalonnier?.Name) ?? "-")
                    </EditTemplate>
                    <Template Context="mpp">
                        @((mpp?.MotherGridPalonnier?.Name) ?? "-")
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="50" TItem="ChargeMp" Property="X" TextAlign="TextAlign.Center" FormatString="@($"{{0:N{decimalPlaces}}}")">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["X"]</span>   <br />
                    </HeaderTemplate>
                    <EditTemplate Context="mp">
                        <InputNumber @bind-Value="mp.X" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="50" TItem="ChargeMp" Property="Charge" TextAlign="TextAlign.Center" FormatString="@($"{{0:N{decimalPlaces}}}")">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Charge"]</span>   <br />
                    </HeaderTemplate>
                    <EditTemplate Context="mp">
                        <InputNumber @bind-Value="mp.Charge" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>


                <RadzenDataGridColumn Width="15em" TItem="ChargeMp" Property="PULMONARY_TOXICITY" Title="@L["Action"]" Filterable="false" Sortable="false">
                    <Template Context="data">
                        <Div Style="display: flex">
                            <a title="@L["Edit"]" class="nav-link" @onclick="@(args => EditRow(data))" @onclick:preventDefault="true" href="">
                                <span class="oi oi-pencil" aria-hidden="true"></span>
                            </a>
                            <a title="@L["End Edit"]" class="nav-link" @onclick="@(args => UpdateRow(data))" @onclick:preventDefault="true" href="">
                                <span class="oi oi-check" aria-hidden="true"></span>
                            </a>
                            <a title="@L["Delete"]" class="nav-link" @onclick="@(() => DeleteMP(data))" @onclick:preventDefault="true" href="">
                                <span class="oi oi-trash" aria-hidden="true"></span>
                            </a>
                        </Div>

                    </Template>

                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

    </EditForm>


@code {
    int PageSize { get; set; } = 10;

    private IList<ChargeMp> _selectedChargeList = new List<ChargeMp>();

    public IList<ChargeMp> SelectedMPList
    {
        get { return _selectedChargeList; }
        set
        {
            if (value == null) throw new ArgumentNullException(nameof(value));
            _selectedChargeList = value;
            var selected = _selectedChargeList.FirstOrDefault();
            if (!Equals(selectedChargeMP, selected))
            {
                selectedChargeMP = selected;
                selectedChargeMPChanged.InvokeAsync(selectedChargeMP);
            }
        }
    }

    [Parameter]
    public ChargeMp selectedChargeMP { get; set; }

    [Parameter]
    public EventCallback<ChargeMp> selectedChargeMPChanged { get; set; }

    [Parameter]
    public List<ChargeMp> ChargeList { get; set; }

    RadzenDataGrid<ChargeMp> chargeGrid;



    /// <summary>The element selected on the page - a mother or a palonnier - which a charge added or imported is placed
    /// on. Null when none is selected.</summary>
    [Parameter]
    public MotherGridPalonnier? Carrier { get; set; }

    [Parameter]
    public Guid EventMpscenarioId { get; set; }

    // The result of a calculation, for the page to draw on the plan: where load enters the mothers (a palonnier's hanging
    // point, or a charge placed straight on a mother) and the load on every charpente point. Reconnected on 2026-09-17 -
    // it had been commented out, so the plan's two layers never showed.
    [Parameter]
    public EventCallback<LoadTransmissionResult> OnCalculCharpente { get; set; }

    [Parameter]
    public EventCallback ChargeListChanged { get; set; }

    [CascadingParameter]
    public AntaresConceptionLayout Layout { get; set; }

    double ChargeTotale { get; set; }

    private int decimalPlaces = 3;
private bool showDecimalSettings = false;
bool isImportingCharges = false;

    // One calculation at a time: two that overlap would both save the Charpente row, and a double click started two. A
    // run asked for while another is going waits behind it, and the queue never fails - so a run that throws or is
    // cancelled (an alert left open past the JS timeout) does not stop the one after it.
    private Task calculation = Task.CompletedTask;   // the last run asked for
    private bool runWaiting;                          // that run waits behind another and has not started
    private int unfinishedRuns;                       // asked for and not finished
    private bool isCalculating => unfinishedRuns > 0;

    /// <summary>Completes when no calculation is running or waiting - including one queued while this waits (never
    /// faults). The page awaits it before it reads the element types through the circuit's shared context, which a
    /// calculation reads them through too (its elements, charges and Charpente row have contexts of their own).</summary>
    public async Task WhenIdle()
    {
        while (!calculation.IsCompleted)
            await calculation;
    }

    // The button: a click while anything runs or waits is dropped, not queued (the button is disabled then, but a second
    // click can arrive before that shows).
    private Task CalculCharpenteClicked() => isCalculating ? Task.CompletedTask : QueueCalculation(leaving: false);

    // Leaving the page that shows these charges for another page of the application - a link, Back or Forward, a
    // NavigateTo, another scenario's Mother Grid - stores their loads first: the Charpente page, the report and the 3D
    // model read the stored table. The navigation waits for it. A NavigationLock is active only while this component is
    // shown; the layout used to guess from the address instead, which a download link left on the file's address - the
    // download then calculated, and a later departure did not. Never seen, by any handler: a reload (F5), closing the
    // tab, a lost connection, Log out (a plain form post), an address typed or a bookmark, a link or Back to an address
    // outside the application, and a departure in the very first moment after the page appears (the lock registers
    // after its first render).
    private async Task CalculateBeforeLeaving(LocationChangingContext context)
    {
        try
        {
            if (IsStaying(context)) return;
            await QueueCalculation(leaving: true);
        }
        catch (Exception ex)
        {
            // Nothing may escape a navigation's handler: it would end the circuit.
            Console.WriteLine($"Calcul charpente avant de quitter la page : {ex}");
        }
    }

    // Staying: this very Mother Grid (Générer l'implantation navigates back to it), or the router's own reload of a link it
    // could not route - the click itself was the departure, handled then. Mother Grid is the only page that shows this
    // component. Any other address, another scenario's Mother Grid included, is a departure: the calculation reads this
    // page's own scenario, whatever the dropdown already shows.
    private bool IsStaying(LocationChangingContext context)
    {
        if (!context.IsNavigationIntercepted && string.Equals(context.TargetLocation, navigationManager.Uri, StringComparison.Ordinal))
            return true;
        return ConceptionRoute.TryParse(navigationManager, context.TargetLocation, out var page, out var id)
               && page == "MotherGrid" && id == EventMpscenarioId;
    }

    private Task QueueCalculation(bool leaving)
    {
        // A run waiting reads the page when it starts, so it serves this request too: repeated requests - clicks on a
        // link, the dropdown's arrow keys (one navigation per key) - never pile up more than one run behind the one going.
        // Not the run going itself: the page stays live while a navigation waits, and an edit made since that run read
        // the rows would not be stored.
        if (runWaiting) return calculation;

        runWaiting = !calculation.IsCompleted;
        unfinishedRuns++;
        calculation = CalculateAfter(calculation, leaving);
        Redraw();   // the button, disabled - for a click Blazor would do it, not for a departure
        return calculation;
    }

    private async Task CalculateAfter(Task previous, bool leaving)
    {
        try { await previous; }
        catch { /* CalculateAfter never fails; kept so a change there cannot stop the queue */ }
        runWaiting = false;

        try
        {
            await CalculCharpente(leaving);
        }
        catch (Exception ex)
        {
            // CalculCharpente reports its own errors; this is what escapes its catch - its error alert itself cancelled,
            // or the circuit gone.
            Console.WriteLine($"Calcul charpente interrompu : {ex}");
        }
        finally
        {
            unfinishedRuns--;
        }

        Redraw();   // the button, enabled again when nothing else is queued, however the run ended and whoever asked
    }

    // The button's messages are alerts, as they always were. A departure's are notifications, which name the scenario: the
    // navigation does not wait for someone to close them, and by then the dropdown may already show the next scenario.
    private async Task Tell(bool leaving, string message)
    {
        if (!leaving)
        {
            await js.InvokeVoidAsync("alert", message);
            return;
        }
        notifications.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Warning,
            Summary = "Calcul charpente",
            Detail = message,
            Duration = 30000,
            CloseOnClick = true,
            Style = "white-space: pre-line; max-width: 34rem;"
        });
    }

    private void Redraw()
    {
        try { StateHasChanged(); }
        catch (ObjectDisposedException) { }
    }

    protected override void OnParametersSet()
    {
        // The page reads the charges with its elements (EntitiesService.ReadScenarioElementsAsync) and hands them over:
        // this grid reads nothing itself.
        if (ChargeList is null)
            throw new InvalidOperationException("ChargeMPComponent : la page qui l'affiche doit lui donner ChargeList.");
        CalculateChargeTotale();
    }

    async Task DeleteMP(ChargeMp mp)
    {
        // A refused delete is shown by the service itself; a charge another tab already deleted counts as deleted.
        if (await entitiesService.DeleteOwnedAsync(mp))
        {
            if (ChargeList.RemoveAll(c => c.ChargeMpid == mp.ChargeMpid) > 0)
            {
                await chargeGrid.Reload();
            }
        }
        CalculateChargeTotale();
        
        //  Notify parent that charges have changed
        if (ChargeListChanged.HasDelegate)
        {
            await ChargeListChanged.InvokeAsync();
        }
    }

    /// <summary>
    /// Takes off the grid the charges whose element the page no longer lists - deleted, and the database deleted its
    /// charges with it (ON DELETE CASCADE). In place: given a new list, the EditForm would build the grid anew, and a charge
    /// being edited would lose what was typed. The total follows.
    /// </summary>
    public async Task KeepChargesOf(IReadOnlySet<Guid> listedElements)
    {
        if (ChargeList.RemoveAll(c => !listedElements.Contains(c.MotherGridPalonnierId)) == 0) return;
        await chargeGrid.Reload();
        CalculateChargeTotale();
    }

    void EditRow(ChargeMp mp)
    {
        chargeGrid.EditRow(mp);
        CalculateChargeTotale();
    }

    async Task Insertmp()
    {
        if (Carrier is not { } carrier)
        {
            await js.InvokeVoidAsync("alert", $"{L["No MotherGrid/Palonnier selected. Please select one before adding a charge."]}");
            return;
        }
        Guid scenarioId = EventMpscenarioId;

        // Its carrier's id only: InsertOwnedAsync adds what the new row points to, and the element would be inserted a
        // second time with it.
        ChargeMp mp = new ChargeMp();
        mp.MotherGridPalonnierId = carrier.MotherGridPalonnierId;

        // A refused insert is shown by the service itself. Into the grid only if it still shows that scenario (Back, or
        // the dropdown, may have moved the page meanwhile).
        if (await entitiesService.InsertOwnedAsync(mp) && EventMpscenarioId == scenarioId)
        {
            mp.MotherGridPalonnier = carrier;   // for the carrier column, as a read of the page gives it
            ChargeList.Add(mp);
            await chargeGrid.InsertRow(mp);
        }
        CalculateChargeTotale();
        
        //  Notify parent that charges have changed
        if (ChargeListChanged.HasDelegate)
        {
            await ChargeListChanged.InvokeAsync();
        }
    }

    async Task UpdateRow(ChargeMp mp)
    {
        try
        {
            if (await entitiesService.UpdateOwnedAsync(mp))
            {
                await chargeGrid.UpdateRow(mp);
            }
        }
        catch (Exception ex)
        {
            // UpdateOwnedAsync throws when the database refuses the row, or when it no longer exists (deleted from another
            // tab). Unhandled here it ends the circuit; the row stays in edit with what was typed.
            await js.InvokeVoidAsync("alert", EntitiesService.NotSavedMessage(ex));
        }
        CalculateChargeTotale();
        
        // Notify parent that charges have changed
        if (ChargeListChanged.HasDelegate)
        {
            await ChargeListChanged.InvokeAsync();
        }
    }

    private void CalculateChargeTotale()
    {
        ChargeTotale = 0;
        foreach (var v in ChargeList)
        {
            ChargeTotale += v.Charge ?? 0;
        }
    }

    // Ajouter une liste pour stocker les messages d'alerte
    private List<string> alertMessages = new List<string>();

    private async Task CalculCharpente(bool leaving)
    {
        // The scenario on screen - this page's own id, read once - and its event. Never the layout's dropdown: after Back,
        // or once the dropdown already names the scenario a navigation is taking the page to, it shows another scenario,
        // and this calculation used to write the page's loads into that one's Charpente row, weighed with its inventory
        // and placed from its event's Point0.
        Guid scenarioId = EventMpscenarioId;
        string scenarioName = null;
        try
        {
            // Vider les anciennes alertes
            alertMessages.Clear();

            if (scenarioId == Guid.Empty)
            {
                // No scenario on screen (after « Supprimer le scénario »): nothing to calculate, nothing to store.
                if (!leaving) await Tell(false, "Aucun scénario sélectionné : rien à calculer.");
                return;
            }

            var here = await ConceptionScenario.ResolveAsync(entitiesService, Layout, scenarioId);
            if (here is null)
            {
                // Deleted - « Supprimer le scénario » navigates away right after, or someone else did. Nothing is written:
                // no Charpente row is created for a scenario that is gone.
                if (leaving)
                    Console.WriteLine($"Calcul charpente : le scénario {scenarioId} n'existe plus, rien n'est enregistré.");
                else
                    await Tell(false, "Ce scénario n'existe plus : calcul impossible.");
                return;
            }
            scenarioName = here.Scenario.Name;

            // The scenario's mothers and palonniers and their charges as stored, read fresh through a context of their own:
            // what is calculated is what the database holds - another tab's change included, a value typed and not
            // confirmed with ✓ not (the page then hides the result, which no longer matches what it shows).
            var (allMotherGridsAndPalonniers, allCharges) = await entitiesService.ReadScenarioElementsAsync(scenarioId);

            // The scenario's Charpente row, read fresh through a context of its own - or a new one, inserted with its loads
            // once they are calculated (SaveCharpenteAsync), not empty before. The Charpente page and the report read it fresh
            // too, and nothing of it stays in the circuit's shared context.
            Models.Charpente charpente;
            await using (var db = entitiesService.CreateOwnedContext())
                charpente = await db.Charpentes.AsNoTracking().FirstOrDefaultAsync(x => x.EventMpscenarioId == scenarioId)
                            ?? new Models.Charpente { EventMpscenarioId = scenarioId };

            var elementTypes = await entitiesService.GetAllEntitiesAsync<ElementType>();
            var typeNames = elementTypes.ToDictionary(t => t.ElementTypeId, t => t.Name ?? "");

            // The trusses carry themselves. Their masses come from the inventory, MotherGrill.xlsx and
            // Palonnier.xlsx, the scenario's copies first - the same lookup the report uses, so the
            // study and the calculation can never disagree about what a truss weighs.
            var paths = scenarioStorage.GetScenarioPaths(
                here.Event, here.Scenario, create: false);

            // What this calculation is given, signed with no await from here to the calculation, so it is exactly what
            // the calculation reads: these rows with their values now, and the inventory files as they are before being
            // read (a file replaced in between then differs from the page's next look at it, which hides the result).
            // MotherGrid compares it with what it holds (CalculationSignature).
            string inputSignature = CalculationSignature.Of(scenarioId,
                here.Event.Point0X, here.Event.Point0Y,
                CalculationSignature.InventoryStamp(paths.DataDir, scenarioStorage.CommonDataDir),
                allMotherGridsAndPalonniers, allCharges);

            var catalog = RiggingOptimizer.IO.InventoryFiles.Load(paths.DataDir, scenarioStorage.CommonDataDir).Catalog;

            // Créer le helper et configurer les alertes
            var helper = new LoadTransmissionHelper();

            // The same mass source the report uses, so the stored loads and the study can never
            // disagree about what a truss weighs. See ReportDataBuilder.MassSource.
            helper.TrussMassOf = ReportDataBuilder.MassSource(catalog, typeNames);
            // Event-dependent origin: palonnier/charge coords are stored relative to Point0.
            helper.Point0X = here.Event.Point0X ?? 0;
            helper.Point0Y = here.Event.Point0Y ?? 0;
            helper.AlertAction = (message) => 
            {
                Console.WriteLine(message);
                alertMessages.Add(message);
                StateHasChanged(); // Forcer le rafraîchissement de l'UI
                return Task.CompletedTask;
            };

            // Calculer avec détails pour la visualisation
            var (motherGridLoads, charpenteLoads) = helper.CalculateCompleteLoadTransmissionWithDetails(
                allCharges,
                allMotherGridsAndPalonniers);

            // Appliquer les charges à la charpente
            helper.ApplyLoadsToCharpente(charpente, charpenteLoads);

            // Sauvegarder la charpente - inserted if the scenario had none yet. A refusal throws into the catch below, which
            // says so (an alert for the button, a notification for a departure).
            await entitiesService.SaveCharpenteAsync(charpente);

            // Créer le résultat pour la visualisation
            var result = new LoadTransmissionResult
            {
                MotherGridLoads = motherGridLoads,
                CharpenteLoads = charpenteLoads,
                Charpente = charpente,
                InputSignature = inputSignature
            };

            // Notifier le composant parent
            await OnCalculCharpente.InvokeAsync(result);

            // Afficher toutes les alertes à la fin si il y en a
            // All calc messages concatenated — set a breakpoint on the next line to copy
            // the value, or read it from the container/console output.
            string messagesDeCalcul = string.Join("\n", alertMessages);
            Console.WriteLine("===== Messages de calcul =====\n" + messagesDeCalcul);

            // Anything the run could not transmit has to reach the person who pressed calculate.
            // Every one of these makes the stored table read LOWER than the truth, and until now
            // they only ever went to a console nobody watches.
            var reserves = helper.Account.Describe().ToList();

            double transmitted = charpenteLoads.Values.Sum();
            double expected = helper.Account.ScenicTransmittedKg + helper.Account.SelfWeightTransmittedKg;

            if (Math.Abs(transmitted - expected) > 1e-6 * Math.Max(1.0, Math.Abs(expected)))
            {
                // Necessary, not sufficient: this balance is invariant to WHERE a load lands, so it
                // catches a leak rather than a misplacement. A failure still means the table is wrong.
                reserves.Add($"Contrôle d'équilibre échoué : {transmitted:N0} daN répartis sur la charpente "
                           + $"pour {expected:N0} daN transmis. Le tableau des charges est incomplet.");
            }

            if (reserves.Count > 0)
            {
                await Tell(leaving,
                    $"Calcul charpente de « {scenarioName} » terminé : {helper.Account.ScenicTransmittedKg:N0} daN de charges "
                    + $"scéniques et {helper.Account.SelfWeightTransmittedKg:N0} daN de poids propre des ponts.\n\n"
                    + "Réserves :\n• " + string.Join("\n• ", reserves));
            }
        }
        catch (Exception ex)
        {
            await Tell(leaving, $"❌ ERREUR lors du calcul{(scenarioName is null ? "" : $" de « {scenarioName} »")} :\n{ex.GetBaseException().Message}");
            Console.WriteLine($"Erreur détaillée: {ex}");
        }
    }

    // Classe pour transmettre les résultats
    public class LoadTransmissionResult
    {
        public Dictionary<Guid, (double Load, List<(double X, double Y)> IntersectionPoints)> MotherGridLoads { get; set; }
        public Dictionary<string, double> CharpenteLoads { get; set; }
        public Models.Charpente Charpente { get; set; }

        // What the calculation was given, as CalculationSignature.Of signs it.
        public string InputSignature { get; set; }
    }

    public void SelectItem(ChargeMp item)
    {
        _selectedChargeList = item != null
            ? new List<ChargeMp> { item }
            : new List<ChargeMp>();
        chargeGrid?.SelectRow(item);
        InvokeAsync(StateHasChanged);
    }

    async Task TriggerChargeExcelImport()
    {
        if (Carrier is null)
        {
            await AlertNoCarrierToImportOnto();
            return;
        }
        await js.InvokeVoidAsync("eval", "document.getElementById('chargeImport').click()");
    }

    // Before the file dialog opens, and again when the file arrives (the selection may have been cleared meanwhile).
    private ValueTask AlertNoCarrierToImportOnto() =>
        js.InvokeVoidAsync("alert", L["No MotherGrid/Palonnier selected. Please select one before importing."].ToString());

    async Task ImportChargesFromExcel(InputFileChangeEventArgs e)
    {
        // The element selected when the file arrives: the charges are placed along it. Cleared while the file dialog was
        // open, nothing is imported. One deleted from another tab meanwhile is refused by the database (its foreign key),
        // and the catch below says so.
        if (Carrier is not { } palonnier)
        {
            await AlertNoCarrierToImportOnto();
            return;
        }
        Guid scenarioId = EventMpscenarioId;

        isImportingCharges = true;
        StateHasChanged();
        try
        {
            using var mem = new System.IO.MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(mem);
            mem.Position = 0;

            var toInsert = await RiggingOptimizer.Pipeline.ImportChargeMpsFromStream(
                mem,
                palonnier,
                ChargeList.Select(x => x.Name),
                out var warnings,
                startNumero: ChargeList.Count + 1);

            // ── Show what the reader noticed, and the rows left out ───
            // This list no longer holds skipped rows alone: the reader now also says what it made of the
            // file — a first line taken as a header, or columns read in order for want of one. Announcing
            // all of it as skipped rows would say something the person cannot check against the file.
            if (warnings.Any())
            {
                string msg = string.Join("\n", warnings);
                await js.InvokeVoidAsync("alert",
                    $"⚠️ Lecture du fichier :\n\n{msg}\n\nPalonnier: '{palonnier.Name}' length={Math.Sqrt(Math.Pow((palonnier.X2??0)-(palonnier.X1??0),2)+Math.Pow((palonnier.Y2??0)-(palonnier.Y1??0),2)):F2}m");
            }

            if (toInsert.Count == 0)
            {
                await js.InvokeVoidAsync("alert", "Nothing imported — all charges exist or all rows were skipped.");
                return;
            }

            // The rows carry their carrier's id only (InsertOwnedRangeAsync adds what they point to).
            if (await entitiesService.InsertOwnedRangeAsync(toInsert))
            {
                // Into the grid only if it still shows that scenario.
                if (EventMpscenarioId == scenarioId)
                {
                    foreach (var charge in toInsert) charge.MotherGridPalonnier = palonnier;
                    ChargeList.AddRange(toInsert);
                    await chargeGrid.Reload();
                    CalculateChargeTotale();
                    if (ChargeListChanged.HasDelegate)
                        await ChargeListChanged.InvokeAsync();
                }
                await js.InvokeVoidAsync("alert", $"{toInsert.Count} charge(s) imported successfully.");
            }
            else
            {
                await js.InvokeVoidAsync("alert", "Import failed.");
            }
        }
        catch (Exception ex)
        {
            // The database's own reason (a refused row, the carrier deleted meanwhile), not EF's "see the inner exception".
            await js.InvokeVoidAsync("alert", $"Error: {ex.GetBaseException().Message}");
        }
        finally
        {
            isImportingCharges = false;
            StateHasChanged();
        }
    }
}

