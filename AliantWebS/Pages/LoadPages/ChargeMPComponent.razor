            charpente = new Models.Charpente();
            charpente.EventId = (Guid)scenario.EventId;
            charpente = await entitiesService.InsertEntityAsync(charpente);
            if (charpente != null)
            {
            }
            else
            {
                await js.InvokeVoidAsync("alert", $"Update Unsuccessfull!");
            }
        }



        charpente.A4 = 43;
        charpente.B7 = 50;
        //etc/


        await entitiesService.UpdateEntityAsync(charpente);

    }



}

