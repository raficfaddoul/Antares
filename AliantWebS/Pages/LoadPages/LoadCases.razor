    async Task AssignementStaticLoad(StaticLoad staticLoad)
    {
        var checkedElements = appData.CheckedNodeObjects.Select(x => (AliantWebS.Models.Element)x).ToList();
        var v2 = await entitiesService.GetFilteredEntitiesAsync<StaticLoadElement>(x => x.StaticLoadId == staticLoad.StaticLoadId);
        var elementsids = v2.Select(x => x.ElementId);
        foreach (Element el in checkedElements)
        {
            if (!elementsids.Contains(el.ElementId))
            {
                StaticLoadElement elc = new StaticLoadElement();
                elc.ElementId = el.ElementId;
                elc.StaticLoadId = staticLoad.StaticLoadId;
                if (await entitiesService.InsertEntityAsync(elc) == null)
                {
                    await js.InvokeVoidAsync("alert", $"Update Unsuccessfull!");
                }
            }
        }
        foreach (StaticLoadElement elid in v2)
        {
            if (!checkedElements.Select(x => x.ElementId).Contains(elid.ElementId))
            {
                await entitiesService.DeleteEntityAsync(elid);
            }
        }
        this.StateHasChanged();
        await staticLoadsGrid.SelectRow(staticLoad);


