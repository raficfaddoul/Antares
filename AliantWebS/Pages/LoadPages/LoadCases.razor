@page "/LoadCases/"
@using AliantWebS.Data
@using AliantWebS.Models
@inject EntitiesService entitiesService
@inject AppData appData
@inject IJSRuntime js
@inject IStringLocalizer<Languages> L
@inject NavigationManager navigationManager

@layout InventoryElementPages.ElementsLayout

<NavigationLock OnBeforeInternalNavigation="appData.OnBeforeInternalNavigation" ConfirmExternalNavigation="appData.SaveConfirmation&& appData.SaveChanges" />


<RadzenSplitter Orientation="Radzen.Orientation.Vertical" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
    <RadzenSplitterPane Size="50%">
        <Div Style="display: flex">
            <h3>@L["Load Cases"]</h3>
            <div style="margin-left: auto; ">
                <Label> @L["Page Size"]: &nbsp;&nbsp;</Label>
                <RadzenNumeric @bind-Value="PageSize" Style="width:60px"></RadzenNumeric>
            </div>
        </Div>
        <a class="nav-link" @onclick="@(InsertLoadCase)" @onclick:preventDefault="true" href="">
            <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
        </a>

            <RadzenDataGrid class="RadzenDataGrid" @ref="loadCasesGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize"
            Data="@loadCases" TItem="LoadCase" ColumnWidth="150px" @bind-Value="@SelectedLoadCases" RowSelect=@RowSelect>
                <Columns>
                    <RadzenDataGridColumn Width="50" TItem="LoadCase" Property="Name">
                        <HeaderTemplate>
                            <span class="gridColumndStyle">@L["Name"]</span>                    <br />
                        </HeaderTemplate>
                        <EditTemplate Context="loadCase">
                            <InputTextArea @bind-Value="loadCase.Name" Style="width:100%" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="50" TItem="LoadCase" Property="Description">
                        <HeaderTemplate>
                            <span class="gridColumndStyle">@L["Description"]</span>                    <br />
                        </HeaderTemplate>
                        <EditTemplate Context="loadCase">
                            <InputTextArea @bind-Value="loadCase.Description" Style="width:100%" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="50" TItem="LoadCase">
                        <HeaderTemplate>
                            <span class="gridColumndStyle">@L["Exclusive"]</span>
                        </HeaderTemplate>
                        <Template Context="loadCase">
                            <!-- Read-only mode -->
                            <RadzenCheckBox Value="@(loadCase.StructureId != null)" Disabled="true" />
                        </Template>
                        <EditTemplate Context="loadCase">
                            <!-- Editable mode -->
                            <RadzenCheckBox TValue="bool"
                                            Value="@(loadCase.StructureId != null)"
                                            ValueChanged="@(value => OnCheckboxChanged(value, loadCase))" />
                        </EditTemplate>
                    </RadzenDataGridColumn>



@*                     <RadzenDataGridColumn Width="50" TItem="LoadCase">
                        <HeaderTemplate>
                            <span class="gridColumndStyle">@L["Exclusive"]</span>                    <br />
                        </HeaderTemplate>
                        <Template Context="loadCase">
                            <InputCheckbox Value ="@(loadCase.StructureId != null)" ValueExpression="@( () => coco )"></InputCheckbox>
                        </Template>
                        <EditTemplate Context="loadCase">
                            <InputCheckbox Value="@(loadCase.StructureId != null)" 
                            ValueChanged="@(value => OnCheckboxChanged(value, loadCase))"
                            ValueExpression="@( () => coco )"></InputCheckbox>

                        </EditTemplate>
                    </RadzenDataGridColumn> *@


                    <RadzenDataGridColumn Width="50" TItem="LoadCase" Title="Action" Filterable="false" Sortable="false">
                        <Template Context="data">
                            <div style="display:flex">
                                <a title="@L["Edit"]" class="nav-link" @onclick="@(args => EditRow(data))" @onclick:preventDefault="true" href="">
                                    <span class="oi oi-pencil" aria-hidden="true"></span>
                                </a>
                                <a title="@L["End Edit"]" class="nav-link" @onclick="@(args => UpdateRow(data))" @onclick:preventDefault="true" href="">
                                    <span class="oi oi-check" aria-hidden="true"></span>
                                </a>
                                <a title="@L["Delete"]" class="nav-link" @onclick="@(() => DeleteLoadCase(data))" @onclick:preventDefault="true" href="">
                                    <span class="oi oi-trash" aria-hidden="true"></span>
                                </a>

                            </div>
                        </Template>

                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        
    </RadzenSplitterPane>
    <RadzenSplitterPane Size="50%">
        @if (selectedLoadCase != null)
        {
            <RadzenTabs RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="@L["Static Load"]">

                        <a class="nav-link" @onclick="@(args => InsertStaticLoad())" @onclick:preventDefault="true" href="">
                            <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
                        </a>
                        <RadzenDataGrid class="RadzenDataGrid" @ref="staticLoadsGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize"
                        Data="@selectedLoadCase.StaticLoads" TItem="StaticLoad" RowSelect=@StaticLoadRowSelect ColumnWidth="150px">
                            <Columns>
                                <RadzenDataGridColumn Width="50" TItem="StaticLoad" Property="Name">
                                    <HeaderTemplate>
                                        <span class="gridColumndStyle">@L["Name"]</span>                    <br />
                                    </HeaderTemplate>
                                    <EditTemplate Context="staticLoad">
                                        <InputTextArea @bind-Value="staticLoad.Name" Style="width:100%" />
                                    </EditTemplate>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn Width="50" TItem="StaticLoad" Property="Dof">
                                    <HeaderTemplate>
                                        <span class="gridColumndStyle">@L["DOF"]</span>                    <br />
                                    </HeaderTemplate>
                                    <EditTemplate Context="staticLoad">
                                        <RadzenNumeric @bind-Value="staticLoad.Dof" Style="width:100%" Name="Dof" />
                                        <RadzenRequiredValidator Text="DOF is required" Component="Dof" Popup="true" />
                                    </EditTemplate>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn Width="50" TItem="StaticLoad" Property="StartValue">
                                    <HeaderTemplate>
                                        <span class="gridColumndStyle">@L["Start Value"]</span>                    <br />
                                    </HeaderTemplate>
                                    <EditTemplate Context="staticLoad">
                                        <RadzenNumeric @bind-Value="staticLoad.StartValue" Style="width:100%" Name="StartValue" />
                                        <RadzenRequiredValidator Text="Start Value is required" Component="StartValue" Popup="true" />
                                    </EditTemplate>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn Width="50" TItem="StaticLoad" Property="EndValue">
                                    <HeaderTemplate>
                                        <span class="gridColumndStyle">@L["End Value"]</span>                    <br />
                                    </HeaderTemplate>
                                    <EditTemplate Context="staticLoad">
                                        <RadzenNumeric @bind-Value="staticLoad.EndValue" Style="width:100%" Name="EndValue" />
                                        <RadzenRequiredValidator Text="End Value is required" Component="EndValue" Popup="true" />
                                    </EditTemplate>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn Width="50" TItem="StaticLoad" Title="Action" Filterable="false" Sortable="false">
                                    <Template Context="data">
                                        <div style="display:flex">
                                            <a title="@L["Edit"]" class="nav-link" @onclick="@(args => EditStaticRow(data))" @onclick:preventDefault="true" href="">
                                                <span class="oi oi-pencil" aria-hidden="true"></span>
                                            </a>
                                            <a title="@L["End Edit"]" class="nav-link" @onclick="@(args => UpdateStaticRow(data))" @onclick:preventDefault="true" href="">
                                                <span class="oi oi-check" aria-hidden="true"></span>
                                            </a>
                                            <a title="@L["Delete"]" class="nav-link" @onclick="@(() => DeleteStaticLoad(data))" @onclick:preventDefault="true" href="">
                                                <span class="oi oi-trash" aria-hidden="true"></span>
                                            </a>
                                            <a title="@L["Element Assignement"]" class="nav-link" @onclick="@(() => AssignementStaticLoad(data))" @onclick:preventDefault="true" href="">
                                                <i class="material-icons">assignment</i>
                                            </a>
                                        </div>
                                    </Template>

                                </RadzenDataGridColumn>


                            </Columns>
                        </RadzenDataGrid>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="@L["Static Point Load"]">

                        <a class="nav-link" @onclick="@(args => InsertStaticPointLoad())" @onclick:preventDefault="true" href="">
                            <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
                        </a>
                        <RadzenDataGrid class="RadzenDataGrid" @ref="staticPointLoadsGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize"
                        Data="@selectedLoadCase.StaticPointLoads" TItem="StaticPointLoad" RowSelect=@StaticPointLoadRowSelect ColumnWidth="150px">
                            <Columns>
                                <RadzenDataGridColumn Width="50" TItem="StaticPointLoad" Property="Name">
                                    <HeaderTemplate>
                                        <span class="gridColumndStyle">@L["Name"]</span>                    <br />
                                    </HeaderTemplate>
                                    <EditTemplate Context="staticPointLoad">
                                        <InputTextArea @bind-Value="staticPointLoad.Name" Style="width:100%" />
                                    </EditTemplate>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn Width="50" TItem="StaticPointLoad" Property="Dof">
                                    <HeaderTemplate>
                                        <span class="gridColumndStyle">@L["DOF"]</span>                    <br />
                                    </HeaderTemplate>
                                    <EditTemplate Context="staticLoad">
                                        <RadzenNumeric @bind-Value="staticLoad.Dof" Style="width:100%" Name="Dof" />
                                        <RadzenRequiredValidator Text="DOF is required" Component="Dof" Popup="true" />
                                    </EditTemplate>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn Width="50" TItem="StaticPointLoad" Property="Value">
                                    <HeaderTemplate>
                                        <span class="gridColumndStyle">@L["Point Value"]</span>                    <br />
                                    </HeaderTemplate>
                                    <EditTemplate Context="staticLoad">
                                        <RadzenNumeric @bind-Value="staticLoad.Value" Style="width:100%" Name="Value"/>
                                        <RadzenRequiredValidator Text="Value is required" Component="Value" Popup="true" />
                                    </EditTemplate>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn Width="50" TItem="StaticPointLoad" Property="ApplicationPointDistance">
                                    <HeaderTemplate>
                                        <span class="gridColumndStyle">@L["Application Point Distance"]</span>                    <br />
                                    </HeaderTemplate>
                                    <EditTemplate Context="staticPointLoad">
                                        <RadzenNumeric @bind-Value="staticPointLoad.ApplicationPointDistance" Style="width:100%" Name="ApplicationPointDistance" />
                                        <RadzenRequiredValidator Text="Distance is required" Component="ApplicationPointDistance" Popup="true" />
                                    </EditTemplate>
                                </RadzenDataGridColumn>




                                <RadzenDataGridColumn Width="50" TItem="StaticPointLoad" Title="Action" Filterable="false" Sortable="false">
                                    <Template Context="data">
                                        <div style="display:flex">
                                            <a title="@L["Edit"]" class="nav-link" @onclick="@(args => EditStaticPointRow(data))" @onclick:preventDefault="true" href="">
                                                <span class="oi oi-pencil" aria-hidden="true"></span>
                                            </a>
                                            <a title="@L["End Edit"]" class="nav-link" @onclick="@(args => UpdateStaticPointRow(data))" @onclick:preventDefault="true" href="">
                                                <span class="oi oi-check" aria-hidden="true"></span>
                                            </a>
                                            <a title="@L["Delete"]" class="nav-link" @onclick="@(() => DeleteStaticPointLoad(data))" @onclick:preventDefault="true" href="">
                                                <span class="oi oi-trash" aria-hidden="true"></span>
                                            </a>
                                            <a title="@L["Element Assignement"]" class="nav-link" @onclick="@(() => AssignementStaticPointLoad(data))" @onclick:preventDefault="true" href="">
                                                <i class="material-icons">assignment</i>
                                            </a>
                                        </div>
                                    </Template>

                                </RadzenDataGridColumn>


                            </Columns>
                        </RadzenDataGrid>
                    </RadzenTabsItem>

 
                </Tabs>
            </RadzenTabs>
        }
    </RadzenSplitterPane>
</RadzenSplitter>


@code {
    int PageSize { get; set; } = 10;

    bool coco;


    Structure structure;

    LoadCase selectedLoadCase;
    IList<LoadCase> SelectedLoadCases { get; set; }
    List<LoadCase> loadCases;

    RadzenDataGrid<LoadCase> loadCasesGrid;

    RadzenDataGrid<StaticLoad> staticLoadsGrid;
    RadzenDataGrid<StaticPointLoad> staticPointLoadsGrid;

    protected override async Task OnInitializedAsync()
    {
        if (appData.Structure == null)
        {
            navigationManager.NavigateTo("Structures");
            return;
        }
        structure = appData.Structure;

        loadCases = await entitiesService.GetFilteredEntitiesAsync<LoadCase>(x => (x.StructureId == structure.StructureId) || (x.StructureId == null));

    }

    private void OnCheckboxChanged(bool value, LoadCase loadCase)
    {
        if (value)
        {
            // If checkbox is checked, set StructureID to a non-null value or a default value
            loadCase.StructureId = structure.StructureId;
        }
        else
        {
            // If checkbox is unchecked, set StructureID to null
            loadCase.StructureId = null;
        }
    }


    async Task DeleteLoadCase(LoadCase loadCase)
    {

        if (await entitiesService.DeleteEntityAsync(loadCase))
        {
            if (loadCases.Remove(loadCase))
            {
                await loadCasesGrid.Reload();

            }
        }
    }



    async Task AssignementStaticLoad(StaticLoad staticLoad)
    {
        var checkedElements = appData.CheckedNodeObjects.Select(x => (AliantWebS.Models.Element)x).ToList();
        var v2 = await entitiesService.GetFilteredEntitiesAsync<StaticLoadElement>(x => x.StaticLoadId == staticLoad.StaticLoadId);
        var elementsids = v2.Select(x => x.ElementId);
        foreach (Element el in checkedElements)
        {
            if (!elementsids.Contains(el.ElementId))
            {
                StaticLoadElement elc = new StaticLoadElement();
                elc.ElementId = el.ElementId;
                elc.StaticLoadId = staticLoad.StaticLoadId;
                if (await entitiesService.InsertEntityAsync(elc) == null)
                {
                    await js.InvokeVoidAsync("alert", $"Update Unsuccessfull!");
                }
            }
        }
        foreach (StaticLoadElement elid in v2)
        {
            if (!checkedElements.Select(x => x.ElementId).Contains(elid.ElementId))
            {
                await entitiesService.DeleteEntityAsync(elid);
            }
        }
        this.StateHasChanged();
        await staticLoadsGrid.SelectRow(staticLoad);


    }

   

    async Task AssignementStaticPointLoad(StaticPointLoad staticPointLoad)
    {
        var checkedElements = appData.CheckedNodeObjects.Select(x => (AliantWebS.Models.Element)x).ToList();
        var v2 = await entitiesService.GetFilteredEntitiesAsync<StaticPointLoadElement>(x => x.StaticPointLoadId == staticPointLoad.StaticPointLoadId);
        var elementsids = v2.Select(x => x.ElementId);
        foreach (Element el in checkedElements)
        {
            if (!elementsids.Contains(el.ElementId))
            {
                StaticPointLoadElement elc = new StaticPointLoadElement();
                elc.ElementId = el.ElementId;
                elc.StaticPointLoadId = staticPointLoad.StaticPointLoadId;
                if (await entitiesService.InsertEntityAsync(elc) == null)
                {
                    await js.InvokeVoidAsync("alert", $"Update Unsuccessfull!");
                }
            }
        }
        foreach (StaticPointLoadElement elid in v2)
        {
            if (!checkedElements.Select(x => x.ElementId).Contains(elid.ElementId))
            {
                await entitiesService.DeleteEntityAsync(elid);
            }
        }
        this.StateHasChanged();
        await staticPointLoadsGrid.SelectRow(staticPointLoad);


    }

    async Task DeleteStaticLoad(StaticLoad loadCase)
    {

        if (await entitiesService.DeleteEntityAsync(loadCase))
        {
            //  if (selectedLoadCase.StaticLoads.Remove(loadCase))
            //  {
            await staticLoadsGrid.Reload();
            //  StateHasChanged();

            // }
        }
    }

    async Task DeleteStaticPointLoad(StaticPointLoad loadCase)
    {

        if (await entitiesService.DeleteEntityAsync(loadCase))
        {
            //  if (selectedLoadCase.StaticLoads.Remove(loadCase))
            //  {
            await staticPointLoadsGrid.Reload();
            //  StateHasChanged();

            // }
        }
    }


    void EditRow(LoadCase loadCase)
    {

        loadCasesGrid.EditRow(loadCase);


    }

    void EditStaticRow(StaticLoad loadCase)
    {

        staticLoadsGrid.EditRow(loadCase);

    }

    void EditStaticPointRow(StaticPointLoad loadCase)
    {

        staticPointLoadsGrid.EditRow(loadCase);

    }


    async Task InsertLoadCase()
    {

        LoadCase loadCase = new LoadCase();
        loadCase.StructureId = structure.StructureId;

        if ((await entitiesService.InsertEntityAsync(loadCase)) != null)
        {
            loadCases.Add(loadCase);

            await loadCasesGrid.InsertRow(loadCase);

        }
        else
        {
            await js.InvokeVoidAsync("alert", $"Update Unsuccessfull!");
        }

    }

    async Task InsertStaticLoad()
    {
        StaticLoad staticLoad = new StaticLoad();
        staticLoad.LoadCaseId = selectedLoadCase.LoadCaseId;

        var elements = appData.CheckedNodeObjects.Select(x => (AliantWebS.Models.Element)x).ToList();        
        foreach (Element el in elements)
        {
            StaticLoadElement elc = new StaticLoadElement();
            elc.ElementId = el.ElementId;
            elc.StaticLoadId = staticLoad.StaticLoadId;         
            staticLoad.StaticLoadElements.Add(elc);  
        }


        if ((await entitiesService.InsertEntityAsync(staticLoad)) != null)
        {
            // selectedLoadCase.StaticLoads.Add(staticLoad);
            await staticLoadsGrid.InsertRow(staticLoad);
        }
        else
        {
            await js.InvokeVoidAsync("alert", $"Update Unsuccessfull!");
        }
    }

    async Task InsertStaticPointLoad()
    {
        StaticPointLoad staticPointLoad = new StaticPointLoad();
        staticPointLoad.LoadCaseId = selectedLoadCase.LoadCaseId;

        var elements = appData.CheckedNodeObjects.Select(x => (AliantWebS.Models.Element)x).ToList();
        foreach (Element el in elements)
        {
            StaticPointLoadElement elc = new StaticPointLoadElement();
            elc.ElementId = el.ElementId;
            elc.StaticPointLoadId = staticPointLoad.StaticPointLoadId;
            staticPointLoad.StaticPointLoadElements.Add(elc);
        }

        if ((await entitiesService.InsertEntityAsync(staticPointLoad)) != null)
        {
            // selectedLoadCase.StaticLoads.Add(staticLoad);
            await staticPointLoadsGrid.InsertRow(staticPointLoad);
        }
        else
        {
            await js.InvokeVoidAsync("alert", $"Update Unsuccessfull!");
        }
    }


    async Task UpdateRow(LoadCase loadCase)
    {
        if (await entitiesService.UpdateEntityAsync(loadCase))
        {
            await loadCasesGrid.UpdateRow(loadCase);
        }
    }

    async Task UpdateStaticRow(StaticLoad loadCase)
    {
        if (await entitiesService.UpdateEntityAsync(loadCase))
        {
            await staticLoadsGrid.UpdateRow(loadCase);
        }
    }

    async Task UpdateStaticPointRow(StaticPointLoad loadCase)
    {
        if (await entitiesService.UpdateEntityAsync(loadCase))
        {
            await staticPointLoadsGrid.UpdateRow(loadCase);
        }
    }

    void RowSelect(LoadCase loadCase)
    {
        selectedLoadCase = loadCase;

        if (selectedLoadCase.StaticLoads.Count == 0)
        {
            entitiesService.LoadCollection(selectedLoadCase, "StaticLoads");
        }
        if (selectedLoadCase.StaticPointLoads.Count == 0)
        {
            entitiesService.LoadCollection(selectedLoadCase, "StaticPointLoads");
        }

        appData.CheckedNodeObjects = new List<AliantWebS.Models.Element>();
        //if (selectedLoadCase.ElementLoadCases.Count == 0)
        // {
        //     entitiesService.LoadCollection(selectedLoadCase, "ElementLoadCases");
        // }

        // appData.CheckedNodeObjects = selectedLoadCase.ElementLoadCases.Select(x => x.Element);
        // StateHasChanged();

    }

    void StaticLoadRowSelect(StaticLoad staticLoad)
    {
        if (staticLoad.StaticLoadElements.Count == 0)
        {
            entitiesService.LoadCollection(staticLoad, "StaticLoadElements");
        }
        appData.CheckedNodeObjects = staticLoad.StaticLoadElements.Select(x => x.Element).Where(x => appData.Structure.Elements.Contains(x));
        StateHasChanged();
    }

    void StaticPointLoadRowSelect(StaticPointLoad staticPointLoad)
    {
        if (staticPointLoad.StaticPointLoadElements.Count == 0)
        {
            entitiesService.LoadCollection(staticPointLoad, "StaticPointLoadElements");
        }
        appData.CheckedNodeObjects = staticPointLoad.StaticPointLoadElements.Select(x => x.Element).Where(x => appData.Structure.Elements.Contains(x));
        StateHasChanged();        
    }


}
