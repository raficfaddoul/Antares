                                    <EditTemplate Context="staticLoad">
                                        <RadzenNumeric @bind-Value="staticLoad.Dof" Style="width:100%" Name="Dof" />
                                        <RadzenRequiredValidator Text="DOF is required" Component="Dof" Popup="true" />
                                    </EditTemplate>
