@page "/MotherGridComponent/{EventID:guid}"
@implements IDisposable
@using AliantWebS.Data
@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject IJSRuntime js
@inject AliantWebS.Data.AppData AppData
@using Models
@inject IStringLocalizer<Languages> L

@layout AntaresConceptionLayout
@if (MPList is null)
{
    <p><em>@L["Loading"]... !</em></p>
}
else
{
    <Div Style="display: flex; align-items: center;">
        <h3 style="margin: 0; padding: 0; line-height: 1.5;">@L[Title]</h3>
        <div style="width: 20px; height: 20px; background-color: @GetLegendColor(); margin-left: 10px;"></div>

        <a class="nav-link" @onclick="@(args => Insertmp())" @onclick:preventDefault="true" href="">
            <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
        </a>
        <a class="nav-link" @onclick="@(args => DeleteAllMP())" @onclick:preventDefault="true" href="" title="@L["Delete All"]">
            <span class="oi oi-trash" aria-hidden="true"> @L["Delete All"]</span>
        </a>

        @* ── Import Excel — must be here inside the toolbar Div ── *@
        @if (isImporting)
        {
            <span class="spinner-border spinner-border-sm text-primary ms-2" role="status"></span>
            <span class="ms-1">@L["Importing..."]</span>
        }
        else
        {
            <a class="nav-link" @onclick="TriggerMGExcelImport" @onclick:preventDefault="true" href="" title="@L["Import from Excel"]">
                <span class="oi oi-data-transfer-upload" aria-hidden="true"> @L["Import Excel"]</span>
            </a>
        }
        <InputFile id="@($"mgImport_{Title}")" OnChange="ImportMGFromExcel" accept=".xlsx" style="display:none" />

        <div style="margin-left: auto; display: flex; align-items: center; gap: 10px;">
            <Label>@L["Page Size"]: &nbsp;&nbsp;</Label>
            <RadzenNumeric @bind-Value="PageSize" Style="width:60px"></RadzenNumeric>
            <a class="nav-link" title="@L["Display Settings"]" @onclick="() => showDecimalSettings = !showDecimalSettings" @onclick:preventDefault="true" href="">
                <span class="oi oi-cog" aria-hidden="true"></span>
            </a>
            @if (showDecimalSettings)
            {
                <div style="display: flex; align-items: center; gap: 6px; background: #f0f4ff; border: 1px solid #667eea; border-radius: 8px; padding: 4px 10px;">
                    <span style="font-size: 12px; color: #4a5568;">@L["Decimals"]:</span>
                    <RadzenNumeric @bind-Value="decimalPlaces" Min="0" Max="6" Style="width:55px;" />
                </div>
            }
        </div>
    </Div>

    @* A note about the pieces: a proposal the stock could not make, or a caveat about one it made. *@
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div style="display: flex; align-items: flex-start; gap: 8px; background: #fff4e5; border: 1px solid #f0ad4e; border-radius: 6px; padding: 4px 8px; margin: 4px 0; font-size: 0.85em;">
            <span style="flex: 1;">@statusMessage</span>
            <a href="" title="@L["Close"]" @onclick="ClearStatus" @onclick:preventDefault="true">✕</a>
        </div>
    }




    <EditForm Model="@MPList">

        <RadzenDataGrid @ref="MPGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize"
                        Data="@MPList" TItem="MotherGridPalonnier"   SelectionMode="DataGridSelectionMode.Single" @bind-Value="@SelectedMPList">
            <Columns>

                <RadzenDataGridColumn Width="50" TItem="MotherGridPalonnier" Property="Name" >
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Nom"]</span>                    <br />
                    </HeaderTemplate>
                    <EditTemplate Context="mp">
                        <InputTextArea @bind-Value="mp.Name" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Width="50" TItem="MotherGridPalonnier" Property="Numero" TextAlign="TextAlign.Center">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Element Type"]</span>                    <br />
                    </HeaderTemplate>
                  <Template Context="mp">
                    @* An exception while rendering takes the whole circuit down, not the cell. A row whose type
                       cannot be read says so, in the cell, and the page stays usable to fix it. *@
                    @if (TypeOf(mp) is { } elementType)
                    {
                        @elementType.Name
                    }
                    else
                    {
                        <span style="color:#c62828;" title="@mp.ElementTypeId">type introuvable</span>
                    }
                </Template>
                <EditTemplate Context="mp">
                    <InputSelect class="form-control" @bind-Value=mp.ElementTypeId>
                        @foreach (var elementType in ElementTypesList)
                            {
                            <option value="@elementType.ElementTypeId">@elementType.Name</option>
                            }
                    </InputSelect>
                    </EditTemplate>
                </RadzenDataGridColumn>

                @* X1, Y1, X2, Y2 in the studies' axes (StudyX1..StudyY2): metres from Point0 (E5), X along the
                   beams towards point 9, Y across them towards J. The stored X1..Y2 stay in the grid's axes. *@
                <RadzenDataGridColumn Width="6em" TItem="MotherGridPalonnier" Property="StudyX1" TextAlign="TextAlign.Center" FormatString="@($"{{{0}:N{decimalPlaces}}}")">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["X1"]</span>   <br />
                    </HeaderTemplate>
                    <EditTemplate Context="mp">
                        <InputNumber @bind-Value="mp.StudyX1" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="6em" TItem="MotherGridPalonnier" Property="StudyY1" TextAlign="TextAlign.Center" FormatString="@($"{{{0}:N{decimalPlaces}}}")">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Y1"]</span>   <br />
                    </HeaderTemplate>
                    <EditTemplate Context="mp">
                        <InputNumber @bind-Value="mp.StudyY1" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>


                <RadzenDataGridColumn Width="6em" TItem="MotherGridPalonnier" Property="StudyX2" TextAlign="TextAlign.Center" FormatString="@($"{{{0}:N{decimalPlaces}}}")">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["X2"]</span>   <br />
                    </HeaderTemplate>
                    <EditTemplate Context="mp">
                        <InputNumber  @bind-Value="mp.StudyX2" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="6em" TItem="MotherGridPalonnier" Property="StudyY2" TextAlign="TextAlign.Center" FormatString="@($"{{{0}:N{decimalPlaces}}}")">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Y2"]</span>   <br />
                    </HeaderTemplate>
                    <EditTemplate Context="mp">
                        <InputNumber @bind-Value="mp.StudyY2" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                @* The pieces the truss is assembled from, all of its model: "5,6 + 2,8 m". Typed as "5,6+2,8";
                   "Proposer" asks the stock (TrussPieces). *@
                <RadzenDataGridColumn Width="13em" TItem="MotherGridPalonnier" Property="Composition" Sortable="false" Filterable="false">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Pieces"]</span>   <br />
                    </HeaderTemplate>
                    <Template Context="mp">
                        <div style="white-space: normal;">
                            <span>@TrussPieces.Display(mp)</span>
                            @if (string.IsNullOrWhiteSpace(mp.Composition))
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" style="padding: 0 6px; margin-left: 6px;"
                                        title="@L["Propose the pieces the stock can still make"]"
                                        @onclick="@(() => ProposeAsync(mp))" @onclick:stopPropagation="true">
                                    @L["Propose"]
                                </button>
                            }
                            @foreach (var warning in WarningsOf(mp))
                            {
                                <div style="color: #c0392b; font-size: 0.8em;">⚠ @warning</div>
                            }
                        </div>
                    </Template>
                    <EditTemplate Context="mp">
                        <div style="display: flex; gap: 4px; align-items: center;">
                            <input type="text" class="form-control form-control-sm" style="min-width: 6em;" placeholder="5,6+2,8"
                                   value="@PiecesTextOf(mp)" @onchange="@(args => SetPiecesText(mp, args))" />
                            <button type="button" class="btn btn-sm btn-outline-primary" style="padding: 0 6px;"
                                    title="@L["Propose the pieces the stock can still make"]"
                                    @onclick="@(() => ProposeIntoTextAsync(mp))">
                                @L["Propose"]
                            </button>
                        </div>
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="10em" TItem="MotherGridPalonnier" Property="PULMONARY_TOXICITY" Title="@L["Action"]" Filterable="false" Sortable="false">
                    <Template Context="data">
                        <Div Style="display: flex; width: fit-content; justify-content: center; align-items: center;">
                            <a title="@L["Edit"]" style="margin:0" class="nav-link" @onclick="@(args => EditRow(data))" @onclick:preventDefault="true" href="">
                                <span class="oi oi-pencil" aria-hidden="true"></span>
                            </a>
                            <a title="@L["End Edit"]" style="margin:0" class="nav-link" @onclick="@(args => UpdateRow(data))" @onclick:preventDefault="true" href="">
                                <span class="oi oi-check" aria-hidden="true"></span>
                            </a>
                            <a title="@L["Delete"]" style="margin:0" class="nav-link" @onclick="@(() => DeleteMP(data))" @onclick:preventDefault="true" href="">
                                <span class="oi oi-trash" aria-hidden="true"></span>
                            </a>
                        </Div>
                    </Template>
                </RadzenDataGridColumn>

            </Columns>
        </RadzenDataGrid>



        <InputFile id="@($"mgImport_{Title}")" OnChange="ImportMGFromExcel" accept=".xlsx" style="display:none" />

    </EditForm>


}


@code {
    int PageSize { get; set; } = 10;
    int decimalPlaces { get; set; } = 3;
    bool showDecimalSettings = false;
    bool isImporting = false;

    private IList<MotherGridPalonnier> _selectedMPList = new List<MotherGridPalonnier>();


    public IList<MotherGridPalonnier> SelectedMPList
    {
        get
        {
            // You can add logic here to filter or sort items when accessed.
            return _selectedMPList;
        }
        set
        {
            // Validate input before setting.
            if (value == null) throw new ArgumentNullException(nameof(value));
            _selectedMPList = value;
            SelectedMP = _selectedMPList.FirstOrDefault();
        }
    }

    private MotherGridPalonnier _selectedMP;

    [Parameter]
    public MotherGridPalonnier SelectedMP
    {
        get => _selectedMP;
        set
        {
            if (!Equals(_selectedMP, value))
            {
                _selectedMP = value;
                // Keep the grid's bound list in sync so re-renders don't clear the visual selection
                _selectedMPList = value != null
                    ? new List<MotherGridPalonnier> { value }
                    : new List<MotherGridPalonnier>();
                SelectedMPChanged.InvokeAsync(_selectedMP);
            }
        }
    }

    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public EventCallback<MotherGridPalonnier> SelectedMPChanged { get; set; }

    [Parameter]
    public RadzenDataGrid<MotherGridPalonnier> MPGrid { get; set; }

    [Parameter]
    public EventCallback<RadzenDataGrid<MotherGridPalonnier>> MPGridChanged { get; set; }

    [Parameter]
    public EventCallback<List<MotherGridPalonnier>> MotherGridPalonnierListChanged { get; set; }

    // A row was saved - its ends, type, name or pieces, from ✓ or from "Proposer" - so the page can check what it shows
    // against it (MotherGrid hides a charpente calculation the row no longer matches).
    [Parameter]
    public EventCallback<MotherGridPalonnier> RowSaved { get; set; }

    [Parameter]
    public List<MotherGridPalonnier> MPList{ get; set; }

    [Parameter]
    public Guid EventMpscenarioId { get; set; }

    [Parameter]
    public bool Famille { get; set; }


    [Parameter]
    public List<ElementType> ElementTypesList { get; set; }

    /// <summary>
    /// The truss inventory (MotherGrill.xlsx and Palonnier.xlsx), read once by the page. The pieces of this
    /// list's role come from its mothers or its palonniers, as <see cref="Famille"/> says. Null when it could
    /// not be read; <see cref="InventoryError"/> then says why.
    /// </summary>
    [Parameter]
    public RiggingOptimizer.IO.Inventory? Inventory { get; set; }

    [Parameter]
    public string? InventoryError { get; set; }

    public ElementType lastSelectedElementType = new ElementType();

    // What was typed in the "Pièces" box of a row being edited, until the row is saved. By the row's id: the page reads
    // its rows afresh (another scenario and back, Générer l'implantation), and every read gives new objects.
    private readonly Dictionary<Guid, string> piecesText = new();

    // Rows added with "Add New", by id: they have no ends yet, so they get the stock's proposal when first saved
    // with both ends and no pieces typed.
    private readonly HashSet<Guid> proposeOnSave = new();

    private string? statusMessage;

    private string GetLegendColor()
    {
        return Title == "MotherGrids" ? "yellow" : Title == "Palonniers" ? "green" : "transparent";
    }


