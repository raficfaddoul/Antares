    private async void zaza()
    {
        await MPGrid.Reload();
        StateHasChanged();
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await MPGridChanged.InvokeAsync(MPGrid);
        }


        await base.OnAfterRenderAsync(firstRender);
    }


    public async Task DeleteMP(MotherGridPalonnier mp)
    {
        // One DELETE through a context of its own; the database deletes the row's charges with it (cascade). A refused
        // delete is shown by the service itself; a row another tab already deleted counts as deleted.
        if (await entitiesService.DeleteOwnedAsync(mp))
        {
            if (ForgetRow(mp.MotherGridPalonnierId))
            {
                await MPGrid.Reload();
                await MotherGridPalonnierListChanged.InvokeAsync(MPList);
            }
        }

    }

    // A row deleted: off the list, with what was typed in its box and its pending proposal. True when it was listed.
    private bool ForgetRow(Guid id)
    {
        piecesText.Remove(id);
        proposeOnSave.Remove(id);
        return MPList.RemoveAll(m => m.MotherGridPalonnierId == id) > 0;
    }

    async void EditRow(MotherGridPalonnier mp)
    {
        piecesText.Remove(mp.MotherGridPalonnierId);   // the box starts from what is stored
        await MPGrid.EditRow(mp);
        await MotherGridPalonnierListChanged.InvokeAsync(MPList);

    }

    async Task Insertmp()
    {

        if (EventMpscenarioId == Guid.Empty)
        {
            await js.InvokeVoidAsync("alert", $"{L["No scenario selected. Please select a scenario before adding an element."]}");
            return;
        }
        if (ElementTypesList is null || ElementTypesList.Count == 0)
        {
            await js.InvokeVoidAsync("alert", $"{L["No element types available. Please define element types for the MotherGridPalonnier category first."]}");
            return;
        }

        MotherGridPalonnier mp = new MotherGridPalonnier();
        mp.EventMpscenarioId = EventMpscenarioId;
        mp.Famille = Famille;

        if ((lastSelectedElementType == null) || (lastSelectedElementType.ElementTypeId == Guid.Empty))
        {
            lastSelectedElementType = ElementTypesList.FirstOrDefault();
        }

        if (lastSelectedElementType == null) return;

        // Its type's id only, no navigation: InsertOwnedAsync adds what the new row points to.
        mp.ElementTypeId = lastSelectedElementType.ElementTypeId;
        Guid scenarioId = mp.EventMpscenarioId;

        // A refused insert is shown by the service itself. Into the list only if it still shows that scenario (Back, or
        // the dropdown, may have moved the page meanwhile): the row would sit in another scenario's list.
        if (await entitiesService.InsertOwnedAsync(mp) && EventMpscenarioId == scenarioId)
        {
            MPList.Add(mp);
            proposeOnSave.Add(mp.MotherGridPalonnierId);
            await MPGrid.InsertRow(mp);
        }
    }

    // public async Task Insertmp(double x1, double y1, double x2, double y2)
    // {
    //     MotherGridPalonnier mp = new MotherGridPalonnier();
    //     mp.EventMpscenarioId = EventMpscenarioId;
    //     mp.Famille = Famille;
    //     mp.ElementTypeId = lastSelectedElementType.ElementTypeId;


    //     mp.X1 = x1;         mp.Y1 = y1;

    //     mp.X2 = x2;         mp.Y2 = y2;

    //     if ((await entitiesService.InsertEntityAsync(mp)) != null)
    //     {
    //         MPList.Add(mp);

    //         await MPGrid.InsertRow(mp);
    //         await MPGrid.UpdateRow(mp);
    //     }
    //     else
    //     {
    //         await js.InvokeVoidAsync("alert", $"Update Unsuccessfull!");
    //     }
    // }



    async Task UpdateRow(MotherGridPalonnier mp)
    {
        try
        {
            await SaveRowAsync(mp);
        }
        catch (Exception ex)
        {
            // The database refused the row, or it no longer exists (deleted from another tab). Unhandled here it ends the
            // circuit; the row stays in edit with what was typed.
            await js.InvokeVoidAsync("alert", EntitiesService.NotSavedMessage(ex));
        }
    }

    // Saves a row through a context of its own (UpdateOwnedAsync: only the columns that changed). The pieces typed in its
    // box are read first; text that cannot be read is refused and the row stays in edit. A row added with "Add New" that
    // now has both ends, and no pieces typed, gets the stock's proposal. True once saved; throws when the database refuses
    // the row or it no longer exists - the callers say why, each in its own words.
    private async Task<bool> SaveRowAsync(MotherGridPalonnier mp)
    {
        var id = mp.MotherGridPalonnierId;
        bool typedPieces = piecesText.TryGetValue(id, out var typed);
        if (typedPieces)
        {
            var (composition, problem) = TrussPieces.FromText(typed);
            if (problem is not null)
            {
                await js.InvokeVoidAsync("alert", problem);
                return false;
            }
            mp.Composition = composition;
        }

        if (!typedPieces && proposeOnSave.Contains(id)
            && string.IsNullOrWhiteSpace(mp.Composition) && TrussPieces.DrawnLengthM(mp) is not null)
        {
            proposeOnSave.Remove(id);
            var proposal = ProposeFor(mp);
            mp.Composition = proposal.Composition;
            statusMessage = proposal.Composition is null
                ? $"« {mp.Name ?? ModelOf(mp) ?? "Élément"} » : aucune pièce proposée. {proposal.Message}"
                : proposal.Message;
        }

        if (await entitiesService.UpdateOwnedAsync(mp))
        {
            piecesText.Remove(id);
            await MPGrid.UpdateRow(mp);
            lastSelectedElementType = TypeOf(mp);
            await RowSaved.InvokeAsync(mp);
            return true;
        }
        return false;
    }

    public async Task DeleteAllMP()
    {
        // The rows on screen when asked, not whatever list the component holds once the dialog is answered: the layout
        // follows the address and can switch the page to another scenario meanwhile.
        var toDelete = MPList.ToList();
        bool confirmed = await js.InvokeAsync<bool>("confirm", L["Are you sure you want to delete all items?"].ToString());
        if (!confirmed) return;

        foreach (var item in toDelete)
        {
            // Off the list only once deleted (a row another tab already deleted counts as deleted): a refused delete
            // leaves the row where it is. Stopped at the first refusal, which the service has already shown - one
            // alert, not one per row.
            if (!await entitiesService.DeleteOwnedAsync(item)) break;
            ForgetRow(item.MotherGridPalonnierId);
        }

        await MPGrid.Reload();
        await MotherGridPalonnierListChanged.InvokeAsync(MPList);
    }

    void IDisposable.Dispose()
    {
        //AppData.ScenarioChanged -= zaza;
    }

    public void SelectItem(MotherGridPalonnier item)
    {
        _selectedMPList = item != null
            ? new List<MotherGridPalonnier> { item }
            : new List<MotherGridPalonnier>();
        MPGrid?.SelectRow(item);
        InvokeAsync(StateHasChanged);
    }

    // ── Pieces ───────────────────────────────────────────────────────────────────────────────────

    // The row's element type: the category's type with its id - the edit's select changes the id only, and a row saved
    // through a context of its own keeps the navigation it was read with - else the type the row was read with, for a
    // type outside the category. Null when neither has its id: the cell then says « type introuvable », never a wrong name.
    private ElementType? TypeOf(MotherGridPalonnier e) =>
        ElementTypesList?.FirstOrDefault(t => t.ElementTypeId == e.ElementTypeId)
        ?? (e.ElementType?.ElementTypeId == e.ElementTypeId ? e.ElementType : null);

    // The element's model: its element type, named as the inventory's "Modèle" (Generate Layout creates the
    // types from those names).
    private string? ModelOf(MotherGridPalonnier e) => TypeOf(e)?.Name;

    private List<string> WarningsOf(MotherGridPalonnier e) =>
        TrussPieces.Warnings(e, ModelOf, MPList ?? new List<MotherGridPalonnier>(), Inventory, Famille);

    private string PiecesTextOf(MotherGridPalonnier e) =>
        piecesText.TryGetValue(e.MotherGridPalonnierId, out var typed) ? typed : TrussPieces.EditText(e);

    private void SetPiecesText(MotherGridPalonnier e, ChangeEventArgs args) =>
        piecesText[e.MotherGridPalonnierId] = args.Value?.ToString() ?? "";

    private void ClearStatus() => statusMessage = null;

    /// <summary>
    /// The pieces the stock can still make for an element of this list's role, counting what the list's other
    /// elements of its model use. Also for a line drawn on the plan, before it is added.
    /// </summary>
    public TrussPieces.Proposal ProposeFor(MotherGridPalonnier e) =>
        TrussPieces.Propose(e, ModelOf, MPList ?? new List<MotherGridPalonnier>(), Inventory, InventoryError, Famille);

    /// <summary>Shows a note above the grid; null clears it.</summary>
    public void ShowStatus(string? message)
    {
        statusMessage = message;
        InvokeAsync(StateHasChanged);
    }

    // "Proposer" on a row that is not being edited: the proposal is saved at once, through the row's save.
    private async Task ProposeAsync(MotherGridPalonnier mp)
    {
        var proposal = ProposeFor(mp);
        if (proposal.Composition is null)
        {
            await js.InvokeVoidAsync("alert",
                $"Aucune pièce proposée pour « {mp.Name ?? ModelOf(mp) ?? "l’élément"} ». {proposal.Message}");
            return;
        }

        var previous = mp.Composition;
        mp.Composition = proposal.Composition;
        string? failure;
        try
        {
            failure = await SaveRowAsync(mp) ? null : "Les pièces proposées n’ont pas pu être enregistrées.";
        }
        catch (Exception ex)
        {
            // Refused by the database, or the row deleted from another tab: one alert with the reason (the row is not in
            // edit, so not « La ligne reste en édition »).
            failure = $"Les pièces proposées n’ont pas pu être enregistrées : {ex.GetBaseException().Message}";
        }
        if (failure is not null)
        {
            mp.Composition = previous;   // its pieces as they were
            await js.InvokeVoidAsync("alert", failure);
            return;
        }
        statusMessage = proposal.Message;
    }

    // "Proposer" on a row being edited: the proposal goes in the box, saved with the row.
    private async Task ProposeIntoTextAsync(MotherGridPalonnier mp)
    {
        var proposal = ProposeFor(mp);
        if (proposal.Composition is null)
        {
            await js.InvokeVoidAsync("alert", $"Aucune pièce proposée. {proposal.Message}");
            return;
        }

        var lengths = global::Helpers.TrussComposition.Parse(proposal.Composition, out _) ?? new List<double>();
        piecesText[mp.MotherGridPalonnierId] = string.Join("+", lengths.OrderByDescending(l => l).Select(TrussPieces.Metres));
        statusMessage = proposal.Message;
    }

    async Task TriggerMGExcelImport()
    {
        // As "Add New": with no scenario the rows would be saved against no scenario and the database
        // would refuse them with an error that says nothing useful.
        if (EventMpscenarioId == Guid.Empty)
        {
            await js.InvokeVoidAsync("alert", $"{L["No scenario selected. Please select a scenario before adding an element."]}");
            return;
        }
        await js.InvokeVoidAsync("eval", $"document.getElementById('mgImport_{Title}').click()");
    }

    async Task ImportMGFromExcel(InputFileChangeEventArgs e)
    {
        Guid scenarioId = EventMpscenarioId;
        isImporting = true;
        StateHasChanged();
        try
        {
            using var mem = new System.IO.MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(mem);
            mem.Position = 0;

            // ── Directly reuse Pipeline's function ───────────────────
            // Rows with ids only, no navigation (InsertOwnedRangeAsync adds what they point to); the type cell finds
            // their type by its id (TypeOf).
            var toInsert = await RiggingOptimizer.Pipeline.ImportMotherGridPalonniersFromStream(
                mem,
                scenarioId,
                Famille,
                ElementTypesList,
                MPList.Select(x => x.Name),
                out var warnings);

            // ── Show what the reader noticed, and the rows left out ───
            // This list no longer holds unknown-type rows alone: the reader now also says what it made of
            // the file — a first line taken as a header, or columns read in order for want of one. Naming
            // the ElementType as the cause of all of it would send people hunting for the wrong mistake.
            if (warnings.Any())
            {
                string msg = string.Join("\n", warnings);
                await js.InvokeVoidAsync("alert",
                    $"⚠️ Lecture du fichier :\n\n{msg}\n\nAvailable types:\n{string.Join(", ", ElementTypesList.Select(x => x.Name))}");
            }

            if (toInsert.Count == 0)
            {
                await js.InvokeVoidAsync("alert", "Nothing imported — all items exist or all rows were skipped.");
                return;
            }

            if (await entitiesService.InsertOwnedRangeAsync(toInsert))
            {
                // Into the list only if it still shows that scenario.
                if (EventMpscenarioId == scenarioId)
                {
                    MPList.AddRange(toInsert);
                    await MPGrid.Reload();
                    await MotherGridPalonnierListChanged.InvokeAsync(MPList);
                }
                await js.InvokeVoidAsync("alert", $"{toInsert.Count} item(s) imported successfully.");
            }
            else
            {
                await js.InvokeVoidAsync("alert", "Import failed.");
            }
        }
        catch (Exception ex)
        {
            // The database's own reason, not EF's "see the inner exception".
            await js.InvokeVoidAsync("alert", $"Error: {ex.GetBaseException().Message}");
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }
}

