@inherits LayoutComponentBase

@using AliantWebS.Data
@using Models
@using Microsoft.EntityFrameworkCore
@using RiggingOptimizer
@inject AppData appData;
@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject DialogService dialogService
@inject ScenarioStorageService scenarioStorage
@inject IJSRuntime js
@implements IDisposable

@layout MainLayout

<div class="main-container">

    @if (isGenerating)
    {
        <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 9999;
            display: flex; flex-direction: column; align-items: center; justify-content: center;">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate"
                                       Size="ProgressBarCircularSize.Large" />
            <span style="color: white; margin-top: 1rem; font-size: 1.1rem;">Generating layout...</span>
        </div>
    }

    <header>
        <div class="top-row px-4 auth" style="display: flex; align-items: center; position: sticky; top: 0; background-color: #fff; z-index: 1000;">
            <!-- Breadcrumbs. Relative, no leading slash: resolved against the base href, they stay inside the application
                 when it is served under a sub-path (/Aliant1), where "/MotherGrid/..." left it for a full reload. -->
            <div style="flex-grow: 1;">
                <Breadcrumb Mode="BreadcrumbMode.Auto">
                    <BreadcrumbItem Active>
                        <BreadcrumbLink To="@($"ChargesSceniques/{selectedScenario?.EventMpscenarioId ?? Guid.Empty}")">Charges Scéniques</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbItem>
                        <BreadcrumbLink To="@($"MotherGrid/{selectedScenario?.EventMpscenarioId ?? Guid.Empty}")">Mother Grid</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbItem>
                        <BreadcrumbLink To="@($"Charpente/{selectedScenario?.EventMpscenarioId ?? Guid.Empty}")">Charpente</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbItem>
                        <BreadcrumbLink To="@($"Model3D/{selectedScenario?.EventMpscenarioId ?? Guid.Empty}")">Modèle 3D</BreadcrumbLink>
                    </BreadcrumbItem>
                </Breadcrumb>
            </div>

            <RadzenButton Icon="grid_on" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
                          Click="GenerateLayout" title="Generate MotherGrid/Palonnier Layout"
                          Disabled="@isGenerating"
                          style="margin-right: 0.25rem;" />
            <RadzenButton Icon="description" ButtonStyle="ButtonStyle.Info" Variant="Variant.Text"
                          Click="OpenReportDialog" title="Éditer l'étude d'implantation (Word)"
                          style="margin-right: 0.25rem;" />
            <RadzenButton Icon="folder_open" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text"
                          Click="OpenFileManager" title="Gérer les fichiers du scénario (entrées et résultats)"
                          style="margin-right: 1rem;" />

            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="Radzen.JustifyContent.Center" Gap="0.5rem">
                <RadzenLabel id="DropDownEditLabel" Text="Scénario" Component="DropDownEdit" />
                <RadzenDropDown @ref=rdzd Change="ScenarioChanged" @bind-Value=@selectedScenario Placeholder="Select a scenario" Data=@Scenarios TextProperty="Name" Style="width: 100%; max-width: 400px;" Name="DropDownEdit" />
                <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text"
                              Click="addScenario" title="Ajouter un scénario" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                              Click="DeleteScenario" title="Suprimer le scénario" />
            </RadzenStack>
        </div>
    </header>

    <main>
        <CascadingValue Value="this">
            @* Only once the layout knows the scenario the address names (FollowAddressAsync): no page ever runs against
               the first scenario of an event it does not show. *@
            @if (ready)
            {
                @Body
            }
        </CascadingValue>
    </main>
</div>

@code {
    RadzenDropDown<EventMpscenario> rdzd;

    private List<EventMpscenario> Scenarios = new List<EventMpscenario>();
    public EventMpscenario selectedScenario { get; set; }
    public Event selectedEvent { get; set; }

    /// <summary>The scenarios of the event shown, as the dropdown lists them.</summary>
    public IReadOnlyList<EventMpscenario> ScenarioList => Scenarios;

    private bool isGenerating = false;

    // The pages are drawn once the layout has followed the address a first time (see the markup).
    private bool ready;
    private bool disposed;

    // Leaving Mother Grid - which stores its loads - is no longer detected here: the page's own NavigationLock does it
    // (ChargeMPComponent), for as long as it is shown. This layout guessed from the address, which a download link left
    // on the file's address: a later departure then calculated nothing, and the download itself did.

    protected override async Task OnInitializedAsync()
    {
        if (appData.EventID == Guid.Empty)
        {
            navigationManager.NavigateTo("AntaresHome");
        }

        (Scenarios, selectedEvent) = await ReadEventAsync(appData.EventID);
        selectedScenario = Scenarios.FirstOrDefault();

        // Resolving a scenario's folders also corrects the name of a folder whose event or scenario was
        // renamed since it was created, and adopts folders left behind by the old naming scheme.
        EnsureScenarioFolders();

        await FollowAddressAsync();
        ready = true;

        // Not for a layout already gone (a quick Back during its first lookups): Dispose ran before there was anything
        // to remove, and the circuit would keep it.
        if (!disposed)
            navigationManager.LocationChanged += OnLocationChanged;
    }

    // Every navigation within this layout comes through here, before the page is given its new parameters in the same
    // pass: for a scenario of the event shown, the page sees the scenario of its own address at once. For another event's
    // (a jump back in the history past a change of event) the lookup waits on the database: the page runs one pass
    // against the event shown before, and is given its parameters again once the layout has switched.
    protected override Task OnParametersSetAsync() => ready ? FollowAddressAsync() : Task.CompletedTask;

    // Every completed navigation, even to the very same address - Back onto a duplicate entry (Générer l'implantation
    // adds one) while a dropdown choice waited for its own navigation, which that Back then cancelled: the dropdown shows
    // the page's scenario again. Runs after the router has drawn the page. A redraw from elsewhere is no navigation, so a
    // choice still waiting keeps its place.
    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                var shown = (selectedScenario, selectedEvent);
                followedAddress = null;
                await FollowAddressAsync();
                if (!disposed && (!ReferenceEquals(shown.selectedScenario, selectedScenario) || !ReferenceEquals(shown.selectedEvent, selectedEvent)))
                    StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Layout : adresse {navigationManager.Uri} non suivie : {ex.Message}");
            }
        });
    }

    public void Dispose()
    {
        disposed = true;
        navigationManager.LocationChanged -= OnLocationChanged;
    }

    // The address last followed. The layout follows it again only when it changes: a redraw from elsewhere (the main
    // layout, a save) while a dropdown choice waits for its navigation - held by the leave calculation - must not put the
    // dropdown back.
    private string followedAddress;
    private bool following;

    // Ids of an address that name nothing - a scenario deleted since: looked up once.
    private readonly HashSet<Guid> namesNothing = new();

    // The dropdown shows the scenario of the page's address - after Back, after Back past a change of event, whatever
    // the dropdown said before. Generate, Delete, the file manager, the report and the breadcrumbs act on what it shows,
    // so they act on the scenario on screen. The event followed is this layout's alone: appData.EventID stays the one
    // chosen on the Events page (the monitoring pages use it), and a later Charges Scéniques opened with that event's id
    // shows that event again.
    private async Task FollowAddressAsync()
    {
        if (following) return;   // the one running goes round again until the address stops changing
        following = true;
        try
        {
            while (!disposed && navigationManager.Uri != followedAddress)
            {
                string address = navigationManager.Uri;
                followedAddress = address;
                if (!ConceptionRoute.TryParse(navigationManager, address, out _, out var id)) continue;

                // No scenario (after a delete): keep what is shown - the page shows nothing to act on.
                if (id == Guid.Empty || id == selectedScenario?.EventMpscenarioId) continue;

                // A scenario of the event shown: at once, with no await, so the pages drawn in this pass see it.
                var listed = Scenarios.FirstOrDefault(s => s.EventMpscenarioId == id);
                if (listed != null)
                {
                    selectedScenario = listed;
                    continue;
                }

                // The event shown, by its own id (Charges Scéniques from the Events page), or an id already known to name
                // nothing: keep what is shown.
                if (id == selectedEvent?.EventId || namesNothing.Contains(id)) continue;

                // Another event's scenario (Back past a change of event), or another event's id.
                (Guid EventId, Guid? ScenarioId)? named = null;
                List<EventMpscenario> scenarios = null;
                Event ev = null;
                try
                {
                    named = await ConceptionScenario.LookUpAsync(entitiesService, id);
                    if (named is { } n)
                    {
                        (scenarios, ev) = await ReadEventAsync(n.EventId);
                    }
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Scénario de l'adresse {address} introuvable : {ex.Message}");
                    // Moved on meanwhile: follow the newer address, which the navigation that brought it left to this loop.
                    if (!disposed && navigationManager.Uri != address) continue;
                    // Otherwise tried again the next time the layout is given its parameters; nothing is changed meanwhile.
                    followedAddress = null;
                    break;
                }

                if (disposed || navigationManager.Uri != address) continue;   // moved on meanwhile: follow the newer one
                if (named is null || ev is null)
                {
                    namesNothing.Add(id);
                    continue;
                }

                // In one step, with no await: never half of one event and half of another.
                Scenarios = scenarios;
                selectedEvent = ev;
                selectedScenario = named.Value.ScenarioId is { } scenarioId
                    ? scenarios.FirstOrDefault(s => s.EventMpscenarioId == scenarioId)
                    : scenarios.FirstOrDefault();
                EnsureScenarioFolders();
            }
        }
        finally
        {
            following = false;
        }
    }

    private void EnsureScenarioFolders()
    {
        if (selectedEvent is null) return;

        foreach (var scenario in Scenarios)
        {
            try
            {
                scenarioStorage.GetScenarioPaths(selectedEvent, scenario);
            }
            catch (Exception ex)
            {
                // A locked or unwritable folder must not stop the page from loading; the file manager
                // and Generate Layout each report the problem where it actually matters.
                Console.Error.WriteLine(
                    $"ScenariosData: dossier du scénario '{scenario.Name}' indisponible: {ex.Message}");
            }
        }
    }

    /// <summary>
    /// The event and its scenarios, read through a context of its own and not tracked: what this layout shows is a
    /// picture taken now, not rows living in the circuit's shared context. Nothing of a deleted scenario can be left
    /// behind there, and the filter runs in the database - GetFilteredEntitiesAsync takes a C# function, so it read
    /// every scenario row of every event and filtered them in memory.
    /// </summary>
    private async Task<(List<EventMpscenario> Scenarios, Event Event)> ReadEventAsync(Guid eventId)
    {
        await using var db = entitiesService.CreateOwnedContext();
        return (await db.EventMpscenarios.AsNoTracking()
                        .Where(s => s.EventId == eventId).ToListAsync(),
                await db.Events.AsNoTracking()
                        .FirstOrDefaultAsync(e => e.EventId == eventId));
    }

    public async void RequestRedraw()
    {
        // The event shown is left as it is: only its list is read again (the layout follows the address, so the event shown
        // is not necessarily appData.EventID).
        (Scenarios, _) = await ReadEventAsync(selectedEvent?.EventId ?? appData.EventID);
        selectedScenario = Scenarios.FirstOrDefault();
    }

    private async Task GenerateLayout()
    {
        if (selectedEvent is null || selectedScenario is null)
        {
            await js.InvokeVoidAsync("alert", "Sélectionnez un scénario avant de générer l'implantation.");
            return;
        }

        // One at a time. The generation no longer holds this circuit's thread (below), so the page stays live
        // while it runs - and a second click would start a second run replacing the same rows in parallel.
        if (isGenerating) return;

        isGenerating = true;
        StateHasChanged();
        try
        {
            var paths = scenarioStorage.GetScenarioPaths(selectedEvent, selectedScenario);

            // Read before leaving the circuit: what the user selects while the run is going must not change
            // which scenario it writes.
            var scenarioId = selectedScenario.EventMpscenarioId;
            var commonDataDir = scenarioStorage.CommonDataDir;

            // OFF THIS CIRCUIT'S THREAD - the fix for the freeze on a second generation, captured on the
            // database on 2026-09-12 rather than reasoned out:
            //
            //   session 59 = this pipeline: an open user transaction, the DELETE of the old layout sent, then
            //                SLEEPING - no further statement, no COMMIT;
            //   session 62 = MotherGrid.OnParametersSetAsync's SELECT on MotherGridPalonnier, waiting on
            //                session 59's lock (LCK_M_S), until the 30 s command timeout killed the circuit.
            //
            // The StateHasChanged above queues a render of the page. Awaited here, the pipeline would hand this
            // thread back at its first await inside the transaction; the render would then run MotherGrid's
            // reload, whose queries are SYNCHRONOUS (EntitiesService: ToList() behind an async signature), and
            // block the thread on the lock the transaction holds. The transaction cannot commit either: the rest
            // of the pipeline is queued to resume on that very thread. Neither side can move.
            //
            // It appeared when the pipeline was given a context of its own (EntitiesService.CreateOwnedContext):
            // on the page's shared connection its locks could never block the page's own reads. And it needs old
            // rows to delete, which is why the FIRST generation of a scenario went through.
            //
            // Nothing in the pipeline is bound to the circuit - no shared context, no JS, no component; its
            // database access is its own context and AppSettings' factory - so on the thread pool it commits
            // whatever the page is doing, and the page's read simply waits the few milliseconds until it has.
            // The optimiser, the PNG and the workbook stop freezing the page while they run, too.
            await Task.Run(() => Pipeline.GenerateLayout(
                paths.DataDir, paths.OutputDir, entitiesService, scenarioId, commonDataDir));

            // Back on the circuit - the await above resumes here - for the navigation and the page.
            await ScenarioChanged();
        }
        catch (Exception ex)
        {
            // This used to fail silently: the pipeline swallowed the exception, the spinner stopped and
            // nothing appeared in the output folder, which is indistinguishable from a run that worked.
            await js.InvokeVoidAsync("alert", $"Génération impossible : {ex.Message}");
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task addScenario()
    {
        EventMpscenario emp = new EventMpscenario();
        // The event shown, which follows the address: not necessarily the one last chosen on the Events page.
        emp.EventId = selectedEvent?.EventId ?? appData.EventID;

        var res = await dialogService.OpenAsync<LoadPages.ScenarioNameDialog>($"Scenario",
               new Dictionary<string, object>() { { "emp", emp } },
               new DialogOptions() { Resizable = true, Draggable = true, Width = "400px", Height = "180px" });

        if (res == true)
        {
            if (await entitiesService.InsertOwnedAsync(emp))
            {
                scenarioStorage.GetScenarioPaths(selectedEvent, emp);
                Scenarios.Add(emp);
                selectedScenario = emp;
            }
            await ScenarioChanged();
        }
    }

    private async Task DeleteScenario()
    {
        // The scenario the confirmation names, captured before it: the layout follows the address, and a lookup finishing
        // while the dialog is open can change the selection - what is deleted is what was confirmed, or nothing. Matched by
        // its id, not as an object: the list is read fresh (ReadEventAsync), so following an address can bring the same
        // row back as a new object.
        var scenario = selectedScenario;
        if (scenario is null) return;

        var confirmed = await js.InvokeAsync<bool>("confirm",
            $"Supprimer le scénario « {scenario.Name} » ?\n"
            + "Ses charges scéniques, ses mother grids et palonniers, leurs charges et sa charpente sont supprimés avec lui.\n"
            + "Ses fichiers seront déplacés dans la corbeille, pas effacés.");
        if (!confirmed || selectedScenario?.EventMpscenarioId != scenario.EventMpscenarioId) return;

        // Captured before the delete: the entity is what tells us which folder to move. The event's name with its id - the
        // layout may follow the address to another event while the delete runs.
        var eventId = selectedEvent?.EventId ?? appData.EventID;
        var eventName = selectedEvent?.Name;
        var scenarioId = scenario.EventMpscenarioId;

        // Through a context of its own, children first, in one transaction (EntitiesService.DeleteScenarioAsync): the
        // database refused the scenario alone as soon as it had charges scéniques, and the refused delete then stayed
        // queued in the circuit's context for every later save. The folder goes to the trash only once the rows are gone,
        // so a refused delete cannot strand it there.
        bool hadFolder = false;
        string moved = null;
        var deleted = await entitiesService.DeleteScenarioAsync(scenario, afterDelete: () =>
        {
            // Right after the commit, before anything else can run: off the list, so that no page resolves the deleted
            // scenario from it in the meantime (a departure calculation would try to create its Charpente row).
            Scenarios.RemoveAll(s => s.EventMpscenarioId == scenarioId);
            hadFolder = scenarioStorage.HasScenarioFolder(eventId, scenarioId, eventName, scenario.Name);
            moved = hadFolder ? scenarioStorage.TrashScenarioFolder(eventId, scenarioId, eventName) : null;
            return !hadFolder ? "aucun dossier" : moved is null ? "dossier non déplacé" : $"dossier déplacé dans {moved}";
        });
        if (deleted is null) return;

        // Then the page, for no scenario - unless the layout has already followed the address elsewhere meanwhile.
        if (selectedScenario?.EventMpscenarioId == scenarioId)
        {
            selectedScenario = null;
            StateHasChanged();
            await ScenarioChanged();
        }
        else
        {
            StateHasChanged();
        }

        if (hadFolder && moved is null)
            await js.InvokeVoidAsync("alert",
                $"Le scénario « {scenario.Name} » est supprimé, mais son dossier n'a pas pu être déplacé dans la corbeille : "
                + "ses fichiers sont restés en place.");
    }

    // The same page, for the scenario the dropdown now shows. The page is read from the address as its route names it
    // (four Contains tests used to match "MotherGrid" inside MotherGridComponent, and nothing at all once a download link
    // had left the address on the file). A layout already gone - Back pressed while « Générer l'implantation » ran -
    // navigates nowhere.
    private Task ScenarioChanged()
    {
        if (!disposed && ConceptionRoute.TryParse(navigationManager, navigationManager.Uri, out var page, out _))
            navigationManager.NavigateTo($"{page}/{selectedScenario?.EventMpscenarioId ?? Guid.Empty}");
        return Task.CompletedTask;
    }

    private async Task OpenReportDialog()
    {
        if (selectedEvent is null || selectedScenario is null)
        {
            await js.InvokeVoidAsync("alert", "Sélectionnez un scénario avant d'éditer le rapport.");
            return;
        }

        await dialogService.OpenAsync<LoadPages.ReportDialog>(
            $"Étude d'implantation – {selectedEvent.Name}",
            new Dictionary<string, object>
            {
                { "Event", selectedEvent },
                { "Scenario", selectedScenario }
            },
            new DialogOptions { Resizable = true, Draggable = true, Width = "720px", Height = "560px" });
    }

    private async Task OpenFileManager()
    {
        if (selectedEvent == null || selectedScenario == null) return;

        // Make sure the folders exist (and are correctly named) before the dialog looks them up by id.
        scenarioStorage.GetScenarioPaths(selectedEvent, selectedScenario);

        await dialogService.OpenAsync<LoadPages.ScenariosDataFileManager>(
            $"Fichiers – {selectedEvent.Name} / {selectedScenario.Name}",
            new Dictionary<string, object>
            {
                { "EventId",    selectedEvent.EventId },
                { "ScenarioId", selectedScenario.EventMpscenarioId }
            },
            new DialogOptions { Resizable = true, Draggable = true, Width = "760px", Height = "560px" });
    }
}