@page "/Structures"
@page "/Structures/{SiteID:guid}"
@using AliantWebS.Data
@inject EntitiesService entitiesService
@using Models
@using System.Data;
@*@inject FileManagementService fileManagementService*@
@inject NavigationManager navigationManager
@inject AppData appData;
@inject IJSRuntime js
@inject IStringLocalizer<Languages> L

    <style>

    #threejsCanvas {
    width: 100%;
    height: 100vh;
    display: block;
}
</style>

<Div Style="display: flex">
    <h3>@L["Structure Info"]</h3>
    <div style="margin-left: auto; ">
        <Label> Page Size: &nbsp;&nbsp;</Label>
        <RadzenNumeric @bind-Value="PageSize" Style="width:60px"></RadzenNumeric>
    </div>
</Div>
@if (structuresList is null)
{
    <p><em>@L["Loading"]... !</em></p>
}
else
{

    

    <NavLink class="nav-link" href="@AddStructureAddress">
        <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
    </NavLink>
    <RadzenSplitter Orientation="Radzen.Orientation.Vertical" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
        <RadzenSplitterPane Size="auto">


            <RadzenDataGrid class="RadzenDataGrid" @ref="structuresGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize" RowSelect=@RowSelect
                        Data="@structuresList" TItem="Structure" ColumnWidth="150px">
                <Columns>
@*                    <RadzenDataGridColumn TItem="Structure" Property="StructureId" Title="Structure Id"></RadzenDataGridColumn>*@
                    <RadzenDataGridColumn TItem="Structure" Property="Name" Title="@L["Name"]"></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Structure" Property="ShortDescription" Title="@L["Short Description"]"></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Structure" Property="YearBuilt" Title="@L["Year Built"]"></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Structure" Title="@L["Site"]" Type="typeof(string)" FilterProperty="Site.Name" Property="Site.Name">
                        <Template Context="context" >
                            @context.Site?.Name
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Structure" Property="Length" Title="@L["Action"]" Filterable = "false" Sortable="false" Width="200px">
                        <Template Context="data">
                            <Div Style="display: flex">
                                <a title="@L["Edit"]" class="nav-link" href="EditStructure/@data.StructureId">
                                    <span class="oi oi-pencil" aria-hidden="true"></span>
                                </a>
                                <a title="@L["Delete"]" class="nav-link" @onclick="@(() => DeleteStructure(data))" @onclick:preventDefault="true" href="">
                                    <span class="oi oi-trash" aria-hidden="true"></span>
                                </a>
                                <a title="@L["Reporting"]" class="nav-link" @onclick="@(args => Report(data))" @onclick:preventDefault="true" href="">
                                    <span class="oi oi-document" aria-hidden="true"></span>
                                </a>
                                <a title="@L["Identification"]" class="nav-link" @onclick="@(args => Identification(data))" @onclick:preventDefault="true" href="">
                                    <span class="oi oi-dashboard" aria-hidden="true"></span>
                                </a>
                                <a title="@L["Dashboard"]" class="nav-link" @onclick="@(args => Dashboard(data))" @onclick:preventDefault="true" href="">
                                    <RadzenIcon Icon="dashboard"></RadzenIcon>
                                </a>



                            </Div>
                        </Template>

                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>

        </RadzenSplitterPane>
        <RadzenSplitterPane>
            @if ((selectedStructure != null) && (updating == false) && (structuresList.Count !=0))
            {
                <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" Style="height: auto; border: 1px solid rgba(0,0,0,.08);">
                    <RadzenSplitterPane>
                        <AttributesComponent Titem1="AttributeStructure" Titem2="Structure" Titem3="StructureTypeAttributeType" CallerIdName="StructureId"
                                     CallerTypeIdName="StructureTypeId" CallerTypeName="Structure" JunctionPropName="AttributeStructures"
                                     element="selectedStructure"></AttributesComponent>
                    </RadzenSplitterPane>
                    <RadzenSplitterPane Style="height:auto">

                        <div>
                            <MediaComponent selectedObject="selectedStructure"></MediaComponent>
                        </div>

                    </RadzenSplitterPane>
                </RadzenSplitter>
            }


        </RadzenSplitterPane>

    </RadzenSplitter>




}


@code {



    RadzenDataGrid<Structure> structuresGrid;

    [Parameter]
    public Guid SiteID { get; set; }

    List<Structure> structuresList;

    Structure selectedStructure;

    int PageSize { get; set; } = 10;

    string AddStructureAddress = "AddStructure";

    bool updating = false;



    protected override async Task OnInitializedAsync()
    {
        appData.Structure = null;
        await Task.WhenAll(entitiesService.tasksList);

        if (SiteID == Guid.Empty)
        {
            structuresList = await entitiesService.GetAllEntitiesAsync<Structure>("Site");
        }
        else
        {
            structuresList = await entitiesService.GetFilteredEntitiesAsync<Structure>(a => a.SiteId == SiteID,"Site");
            AddStructureAddress = "AddStructure/" + SiteID;
        }




    }






    void RowSelect(Structure structure)
    {
        //   navigationManager.NavigateTo(@"/defects");
        selectedStructure = structure;
        //   StateHasChanged();
    }

    async Task DeleteStructure(Structure site)
    {
        var isConfirmed = await js.InvokeAsync<bool>("confirm", $"Are you sure you want to delete this structure?");
        updating = true;
        if (isConfirmed)
        {
            selectedStructure = null;

            if (await entitiesService.DeleteEntityAsync(site))
            {
                if (structuresList.Remove(site))
                {
                    await structuresGrid.Reload();

                }
            }

        }
        updating = false;


    }

    async Task Report(Structure structure)
    {

    //    Reporting.Reporting rep = new Reporting.Reporting(structure, entitiesService);

    }

    async Task Dashboard(Structure structure)
    {
        appData.Structure = structure;
        if (structure.Name.Trim() == "Antares")
        {
            navigationManager.NavigateTo("DashBoard2");
        }
        else
        {
            navigationManager.NavigateTo("DashBoard");
        }
        

    }

    async Task Identification(Structure structure)
    {
        appData.Structure = structure;
        navigationManager.NavigateTo("Identification");

    }





}
