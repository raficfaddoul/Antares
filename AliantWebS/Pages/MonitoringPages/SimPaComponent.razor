@using AliantWebS.Data
@using AliantWebS.Models
@inject IStringLocalizer<Languages> L

<EditForm Model="simPa">
    <DataAnnotationsValidator />
    <Blazorise.Row>
        <Column ColumnSize="ColumnSize.Is8">
            <div class="form-group">
                <label>@L["Simulation Identifier"]:</label>
                <div>
                    <InputText @bind-Value="@simPa.SimulationID" />
                    <ValidationMessage For="@(() => simPa.SimulationID)" />
                </div>
            </div>
            <div class="form-group">
                <label>@L["Short Description"] :</label>
                <div>
                    <textarea @bind="@simPa.ShortDescription" class="form-control"></textarea>
                    <ValidationMessage For="@(() => simPa.ShortDescription)" />
                </div>
            </div>
            <div class="form-group ">
                <div>
                    <label>@L["Signal Length (seconds)"]:</label>
                    <div>
                        <InputNumber @bind-Value="@simPa.Duree" />
                        <ValidationMessage For="@(() => simPa.Duree)" />
                    </div>
                </div>
            </div>
            <div class="form-group ">
                <div>
                    <label>@L["Sampling Frequency"] :</label>
                    <div>
                        <InputNumber @bind-Value="@simPa.SamplingFrequency" />
                        <ValidationMessage For="@(() => simPa.SamplingFrequency)" />
                    </div>
                </div>
            </div>
        </Column>
        <Column ColumnSize="ColumnSize.Is4">
            <div class="form-group ">
                <div>
                    <label>@L["Simulation Seed"]:</label>
                    <div>
                        <InputNumber @bind-Value="@simPa.GlobalSeed" />
                        <ValidationMessage For="@(() => simPa.GlobalSeed)" />
                    </div>
                </div>
            </div>

            <div class="form-group ">
                <div>
                    <label>@L["Simulation Seed"]:</label>
                    <div>
                        <InputCheckbox @bind-Value="@simPa.WriteCSV" />
                        <ValidationMessage For="@(() => simPa.WriteCSV)" />
                    </div>
                </div>
            </div>


        </Column>
    </Blazorise.Row>
    <AliantWebS.Pages.LoadPages.LoadCasesSelector LoadCases="@LoadCases" SelectedLoadCases="@SelectedLoadCases" Coeficients="Coeficients"></AliantWebS.Pages.LoadPages.LoadCasesSelector>


</EditForm>

@code {
    [Parameter]
    public Structural.SimulationParameters simPa { get; set; }

    [Parameter] public List<LoadCase> LoadCases { get; set; } = new List<LoadCase>();
    [Parameter] public Dictionary<LoadCase, double> SelectedLoadCases { get; set; } = new Dictionary<LoadCase, double>();
    [Parameter] public Dictionary<Guid, double> Coeficients { get; set; } = new Dictionary<Guid, double>();

}
