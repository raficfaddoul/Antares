    /// <summary>
    /// Alternative method: Color Beam3d elements based on a condition (e.g., rigidity, status, etc.)
    /// </summary>
    private async Task LoadBeam3dColorMappingByCondition(List<Element> beam3dElements)
    {
        // Example: Group elements by parent name or some attribute
        var criticalElements = new List<long>();
        var warningElements = new List<long>();
        var normalElements = new List<long>();

        foreach (var el in beam3dElements)
        {
            if (!el.BimId.HasValue) continue;

            // Load attributes if needed
            if (el.AttributeElements == null || el.AttributeElements.Count == 0)
            {
                entitiesService.LoadCollection(el, "AttributeElements");
            }

            // Example condition: categorize based on some logic
            // Replace with your actual condition (e.g., rigidity values, sensor data, etc.)
            var random = new Random();
            var condition = random.Next(0, 3); // Mockup - replace with real logic

            switch (condition)
            {
                case 0:
                    criticalElements.Add(el.BimId.Value);
                    break;
                case 1:
                    warningElements.Add(el.BimId.Value);
                    break;
                default:
                    normalElements.Add(el.BimId.Value);
                    break;
            }
        }

        colorMapping = new Dictionary<int, (List<long> EntityIds, (int R, int G, int B) Color)>();

        if (criticalElements.Any())
            colorMapping.Add(0, (criticalElements, (255, 0, 0)));      // Red - Critical

        if (warningElements.Any())
            colorMapping.Add(1, (warningElements, (255, 165, 0)));     // Orange - Warning

        if (normalElements.Any())
            colorMapping.Add(2, (normalElements, (0, 255, 0)));        // Green - Normal
    }

    void OnChange(int index)
    {

    }

    // Run the SAME charpente FE as Charpente.razor, but with MEASURED nodal loads: each structural
    // node's load = Σ of its child manilles' max measured weight over the selected period.
    private async Task CalculCharpenteMesure()
    {
        if (appData.Structure == null) return;

        isCalculating = true;
        statusMessage = "";
        StateHasChanged();
        await Task.Yield(); // let the spinner paint before the (synchronous) FE solve

        try
        {
            var (start, end) = GetPeriodRange(selectedPeriod);

            var chargeNodale = await BuildMeasuredChargeNodaleAsync(start, end);
            if (chargeNodale.Count == 0)
            {
                statusMessage = "Aucune charge mesurée sur la période.";
                return;
            }

            var selectedLoadCases = (await entitiesService.GetFilteredEntitiesAsync<LoadCase>(
                x => x.StructureId == appData.Structure.StructureId)).ToDictionary(lc => lc, lc => 1.0);

            var (beamTaux, componentTaux) = await CharpenteFEHelper.ComputeAsync(
                appData.Structure, selectedLoadCases, chargeNodale, entitiesService);

            tauxByBimId = beamTaux
                .Where(b => b.BimId.HasValue)
                .GroupBy(b => b.BimId.Value)
                .ToDictionary(g => g.Key, g => g.First().Taux);

            colorMapping = TauxColor.BuildColorMapping(tauxByBimId);

            statusMessage = $"{chargeNodale.Count} nœud(s) chargé(s), {tauxByBimId.Count} élément(s) coloré(s).";
        }
        finally
        {
            isCalculating = false;
            StateHasChanged();
        }

        // Re-apply to the already-loaded 3D model (colours are otherwise only set on first render).
        if (bimRef != null)
            await bimRef.ApplyColorsAsync(colorMapping, tauxByBimId);
    }

    // node load (dof 2 = vertical) = Σ over the node's child manilles of their max weight over [start, end].
    private async Task<Dictionary<Guid, (int dof, double value)>> BuildMeasuredChargeNodaleAsync(
        DateTime start, DateTime end)
    {
        var chargeNodale = new Dictionary<Guid, (int dof, double value)>();

        var (shackleSensors, weightChannel) =
            await SensorChargeRatioHelper.LoadShackleSensorsAsync(dbContextFactory, appData.Structure);

        var maxWeights = await SensorChargeRatioHelper.MaxWeightsAsync(shackleSensors, weightChannel, start, end);

        foreach (var sensor in shackleSensors)
        {
            if (sensor.ParentId is not Guid nodeId) continue;             // manille → parent structural node
            if (!maxWeights.TryGetValue(sensor.ElementId, out double w)) continue;

            if (chargeNodale.TryGetValue(nodeId, out var existing))
                chargeNodale[nodeId] = (2, existing.value + w);
            else
                chargeNodale[nodeId] = (2, w);
        }

        return chargeNodale;
    }

    private (DateTime start, DateTime end) GetPeriodRange(string period)
    {
        var end = DateTime.Now;
        var start = period switch
        {
            "hour"  => end.AddHours(-1),
            "day"   => end.AddDays(-1),
            "week"  => end.AddDays(-7),
            "month" => end.AddMonths(-1),
            "year"  => end.AddYears(-1),
            _       => end.AddDays(-1),
        };
        return (start, end);
    }

}
