    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Deferred out of OnInitializedAsync so the page paints immediately. The app is
        // ServerPrerendered, so loading the Structure in OnInitializedAsync blocks the initial HTML.
        if (appData.Structure == null)
        {
            appData.Structure = await entitiesService.GetFilteredFirstEntityAsync<Structure>(
                x => x.StructureId.ToString() == "84028ce7-6e17-ef11-ab4f-3c557678c0f7");

            if (appData.Structure == null)
            {
                navigationManager.NavigateTo(@"Structures");
                return;
            }
            StructureID = appData.Structure.StructureId;
        }

        await LoadBeam3dColorMapping();
        StateHasChanged();
    }

