@page "/SurveillanceAntares/{StructureID:guid}"
@page "/SurveillanceAntares"

@using AliantWebS.Data
@using Models
@using Microsoft.EntityFrameworkCore
@using AliantWebS.Pages.InventoryElementPages
@inject AppData appData;
@inject EntitiesService entitiesService
@inject IDbContextFactory<AliantWebContext> dbContextFactory
@inject NavigationManager navigationManager
@inject IStringLocalizer<Languages> L

<RadzenTabs Change=@OnChange TabPosition="Radzen.TabPosition.Top" RenderMode="TabRenderMode.Server">
    <Tabs>
        <RadzenTabsItem Text="Tableau de bord">
            @if (appData.Structure is null)
            {
                <p><em>@L["Loading"]... !</em></p>
            }
            else
            {
                <DashBoardComponent2></DashBoardComponent2>
            }
        </RadzenTabsItem>
        <RadzenTabsItem Text="Surveillance">
            @if (appData.Structure is null)
            {
                <p><em>@L["Loading"]... !</em></p>
            }
            else
            {
                <SurveillanceCapteursAntares Structure="appData.Structure" ></SurveillanceCapteursAntares>
            }
        </RadzenTabsItem>
        <RadzenTabsItem Text="Corrélation">
            <CorrelationComponent Structure="appData.Structure"></CorrelationComponent>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Modèle 3D">
            @if (appData.Structure is null)
            {
                <p><em>@L["Loading"]... !</em></p>
            }
            else
            {
                <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
                    <RadzenDropDown TValue="string" @bind-Value="selectedPeriod" Data="periodOptions"
                                    TextProperty="Text" ValueProperty="Value" Style="width:200px;" />
                    <button type="button" class="btn btn-success" @onclick="CalculCharpenteMesure" disabled="@isCalculating">
                        @if (isCalculating)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>@L["Calcul en cours..."]</span>
                        }
                        else
                        {
                            @L["Calcul Charpente"]
                        }
                    </button>
                    <span style="color:#666;">@statusMessage</span>
                </div>
                <BIMComponent @ref="bimRef" Structure="appData.Structure"
                              ColorMapping="@colorMapping" TauxMap="@tauxByBimId"></BIMComponent>
            }
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

