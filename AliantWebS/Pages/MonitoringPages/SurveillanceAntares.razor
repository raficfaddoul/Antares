            .ToList();

        // Option 1: Single color for all Beam3d elements (Green)
        colorMapping = new Dictionary<int, (List<long> EntityIds, (int R, int G, int B) Color)>
        {
            { 0, (bimIds, (0, 255, 0)) }  // All Beam3d in Green
        };

