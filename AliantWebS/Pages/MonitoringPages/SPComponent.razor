                {
                    Console.WriteLine("errooooor");
                }

                //if (selectedChartsTypes.Count == 1) return;
            }

            if (selectedChartsTypes.Contains("Fourier") && selectedSourceTypes.Contains("Live"))
            {
                string? adressmapping = sensor.AttributeElements.FirstOrDefault(ae => ae.AttributeType.Name.Trim().ToLower() == "adressmapping").Value;
                if (!filterAddress.ContainsKey(adressmapping))
                    filterAddress.Add(adressmapping, name);

                await FillStack("Fourier", name);
            }


        }
        else
        {
            toBeShown.Remove((sensor, channelDataType));

            if (selectedChartsTypes.Contains("TimeDomain") && selectedSourceTypes.Contains("History"))
            {
                PlotData(name, null, null, chartBundles["TimeDomainHistory"].Data, "TimeDomainHistory");

            }
            if (selectedChartsTypes.Contains("TimeDomain") && selectedSourceTypes.Contains("Simulation"))
