    string message = string.Empty;
    bool run = true;
    async Task FillStack(string chartType, string name)
    {
        long diff = -1;
        run = false;
        await Task.Delay(1000);

        DateTime lastSentTime = DateTime.MinValue;

        using (TcpClient client = new TcpClient(ServerHost, ServerPort))
        using (NetworkStream networkStream = client.GetStream())
        using (StreamReader reader = new StreamReader(networkStream))
        {
            run = true;
            while (run)
            {
                if ((DateTime.UtcNow - lastSentTime).TotalMilliseconds >= stepSize)
                {
                    int index = 0;
                    while (index < filterAddress.Count)
                    {

                        message = await reader.ReadLineAsync();
                        message = message.Trim();
                        string[] parts = message.Split();

                        string address = parts[0].ToString();
                        long t = long.Parse(parts[1], CultureInfo.InvariantCulture) / 1000;// - 1692257501702; 1697497450736133
                                                                                           // DateTimeOffset dateTimeOffset = DateTime.Now;// DateTimeOffset.FromUnixTimeMilliseconds(t);

                        long timeNow = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

                        if (diff == -1)
                        {
                            diff = timeNow - t;
                        }

                        t = t + diff;

                        double x = double.Parse(parts[2], CultureInfo.InvariantCulture);
                        double y = double.Parse(parts[3], CultureInfo.InvariantCulture);
                        double z = double.Parse(parts[4], CultureInfo.InvariantCulture);

                        if (filterAddress.Keys.Contains(address))
                        {

                            DataUpdateService.UpdateData(chartType, filterAddress[address], address, t, x, y, z);
                            index++;
                        }
                    }

                    lastSentTime = DateTime.UtcNow;
                }
                else
                {
                    await reader.ReadLineAsync();
                }
            }
        }
    }
    async Task UpdateDataFourier(string name)
    {
    Start:
        try
        {


            DateTimeOffset dateTimeOffset = DateTimeOffset.FromUnixTimeMilliseconds(DataUpdateService.t);

            foreach (var a in filterAddress)
            {

                if (a.Key == DataUpdateService.address)
                {
                    if (!dic.Keys.Contains(name))
                    {
                        dic.Add(name, new Queue<object>());
                    }

                    dic[name].Enqueue(DataUpdateService.y);
                    if (dic[name].Count > 1000)
                    {
                        dic[name].Dequeue();
                    }

                    if (dic[name].Count < 20) continue;

                    IList<object> X = Enumerable.Range(1, dic[name].Count).ToList().Cast<object>().ToList(); ;
                    IList<object> Y = dic[name].ToList();

                    var rrr = Structural.SP.FFT2(Y.Select(x => Convert.ChangeType(x, typeof(double), CultureInfo.InvariantCulture)).Cast<double>().ToArray());

                    rrr[0] = 0;
                    Y = rrr.Select(x => Convert.ChangeType(x.Magnitude, typeof(object))).Cast<object>().ToArray();

                    ITrace it = chartBundles["FourierLive"].Data.FirstOrDefault(x => ((Scatter)x).Name == name);

                    if (it == null)
                    {
                        Scatter sc = new Scatter();

                        sc.Name = name;
                        sc.XCalendar = Plotly.Blazor.Traces.ScatterLib.XCalendarEnum.Gregorian;
                        sc.Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines;

                        sc.X = X;
                        sc.Y = Y;

                        chartBundles["FourierLive"].Data.Add(sc);
                    }
                    else
                    {
                        ((Scatter)it).X = X;
                        ((Scatter)it).Y = Y;
                    }




                }

            }



        }
        catch (Exception ex)
        {
            await Task.Delay(100);
            goto Start;

        }

    }

    async Task UpdateDataTimeDomain(string name)
    {
        try
        {
            Random rand = new Random();


            DateTimeOffset dateTimeOffset = DateTimeOffset.FromUnixTimeMilliseconds(DataUpdateService.t);

            if (filterAddress.Keys.Contains(DataUpdateService.address))
            {
                chartBundles["TimeDomainLive"].Layout.XAxis[0].Range = new object[] { DateTime.Now - MaxTimeWindow, DateTime.Now };

                ITrace it = chartBundles["TimeDomainLive"].Data.FirstOrDefault(x => ((Scatter)x).Name == name);

                if (it == null)
                {

                    Scatter scatterData = new Scatter
                        {
                            Name = name,
                            Mode = ModeFlag.Lines,
                            X = new List<object>(),
                            Y = new List<object>(),
                            XCalendar = Plotly.Blazor.Traces.ScatterLib.XCalendarEnum.Gregorian

                        };

                    scatterData.Line = new Line();

                    scatterData.Line.Color = $"rgb({rand.Next(256)}, {rand.Next(256)}, {rand.Next(256)})";


                    chartBundles["TimeDomainLive"].Data.Add(scatterData);

                }
                else
                {

                    ((Scatter)it).X.Add(DateTime.Now);
                    ((Scatter)it).Y.Add(DataUpdateService.y);
                    // if (!letUpdateDataRun) break;
                    var startTime = ((Scatter)it).X.First();
                    var endTime = ((Scatter)it).X.Last();


                    TimeSpan timeWindow = ((DateTime)endTime) - ((DateTime)startTime);


                    if (timeWindow > MaxTimeWindow)
                    {
                        ((Scatter)it).X.RemoveAt(0); // Remove the oldest data point
                        ((Scatter)it).Y.RemoveAt(0);
                    }

                }

                //   if (!letUpdateDataRun) break;
                await chartBundles["TimeDomainLive"].Chart.Update(ct);

            }


        }
        catch (Exception ex)
        {
            await Task.Delay(100);
            UpdateDataTimeDomain(name);
        }

    }




    async void OnChangeSelectedChartTypes(bool args, string chartType)
    {
        if (args)
        {
            if (chartType == "ModalDeformation")
            {
                if (str == null)
                {
                    str = await Structural.Simulation.CreateStructure(appData.Structure, null, entitiesService);
                }

                if ((ValeursPropres == null) || (VecteursPropres == null))
                {
                    ValeursPropres = Structural.StructuralVibration.Calcul_ValeursPropres(str.element,
                    str.noeud, str.MasseNodale, str.CL, out VecteursPropres);
                }
            }


            selectedChartsTypes.Add(chartType);

            foreach (var v in selectedSensorsChannelDataTypes)
            {
                await ploti(true, v.Item1, v.Item2);
            }
        }
        else
        {
            foreach (var chb in chartBundles.Keys)
            {
                if (chb.Contains(chartType))
                {
                    if (chartBundles[chb].Data.Count != 0)
                    {
                        await chartBundles[chb].Chart.Clear();
                    }
                }

            }


            if (chartType == "ModalDeformation")
            {
                ValeursPropres = null;
                VecteursPropres = null;
            }



            selectedChartsTypes.Remove(chartType);

            Selected = !Selected;
            this.StateHasChanged();
            await Task.Delay(100);
            Selected = !Selected;

            this.StateHasChanged();

        }
    }

