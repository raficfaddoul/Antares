    void PlotData(string name, IList<object> X, IList<object> Y, IList<ITrace> data, string BundelName = null)
    {

        ITrace it = data.FirstOrDefault(x => ((Scatter)x).Name == name);


        if ((X != null) && (Y != null))
        {
            if (it != null) return;

            Scatter sc = new Scatter();

            sc.Name = name;

            sc.XCalendar = Plotly.Blazor.Traces.ScatterLib.XCalendarEnum.Gregorian;

            sc.Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines;

            sc.X = X;
            sc.Y = Y;

            data.Add(sc);
        }
        else
        {
            if (it == null) return;
            if (BundelName != null)
            {
                chartBundles[BundelName].Chart.DeleteTrace(it);
            }
            data.Remove(it);




        }

    }

    private async Task<List<object[]>> GetLa(Element element, ChannelDataType channelDataType)
    {
        return await InfluxService.GetData(new List<string>() { element.ElementId.ToString() }, new List<string>() { channelDataType.ChannelDataTypeId.ToString() }, startDate, endDate);
    }

    private async Task<(IList<object> X, IList<object> Y)> GetXY(Element sensor, ChannelDataType channelDataType)
    {
        if (sensedNodes.nodes is null)
        {
            sensedNodes = await Task.Run(() => Structural.Simulation.GetSensedNodes(appData.Structure, entitiesService._appDBContext, sensors));
        }
        Guid? sensedNodeGuid = sensedNodes.sensorNodeDic[sensor.ElementId];
        if (sensedNodeGuid == null)
        {
            return (null, null);
        }
        int index = sensedNodes.sensedNodesIndex[(Guid)sensedNodeGuid];

        double[] column = qTime.GetColumn(index * 3 + channelDataTypeList.IndexOf(channelDataType));
        double[] xs = Enumerable.Range(1, column.Count()).Select(i => (double)i).ToArray();

        IList<object> X = xs.Cast<object>().ToList();
        IList<object> Y = column.Cast<object>().ToList();

        return (X, Y);
    }

    private async Task plot(bool args, Element sensor, ChannelDataType channelDataType)
    {
        if (args == true)
        {
            selectedSensorsChannelDataTypes.Add((sensor, channelDataType));
            await ploti(args, sensor, channelDataType);
        }
        else
        {
            selectedSensorsChannelDataTypes.Remove((sensor, channelDataType));
            await ploti(args, sensor, channelDataType);
        }
    }



    private async Task ploti(bool args, Element sensor, ChannelDataType channelDataType)
    {

        if (sensor.AttributeElements.Count == 0)
        {
            entitiesService.LoadCollection(sensor, "AttributeElements");
        }

        string name = sensor.Name + " " + "Channel " + channelDataType.Name;
        if (args)
        {
            if (!toBeShown.Contains((sensor, channelDataType))) toBeShown.Add((sensor, channelDataType));



            if (selectedChartsTypes.Contains("TimeDomain") && selectedSourceTypes.Contains("History"))
            {
                List<object[]> la = await GetLa(sensor, channelDataType);

                IList<object> X = la.Select(x => x[0]).ToList();
                IList<object> Y = la.Select(x => x[2]).ToList();
                PlotData(name, X, Y, chartBundles["TimeDomainHistory"].Data);
            }

            if (selectedChartsTypes.Contains("TimeDomain") && selectedSourceTypes.Contains("Simulation"))
            {

                var (X, Y) = await GetXY(sensor, channelDataType);

                PlotData(name, X, Y, chartBundles["TimeDomainSimulation"].Data);

            }

            if (selectedChartsTypes.Contains("ModalDeformation") && selectedSourceTypes.Contains("Simulation"))
            {





            }

            if (selectedChartsTypes.Contains("Fourier") && selectedSourceTypes.Contains("Simulation"))
            {

                var (X, Y) = await GetXY(sensor, channelDataType);

                var rrr = Structural.SP.FFT2(Y.Select(x => Convert.ChangeType(x, typeof(double), CultureInfo.InvariantCulture)).Cast<double>().ToArray());
                rrr[0] = 0;
                Y = rrr.Select(x => Convert.ChangeType(x.Magnitude, typeof(object))).Cast<object>().ToArray();
                PlotData(name, X, Y, chartBundles["FourierSimulation"].Data);

            }



            if (selectedChartsTypes.Contains("Fourier") && selectedSourceTypes.Contains("History"))
            {
                List<object[]> la = await GetLa(sensor, channelDataType);

                IList<object> Y = la.Select(x => x[2]).ToList();
                IList<object> X = Enumerable.Range(1, Y.Count()).Select(i => (object)i).ToList();


                var rrr = Structural.SP.FFT2(Y.Select(x => Convert.ChangeType(x, typeof(double), CultureInfo.InvariantCulture)).Cast<double>().ToArray());
                rrr[0] = 0;
                Y = rrr.Select(x => Convert.ChangeType(x.Magnitude, typeof(object))).Cast<object>().ToArray();
                PlotData(name, X, Y, chartBundles["FourierHistory"].Data);

