    private async Task HandleSensorClickedFromSvg(Element sensor)
    {
        if (sensor?.ElementType?.ChannelDataTypeElementTypes == null)
        {
            // Need to reload sensor with channel data types
            using var context = await dbContextFactory.CreateDbContextAsync();
            sensor = await context.Elements
                .Include(e => e.ElementType)
                    .ThenInclude(et => et.ChannelDataTypeElementTypes)
                    .ThenInclude(cdtet => cdtet.ChannelDataType)
                .FirstOrDefaultAsync(e => e.ElementId == sensor.ElementId);
        }
        
        if (sensor?.ElementType?.ChannelDataTypeElementTypes == null || !sensor.ElementType.ChannelDataTypeElementTypes.Any())
        {
            await js.InvokeVoidAsync("alert", $"Sensor '{sensor?.Name}' has no channel data types configured.");
            return;
        }
        
        // Build list of sensor/channel pairs for this sensor
        var sensorChannelPairs = new List<(Element sensor, ChannelDataType channelDataType)>();
        
        foreach (var channelDataType in ChannelsOf(sensor))
        {
            sensorChannelPairs.Add((sensor, channelDataType));

            // Update checkbox states
            var checkboxKey = $"{sensor.ElementId}_{channelDataType.ChannelDataTypeId}";
            checkboxStates[checkboxKey] = true;
        }
        
        if (sensorChannelPairs.Any())
        {
            // Trigger the chart update
            await HandleBatchPlot((sensorChannelPairs, startDate, endDate));
            
            // Notify the child component to refresh
            StateHasChanged();
        }
    }

    private async Task<bool> IsDeveloperNowAsync()
        => (await authenticationStateProvider.GetAuthenticationStateAsync()).User.IsInRole(DeveloperRole);

    // A plotted series' key, "sensorId|channelId", as HandleBatchPlot builds it.
    private static bool TryParseSeriesKey(string key, out Guid sensorId, out Guid channelId)
    {
        sensorId = channelId = Guid.Empty;
        var parts = key.Split('|');
        return parts.Length == 2 && Guid.TryParse(parts[0], out sensorId) && Guid.TryParse(parts[1], out channelId);
    }

    // A sensor's channels, in their configured order.
    private static IEnumerable<ChannelDataType> ChannelsOf(Element sensor) =>
        sensor.ElementType.ChannelDataTypeElementTypes
            .OrderBy(c => c.SortOrder ?? int.MaxValue)
            .Select(c => c.ChannelDataType)
            .Where(c => c != null);

    // A point of the plot, with its sensor and channel, the instant the plot drew it at and its value.
    private sealed record TracedPoint(Element Sensor, ChannelDataType Channel, DateTime At, double Value);

    // The point of the displayed plot the browser named, or null with the reason: the curve must be one series of
    // the plot, of a sensor of this page, holding a point at exactly that x with exactly that value.
    private TracedPoint TracePlottedPoint(IndicesInTimeComponent.ChosenPoint point, out string refusal)
    {
        refusal = null;

        // headers[0] is "Date", indices[i] is headers[i + 1].
        int column = headers.IndexOf(point.Series);
        if (column < 1 || headers.LastIndexOf(point.Series) != column)
        {
            refusal = $"La courbe « {point.Series} » ne peut pas être identifiée sans ambiguïté.";
            return null;
        }

        var (seriesKey, seriesData) = indices[column - 1];
        var sensor = TryParseSeriesKey(seriesKey, out var sensorId, out var channelId)
            ? sensors?.FirstOrDefault(s => s.ElementId == sensorId)
            : null;
        var channel = sensor == null ? null : ChannelsOf(sensor).FirstOrDefault(c => c.ChannelDataTypeId == channelId);
        if (channel == null)
        {
            refusal = $"La courbe « {point.Series} » ne correspond à aucun capteur de cette page.";
            return null;
        }

        var keys = seriesData.Keys.Where(k => IndicesInTimeComponent.CsvX(k) == point.X).ToList();
        if (keys.Count != 1 || seriesData[keys[0]] != point.Y)
        {
            refusal = "Ce point ne correspond plus aux données affichées : rechargez la courbe et recommencez.";
            return null;
        }

        return new TracedPoint(sensor, channel, (DateTime)keys[0], point.Y);
    }

    // A point right-clicked on the plot (Developer role): traced back to the raw readings behind it, which are
    // deleted from InfluxDB once the developer confirms. A point that cannot be traced exactly is never deleted:
    // every check refuses aloud.
    private async Task DeletePlottedPoint(IndicesInTimeComponent.ChosenPoint point)
    {
        if (isDeletingPoint)
        {
            await js.InvokeVoidAsync("alert", "Une suppression est déjà en cours.");
            return;
        }

        isDeletingPoint = true;
        // What a failure at the current step means for the data: set before each step, said before the error.
        string failure = "Rien n'a été supprimé";
        try
        {
            if (!await IsDeveloperNowAsync())
            {
                await js.InvokeVoidAsync("alert", "La suppression de mesures est réservée au rôle Developer.");
                return;
            }

            var plot = plotted;
            if (isLoadingData || plot == null)
            {
                await js.InvokeVoidAsync("alert", "La courbe est en cours de chargement : réessayez une fois qu'elle est affichée.");
                return;
            }

            var traced = TracePlottedPoint(point, out string refusal);
            if (traced == null)
            {
                await js.InvokeVoidAsync("alert", $"{refusal} Rien n'a été supprimé.");
                return;
            }

            var sensorId = traced.Sensor.ElementId;
            var channelId = traced.Channel.ChannelDataTypeId;
            var found = await OutlierReadings.FindAsync(sensorId, channelId, traced.At, traced.Value, plot);
            if (found.Instants.Count == 0)
            {
                await js.InvokeVoidAsync("alert", "Aucune lecture de la base ne donne ce point (elle a peut-être déjà été supprimée) : rechargez la courbe.");
                return;
            }

            failure = "La confirmation n'a pas abouti : rien n'a été supprimé";
            if (!await js.InvokeAsync<bool>("confirm", DeleteConfirmText(traced, found)))
                return;

            failure = "La suppression n'a pas abouti ; rechargez la courbe pour voir ce qui reste";
            await OutlierReadings.DeleteAsync(sensorId, channelId, found.Instants, plot.Bucket);

            failure = "La lecture a été supprimée, mais la suite a échoué";
            await journal.WriteAsync(JournalCategory.Donnees, "influx.reading.delete",
                target: $"{traced.Sensor.Name} / {traced.Channel.Name}",
                details: $"{found.Instants.Count} lecture(s) entière(s) supprimée(s) du bucket {plot.Bucket}, toutes les voies du capteur : "
                       + string.Join(", ", found.Instants.Select(at => at.ToString("o", CultureInfo.InvariantCulture)))
                       + $". Point du graphique : {traced.Channel.Name} = {traced.Value.ToString("G6", CultureInfo.InvariantCulture)} le {Utc(traced.At)}.",
                severity: 2,
                structureId: Structure?.StructureId);

            await RefreshChart();
            await js.InvokeVoidAsync("alert", $"{found.Instants.Count} lecture(s) supprimée(s) de la base.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SurveillanceCapteurs] point delete ({point.Series} @ {point.X}): {ex}");
            await js.InvokeVoidAsync("alert", $"{failure} : {ex.Message}");
        }
        finally
        {
            isDeletingPoint = false;
        }
    }

    // What the developer is asked before anything is deleted, InfluxDB's whole-reading rule included.
    private static string DeleteConfirmText(TracedPoint point, OutlierReadings.Found found)
    {
        const int Listed = 10;
        var text = new System.Text.StringBuilder();
        text.AppendLine("Supprimer définitivement de la base InfluxDB ?");
        text.AppendLine();
        text.AppendLine($"Capteur : {point.Sensor.Name}");
        text.AppendLine($"Point : {point.Channel.Name} = {point.Value.ToString("G6", CultureInfo.InvariantCulture)}, le {Utc(point.At)}");
        if (found.ReadingsInWindow > 1)
            text.AppendLine($"Ce point est le maximum de {found.ReadingsInWindow} lectures, du {Utc(found.WindowStart)} au {Utc(found.WindowStop)}.");
        text.AppendLine();
        text.AppendLine($"Lecture(s) donnant cette valeur, à supprimer : {found.Instants.Count}");
        foreach (var at in found.Instants.Take(Listed))
            text.AppendLine($"   {Utc(at)}");
        if (found.Instants.Count > Listed)
            text.AppendLine($"   … et {found.Instants.Count - Listed} autre(s)");
        text.AppendLine();
        text.AppendLine("InfluxDB efface chaque lecture entière : toutes les voies du capteur à cet instant "
                      + $"({string.Join(", ", ChannelsOf(point.Sensor).Select(c => c.Name))}), pas seulement {point.Channel.Name}.");
        text.Append("Cette suppression est définitive.");
        return text.ToString();
    }

    private static string Utc(DateTime at) => at.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.InvariantCulture) + " UTC";
}
