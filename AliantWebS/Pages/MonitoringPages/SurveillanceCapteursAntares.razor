    public async Task EnableSensorPositioning(Element sensor)
    {
        sensorToPosition = sensor;
        positioningSensorId = sensor.ElementId;
        isPositioningMode = true;
        StateHasChanged();
    }

    // The plan gives the point clicked as sensor positions are stored: absolute millimetres in the grid's axes.
    private async Task HandlePointPlaced(AliantWebS.Pages.CADPages.PlanPoint point)
    {
        if (isPositioningMode && sensorToPosition != null)
        {
            var currentSensor = sensorToPosition;

            await SaveSensorPosition(currentSensor, point.Xmm, point.Ymm);
            
            // Add to positioned set
            positionedSensorIds.Add(currentSensor.ElementId);
            
            await LoadSensorsAsync();

            isPositioningMode = false;
            sensorToPosition = null;
            positioningSensorId = null;  // Reset the positioning ID
            StateHasChanged();
        }
    }

    private async Task SaveSensorPosition(Element sensor, double x, double y)
    {
        if (sensor == null)
        {
            await js.InvokeVoidAsync("alert", "Sensor positioning was cancelled.");
            return;
        }

        // Use a fresh context to avoid tracking conflicts
        using var context = await dbContextFactory.CreateDbContextAsync();

        // Get attribute types directly from fresh context
        var xAttrType = await context.Set<AttributeType>()
            .FirstOrDefaultAsync(at => at.Name == "X");
        var yAttrType = await context.Set<AttributeType>()
            .FirstOrDefaultAsync(at => at.Name == "Y");

        if (xAttrType == null || yAttrType == null)
        {
            await js.InvokeVoidAsync("alert", "X or Y AttributeType not found in the database!");
            return;
        }

        try
        {
            await WritePosition(context);
        }
        catch (DbUpdateException ex) when (EntitiesService.IsUniqueViolation(ex))
        {
            // Another save inserted X or Y, or linked them to the sensor's type, between this one's read and its
            // insert (a second click on the plan before the first had finished, another user placing the same
            // sensor or another sensor of the same type), and the unique index on (ElementID, AttributeTypeID)
            // or on (ElementTypeID, AttributeTypeID) refused the duplicate. Whatever was refused is there now:
            // read again in a clean context, which finds it and only updates the values. Letting the exception
            // out of the click handler would end the circuit.
            using var retryContext = await dbContextFactory.CreateDbContextAsync();
            await WritePosition(retryContext);
        }

        async Task WritePosition(AliantWebContext db)
        {
            // A position is two attribute rows of types X and Y. EditElement shows the rows of an attribute type
            // the element's type is not linked to greyed and read-only, so a sensor whose type lacks the link
            // gets it with its position. The type is read here rather than taken from the list the page loaded,
            // so that the link goes to the type the sensor has now.
            var elementTypeId = await db.Set<Element>()
                .Where(e => e.ElementId == sensor.ElementId)
                .Select(e => e.ElementTypeId)
                .FirstOrDefaultAsync();

            var newLinks = new List<string>();
            if (elementTypeId is Guid typeId)
            {
                var linkedIds = await db.Set<AttributeTypeElementType>()
                    .Where(l => l.ElementTypeId == typeId &&
                               (l.AttributeTypeId == xAttrType.AttributeTypeId ||
                                l.AttributeTypeId == yAttrType.AttributeTypeId))
                    .Select(l => l.AttributeTypeId)
                    .ToListAsync();

                foreach (var attrType in new[] { xAttrType, yAttrType })
                {
                    if (linkedIds.Contains(attrType.AttributeTypeId)) continue;

                    db.Set<AttributeTypeElementType>().Add(new AttributeTypeElementType
                    {
                        ElementTypeId = typeId,
                        AttributeTypeId = attrType.AttributeTypeId
                    });
                    newLinks.Add(attrType.Name);
                }
            }

            // Get existing attribute elements for this sensor
            var existingAttributes = await db.Set<AttributeElement>()
                .Where(ae => ae.ElementId == sensor.ElementId &&
                            (ae.AttributeTypeId == xAttrType.AttributeTypeId ||
                             ae.AttributeTypeId == yAttrType.AttributeTypeId))
                .ToListAsync();

            var xAttribute = existingAttributes.FirstOrDefault(ae => ae.AttributeTypeId == xAttrType.AttributeTypeId);
            var yAttribute = existingAttributes.FirstOrDefault(ae => ae.AttributeTypeId == yAttrType.AttributeTypeId);

            // Handle X attribute
            if (xAttribute == null)
            {
                xAttribute = new AttributeElement
                {
                    AttributeElementId = Guid.NewGuid(),
                    ElementId = sensor.ElementId,
                    AttributeTypeId = xAttrType.AttributeTypeId,
                    Value = x.ToString("F2", CultureInfo.InvariantCulture)
                };
                db.Set<AttributeElement>().Add(xAttribute);
            }
            else
            {
                xAttribute.Value = x.ToString("F2", CultureInfo.InvariantCulture);
                db.Set<AttributeElement>().Update(xAttribute);
            }

            // Handle Y attribute
            if (yAttribute == null)
            {
                yAttribute = new AttributeElement
                {
                    AttributeElementId = Guid.NewGuid(),
                    ElementId = sensor.ElementId,
                    AttributeTypeId = yAttrType.AttributeTypeId,
                    Value = y.ToString("F2", CultureInfo.InvariantCulture)
                };
                db.Set<AttributeElement>().Add(yAttribute);
            }
            else
            {
                yAttribute.Value = y.ToString("F2", CultureInfo.InvariantCulture);
                db.Set<AttributeElement>().Update(yAttribute);
            }

            await db.SaveChangesAsync();

            if (newLinks.Count > 0)
                Console.WriteLine($"[SurveillanceCapteurs] linked attribute type(s) {string.Join(", ", newLinks)} to element type {elementTypeId}, saving the position of sensor {sensor.Name} ({sensor.ElementId}).");
        }
    }

