    private async Task HandleBatchPlot((List<(Element sensor, ChannelDataType channelDataType)> pairs, DateTime startDate, DateTime endDate) args)
    {
        var (sensorChannelPairs, receivedStartDate, receivedEndDate) = args;
        plotted = null;

        if (!sensorChannelPairs.Any())
        {
            headers.Clear();
            headers.Add("Date");
            indices.Clear();
            checkboxStates.Clear();
            
            if (iitc != null)
            {
                await iitc.DisplayData(new List<Dictionary<object, double>>(), headers);
            }
            return;
        }

        isLoadingData = true;
        loadingMessage = $"Loading {sensorChannelPairs.Count} sensor channels...";
        StateHasChanged();

        try
        {
            headers.Clear();
            headers.Add("Date");
            indices.Clear();
            checkboxStates.Clear();

            var uniqueSensorIds = sensorChannelPairs.Select(x => x.sensor.ElementId.ToString()).Distinct().ToList();
            var uniqueChannelIds = sensorChannelPairs.Select(x => x.channelDataType.ChannelDataTypeId.ToString()).Distinct().ToList();

            loadingMessage = $"Fetching data for {sensorChannelPairs.Count} sensor channels...";
            StateHasChanged();

            var bucketName = ReportsService.BucketName;
            var allRawData = await InfluxService.GetData(
                uniqueSensorIds,
                uniqueChannelIds,
                receivedStartDate,
                receivedEndDate,
                bucketName,
                maxDataPoints
            );

            loadingMessage = $"Processing {allRawData.Count} data points...";
            StateHasChanged();

            var dataDictionaries = new Dictionary<string, Dictionary<object, double>>();
            foreach (var (sensor, channelDataType) in sensorChannelPairs)
            {
                var key = $"{sensor.ElementId}|{channelDataType.ChannelDataTypeId}";
                dataDictionaries[key] = new Dictionary<object, double>();
            }

            foreach (var row in allRawData)
            {
                if (row == null || row.Length < 2) continue;
                if (row[0] == null) continue;
                
                var timestamp = (DateTime)row[0];
                var sensorId = row[1]?.ToString();
                
                if (string.IsNullOrEmpty(sensorId)) continue;

                for (int i = 0; i < uniqueChannelIds.Count; i++)
                {
                    var channelId = uniqueChannelIds[i];
                    var valueIndex = i + 2;

                    if (valueIndex >= row.Length || row[valueIndex] == null)
                        continue;

                    var key = $"{sensorId}|{channelId}";
                    
                    if (!dataDictionaries.ContainsKey(key))
                        continue;

                    var value = Convert.ToDouble(row[valueIndex], CultureInfo.InvariantCulture);

                    if (!dataDictionaries[key].ContainsKey(timestamp))
                    {
                        dataDictionaries[key][timestamp] = value;
                    }
                }
            }

            var curves = new List<(string Series, string Channel)>();
            foreach (var (sensor, channelDataType) in sensorChannelPairs)
            {
                var key = $"{sensor.ElementId}|{channelDataType.ChannelDataTypeId}";
                var dic = dataDictionaries[key];

                string checkboxKey = $"{sensor.ElementId}_{channelDataType.ChannelDataTypeId}";
                checkboxStates[checkboxKey] = true;

                var header = $"{sensor.Name}|{channelDataType.Name}";
                headers.Add(header);
                curves.Add((header, channelDataType.Name));
                indices.Add((key, dic));
            }

            loadingMessage = "Rendering chart...";
            StateHasChanged();

            if (iitc != null)
            {
                await iitc.DisplayData(indices.Select(x => x.Item2).ToList(), headers, axes: PlotAxes.For(curves));
                plotted = new OutlierReadings.Plot(receivedStartDate, receivedEndDate, maxDataPoints, bucketName);
            }

            await PushGraphExportMetaAsync();
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", $"Error loading data: {ex.Message}\n\n{ex.StackTrace}");
        }
        finally
        {
            isLoadingData = false;
            StateHasChanged();
        }
    }

    // Metadata drawn into the header of the exported JPG. Pushed to a JS global (rather than passed
    // at click time) so the export button can call JS directly and keep the user activation the
    // Save-As picker requires.
    private async Task PushGraphExportMetaAsync()
    {
        try
        {
            await js.InvokeVoidAsync("setGraphExportMeta", new
            {
                structure = Structure?.Name ?? "",
                start = startDate.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture) + " UTC",
                end = endDate.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture) + " UTC",
                series = headers.Skip(1).ToList()   // headers[0] is "Date"
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"setGraphExportMeta failed: {ex.Message}");
        }
    }

