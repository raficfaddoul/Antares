<RadzenSplitter Orientation="Radzen.Orientation.Horizontal">
    <RadzenSplitterPane>

        <SelecteurDeCapteurComponent Structure=@Structure OnPlotRaised="@(p =>plot(p.Item1,p.Item2,p.Item3,p.Item4,p.Item5))"></SelecteurDeCapteurComponent>

    </RadzenSplitterPane>
    <RadzenSplitterPane>
        @if (correlationMatrix != null)
        {
            <table class="correlation-table">
                <thead>
                    <tr>
                        <th></th>
                        @for (int i = 0; i < correlationMatrix.Count; i++)
                        {
                            <th>@headers[i]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < correlationMatrix.Count; i++)
                    {
                        <tr>
                            <th>@headers[i]</th>
                            @for (int j = 0; j < correlationMatrix[i].Count; j++)
                            {
                                <td style="background-color: @GetColor(correlationMatrix[i][j]);">
                                    @correlationMatrix[i][j].ToString("0.00")
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>Loading...</p>
        }
    </RadzenSplitterPane>
</RadzenSplitter>
@* } *@

