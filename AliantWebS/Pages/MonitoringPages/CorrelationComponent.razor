<style>
    .correlation-table {
        width: 100%;
        border-collapse: collapse;
    }

        .correlation-table th, .correlation-table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: center;
        }

        .correlation-table th {
            background-color: #f2f2f2;
            font-weight: bold;
            font-size: 0.8em; /* Adjust the font size here */
        }

        .correlation-table td {
            color: white;
        }
</style>

