        //     d.Add(e.ElementId, ll[j]);
        //     j++;
        // }

        // ir.Rigidités = d;


        // await ir.Save(appData.Structure);

        if (appData.Structure == null)
        {
            navigationManager.NavigateTo(@"/Structures");
        }

        Structural.IdentificationResult ir = new Structural.IdentificationResult();
