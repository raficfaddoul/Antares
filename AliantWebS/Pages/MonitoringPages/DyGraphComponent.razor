    private async Task FetchLiveData()
    {
        if (stop) return;
        try
        {
            if (numberOfChannels != FilterAddress.Count)
            {
                dataPoints = new List<string>();
                headers = "Date";
                foreach (var v in FilterAddress)
                {
                    headers += "," + v.Value; 
                }
                headers += "\n";
                numberOfChannels = FilterAddress.Count;
            }

            if (FilterAddress.Keys.Contains(DataUpdateService.address))
            {
                string value = string.Empty;
                foreach (var v in FilterAddress)
                {
                    if (DataUpdateService.address != v.Key)
                    {
                        value += ",";
                    }
                    else
                    {
                        value += DataUpdateService.y + ",";
                    }
                }
                value = value.Remove(value.Count() - 1);

                string newData = $"{DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss.fff")},{value}\n";


                // if (currentCount > 1000)
                // {
                //     dataPoints.RemoveAt(0);
                // }
                dataPoints.Add(newData);


                // Keep only the data points within the last 30 seconds
                cutoffTime = DateTime.Now.AddSeconds(-100);

                dataPoints = dataPoints.Where(dp => DateTime.Parse(dp.Split(',')[0]) >= cutoffTime).ToList();

                // Convert the filtered data points back to the expected CSV format
                var liveData = $"{headers}\n" + string.Join("\n", dataPoints);


                await JSRuntime.InvokeVoidAsync("updateTimeDygraph", "graphdiv1", liveData);

                currentCount++;
            }

        }
        catch (Exception ex)
        {
            int k = 1;
        }
    }

