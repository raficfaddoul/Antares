@* What could not be read, and why, where an empty graph, a 0 % gauge or an uncoloured plan would otherwise pass for
   real values. Renders nothing without a message. A banner in the page's flow, or with Cover an overlay on its whole
   area (the parent must be position: relative), so the stale or empty content under it cannot be read. *@
@if (!string.IsNullOrEmpty(Message))
{
    <div class="read-failure @(Cover ? "cover" : "banner")" role="alert">
        <strong>⚠ @Title</strong>
        <span>@Message</span>
    </div>
}

@code {
    /// <summary>The title over a plan whose charge colours could not be computed.</summary>
    public const string ChargeColoursTitle = "Couleurs de charge indisponibles";

    /// <summary>The title when none is given: an InfluxDB read that failed.</summary>
    public const string DefaultTitle = "Les données n'ont pas pu être lues";

    [Parameter] public string Title { get; set; } = DefaultTitle;
    [Parameter] public string Message { get; set; }
    [Parameter] public bool Cover { get; set; }
}
