    void PlotData(string name, IList<object> X, IList<object> Y, IList<ITrace> data, string BundelName = null)
    {

        ITrace it = data.FirstOrDefault(x => ((Scatter)x).Name == name);


        if ((X != null) && (Y != null))
        {
            if (it != null) return;

            Scatter sc = new Scatter();

            sc.Name = name;

            sc.XCalendar = Plotly.Blazor.Traces.ScatterLib.XCalendarEnum.Gregorian;

            sc.Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines;

            sc.X = X;
            sc.Y = Y;

            data.Add(sc);
        }
        else
        {
            if (it == null) return;
            if (BundelName != null)
            {
                chartBundles[BundelName].Chart.DeleteTrace(it);
            }
            data.Remove(it);

        }

    }

    private async Task<List<object[]>> GetLa(Element element, ChannelDataType channelDataType, DateTime startDate, DateTime endDate)
    {
        return await InfluxService.GetData(new List<string>() { element.ElementId.ToString() }, new List<string>() { channelDataType.ChannelDataTypeId.ToString() }, startDate, endDate);
    }

    private async Task<(IList<object> X, IList<object> Y)> GetXY(Element sensor, ChannelDataType channelDataType)
    {
        if (sensedNodes.nodes is null)
        {
            sensedNodes = await Task.Run(() => Structural.Simulation.GetSensedNodes(appData.Structure, entitiesService._appDBContext, sensors));
        }
        Guid? sensedNodeGuid = sensedNodes.sensorNodeDic[sensor.ElementId];
        if (sensedNodeGuid == null)
        {
            return (null, null);
        }
        int index = sensedNodes.sensedNodesIndex[(Guid)sensedNodeGuid];

        double[] column = qTime.GetColumn(index * 3 + channelDataTypeList.IndexOf(channelDataType));
        double[] xs = Enumerable.Range(1, column.Count()).Select(i => (double)i).ToArray();

        IList<object> X = xs.Cast<object>().ToList();
        IList<object> Y = column.Cast<object>().ToList();

        return (X, Y);
    }

