    private void AddIndicesAndHeaders(string key, string name, Dictionary<object,double> dic)
    {

        if (chartBundles[key].Indices.Keys.Contains(name))
        {
            chartBundles[key].Indices[name] = dic;
        }
        else
        {
            chartBundles[key].Indices.Add(name, dic);
        }

        if (!chartBundles[key].Headers.Contains(name))
        {
            chartBundles[key].Headers.Add(name);
        }


    }


    private async Task ploti(bool args, Element sensor, ChannelDataType channelDataType)
    {

        if (sensor.AttributeElements.Count == 0)
        {
            entitiesService.LoadCollection(sensor, "AttributeElements");
        }

        string name = sensor.Name + " " + "Channel " + channelDataType.Name;
        if (args)
        {
            if (!toBeShown.Contains((sensor, channelDataType))) toBeShown.Add((sensor, channelDataType));



            if (selectedChartsTypes.Contains("TimeDomain") && selectedSourceTypes.Contains("History"))
            {
                List<object[]> la = await GetLa(sensor, channelDataType, startDate, endDate);

                if (la.Count ==0)
                {
                    await JsRuntime.InvokeVoidAsync("alert", "No Data available...");
                    return;
                }

                IList<object> X = la.Select(x => x[0]).ToList();
                IList<object> Y = la.Select(x => x[2]).ToList();

                var dates = X.Cast<DateTime>();

                startDate = dates.Min();
                endDate = dates.Max();


                if (dygraph)
                {
                    var x = X;
                    var y = Y.Cast<double>();

                    Dictionary<object, double> dic;

                    if (!concatenate)
                    {

                        dic = x.Zip(y, (key, value) => new { key, value })
                                             .ToDictionary(pair => pair.key, pair => pair.value);
                    }
                    else
                    {


                        var dic0 = X
        .Cast<DateTime>()
        .Zip(Y.Cast<double>(), (t, v) => new { t, v })
        .OrderBy(p => p.t)
        .ToList();

                        // 2) choose a threshold for “device off” gaps
                        var gapThreshold = TimeSpan.FromSeconds(1);  // e.g. any gap >1s is a break

                        // 3) walk it, accumulating an offset whenever we see a gap
                        var newDic = new Dictionary<object, double>();  // <— note object key
                        DateTime segmentStart = dic0.First().t;
                        DateTime? lastTime = null;
                        double cumulativeOffset = 0.0;

                        foreach (var pt in dic0)
                        {
                            if (lastTime.HasValue && (pt.t - lastTime.Value) > gapThreshold)
                            {
                                // we’ve hit a huge gap → close the last segment
                                var segmentDuration = (lastTime.Value - segmentStart).TotalSeconds;
                                cumulativeOffset += segmentDuration;
                                segmentStart = pt.t;
                            }

                            // compute “time since start of this segment” plus whatever we’ve accumulated
                            var relSec = (pt.t - segmentStart).TotalSeconds + cumulativeOffset;
                            newDic[relSec] = pt.v;

                            lastTime = pt.t;
                        }

                        // // 4) now newDic’s keys are in seconds, start at zero, and all gaps removed
                        // chartBundles["TimeDomainHistory"].Indices[name] = newDic;
                        // chartBundles["TimeDomainHistory"].Headers.Add(name);
                        dic = newDic;

                    }

                    //chartBundles["TimeDomainHistory"].Indices.Add(name, dic);
                    //chartBundles["TimeDomainHistory"].Headers.Add(name);
