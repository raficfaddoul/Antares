    async void OnChangeSelectedChartTypes(bool args, string chartType)
    {
        if (args)
        {
            if (chartType == "ModalDeformation")
            {
                if (str == null)
                {
                    str = await Structural.Simulation.CreateStructure(appData.Structure, null, entitiesService);
                }

                if ((ValeursPropres == null) || (VecteursPropres == null))
                {
                    ValeursPropres = Structural.StructuralVibration.Calcul_ValeursPropres(str.element,
                    str.noeud, str.MasseNodale, str.CL, out VecteursPropres);
                }
            }


            selectedChartsTypes.Add(chartType);

            foreach (var v in selectedSensorsChannelDataTypes)
            {
                await ploti(true, v.Item1, v.Item2);
            }
        }
        else
        {
            foreach (var chb in chartBundles.Keys)
            {
                if (chb.Contains(chartType))
                {
                   // if (chartBundles[chb].Indices.Count != 0)
                    {
                      //  await iitc[chb].RemoveFromJavascript();
                    //    iitc.Remove(chb);
                    }
                    if (chartBundles[chb].Data.Count != 0)
                    {
                        await chartBundles[chb].Chart.Clear();

                    }
                }

            }


            if (chartType == "ModalDeformation")
            {
                ValeursPropres = null;
                VecteursPropres = null;
            }



            selectedChartsTypes.Remove(chartType);

            Selected = !Selected;
            this.StateHasChanged();
            await Task.Delay(100);
            Selected = !Selected;

            this.StateHasChanged();

        }
    }

    async Task OnChangeSelectedSourceTypes(bool args, string sourceType)
    {
        if (args)
        {
            if (sourceType == "Simulation")
            {
                isSimulating = true;


                if (str == null)
                {
                    str = await Task.Run(() => Structural.Simulation.CreateStructure(appData.Structure, selectedLoadCases, entitiesService));
                }

                if ((qTime == null) || simpaChanged)
                {
                    qTime = StructuralTimeIntegration.Calcul_Dynamique(duree: simPa.Duree, nbReponse: simPa.SamplingFrequency,
        nbIntegration: simPa.SamplingFrequency * 10, nddl: str.nddl, noeud: str.noeud, element: str.element,
         CL: str.CL, MasseNodale: str.MasseNodale,
        str.ChargesStatiquePonctuelles, str.ChargesStatiqueReparties, str.ChargesDynamiquePonctuelles,
           str.ChargesDynamiqueReparties, str.ChargesMobiles);

                    if (simPa.WriteCSV)
                    {
                        string path = FileManagementService.GetFilesLocation(appData.Structure, @"wwwroot\CSVs").Item1;
                        if (!Directory.Exists(path))
                        {
                            Directory.CreateDirectory(path);
                        }
                        string fileName = Path.Combine(path, "SimulationResults.csv");
                        await Helpers.Helpers.WriteArrayToCsvAsync(qTime, fileName);

                    }

                    simpaChanged = false;
                }
                isSimulating = false;
            }
            selectedSourceTypes.Add(sourceType);

            foreach (var v in selectedSensorsChannelDataTypes)
            {
                await ploti(true, v.Item1, v.Item2);
            }

        }
        else
        {
            if (sourceType == "Simulation")
            {
                str = null;
                qTime = null;
                simpaChanged = true;
            }

            foreach (var chb in chartBundles.Keys)
            {
                if (chb.Contains(sourceType))
                {
                    if (chartBundles[chb].Data.Count != 0)
                    {
                        await chartBundles[chb].Chart.Clear();
                    }
                }

            }

            selectedSourceTypes.Remove(sourceType);

            Selected = !Selected;
            this.StateHasChanged();
            await Task.Delay(100);
            Selected = !Selected;

            this.StateHasChanged();

        }
    }



