@using System.Threading
@using AliantWebS.Data
@using System.Globalization;
@using System.Text
@inject NavigationManager navigationManager
@inject IJSRuntime JSRuntime
@inject DataUpdateService DataUpdateService

<style>
    #darkbg .dygraph-axis-label {
        color: white;
    }

    .dygraph-legend {
        text-align: right;
    }

    #darkbg .dygraph-legend {
        background-color: #101015;
    }

    /* Assurer que le conteneur a une hauteur appropriée pour le zoom slider */
    .chart-container-with-zoom {
        height: 100%;
        width: 100%;
        display: flex;
        flex-direction: column;
        min-height: 350px; /* Espace supplémentaire pour le slider */
    }
</style>

<div class="chart-container-with-zoom">
    <div id="@GraphId" style="height: 100%; width: 100%; min-height: 350px;"></div>
</div>

@code {
    [Parameter]
    public string GraphId { get; set; }

    [Parameter]
    public List<Dictionary<object, double>> Indices { get; set; }

    private List<string> dataPoints = new List<string>();

    [Parameter]
    public List<string> Headers { get; set; } 

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initializeDygraph", GraphId, "Date", "");
            await DisplayData(Indices, Headers);
        }
    }

    public async Task DisplayData(List<Dictionary<object, double>> Indices, List<string> Headers, DateTime? startDate = null)
    {
        try
        {
            // Si il n'y a pas de données, envoyer CSV minimal
            bool noData = (Indices == null || Indices.Count == 0)
                          || Indices.All(d => d == null || d.Count == 0);

            if (noData)
            {
                string emptyCsv = string.Join(",", Headers) + "\n";
                await JSRuntime.InvokeVoidAsync("updateDygraph", GraphId, emptyCsv);
                StateHasChanged();
                return;
            }

            // Traitement normal des données
            var firstNonEmpty = Indices.First(d => d.Count > 0);
            object sampleKey = firstNonEmpty.Keys.First();
            bool isDateTimeKey = sampleKey is DateTime;

            var allKeys = new List<object>();
            foreach (var dic in Indices)
            {
                foreach (var key in dic.Keys)
                {
                    allKeys.Add(key);
                }
            }

            List<object> sortedKeys;
            if (isDateTimeKey)
            {
                sortedKeys = allKeys.Cast<DateTime>().OrderBy(dt => dt).Cast<object>().ToList();
            }
            else
            {
                sortedKeys = allKeys
                    .Select(o => new
                    {
                        Original = o,
                        Num = Convert.ToDouble(o, CultureInfo.InvariantCulture)
                    })
                    .OrderBy(p => p.Num)
                    .Select(p => p.Original)
                    .ToList();
            }

            var sb = new StringBuilder();
            sb.AppendLine(string.Join(",", Headers));

            foreach (var key in sortedKeys)
            {
                var rowCells = new List<string>();

                if (isDateTimeKey)
                {
                    var dt = (DateTime)key;
                    rowCells.Add(dt.ToString("yyyy-MM-dd HH:mm:ss.fff", CultureInfo.InvariantCulture));
                }
                else
                {
                    double val = Convert.ToDouble(key, CultureInfo.InvariantCulture);
                    rowCells.Add(val.ToString(CultureInfo.InvariantCulture));
                }

                foreach (var dic in Indices)
                {
                    if (dic.TryGetValue(key, out double yVal))
                    {
                        rowCells.Add(yVal.ToString(CultureInfo.InvariantCulture));
                    }
                    else
                    {
                        rowCells.Add("");
                    }
                }

                sb.AppendLine(string.Join(",", rowCells));
            }

            string csvData = sb.ToString();
            await JSRuntime.InvokeVoidAsync("updateDygraph", GraphId, csvData, startDate?.ToString("yyyy-MM-dd HH:mm:ss.fff", CultureInfo.InvariantCulture));
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error while building CSV for Dygraph: {ex.Message}");
        }
    }

    public async Task RemoveFromJavascript()
    { 
        await JSRuntime.InvokeVoidAsync("removeDygraph", GraphId); 
    }
}