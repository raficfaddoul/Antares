@using System.Threading
@using AliantWebS.Data
@using System.Globalization;
@using System.Text
@inject NavigationManager navigationManager
@inject IJSRuntime JSRuntime
@inject DataUpdateService DataUpdateService
@implements IDisposable

<style>
    #darkbg .dygraph-axis-label {
        color: white;
    }

    .dygraph-legend {
        text-align: right;
    }

    #darkbg .dygraph-legend {
        background-color: #101015;
    }

    .chart-container-with-zoom {
        position: relative;
        height: 100%;
        width: 100%;
        min-height: 300px;
        display: flex;
        flex-direction: column;
    }

    /* Takes the height the axis notice leaves; dygraphInterop.js resizes the graph when it changes. */
    .chart-flex-row {
        display: flex;
        flex: 1 1 auto;
        min-height: 0;
        width: 100%;
    }

    /* PlotAxes.Notice: several channels drawn on one axis, so on one scale. */
    .chart-axis-notice {
        flex: 0 0 auto;
        padding: 3px 10px;
        margin-bottom: 4px;
        border-left: 3px solid #e0a030;
        background: #fff6e5;
        color: #6b4500;
        font-size: 0.8rem;
    }

    .dygraph-plot {
        flex: 1 1 auto;
        min-width: 0;
        height: 100%;
        position: relative;
    }

    /* Dedicated scrollable legend panel to the right of the plot (dygraph labelsDiv target),
       so ~30 series (each manille × temperature + weight) no longer overflow/clip the chart. */
    .dygraph-side-legend {
        flex: 0 0 210px;
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
        text-align: left;
        border-left: 1px solid #e2e2e8;
        background: #fafafb;
        padding: 8px 10px;
        font-size: 0.75rem;
        line-height: 1.5;
        box-sizing: border-box;
    }

    /* A point note (see DisplayData's pointNotes) under the selected point's values. */
    .dygraph-point-note {
        font-weight: 600;
    }

    /* The right-click menu on a curve (see PointDeleteRequested), built by dygraphInterop.js in the document body. */
    .dygraph-point-menu {
        position: fixed;
        z-index: 10001;
        min-width: 220px;
        max-width: 340px;
        background: #fff;
        border: 1px solid #d0d0d8;
        border-radius: 6px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
        padding: 4px 0;
        font: 13px "Segoe UI", Arial, sans-serif;
        color: #212529;
    }

    .dygraph-point-menu-title {
        padding: 4px 12px 6px;
        border-bottom: 1px solid #ececf0;
        font-size: 12px;
        color: #555;
    }

    .dygraph-point-menu-item {
        display: block;
        width: 100%;
        padding: 6px 12px;
        border: 0;
        background: none;
        text-align: left;
        color: #b02a37;
        cursor: pointer;
    }

    .dygraph-point-menu-item:hover,
    .dygraph-point-menu-item:focus {
        background: #f8e6e8;
        outline: none;
    }

    .dygraph-point-menu-hint {
        padding: 4px 12px 2px;
        border-top: 1px solid #ececf0;
        font-size: 11px;
        color: #777;
    }
</style>

<div class="chart-container-with-zoom">
    @if (axisNotice != null)
    {
        <div class="chart-axis-notice">@axisNotice</div>
    }
    <div class="chart-flex-row">
        <div id="@GraphId" class="dygraph-plot"></div>
        <div id="@(GraphId)_legend" class="dygraph-side-legend"></div>
    </div>
</div>

@code {
    [Parameter]
    public string GraphId { get; set; }

    [Parameter]
    public List<Dictionary<object, double>> Indices { get; set; }

    [Parameter]
    public List<string> Headers { get; set; }

    // How dygraph is given the first CSV column; point notes name their x the same way.
    const string CsvDateFormat = "yyyy-MM-dd HH:mm:ss.fff";

    /// <summary>Text shown under the value of a series' point at a date, see DisplayData.</summary>
    public sealed record PointNote(string Series, DateTime At, string Text);

    /// <summary>A point right-clicked on a curve: its series' header, its x as <see cref="CsvX"/> writes it, its y.</summary>
    public sealed record ChosenPoint(string Series, string X, double Y);

    /// <summary>
    /// Set, right-clicking on a curve opens a menu offering to delete the point under the pointer, and the choice
    /// comes here. The browser's own menu (copy or save the image) stays a second right-click away, and is the one
    /// shown away from the curves. Unset, the chart keeps the browser's menu only.
    /// </summary>
    [Parameter]
    public EventCallback<ChosenPoint> PointDeleteRequested { get; set; }

    DotNetObjectReference<IndicesInTimeComponent> selfRef;
    bool graphCreated;
    bool pointDeleteMenuOn;
    string axisNotice;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initializeDygraph", GraphId, "Date", "");
            graphCreated = true;
            await DisplayData(Indices, Headers);
        }

        // Followed on every render: a parent may learn after its first render that it handles deletions.
        if (graphCreated && PointDeleteRequested.HasDelegate != pointDeleteMenuOn)
        {
            pointDeleteMenuOn = PointDeleteRequested.HasDelegate;
            selfRef ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("setPointDeleteMenu", GraphId, pointDeleteMenuOn ? selfRef : null);
        }
    }

    [JSInvokable]
    public Task OnPointDeleteChosen(string series, string x, double y) =>
        PointDeleteRequested.InvokeAsync(new ChosenPoint(series, x, y));

    /// <summary>A key of the data as the CSV's first column writes it, which is how a ChosenPoint names its x.</summary>
    public static string CsvX(object key) => key is DateTime at
        ? at.ToString(CsvDateFormat, CultureInfo.InvariantCulture)
        : Convert.ToDouble(key, CultureInfo.InvariantCulture).ToString(CultureInfo.InvariantCulture);

    public void Dispose() => selfRef?.Dispose();

    /// <param name="axes">The Y axis of each curve and the axes' labels; its notice is shown above the plot. Unset,
    /// every curve is on the left axis.</param>
    /// <param name="pointNotes">Shown under a point's value, in the legend and the curve tooltip, while the pointer
    /// is on it. They go with the data, so the graph redraws once; none puts dygraph's own legend back.</param>
    public async Task DisplayData(
        List<Dictionary<object, double>> Indices,
        List<string> Headers,
        DateTime? startDate = null,
        PlotAxes axes = null,
        IReadOnlyList<PointNote> pointNotes = null)
    {
        // x written like the CSV's first column, which dygraphInterop.js parses the same way.
        var notes = (pointNotes ?? Array.Empty<PointNote>())
            .Select(n => new { series = n.Series, x = CsvX(n.At), text = n.Text })
            .ToList();

        try
        {
            // If no data, send minimal CSV
            bool noData = (Indices == null || Indices.Count == 0)
                          || Indices.All(d => d == null || d.Count == 0);

            if (noData)
            {
                string emptyCsv = string.Join(",", Headers) + "\n";
                // Clear the data AND the axis labels. updateDygraphFast only updates the data,
                // so the previous ylabel/y2label lingered when every series was deselected.
                // No points, so no notes: the empty list also clears any the graph had.
                await JSRuntime.InvokeVoidAsync("updateDygraphWithAxes", GraphId, emptyCsv,
                    new Dictionary<string, string>(), "", "", Array.Empty<object>());
                await ShowAxisNotice(null);
                return;
            }

            // Determine key type
            var firstNonEmpty = Indices.First(d => d.Count > 0);
            object sampleKey = firstNonEmpty.Keys.First();
            bool isDateTimeKey = sampleKey is DateTime;

            // Use HashSet to collect UNIQUE keys only
            var uniqueKeys = new HashSet<object>();
            foreach (var dic in Indices)
            {
                foreach (var key in dic.Keys)
                {
                    uniqueKeys.Add(key);
                }
            }

            // Sort the unique keys
            List<object> sortedKeys;
            if (isDateTimeKey)
            {
                sortedKeys = uniqueKeys.Cast<DateTime>().OrderBy(dt => dt).Cast<object>().ToList();
            }
            else
            {
                sortedKeys = uniqueKeys
                    .Select(o => new { Original = o, Num = Convert.ToDouble(o, CultureInfo.InvariantCulture) })
                    .OrderBy(p => p.Num)
                    .Select(p => p.Original)
                    .ToList();
            }

            // Build CSV efficiently
            int seriesCount = Indices.Count;
            int estimatedSize = sortedKeys.Count * (seriesCount * 15 + 30);
            var sb = new StringBuilder(estimatedSize);
            
            // Header line
            sb.AppendLine(string.Join(",", Headers));

            // Pre-allocate row buffer
            var rowBuffer = new string[seriesCount + 1];

            foreach (var key in sortedKeys)
            {
                // First column: timestamp/key
                rowBuffer[0] = CsvX(key);

                // Value columns
                for (int i = 0; i < seriesCount; i++)
                {
                    rowBuffer[i + 1] = Indices[i].TryGetValue(key, out double yVal) 
                        ? yVal.ToString(CultureInfo.InvariantCulture) 
                        : "";
                }

                sb.AppendLine(string.Join(",", rowBuffer));
            }

            string csvData = sb.ToString();

            if (axes != null)
            {
                await JSRuntime.InvokeVoidAsync("updateDygraphWithAxes", GraphId, csvData, axes.AxisOfSeries, axes.LeftLabel, axes.RightLabel, notes);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("updateDygraphFast", GraphId, csvData, notes);
            }
            await ShowAxisNotice(axes?.Notice);

            Console.WriteLine($"Rendered {sortedKeys.Count:N0} data points for graph '{GraphId}'");
            
            // Log CSV preview for debugging
            Console.WriteLine($"CSV Preview (first 500 chars): {csvData.Substring(0, Math.Min(500, csvData.Length))}");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error while building CSV for Dygraph: {ex.Message}");
        }
    }

    // Renders only when the notice changes; DisplayData may be called off the renderer's thread.
    Task ShowAxisNotice(string notice)
    {
        if (notice == axisNotice)
            return Task.CompletedTask;
        axisNotice = notice;
        return InvokeAsync(StateHasChanged);
    }

    public async Task RemoveFromJavascript()
    {
        await JSRuntime.InvokeVoidAsync("removeDygraph", GraphId);
    }
}