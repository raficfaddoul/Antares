@page "/ModalShapes/"
@using System.Data;
@using AliantWebS.Data
@using Models
@inject IJSRuntime js
@inject AppData appData;
@inject EntitiesService entitiesService

@using Accord.Math;

<div id="canvas-container" style="position:relative; width:100%; height:100%;">
    <canvas id="threejsCanvas" @ref="canvasReference" style="width:100%; height:100%;"></canvas>
    <div id="overlay" style="position:absolute; top:10px; left:10px;">
        <label for="inputNumber" style="color: white;">Mode</label>
        <InputNumber @bind-Value="Mode" type="number" id="inputNumber" style="width:50px" />

    </div>
</div>

@code {
    int mode;


    [Parameter]
    public double[,] VecteursPropres { get; set; }

    [Parameter]
    public List<Guid> SensorsIDs { get; set; }

    [Parameter]
    public bool Simulate { get; set; } = false;


    public int Mode
    {
        get
        {

            return mode;
        }
        set
        {

            if (mode == value) return;
            mode = value;
            _ = SetModeAsync(mode);

        }
    }


    Structural.Structure structuralStructure = null;


    [Parameter]
    public Structure structure { get; set; }

    private ElementReference canvasReference;




    protected override async Task OnInitializedAsync()
    {

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            if (structure == null) return;
            try
            {

                structuralStructure = await Structural.Simulation.CreateStructure(structure, null, entitiesService);

            }
            catch (Exception ex)
            {
                await js.InvokeVoidAsync("alert", "Could not create structure...");
                return;

            }

            if (VecteursPropres == null && !Simulate)
            {
                return;
            }

            await DoTheWork();

        }
    }



    protected async Task DoTheWork()
    {
        if (structuralStructure == null) return;


        //Structural.Structure structuralStructure = new Structural.Structure();
        //structuralStructure.LoadStructure("Poutre_Pont", 1);

        var lines = new List<List<double>>();

        var nodes = new List<List<int>>();


        var names = new List<(string ElementName, string Node1Name, string Node2Name, double Startx, double Starty, double Endx, double Endy)>();

        foreach (DataRow el in structuralStructure.element.Rows)
        {
            int n1 = el.Field<int>("Noeudi");
            int n2 = el.Field<int>("Noeudj");
            double x1 = structuralStructure.noeud[n1][0];
            double y1 = structuralStructure.noeud[n1][1];

            double x2 = structuralStructure.noeud[n2][0];
            double y2 = structuralStructure.noeud[n2][1];


            List<double> line = new List<double>
            {
                x1,y1,0,x2,y2,0
            };

            string elementName = appData.Structure.Elements.First(x1 => x1.ElementId == el.Field<Guid>("Guid")).Name;
            string node1Name = appData.Structure.Elements.First(x1 => x1.ElementId == structuralStructure.guidsNoeuds[n1]).Name;
            string node2Name = appData.Structure.Elements.First(x1 => x1.ElementId == structuralStructure.guidsNoeuds[n2]).Name;


            names.Add((elementName, node1Name, node2Name, x1, y1, x2, y2));

            List<int> node = new List<int>
            {
                n1,n2
            };

            lines.Add(line);
            nodes.Add(node);

        }

        double[][] VecteursPropresJagged;

        if (Simulate)
        {
            double[] ValeursPropres = null;
            double[,] SimVecteursPropres = null;
            ValeursPropres = Structural.StructuralVibration.Calcul_ValeursPropres(structuralStructure.element,
    structuralStructure.noeud, structuralStructure.MasseNodale, structuralStructure.CL, out SimVecteursPropres);
            VecteursPropresJagged = Helpers.Helpers.ConvertToJagged(SimVecteursPropres);
        }
        else
        {
            double[,] VecteursPropresRearranged = new double[0, VecteursPropres.GetLength(1)];

            foreach (var guid in structuralStructure.guidsNoeuds)
            {
                int index = SensorsIDs.FindIndex(x => x == guid);
                var rowx = VecteursPropres.GetRow(index);
                var rowy = VecteursPropres.GetRow(index + 1);
                var rowr = VecteursPropres.GetRow(index + 2);
                VecteursPropresRearranged = VecteursPropresRearranged.Stack(rowx);
                VecteursPropresRearranged = VecteursPropresRearranged.Stack(rowy);
                VecteursPropresRearranged = VecteursPropresRearranged.Stack(rowr);

            }

            VecteursPropresJagged = Helpers.Helpers.ConvertToJagged(VecteursPropresRearranged);
        }



        //        var lines = new List<List<double>>
        //{
        //    new List<double> {0, 0, 0, 1, 1, 1},  // Line 1
        //    new List<double> {1, 10, 1, 2, 2, 2}  // Line 2
        //};

        await js.InvokeVoidAsync("threeJsFunctions.initCanvas", canvasReference);
        await js.InvokeVoidAsync("threeJsFunctions.addLines", lines, nodes, VecteursPropresJagged, false);

    }

    private async Task SetModeAsync(int mode)
    {
        await js.InvokeVoidAsync("setMode", mode);
    }

