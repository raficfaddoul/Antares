@page "/Identification"
@using AliantWebS.Data
@using AliantWebS.Models
@using Microsoft.Extensions.Logging
@using System.Net.Sockets

@inject EntitiesService entitiesService
@inject IJSRuntime JsRuntime


@using System.Numerics;
@using Accord.Math;
@using System.Text.Json;
@using System.Globalization;
@using System;
@using System.Threading.Tasks;
@inject Radzen.DialogService DialogService
@inject ILogger<FilesUpload> Logger
﻿@using Plotly.Blazor.LayoutLib
@using Plotly.Blazor.Traces.ScatterLib
@using System.Threading

@inject NavigationManager navigationManager
@inject AppData appData
@inject IStringLocalizer<Languages> L

<NavigationLock OnBeforeInternalNavigation="appData.OnBeforeInternalNavigation" ConfirmExternalNavigation="appData.SaveConfirmation&& appData.SaveChanges" />

@if (somethingToPresent)
{



    <div class="page" Style="display: flex">
        <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
            <RadzenSplitterPane Size="30%">

                <Blazorise.Row>
                    <Column>

                        <RadzenDataGrid AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="10"
                                        Data="@sensors" TItem="Element" ColumnWidth="150px">
                            <Columns>
                                <RadzenDataGridColumn TItem="Element" Property="Name" Title="@L["Sensing Device"]"></RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="Element" Property="Description" Title="@L["Action"]" Width="30px">
                                    <Template Context="element">
                                        <Div Style="display: flex">
                                            <RadzenCheckBox TValue=bool Change=@(args => OnChangeSelectedElements(args,element))></RadzenCheckBox>
                                        </Div>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>


                        <RadzenDataGrid AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="10"
                                        Data="@channelDataTypeList" TItem="ChannelDataType" ColumnWidth="150px">
                            <Columns>
                                     <RadzenDataGridColumn TItem="ChannelDataType" Property="Name" Title="@L["Channel"]"></RadzenDataGridColumn>
                                                               <RadzenDataGridColumn TItem="ChannelDataType" Property="Description" Title="@L["Action"]" Width="30px">
                                    <Template Context="channelDataType">
                                        <Div Style="display: flex">
                                             <RadzenCheckBox TValue=bool Change=@(args => OnChangeSelectedChannelDataTypes(args,channelDataType))></RadzenCheckBox>
                                         </Div>
                                    </Template>
                                </RadzenDataGridColumn>  
                            </Columns>
                        </RadzenDataGrid> 


                        <div style="display:flex">

                            <div class="form-group " style="margin:5px">
                                <div>
                                    <label>@L["Start Date"] :</label>
                                    <div>
                                        <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="@startDate1" />
                                        @*           <ValidationMessage For="@(() => startDate)" />*@
                                    </div>
                                </div>
                            </div>
                            <div class="form-group " style="margin:5px">
                                <div>
                                    <label>@L["End Date"] :</label>
                                    <div>
                                        <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="@endDate1" />
                                        @*           <ValidationMessage For="@(() => startDate)" />*@
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div style="display:flex">

                            <div class="form-group " style="margin:5px">
                                <div>
                                    <label>@L["Start Date"] :</label>
                                    <div>
                                        <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="@startDate2" />
                                        @*           <ValidationMessage For="@(() => startDate)" />*@
                                    </div>
                                </div>
                            </div>
                            <div class="form-group " style="margin:5px">
                                <div>
                                    <label>@L["End Date"] :</label>
                                    <div>
                                        <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="@endDate2" />
                                        @*           <ValidationMessage For="@(() => startDate)" />*@
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="Category" class="control-label">@L["Shift Type"]</label>
                            <InputSelect TValue="string" class="form-control" @bind-Value="@IdentificationTechnique">
                                <option value="choose">@L["Choose Identification Technique"]...</option>
                                <option value="Ibrahim">@L["Ibrahim"]...</option>
                                <option value="SSI">@L["SSI"]...</option>
                                <option value="RandomDecrement">@L["Random Decrement"]...</option>
                                <option value="DefectDefection">@L["Defect Deflection"]...</option>
                            </InputSelect>
                        </div>

                    </Column>


                </Blazorise.Row>


            </RadzenSplitterPane>

            <RadzenSplitterPane Size="70%">

                @if (techniqueToPresent)
                {
                @switch (IdentificationTechnique)
                {

                    case "Ibrahim":
                        <IbrahimComponent startDate1="@startDate1" startDate2="@startDate2" endDate1="@endDate1" endDate2="@endDate2" ListJson="@param" ListJson1="@param1"></IbrahimComponent>

                        break;

                    case "SSI":
                        @* navigationManager.NavigateTo("/SSI/" + param);*@
                        break;

                    case "RandomDecrement":
                        @*  navigationManager.NavigateTo("/RandomDecrement/" + param);*@
                        break;
                    case "DefectDefection":
                        @* navigationManager.NavigateTo("/DefectDefection/" + param);*@
                        break;
                }
                }


            </RadzenSplitterPane>
        </RadzenSplitter>
    </div>


}

@code {

    string param;
    string param1;



    string identificationTechnique = "choose";

    public string IdentificationTechnique
    {
        get
        {

            return identificationTechnique;
        }
        set
        {

            //if (identificationTechnique == value) return;
            identificationTechnique = value;
            _ = Identify();

        }
    }








    bool somethingToPresent = false;
    bool techniqueToPresent = false;


    bool oneElement = false;

    Structure st = new Structure();


    IEnumerable<Guid?> elementTypesIDs;


    DateTime startDate1 { get; set; } = DateTime.UnixEpoch;// new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc);
    DateTime endDate1 { get; set; } = DateTime.UtcNow;

    DateTime startDate2 { get; set; } = DateTime.UnixEpoch;// new DateTime(1970, 1, 1, 0, 0, 0, DateTimeKind.Utc);
    DateTime endDate2 { get; set; } = DateTime.UtcNow;




    [Parameter] public EventCallback OnValidSubmit { get; set; }


  //  private const string ServerHost = "localhost";
  //  private const int ServerPort = 8000;

  //  private List<string> filterAddress = new List<string>();

    List<ChannelDataTypeElementType> channelDataTypeElementTypeList;

    List<Element> sensors;
    List<Element> selectedElements { get; set; } = new List<Element>();


    List<ChannelDataType> channelDataTypeList;
    List<ChannelDataType> selectedChannelDataTypes { get; set; } = new List<ChannelDataType>();


    private const int MaxDataPoints = 100;

    DateTime dt1 = DateTime.Now;
    DateTime dt2 = DateTime.Now;


    protected override async Task OnInitializedAsync()
    {


    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {

        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            somethingToPresent = false;
            techniqueToPresent = false;


            entitiesService.LoadCollection(appData.Structure, "Elements");

          


            sensors = await entitiesService.GetFilteredEntitiesAsync<Element>(a => ((a.StructureId  == appData.Structure.StructureId)
                        && ((a.ElementType?.ChannelDataTypeElementTypes?.Count ?? 0) > 0)), "ElementType.ChannelDataTypeElementTypes");


            elementTypesIDs = sensors.Select(x => x.ElementTypeId);

            channelDataTypeElementTypeList = await entitiesService.GetFilteredEntitiesAsync<ChannelDataTypeElementType>(a => elementTypesIDs.Contains(a.ElementTypeId), "ChannelDataType");

            channelDataTypeList = channelDataTypeElementTypeList.Select(x => x.ChannelDataType).Distinct().ToList();

            if (channelDataTypeList.Count() > 0)
            {
                somethingToPresent = true;
                if (sensors.Count == 1)
                {
                    oneElement = true;
                }


            }
            else
            {
                await JsRuntime.InvokeVoidAsync("alert", "no DataChannels available...");
            }
        }

        catch (Exception ex)
        {
            navigationManager.NavigateTo("Structures");
        }

    }



    void OnChangeSelectedElements(bool args, Element element)
    {
        if (args)
        {

            selectedElements.Add(element);
        }
        else
        {
            selectedElements.Remove(element);
        }
    }




    void OnChangeSelectedChannelDataTypes(bool args, ChannelDataType channelDataType)
    {
        if (args)
        {

            selectedChannelDataTypes.Add(channelDataType);
        }
        else
        {
            selectedChannelDataTypes.Remove(channelDataType);
        }
    }



    private async Task Identify()
    {
        techniqueToPresent = false;
        var listIDs = selectedElements.Select(x => x.ElementId);
        param = JsonSerializer.Serialize(listIDs);

        var listCDTIDs = selectedChannelDataTypes.Select(x => x.ChannelDataTypeId);
        param1 = JsonSerializer.Serialize(listCDTIDs);


        if (listIDs.Count() == 0)
        {
            await JsRuntime.InvokeVoidAsync("alert", "Select one or more sensors...");
            identificationTechnique = "choose";
            StateHasChanged();
            return;
        }

        if (listCDTIDs.Count() == 0)
        {
            await JsRuntime.InvokeVoidAsync("alert", "Select one or more Data Channel Type...");
            identificationTechnique = "choose";
            StateHasChanged();
            return;
        }

        if (appData.Structure == null)
        {
            await JsRuntime.InvokeVoidAsync("alert", "Structure is null...");
            identificationTechnique = "choose";
            StateHasChanged();
            return;
        }

        techniqueToPresent = true;

        //switch (IdentificationTechnique)
        //{

        //    case "Ibrahim":
        //        navigationManager.NavigateTo("/Ibrahim/" + param + "/" + param1);
        //        break;

        //    case "SSI":
        //        navigationManager.NavigateTo("/SSI/" + param);
        //        break;

        //    case "RandomDecrement":
        //        navigationManager.NavigateTo("/RandomDecrement/" + param);
        //        break;
        //    case "DefectDefection":
        //        navigationManager.NavigateTo("/DefectDefection/" + param);
        //        break;
        //}




    }


}
