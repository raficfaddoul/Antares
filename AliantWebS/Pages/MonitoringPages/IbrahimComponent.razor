@page "/Ibrahim/{ListJson}/{ListJson1}"
@using System.Data;
@using AliantWebS.Data
@using AliantWebS.Models
@using System.Text.Json;
﻿@using Plotly.Blazor.LayoutLib
@using Plotly.Blazor.Traces.ScatterLib
@inject IStringLocalizer<Languages> L
@inject IJSRuntime JsRuntime
@inject EntitiesService entitiesService

@inject AliantWebS.Data.AppData appData

<RadzenSplitter Orientation="Radzen.Orientation.Vertical" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
    <RadzenSplitterPane Size="auto">
        <EditForm Model="appData.Structure" id="StructureFormId" OnValidSubmit="@OnValidSubmit">
            <DataAnnotationsValidator />
            <Blazorise.Row>
                <Column ColumnSize="ColumnSize.Is6">
                    <div class="form-group ">
                        <div>
                            <label>@L["Number of time steps"] :</label>
                            <div>
                                <InputNumber @bind-Value="@nbTimeSteps" />
                                <ValidationMessage For="@(() => nbTimeSteps)" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group ">
                        <div>
                            <label>@L["Time step"] :</label>
                            <div>
                                <InputNumber @bind-Value="@timeStep" />
                                <ValidationMessage For="@(() => timeStep)" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group ">
                        <div>
                            <label>@L["Number of modes"] :</label>
                            <div>
                                <InputNumber @bind-Value="@nbModes" />
                                <ValidationMessage For="@(() => nbModes)" />
                            </div>
                        </div>
                    </div>
                </Column>



                <Column ColumnSize="ColumnSize.Is6">
                    <div class="form-group ">
                        <div>
                            <label>@L["Time step"] :</label>
                            <div>
                                <InputNumber @bind-Value="@timeStep" />
                                <ValidationMessage For="@(() => timeStep)" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group ">
                        <div>
                            <label>@L["Nb Analysis Steps"] :</label>
                            <div>
                                <InputNumber @bind-Value="@nbAnalysisSteps" />
                                <ValidationMessage For="@(() => nbAnalysisSteps)" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group ">
                        <div>
                            <label>@L["Nb Series Averaging"] :</label>
                            <div>
                                <InputNumber @bind-Value="@nbSeriesAveraging" />
                                <ValidationMessage For="@(() => nbSeriesAveraging)" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="Category" class="control-label">@L["Shift Type"]</label>
                        <InputSelect TValue="string" class="form-control" @bind-Value="@shiftType">
                            <option value="Automatic">@L["Automatic"]...</option>
                            <option value="Constant">@L["Constant"]...</option>
                            <option value="Adaptif">@L["Adaptif"]...</option>
                        </InputSelect>
                    </div>


                </Column>
            </Blazorise.Row>
            <Blazorise.Row>
                <Column>
                    <div style="display:flex">
                    <button type="button" class="btn btn-success" @onclick="@Calcul">
                        @L["Calcul"]
                    </button>
                    <InputNumber @bind-Value=@vp1></InputNumber>
                        <InputNumber @bind-Value=@vp2></InputNumber>
                    </div>
 
                </Column>
            </Blazorise.Row>
        </EditForm>

    </RadzenSplitterPane>
    <RadzenSplitterPane>
        <PlotlyChart style="height:100%;width:100%" @bind-Config="@chartBundles["modalDeformation"].Config" @bind-Layout="@chartBundles["modalDeformation"].Layout" @bind-Data="@chartBundles["modalDeformation"].Data" @ref=@chartBundles["modalDeformation"].Chart />



    </RadzenSplitterPane>
</RadzenSplitter>


@code {




    [Parameter] public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public string ListJson { get; set; }
    [Parameter]
    public string ListJson1 { get; set; }
    [Parameter] public int nbDDL { get; set; }

    [Parameter] public DateTime startDate1 { get; set; }
    [Parameter] public DateTime endDate1 { get; set; }

    [Parameter] public DateTime startDate2 { get; set; }
    [Parameter] public DateTime endDate2 { get; set; }

    int nbTimeSteps { get; set; } = 1000;
    double timeStep { get; set; } = 1000;
    string shiftType { get; set; } = "Automatic";
    int nbModes { get; set; } = 10;
    int nbAnalysisSteps { get; set; } = 100;
    int nbSeriesAveraging { get; set; } = 20;


    int vp1;
    int vp2;

    public class PlotlyChartBundle
    {
        public PlotlyChart Chart { get; set; }
        public Plotly.Blazor.Config Config { get; set; }
        public Plotly.Blazor.Layout Layout { get; set; }
        public IList<ITrace> Data { get; set; }

        public PlotlyChartBundle()
        {
            Chart = new PlotlyChart();
            Config = new Plotly.Blazor.Config();
            //  Layout = new Plotly.Blazor.Layout();

            Layout = new Plotly.Blazor.Layout()
                {
                    //Title = new Title { Text = "Time Series Plot" },
                    XAxis = new[]
                                                        {
                new XAxis
                {
                    Title = new Plotly.Blazor.LayoutLib.XAxisLib.Title
                    {
                        Text = "Index"
                    },
                    TickFormat = "%Y-%m-%d %H:%M:%S",

                    //DTick=1,

                }
            }
                };

            Data = new List<ITrace>();

        }
    }

    Dictionary<string, PlotlyChartBundle> chartBundles = new Dictionary<string, PlotlyChartBundle>();

    Structural.Structure structuralStructure;

    protected override async Task OnInitializedAsync()
    {
        PlotlyChartBundle modalDeformation1ChartBundle = new PlotlyChartBundle();
   

        chartBundles.Add("modalDeformation", modalDeformation1ChartBundle);
 
    }

    private void gg()
    {
        chartBundles["modalDeformation"].Data.Clear();
        structuralStructure = Structural.Simulation.CreateStructure(appData.Structure,null, entitiesService);

        double[] ValeursPropres = null;
        double[,] VecteursPropres = null;

        List<object> X;
        List<object> Y;


        X = new List<object>();
        Y = new List<object>();
        ValeursPropres = Structural.StructuralVibration.Calcul_ValeursPropres(structuralStructure.element,
    structuralStructure.noeud, structuralStructure.MasseNodale, structuralStructure.CL, out VecteursPropres);

        for (int i = 0; i < structuralStructure.noeud.Count; i++)
        {
            X.Add(structuralStructure.noeud[i][0]);
            Y.Add(VecteursPropres[i * 3 + 1, vp1]);
        }

        PlotData("Deformee modale 1", X, Y, chartBundles["modalDeformation"].Data);


        ////////////////////////////////////////


        X = new List<object>();
        Y = new List<object>();

        structuralStructure.element.Rows[13]["E"] = structuralStructure.element.Rows[13].Field<double>("E") * 0.2;

        ValeursPropres = Structural.StructuralVibration.Calcul_ValeursPropres(structuralStructure.element,
    structuralStructure.noeud, structuralStructure.MasseNodale, structuralStructure.CL, out VecteursPropres);

        for (int i = 0; i < structuralStructure.noeud.Count; i++)
        {
            X.Add(structuralStructure.noeud[i][0]);
            Y.Add(VecteursPropres[i * 3 + 1, vp2]);
        }

        PlotData("Deformee modale 2", X, Y, chartBundles["modalDeformation"].Data);
        chartBundles["modalDeformation"].Chart.Update();
        this.StateHasChanged();
    }

    void PlotData(string name, IList<object> X, IList<object> Y, IList<ITrace> data)
    {
        Scatter sc = new Scatter();

        sc.Name = name;
        sc.Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines;

        sc.X = X;
        sc.Y = Y;

        data.Add(sc);


    }



    /// <summary>
    ///
    /// </summary>
    /// <param name="nbDDL"></param>
    /// <param name="ddlSensors"></param>
    /// <param name="nbTimeSteps"></param>
    /// <param name="timeStep"></param>
    /// <param name="startingTimes"></param>
    /// <param name="Xaccelerations"></param>
    /// <param name="nbPseudoSeries"></param>
    /// <param name="shiftType"></param>
    /// <param name="initialShift"></param>
    /// <param name="nbAnalysisSteps"></param>
    /// <param name="nbModes"></param>
    /// <param name="nbSeriesAveraging"></param>
    /// <param name="frequency"></param>
    /// <param name="modeShape"></param>

    public (double[] Frequency, double[,] ModeShape) IdentifierIbrahim(int nbDDL, int[] ddlSensors,
    int nbTimeSteps, double timeStep, List<int> startingTimes, List<double[,]> Xaccelerations,
    int nbPseudoSeries, string shiftType, int initialShift, int nbAnalysisSteps, int nbModes,
    int nbSeriesAveraging)
    {

        double[] frequency = new double[20];

        double[,] modeShape = new double[20, 2];

        return (Frequency: frequency, ModeShape: modeShape);
    }

    private async Task Calcul()
    {
        List<Guid?> elementsIDs = JsonSerializer.Deserialize<List<Guid?>>(ListJson);

        List<Guid?> ChannelsDataTypeIDs = JsonSerializer.Deserialize<List<Guid?>>(ListJson1);

        List<Element> sensors = await entitiesService.GetFilteredEntitiesAsync<Element>(a => (elementsIDs.Contains(a.ElementId) && (a.ElementType.ChannelDataTypeElementTypes.Count > 0)), "ElementType.ChannelDataTypeElementTypes");
        IEnumerable<Guid?> elementTypesIDs = sensors.Select(x => x.ElementTypeId);


        List<ChannelDataType> channelDataTypeList = await entitiesService.GetFilteredEntitiesAsync<ChannelDataType>(a => (ChannelsDataTypeIDs.Contains(a.ChannelDataTypeId)));

        var v = await Task.Run(() => Structural.Simulation.GetSensedNodes(appData.Structure, entitiesService._appDBContext, sensors));
        int nbDDL = v.nodes.Count;
        int[] ddlSensors = v.sensedNodesIndex.ToArray().Select(x => (int)x.Value).ToArray();





        object[,] la = AI.Helpers.ConvertTo2DArray(await InfluxService.GetDataByTag(sensors.Select(e => e.ElementId.ToString()).ToList(), channelDataTypeList.Select(x => x.ChannelDataTypeId.ToString()).ToList(), startDate1, endDate1));

        if (la.Length == 0)
        {
            await JsRuntime.InvokeVoidAsync("alert", "No related Data in the database...");
            return;
        }



        var table = la;

        // Get distinct sensorIDs and sort them
        var distinctSensors = new SortedSet<string>();
        for (int i = 0; i < table.GetLength(0); i++)
        {
            distinctSensors.Add(table[i, 1].ToString());
        }

        var sensorsList = distinctSensors.ToList();
        int numSensors = sensorsList.Count;

        var distinctDates = new HashSet<DateTime>();
        for (int i = 0; i < table.GetLength(0); i++)
        {
            distinctDates.Add((DateTime)table[i, 0]);
        }

        // Adjust the size of the pivoted table
        object[,] pivotedTable = new object[distinctDates.Count, numSensors + 1];



        // Populate the pivoted table
        Dictionary<DateTime, int> timeRowMapping = new Dictionary<DateTime, int>();
        int currentRow = 0;

        for (int i = 0; i < table.GetLength(0); i++)
        {
            DateTime time = (DateTime)table[i, 0];
            string sensor = table[i, 1].ToString();
            object value = table[i, 2];

            if (!timeRowMapping.ContainsKey(time))
            {
                timeRowMapping[time] = currentRow;
                pivotedTable[currentRow, 0] = time;
                currentRow++;
            }

            int sensorColumn = sensorsList.IndexOf(sensor) + 1;
            pivotedTable[timeRowMapping[time], sensorColumn] = value;
        }



        var qtime = AI.Helpers.ConvertToDoubleArray(pivotedTable);

        int numColumns = pivotedTable.GetLength(1);

        for (int i = 0; i < numColumns; i++)
        {
            AI.Helpers.InterpolateColumn(qtime, i);
        }

        var result = Structural.SP.GetSubsequences(AI.Helpers.ConvertToDoubleMatrix(qtime), sequenceLength: 1000, thresholdPercentage: 0.4, refSensor: 1);

        List<int> trigerPoints = result.TriggerPoints;
        List<double[,]> subsequences = result.Subsequences;

        int nbPseudoSeries = 5;
        int initialShift = 200;

        var resultIbrahim = IdentifierIbrahim(nbDDL, ddlSensors,
                    nbTimeSteps, timeStep, trigerPoints, subsequences, nbPseudoSeries, shiftType, initialShift, nbAnalysisSteps, nbModes, nbSeriesAveraging);
        double[] frequency = resultIbrahim.Frequency;
        double[,] modeShape = resultIbrahim.ModeShape;




        // ////// exemple de save
        // Structural.IdentificationResult ir = new Structural.IdentificationResult();
        // ir.Kpi1 = 76;
        // ir.Kpi2 = 85;
        // ir.Kpi3 = 58;
        // ir.Rigidités = new List<double>() { 1.0075, 0.9982, 0.9747, 0.9801, 1.0098, 1.0015, 0.9829, 0.9749, 0.9731, 0.9753, 0.9907, 0.9983, 1.014, 0.9677, 0.9569, 1.013, 0.9965, 1, 1.0004, 0.9945, 0.989, 0.9908, 0.9991, 0.9966, 0.9873, 0.991, 1.0008, 0.9973 };

        // await ir.Save(appData.Structure);
  

        // //// exemple de load
        // Structural.IdentificationResult ir1 = new Structural.IdentificationResult();
        // ir1 = await ir1.Load(appData.Structure);

   


    }

}
