        // string savePath = forceSavePath is not null ? forceSavePath : Environment.GetEnvironmentVariable("SAVE_PATH") ?? $"{Environment.GetEnvironmentVariable("tmp")}/test.aliant" ?? SelectExistingPath("Enter the file to save result", false);

        static bool triggerRandomdecrement(double previous, double data, double threshold) { return previous < data && data > threshold; }

        List<object[]>? data = await InfluxService.GetData(sensors.Select(s => s.ElementId.ToString()).ToList(), channelDataTypeList.Select(c => c.ChannelDataTypeId.ToString()).ToList(), start, end);
        if (data is null || data.Count == 0)
        {
            await JsRuntime.InvokeVoidAsync("alert", "No data found.\n");
            Console.WriteLine("No data found.");
            return null;
        }

        double[,] matrix = new double[sensors.Count, data.Count / sensors.Count];
        //List<DateTime> times = [];
        List<Guid> sensorIds = new List<Guid>();

        for (int i = 0; i < sensors.Count; ++i)
        {
            Guid guid = sensors[i].ElementId;//   .Select(s => s.ElementId.ToString()).ToList()[i];

            try
            {
                var dataCpt = data.Where(d => d[1].ToString() == guid.ToString()).ToList();
                sensorIds.Add(guid);

                for (int j = 0; j < dataCpt.Count; ++j)
            {
                var d = data[(i + 1) * j];
               // times.Add(DateTime.Parse(d[0].ToString() ?? throw new Exception("No DateTime in influx data")));
                matrix[i, j] = double.Parse(d[2].ToString() ?? throw new Exception("No data in influx"));
            }
            }
            catch (Exception e)
            {
                int k = 1;
            }
        }

        int directiveCaptor = 0;
        double dt = 1 / hertz;

        Ibrahim ibrahim = new(matrix, dt, directiveCaptor, sampleToSave, triggerRandomdecrement, nt, hackelBlock, overlapping);

        IEnumerable<int> indices = ibrahim.GetIndices();
        await ibrahim.SetIndices(indices);

        Matrix<System.Numerics.Complex> vp = await ibrahim.GetVp();
        Vector<System.Numerics.Complex> fp = await ibrahim.GetFp();
        Vector<double> freq = await ibrahim.GetFrequency();
        Vector<double> damping = await ibrahim.GetDamping();
        Matrix<double> modes = await ibrahim.GetModes();
        Console.WriteLine("");

        // var sb = new StringBuilder();

        // for (int i = 0; i < freq.Count; i++)
        // {
        //     sb.Append(freq[i].ToString(CultureInfo.InvariantCulture));
        //     if (i < freq.Count - 1) sb.Append(' ');
        // }
        // sb.AppendLine();

        // for (int i = 0; i < damping.Count; i++)
        // {
        //     sb.Append(damping[i].ToString(CultureInfo.InvariantCulture));
        //     if (i < damping.Count - 1) sb.Append(' ');
        // }
        // sb.AppendLine();

        // foreach (var mode in modes.EnumerateRows())
        // {
        //     for (int i = 0; i < mode.Count; i++)
        //     {
        //         sb.Append(mode[i].ToString(CultureInfo.InvariantCulture));
        //         if (i < mode.Count - 1) sb.Append(' ');
        //     }
        //     sb.AppendLine();
        // }

        double[,] modesArray = modes.ToArray();


        return (freq, damping, modes, modesArray, sensorIds);

        // await JsRuntime.InvokeVoidAsync("downloadCsvFile",savePath1, Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(sb.ToString())));
        //return sb.ToString();
    }

    async Task Compare()
    {

        double frenquenciesErrorRate = double.Parse(Environment.GetEnvironmentVariable("FREQUENCIES_ERROR_RATE") ?? "0.05", CultureInfo.InvariantCulture);
        double rejectLevelMac = double.Parse(Environment.GetEnvironmentVariable("REJECT_LEVEL_MAC") ?? "0.8", CultureInfo.InvariantCulture);


        var res1 = await Calculate(startDate1,endDate1);
        var res2 = await Calculate(startDate2,endDate2);


        List<FileResults> filesResult = [];
        filesResult.Add(new FileResults(res1.Value.frequencies, res1.Value.damping, res1.Value.modes));
        filesResult.Add(new FileResults(res2.Value.frequencies, res2.Value.damping, res2.Value.modes));


        List<FileResults> ModeMatched = LDM.MatchModes(filesResult[0], filesResult[1]).ToList();

        for (int i = 0; i < ModeMatched[0].Frequencies.Count; ++i)
        {
            Console.WriteLine($"Frequencies {i} ({ModeMatched[0].Frequencies[i]} != {ModeMatched[1].Frequencies[i]})");
            if (!LDM.IsSameFrequences(ModeMatched[0].Frequencies[i], ModeMatched[1].Frequencies[i], frenquenciesErrorRate))
            {
                Console.WriteLine($"Freq are not the same");
            }
            var mac = LDM.Mac(Matrix<double>.Build.DenseOfColumnVectors(ModeMatched[0].Modes.Column(i)), Matrix<double>.Build.DenseOfColumnVectors(ModeMatched[1].Modes.Column(i)));
            if (mac < rejectLevelMac)
            {
                Console.WriteLine("Issue on the struture");
            }
            Console.WriteLine($"Mac: {mac}\n");
        }

        for (int i = 0; i < ModeMatched[0].Modes.ColumnCount; ++i)
        {
            Console.WriteLine($"\nJ = {i}");
            Console.WriteLine($"COMAC: {LDM.Comac(ModeMatched[0].Modes, ModeMatched[1].Modes, i)}");
            Console.WriteLine($"ECOMAC: {LDM.Ecomac(ModeMatched[0].Modes, ModeMatched[1].Modes, ModeMatched[0].Modes.RowCount, i)}");
        }

        Console.WriteLine("Gamma flexibility: ");
        Console.WriteLine(LDM.GammaFlexibilityMatrix(ModeMatched[0].Modes, ModeMatched[0].Damping, ModeMatched[1].Modes, ModeMatched[1].Damping));
    }

