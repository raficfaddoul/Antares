    async Task<(Vector<double> frequencies, Vector<double> damping, Matrix<double> modes, double[,] modesArray, List<Guid> sensorsIDs)?> Calculate(DateTime startDate, DateTime endDate)
    {


        DateTime start = startDate;// DateTime.Parse(Environment.GetEnvironmentVariable("START") ?? string.Empty); // nedd to be in local time
        DateTime end = endDate;

        AliantWebContext dbContext = entitiesService._appDBContext;

        List<Guid?> elementsIDs = JsonSerializer.Deserialize<List<Guid?>>(ListJson);

        List<Guid?> ChannelsDataTypeIDs = JsonSerializer.Deserialize<List<Guid?>>(ListJson1);

        List<Element> sensors = await entitiesService.GetFilteredEntitiesAsync<Element>(a => (elementsIDs.Contains(a.ElementId) && (a.ElementType.ChannelDataTypeElementTypes.Count > 0)), "ElementType.ChannelDataTypeElementTypes");
        IEnumerable<Guid?> elementTypesIDs = sensors.Select(x => x.ElementTypeId);


        List<ChannelDataType> channelDataTypeList = await entitiesService.GetFilteredEntitiesAsync<ChannelDataType>(a => (ChannelsDataTypeIDs.Contains(a.ChannelDataTypeId)));

        if (sensors.Count == 0)
        {
            await JsRuntime.InvokeVoidAsync("alert", "No sensors found.\n");
            Console.WriteLine("No sensors found.\n");
            return null;
        }


        // DateTime.Parse(Environment.GetEnvironmentVariable("END") ?? string.Empty);
        // threshold = double.Parse(Environment.GetEnvironmentVariable("THRESHOLD") ?? "0.1", CultureInfo.InvariantCulture);
        //ertz = double.Parse(Environment.GetEnvironmentVariable("HERTZ") ?? "250");
        //nt = int.Parse(Environment.GetEnvironmentVariable("NT") ?? "500");
