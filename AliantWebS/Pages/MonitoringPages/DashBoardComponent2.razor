        shackleSensors = selectedSensorTypeId != null && selectedSensorTypeId != Guid.Empty
            ? allShackleSensors.Where(s => s.ElementTypeId == selectedSensorTypeId).ToList()
            : allShackleSensors.ToList();

        // Recompute gauges and color map
        await ComputeGaugeIndicators();
        await ComputeSensorChargeRatios();
        gaugesRendered = false;

        // Recompute charge chart
        await LoadWeeklyMaxCharge();
        if (iitc != null)
            await iitc.DisplayData(indices, headers, pointNotes: chargePeakNotes);

        StateHasChanged();
    }

