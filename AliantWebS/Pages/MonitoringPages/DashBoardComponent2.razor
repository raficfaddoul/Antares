@page "/DashBoard2/"
@implements IDisposable
@using AliantWebS.Data
@using AliantWebS.Models
@using System.Text.Json;
@using Microsoft.EntityFrameworkCore
@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject AppData appData
@inject IStringLocalizer<Languages> L
@inject IJSRuntime js
@inject IDbContextFactory<AliantWebContext> dbContextFactory

<style>
    .chart-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 10px;
        padding: 10px;
        width: 100%;
        height: auto;
        overflow: auto;
        max-height: 600px;
        min-width: 100%;
    }



    .radzen-chart {
        height: 300px; /* Fixed height for each chart */
        width: 100%; /* Chart width is responsive to the grid column width */
    }

    .chart-container {
        text-align: center; /* Centers the label and chart within the container */
        margin: 10px; /* Optional: Adds some space around each chart container */
    }

    .chart-label {
        margin-bottom: 5px; /* Spacing between the label and the chart */
    }

    .svg-container {
        position: relative;
        height: 100%;
        background: #f8f9fa;
        border-radius: 8px;
        overflow: hidden;
    }

</style>

<NavigationLock OnBeforeInternalNavigation="appData.OnBeforeInternalNavigation" ConfirmExternalNavigation="appData.SaveConfirmation && appData.SaveChanges" />



<div style="position: relative; height: 80vh;">
    @if (!dataLoaded)
    {
        <div style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; background:rgba(248,249,250,0.85); z-index:1000;">
            <div class="spinner-border text-primary" style="width:3rem; height:3rem;" role="status"></div>
            <span style="margin-top:14px; color:#555; font-weight:500;">@L["Loading"]…</span>
        </div>
    }
<RadzenSplitter Orientation="Radzen.Orientation.Horizontal" style="height: 80vh; border: 1px solid rgba(0,0,0,.08);">
    <RadzenSplitterPane Size="50%">

        <RadzenSplitter Orientation="Radzen.Orientation.Vertical" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
            <RadzenSplitterPane Size="30%">
                <div style="display: flex; flex-direction: column; height: 100%;">
                    <div style="display: flex; align-items: center; gap: 10px; padding: 5px 10px; flex-shrink: 0; flex-wrap: wrap;">
                        <Label style="font-weight: 600;">Période de référence :</Label>
                        <RadzenDropDown TValue="string" Data="@refPeriodOptions" TextProperty="Text" ValueProperty="Value"
                                        @bind-Value="@selectedRefPeriod" Change="@OnRefPeriodChanged"
                                        Style="width: 200px;" />
                        <Label style="font-weight: 600; margin-left: 10px;">Type de capteur :</Label>
                        <RadzenDropDown TValue="Guid?" Data="@sensorTypeOptions" TextProperty="Text" ValueProperty="Value"
                                        @bind-Value="@selectedSensorTypeId" Change="@OnSensorTypeChanged"
                                        Style="width: 220px;" />
                    </div>
                    <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" style="flex: 1; border: 1px solid rgba(0,0,0,.08);">
                        <RadzenSplitterPane Size="33%">
                            <div style="display: flex; flex-direction: column; align-items: center; width: 100%; height: 100%;">
                                <div id="chart1" style="margin-top:15px; width:100%;"></div>
                                <Label>Taux de travail moyen</Label>
                            </div>
                        </RadzenSplitterPane>
                        <RadzenSplitterPane Size="33%">
                            <div style="display: flex; flex-direction: column; align-items: center; width: 100%; height: 100%;">

                                <div id="chart2" style="margin-top:15px; width:100%"></div>
                                <Label>Taux de travail maximum</Label>
                            </div>
                        </RadzenSplitterPane>
                        <RadzenSplitterPane Size="33%">
                            <div style="display: flex; flex-direction: column; align-items: center; width: 100%; height: 100%;">

                                <div id="chart3" style="margin-top:15px, width:100%"></div>
                                <Label>Pourcentage d'éléments critiques</Label>
                            </div>
                        </RadzenSplitterPane>
                    </RadzenSplitter>
                </div>

            </RadzenSplitterPane>

            <RadzenSplitterPane Size="70%">
                <div class="svg-container" style="height: 100%;">

                    <AliantWebS.Pages.CADPages.SVGComponent
                        @ref="svgComponent"
                        Mode="AliantWebS.Pages.CADPages.PlanMode.View"
                        Point0X="@(selectedEvent?.Point0X ?? 0)"
                        Point0Y="@(selectedEvent?.Point0Y ?? 0)"
                        EventName="@selectedEvent?.Name"
                        EventId="@selectedEvent?.EventId"
                        Sensors="filteredSensors"
                        SensorChargeRatios="sensorChargeRatios"
                        StructureName="@appData.Structure?.Name"
                        ModuleName="Tableau de bord">
                    </AliantWebS.Pages.CADPages.SVGComponent>

                </div>
            </RadzenSplitterPane>

            @*                <RadzenSplitterPane Size="33%">

            </RadzenSplitterPane>*@
        </RadzenSplitter>


    </RadzenSplitterPane>

    <RadzenSplitterPane Size="50%">

        <RadzenSplitter Orientation="Radzen.Orientation.Vertical" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
            <RadzenSplitterPane Size="50%" Style="overflow-y: auto; overflow-x: hidden; display: flex; flex-direction: column;">
                <div style="display: flex; align-items: center; gap: 10px; padding: 5px 10px; flex-shrink: 0;">
                    <Label style="font-weight: 600;">Période :</Label>
                    <RadzenDropDown TValue="string" Data="@timeRangeOptions" TextProperty="Text" ValueProperty="Value"
                                    @bind-Value="@selectedTimeRange" Change="@OnTimeRangeChanged"
                                    Style="width: 200px;" />
                </div>
                <div style="flex: 1; min-height: 320px; position: relative;">
                    <IndicesInTimeComponent GraphId="g2" @ref="iitc" Headers="headers" Indices="indices"></IndicesInTimeComponent>
                </div>
            </RadzenSplitterPane>

            <RadzenSplitterPane Size="50%" Style="overflow-y: auto; overflow-x: hidden; display: flex; flex-direction: column;">
                <div style="display: flex; align-items: center; gap: 10px; padding: 5px 10px; flex-shrink: 0; flex-wrap: wrap;">
                    <Label style="font-weight: 600;">Inclinaison maximum / 0.10°</Label>
                    <Label style="font-weight: 600; margin-left: 10px;">Type de capteur :</Label>
                    <RadzenDropDown TValue="Guid?" Data="@sensorTypeOptions" TextProperty="Text" ValueProperty="Value"
                                    @bind-Value="@selectedInclinoTypeId" Change="@OnInclinoTypeChanged"
                                    Style="width: 220px;" />
                </div>
                <div style="flex: 1; min-height: 320px; position: relative;">
                    <IndicesInTimeComponent GraphId="g3" @ref="iitc2" Headers="headers2" Indices="indices2"></IndicesInTimeComponent>
                </div>
            </RadzenSplitterPane>

        </RadzenSplitter>
    </RadzenSplitterPane>
</RadzenSplitter>
</div>

