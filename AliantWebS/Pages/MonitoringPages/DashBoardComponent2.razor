@page "/DashBoard2/"
@implements IDisposable
@using AliantWebS.Data
@using AliantWebS.Models
@using System.Threading
@using Microsoft.EntityFrameworkCore
@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject AppData appData
@inject IStringLocalizer<Languages> L
@inject IJSRuntime js
@inject IDbContextFactory<AliantWebContext> dbContextFactory
@inject TimeProvider time

@* The "Tableau de bord" tab (redesigned 2026-10-22; the page before it is kept as a frozen legacy copy in this
   folder to revert to, linked from nowhere). One Période drives the gauges, the plan's colours and both curves over
   one span; "Capteurs affichés" only filters the plan. Each panel says why it shows nothing, shows its own loading
   state, and a read that a newer one replaced is never shown. *@

<style>
    .svg-container {
        position: relative;
        height: 100%;
        background: #f8f9fa;
        border-radius: 8px;
        overflow: hidden;
    }

    .dashboard-period-bar, .dashboard-panel-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 5px 10px;
        flex-shrink: 0;
        flex-wrap: wrap;
    }

    /* A panel being read again: over a chart, or a banner over the plan (which keeps panning and zooming). Above a
       ReadFailureNotice cover (z-index 900). */
    .panel-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: #555;
        font-weight: 500;
    }

    .panel-loading.cover {
        position: absolute;
        inset: 0;
        z-index: 1000;
        background: rgba(248, 249, 250, 0.85);
    }

    .panel-loading.banner {
        padding: 4px 10px;
    }

    /* Nothing applicable to show: said plainly, opaque so no stale figure shows through, never an alarm. */
    .dashboard-nothing {
        background: #f1f3f5;
        color: #495057;
        font-size: 14px;
        text-align: center;
    }

    .dashboard-nothing.cover {
        position: absolute;
        inset: 0;
        z-index: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
    }

    .dashboard-nothing.banner {
        margin: 6px 8px;
        padding: 6px 10px;
        border-radius: 8px;
    }
</style>

<NavigationLock OnBeforeInternalNavigation="appData.OnBeforeInternalNavigation" ConfirmExternalNavigation="appData.SaveConfirmation && appData.SaveChanges" />

<div style="display: flex; flex-direction: column; height: 80vh;">
    <div class="dashboard-period-bar">
        <Label style="font-weight: 600;">Période :</Label>
        <RadzenDropDown TValue="string" Name="periode" Data="@DashboardPeriod.All" TextProperty="Label" ValueProperty="Code"
                        @bind-Value="@periodCode" Change="@OnPeriodChanged" Style="width: 200px;" />
    </div>
    <ReadFailureNotice Title="@UnexpectedErrorTitle" Message="@pageError" />

    <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" style="flex: 1; min-height: 0; border: 1px solid rgba(0,0,0,.08);">
        <RadzenSplitterPane Size="50%">
            <RadzenSplitter Orientation="Radzen.Orientation.Vertical" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
                <RadzenSplitterPane Size="30%">
                    <div data-panel="jauges" aria-busy="@Busy(chargeState)" style="display: flex; flex-direction: column; height: 100%;">
                        <div style="flex: 1; position: relative; display: flex; min-height: 0;">
                            <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" style="flex: 1; border: 1px solid rgba(0,0,0,.08);">
                                <RadzenSplitterPane Size="33%">
                                    <div style="display: flex; flex-direction: column; align-items: center; width: 100%; height: 100%;">
                                        <div id="chart1" style="margin-top:15px; width:100%"></div>
                                        <Label>Taux de travail moyen</Label>
                                    </div>
                                </RadzenSplitterPane>
                                <RadzenSplitterPane Size="33%">
                                    <div style="display: flex; flex-direction: column; align-items: center; width: 100%; height: 100%;">
                                        <div id="chart2" style="margin-top:15px; width:100%"></div>
                                        <Label>Taux de travail maximum</Label>
                                    </div>
                                </RadzenSplitterPane>
                                <RadzenSplitterPane Size="33%">
                                    <div style="display: flex; flex-direction: column; align-items: center; width: 100%; height: 100%;">
                                        <div id="chart3" style="margin-top:15px; width:100%"></div>
                                        <Label>Pourcentage d'éléments critiques</Label>
                                    </div>
                                </RadzenSplitterPane>
                            </RadzenSplitter>
                            @(PanelCover(chargeState))
                        </div>
                        @if (!chargeState.Loading && excludedShackles != null)
                        {
                            <div style="padding: 2px 10px; font-size: 12px; color: #6c757d;">@excludedShackles</div>
                        }
                    </div>
                </RadzenSplitterPane>

                <RadzenSplitterPane Size="70%">
                    <div data-panel="plan" aria-busy="@Busy(chargeState)" class="svg-container" style="display: flex; flex-direction: column;">
                        <div class="dashboard-panel-bar">
                            <Label style="font-weight: 600;">Capteurs affichés :</Label>
                            <RadzenDropDown TValue="Guid?" Name="capteurs-affiches" Data="@shownTypeOptions" TextProperty="Text" ValueProperty="Value"
                                            @bind-Value="@shownTypeId" Change="@OnShownTypeChanged" Style="width: 220px;" />
                        </div>
                        @if (chargeState.Loading)
                        {
                            @(LoadingNotice(cover: false))
                        }
                        else if (chargeState.Failure != null)
                        {
                            <ReadFailureNotice Title="@ReadFailureNotice.ChargeColoursTitle" Message="@chargeState.Failure" />
                        }
                        else if (chargeState.Nothing != null)
                        {
                            @(NothingNotice(chargeState.Nothing, cover: false))
                        }
                        <div style="flex: 1; min-height: 0; position: relative;">
                            <AliantWebS.Pages.CADPages.SVGComponent
                                Mode="AliantWebS.Pages.CADPages.PlanMode.View"
                                Point0X="@(selectedEvent?.Point0X ?? 0)"
                                Point0Y="@(selectedEvent?.Point0Y ?? 0)"
                                EventName="@selectedEvent?.Name"
                                EventId="@selectedEvent?.EventId"
                                Sensors="shownSensors"
                                SensorChargeRatios="sensorChargeRatios"
                                StructureName="@appData.Structure?.Name"
                                ModuleName="Tableau de bord">
                            </AliantWebS.Pages.CADPages.SVGComponent>
                        </div>
                    </div>
                </RadzenSplitterPane>
            </RadzenSplitter>
        </RadzenSplitterPane>

        <RadzenSplitterPane Size="50%">
            <RadzenSplitter Orientation="Radzen.Orientation.Vertical" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
                <RadzenSplitterPane Size="50%" Style="overflow-y: auto; overflow-x: hidden; display: flex; flex-direction: column;">
                    <div data-panel="charge" aria-busy="@Busy(chargeState)" style="display: flex; flex-direction: column; flex: 1;">
                        <div class="dashboard-panel-bar">
                            <Label style="font-weight: 600;">@ChargeSeries</Label>
                        </div>
                        <div style="flex: 1; min-height: 320px; position: relative;">
                            <IndicesInTimeComponent GraphId="g2" @ref="chargeGraph" Headers="DateHeaderOnly()" Indices="NoSeries()"></IndicesInTimeComponent>
                            @(PanelCover(chargeState))
                        </div>
                    </div>
                </RadzenSplitterPane>

                <RadzenSplitterPane Size="50%" Style="overflow-y: auto; overflow-x: hidden; display: flex; flex-direction: column;">
                    <div data-panel="courbe-type" aria-busy="@Busy(curveState)" style="display: flex; flex-direction: column; flex: 1;">
                        <div class="dashboard-panel-bar">
                            <Label style="font-weight: 600;">@CurveTitle</Label>
                            <Label style="font-weight: 600; margin-left: 10px;">Type de capteur :</Label>
                            <RadzenDropDown TValue="Guid?" Name="type-courbe" Data="@curveTypeOptions" TextProperty="Text" ValueProperty="Value"
                                            Placeholder="Choisir un type" @bind-Value="@curveTypeId" Change="@OnCurveTypeChanged" Style="width: 220px;" />
                        </div>
                        <div style="flex: 1; min-height: 320px; position: relative;">
                            <IndicesInTimeComponent GraphId="g3" @ref="curveGraph" Headers="DateHeaderOnly()" Indices="NoSeries()"></IndicesInTimeComponent>
                            @(PanelCover(curveState))
                        </div>
                    </div>
                </RadzenSplitterPane>
            </RadzenSplitter>
        </RadzenSplitterPane>
    </RadzenSplitter>
</div>

@code {
    // ── Texts ─────────────────────────────────────────────────────────────────────────────────────────────────────

    const string ChargeSeries = "Charge max manilles / seuil d'alarme";
    const string UnexpectedErrorTitle = "Erreur inattendue";
    const string NoShackle = "Aucune manille sur cette structure.";
    const string NoWeightChannel = "Les manilles n'ont pas de voie « weight ».";
    const string NoShackleThreshold = "Aucune manille n'a de seuil d'alarme pour la voie « weight ».";
    const string ChooseCurveType = "Choisissez un type de capteur pour afficher sa courbe.";

    // "Tous" in Capteurs affichés: every sensor of the structure.
    static readonly Guid AllTypes = Guid.Empty;

    // The bottom-right curve's default: the first present type whose name contains this (else none is chosen).
    const string InclinometerTypeNamePart = "Inclin";

    // Decimals the curves keep (the CSV sent to the browser).
    const int CurveDecimals = 4;

    // Sensors named in the log line about unreadable thresholds; the rest are counted.
    const int UnreadableExamples = 5;

    // ── State ─────────────────────────────────────────────────────────────────────────────────────────────────────

    /// <summary>What one kind of read shows on its panels: loading, a "nothing applicable" sentence, or a failure.</summary>
    sealed class PanelState
    {
        public bool Loading { get; set; } = true;   // nothing read yet
        public string Nothing { get; private set; }
        public string Failure { get; private set; }
        public bool Unexpected { get; private set; }   // the failure is not InfluxDB's

        public void Show(string nothing) { Nothing = nothing; Failure = null; Unexpected = false; }
        public void Fail(string reason, bool unexpected) { Nothing = null; Failure = reason; Unexpected = unexpected; }
    }

    /// <summary>A read's outcome: what to draw, or the sentence that says why there is nothing to draw.</summary>
    sealed record Outcome<T>(T Value, string Nothing)
    {
        public static Outcome<T> Drawn(T value) => new(value, null);
        public static Outcome<T> Say(string nothing) => new(default, nothing);
    }

    sealed record TypeOption(string Text, Guid? Value);

    sealed record Curve(List<Dictionary<object, double>> Indices, List<string> Headers);

    // Disposed with the page (leaving it, or switching tab): the first load (SQL) in flight is cancelled. Its token is
    // taken once, here: CancellationTokenSource.Token throws once the source is disposed.
    private readonly CancellationTokenSource _lifetime = new();
    private readonly CancellationToken lifetime;
    // Gauges, plan colours and the charge curve come from one read; the bottom-right curve from another. Disposed with
    // the page, which cancels the read each has in flight.
    private readonly LatestRead chargeReads = new();
    private readonly LatestRead curveReads = new();
    private readonly PanelState chargeState = new();
    private readonly PanelState curveState = new();

    private bool metadataLoaded;
    private string pageError;

    // The dropdown's value, the remembered one from OnInitialized; the period it names is looked up (an unknown code throws).
    private string periodCode;
    private DashboardPeriod Period => DashboardPeriod.Of(periodCode);
    private (DateTime Start, DateTime End) span;

    // The event in hand, for the plan's origin (Point0) and the DXF drawing data. This page is not under
    // AntaresConceptionLayout, so there is no cascaded event to read: it comes from appData.EventID, the way
    // the rest of the application identifies the current event. Null is normal — see LoadEventAsync.
    // Written out in full: this namespace has an Event of its own (Accelerometer.cs), and a type declared
    // here wins over one reached by a using directive.
    AliantWebS.Models.Event selectedEvent;

    List<Element> allSensors = new();
    List<ElementType> presentTypes = new();
    List<TypeOption> shownTypeOptions = new();
    List<TypeOption> curveTypeOptions = new();
    Guid? shownTypeId = AllTypes;
    Guid? curveTypeId;
    List<Element> shownSensors = new();

    List<Element> shackles = new();
    ChannelDataType weightChannel;

    // ElementId → the shackle's highest charge ratio over the period; a sensor absent from it is drawn grey.
    Dictionary<Guid, double> sensorChargeRatios = new();
    string excludedShackles;

    IndicesInTimeComponent chargeGraph;
    IndicesInTimeComponent curveGraph;

    public DashBoardComponent2()
    {
        lifetime = _lifetime.Token;
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        chargeReads.Dispose();
        curveReads.Dispose();
        _lifetime.Dispose();
    }

    string CurveTitle => curveTypeId is Guid id
        ? $"Maximum hebdomadaire : {presentTypes.Single(t => t.ElementTypeId == id).Name}"
        : "Maximum hebdomadaire";

    static string Busy(PanelState state) => state.Loading ? "true" : "false";
    static List<string> DateHeaderOnly() => new() { "Date" };
    static List<Dictionary<object, double>> NoSeries() => new();

    // ── Notices ───────────────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment LoadingNotice(bool cover) =>
        @<div class="panel-loading @(cover ? "cover" : "banner")" role="status">
            <div class="spinner-border spinner-border-sm text-primary" role="presentation"></div>
            <span>@L["Loading"]…</span>
        </div>;

    private RenderFragment NothingNotice(string text, bool cover) =>
        @<div class="dashboard-nothing @(cover ? "cover" : "banner")" role="status">@text</div>;

    // Over a chart: loading, a failure, or nothing to show (the chart under it is cleared).
    private RenderFragment PanelCover(PanelState state) =>
        @<text>
            @if (state.Loading)
            {
                @(LoadingNotice(cover: true))
            }
            @if (state.Failure != null && state.Unexpected)
            {
                <ReadFailureNotice Title="@UnexpectedErrorTitle" Message="@state.Failure" Cover="true" />
            }
            else if (state.Failure != null)
            {
                <ReadFailureNotice Message="@state.Failure" Cover="true" />
            }
            else if (state.Nothing != null)
            {
                @(NothingNotice(state.Nothing, cover: true))
            }
        </text>;

    // ── First load ────────────────────────────────────────────────────────────────────────────────────────────────

    // Deferred to OnAfterRenderAsync(firstRender), NOT OnInitializedAsync, because the app is ServerPrerendered: work
    // in OnInitializedAsync blocks the initial HTML, so the page would stay blank until every query finished.
    // OnAfterRender runs only in the interactive circuit, so the dashboard paints immediately and fills in afterwards.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (appData.Structure == null)
        {
            navigationManager.NavigateTo(@"Structures");
            return;
        }

        await LoadStructureAsync();
        if (metadataLoaded) await ReloadAllAsync();
    }

    // The structure's sensors, the types present, the shackles, and the choices kept from before (AppData).
    private async Task LoadStructureAsync()
    {
        try
        {
            // Before any read: the event carries Point0, and without it the plan's origin marker, the coordinate
            // readout and every exported DXF coordinate sit on the wrong origin.
            await LoadEventAsync();
            if (lifetime.IsCancellationRequested) return;

            allSensors = await LoadSensorsAsync(lifetime);
            if (lifetime.IsCancellationRequested) return;
            presentTypes = allSensors.Select(s => s.ElementType).DistinctBy(t => t.ElementTypeId).OrderBy(t => t.Name).ToList();
            curveTypeOptions = presentTypes.Select(t => new TypeOption(t.Name, t.ElementTypeId)).ToList();
            shownTypeOptions = curveTypeOptions.Prepend(new TypeOption("Tous", AllTypes)).ToList();

            (shackles, weightChannel) = await SensorChargeRatioHelper.LoadShackleSensorsAsync(dbContextFactory, appData.Structure);
            if (lifetime.IsCancellationRequested) return;

            RestoreChoices();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
            return;   // the page was left during the load: nothing to show
        }
        catch (Exception ex)
        {
            // A SQL failure or a bug, never an InfluxDB one: said on the page, and the circuit lives.
            Console.Error.WriteLine(ex);
            pageError = ex.GetBaseException().Message;
            chargeState.Loading = curveState.Loading = false;
            StateHasChanged();
            return;
        }

        metadataLoaded = true;
        StateHasChanged();
    }

    /// <summary>
    /// Loads the current event, whose Point0 is the origin the SVG draws and exports against.
    /// </summary>
    private async Task LoadEventAsync()
    {
        // Landing straight on the dashboard without having opened an event is legitimate: leave the event
        // null and the SVG keeps its 0/0 default, exactly as the "?? 0" of the other call sites does.
        if (appData.EventID == Guid.Empty) return;

        try
        {
            selectedEvent = await entitiesService.GetEntityAsync<AliantWebS.Models.Event>(appData.EventID);
        }
        catch (Exception ex)
        {
            // A monitoring page must keep drawing: a failed lookup costs the origin, not the plan.
            Console.WriteLine($"[Dashboard] Could not load event {appData.EventID}: {ex.Message}");
        }
    }

    // The structure's sensing devices with their type and channels (the plan and the bottom-right curve).
    private async Task<List<Element>> LoadSensorsAsync(CancellationToken cancellationToken)
    {
        using var context = await dbContextFactory.CreateDbContextAsync(cancellationToken);
        return await context.Elements
            .Include(e => e.ElementType)
                .ThenInclude(et => et.Category)
            .Include(e => e.ElementType)
                .ThenInclude(et => et.ChannelDataTypeElementTypes)
                    .ThenInclude(cdtet => cdtet.ChannelDataType)
            .Include(e => e.AttributeElements)
                .ThenInclude(ae => ae.AttributeType)
            .Where(e => e.StructureId == appData.Structure.StructureId
                     && e.ElementType != null
                     && e.ElementType.Category != null
                     && e.ElementType.Category.Name == "sensing device")
            .AsNoTracking()
            .ToListAsync(cancellationToken);
    }

    // The remembered Période needs no I/O: shown from the first render, during the first load and after it failed.
    protected override void OnInitialized() => periodCode = DashboardPeriod.Of(appData.DashboardPeriodCode).Code;

    // The types kept in AppData across a tab switch. A remembered type this structure does not have is not used:
    // its default is, and the log says which id was dropped (the dropdown shows what applies).
    private void RestoreChoices()
    {
        shownTypeId = PresentOrDefault(appData.DashboardShownTypeId ?? AllTypes, AllTypes, "Capteurs affichés");
        shownSensors = SensorsOfType(shownTypeId);

        var inclinometer = presentTypes
            .FirstOrDefault(t => t.Name.Contains(InclinometerTypeNamePart, StringComparison.OrdinalIgnoreCase))
            ?.ElementTypeId;
        curveTypeId = PresentOrDefault(appData.DashboardCurveTypeId ?? inclinometer, inclinometer, "courbe hebdomadaire");
    }

    private Guid? PresentOrDefault(Guid? remembered, Guid? byDefault, string what)
    {
        if (remembered is not Guid id || id == AllTypes || presentTypes.Any(t => t.ElementTypeId == id))
            return remembered;
        Console.WriteLine($"[Dashboard] The remembered {what} type {id} has no sensor on the structure "
                        + $"{appData.Structure?.Name}: its default ({(byDefault?.ToString() ?? "none")}) is used instead.");
        return byDefault;
    }

    private List<Element> SensorsOfType(Guid? typeId) =>
        typeId == AllTypes ? allSensors.ToList() : allSensors.Where(s => s.ElementTypeId == typeId).ToList();

    // ── Controls ──────────────────────────────────────────────────────────────────────────────────────────────────

    // Gauges, plan colours and both curves, over the new span. Before the first load, only stored: it reads it.
    private async Task OnPeriodChanged()
    {
        appData.DashboardPeriodCode = Period.Code;
        if (metadataLoaded) await ReloadAllAsync();
    }

    // Only which sensors the plan draws: nothing is read, nothing else is drawn again.
    private void OnShownTypeChanged()
    {
        appData.DashboardShownTypeId = shownTypeId;
        shownSensors = SensorsOfType(shownTypeId);
    }

    // The bottom-right curve only, over the span of the last Période change (all panels always cover one span).
    private async Task OnCurveTypeChanged()
    {
        appData.DashboardCurveTypeId = curveTypeId;
        if (metadataLoaded) await LoadCurveAsync();
    }

    private async Task ReloadAllAsync()
    {
        span = Period.Span(time.GetUtcNow().UtcDateTime);
        await Task.WhenAll(LoadChargeAsync(), LoadCurveAsync());   // independent: each catches its own failures
    }

    // ── Latest wins ───────────────────────────────────────────────────────────────────────────────────────────────

    /// <summary>
    /// One read of a kind, latest wins: the read before it is cancelled; its result is shown only while it is still
    /// the latest, as new lists (never cleared and refilled across an await); an InfluxDB failure is a
    /// ReadFailureNotice, anything else is logged and shown as unexpected; only the latest read ends the loading state.
    /// </summary>
    private async Task RunAsync<T>(LatestRead reads, PanelState state, Func<CancellationToken, Task<Outcome<T>>> read,
        Func<T, CancellationToken, Task> draw, Func<Task> clear)
    {
        var ct = reads.Begin();
        state.Loading = true;
        StateHasChanged();
        try
        {
            var outcome = await read(ct);
            if (!reads.IsCurrent(ct)) return;   // a newer read began meanwhile: this one is never shown

            state.Show(outcome.Nothing);
            if (outcome.Nothing != null) await clear();
            else await draw(outcome.Value, ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Superseded by a newer read, or the page was left: nothing is shown, and it is not an error.
        }
        catch (InfluxReadException ex)
        {
            if (reads.IsCurrent(ct))
            {
                state.Fail(ex.Message, unexpected: false);
                await clear();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            if (reads.IsCurrent(ct))
            {
                state.Fail(ex.GetBaseException().Message, unexpected: true);
                await clear();
            }
        }

        if (reads.IsCurrent(ct))
        {
            state.Loading = false;
            StateHasChanged();
        }
    }

    // ── Gauges, plan colours, charge curve ────────────────────────────────────────────────────────────────────────

    private Task LoadChargeAsync()
    {
        var (start, end) = span;
        var label = Period.Label;
        return RunAsync(chargeReads, chargeState, ct => ReadChargeAsync(start, end, label, ct), DrawChargeAsync, ClearChargeAsync);
    }

    private async Task<Outcome<ShackleCharge>> ReadChargeAsync(DateTime start, DateTime end, string periodLabel, CancellationToken ct)
    {
        if (shackles.Count == 0) return Outcome<ShackleCharge>.Say(NoShackle);
        if (weightChannel == null) return Outcome<ShackleCharge>.Say(NoWeightChannel);

        var unreadable = new List<(Guid ElementId, string Value)>();
        var charge = await SensorChargeRatioHelper.ReadChargeAsync(dbContextFactory, shackles, weightChannel, start, end, unreadable, ct);
        LogUnreadableThresholds(unreadable);

        if (charge.Rated == 0) return Outcome<ShackleCharge>.Say(NoShackleThreshold);
        if (charge.Gauges == null)
            // Shackles without a threshold may have been read: only the rated ones were not, and the others are counted.
            return Outcome<ShackleCharge>.Say(charge.WithoutThreshold == 0
                ? $"Aucune mesure des manilles sur la période ({periodLabel})."
                : $"Aucune mesure des manilles ayant un seuil d'alarme sur la période ({periodLabel}). {ExcludedShackles(charge)}");
        return Outcome<ShackleCharge>.Drawn(charge);
    }

    // The shackles left out for lack of a threshold, counted on screen (decision 6).
    private static string ExcludedShackles(ShackleCharge charge) =>
        $"{charge.WithoutThreshold} manille(s) sur {charge.Rated + charge.WithoutThreshold} sans seuil d'alarme : "
        + "non comptée(s) dans les jauges, les couleurs et la courbe de charge.";

    private async Task DrawChargeAsync(ShackleCharge charge, CancellationToken ct)
    {
        sensorChargeRatios = new Dictionary<Guid, double>(charge.MaxRatioBySensor);
        excludedShackles = charge.WithoutThreshold == 0 ? null : ExcludedShackles(charge);

        var gauges = charge.Gauges!;
        await js.InvokeVoidAsync("renderChart", gauges.MeanPercent, gauges.MaxPercent, gauges.CriticalPercent);
        if (ct.IsCancellationRequested) return;

        // The curve with its notes: the shackle behind each weekly peak.
        var peaks = new List<Dictionary<object, double>>
        {
            charge.WeeklyPeaks.ToDictionary(p => (object)p.Week, p => Math.Round(p.Ratio, CurveDecimals)),
        };
        var notes = charge.WeeklyPeaks
            .Select(p => new IndicesInTimeComponent.PointNote(ChargeSeries, p.Week, "Manille : " + ShackleName(p.SensorId)))
            .ToList();
        await chargeGraph.DisplayData(peaks, new List<string> { "Date", ChargeSeries }, pointNotes: notes);
    }

    // Nothing to show, or a failure: no gauge is drawn (the cover says why), the curve is emptied, the plan is grey.
    private async Task ClearChargeAsync()
    {
        sensorChargeRatios = new Dictionary<Guid, double>();
        excludedShackles = null;
        await chargeGraph.DisplayData(NoSeries(), DateHeaderOnly());
    }

    // An unreadable threshold is no threshold, for the gauges, the charge curve and the alarms alike, and
    // nothing else says so: the gauges simply fall. Name the sensors, so the cause is in the log.
    private void LogUnreadableThresholds(List<(Guid ElementId, string Value)> unreadable)
    {
        if (unreadable.Count == 0) return;

        var examples = unreadable
            .Take(UnreadableExamples)
            .Select(u => $"{ShackleName(u.ElementId)} '{u.Value}'");

        Console.WriteLine($"[Dashboard] {unreadable.Count} sensor(s) whose alarm threshold cannot be read in full "
                        + $"(an unreadable part is a threshold for no channel): "
                        + $"{string.Join(", ", examples)}{(unreadable.Count > UnreadableExamples ? ", ..." : "")}. "
                        + $"Expected channel:value, e.g. {AlarmThresholdFormat.Example}.");
    }

    // A shackle's name for messages and notes; its id when it has none.
    private string ShackleName(Guid id)
    {
        var name = shackles.FirstOrDefault(s => s.ElementId == id)?.Name;
        return string.IsNullOrWhiteSpace(name) ? id.ToString() : name;
    }

    // ── Bottom-right curve ────────────────────────────────────────────────────────────────────────────────────────

    private Task LoadCurveAsync()
    {
        var (start, end) = span;
        var label = Period.Label;
        var typeId = curveTypeId;
        return RunAsync(curveReads, curveState, ct => ReadCurveAsync(typeId, start, end, label, ct), DrawCurveAsync, ClearCurveAsync);
    }

    private async Task<Outcome<Curve>> ReadCurveAsync(Guid? typeId, DateTime start, DateTime end, string periodLabel, CancellationToken ct)
    {
        if (typeId is not Guid id) return Outcome<Curve>.Say(ChooseCurveType);
        var type = presentTypes.Single(t => t.ElementTypeId == id);   // the dropdown offers present types only

        var sensors = allSensors.Where(s => s.ElementTypeId == id).ToList();
        var channels = type.ChannelDataTypeElementTypes   // loaded with the sensors (LoadSensorsAsync)
            .Where(cdtet => cdtet.ChannelDataType != null)
            .Select(cdtet => cdtet.ChannelDataType)
            .DistinctBy(cdt => cdt.ChannelDataTypeId)
            .ToList();
        if (channels.Count == 0) return Outcome<Curve>.Say($"Le type « {type.Name} » n'a aucune voie de mesure.");

        var rows = await InfluxService.GetData(
            sensors.Select(s => s.ElementId.ToString()).ToList(),
            channels.Select(c => c.ChannelDataTypeId.ToString()).ToList(),
            start, end, ReportsService.BucketName,
            aggregateWindowDuration: InfluxService.WeeklyWindow, aggregateFn: "max", cancellationToken: ct);

        var curve = WeeklyMaxPerChannel(rows, channels);
        return curve.Indices.Count == 0
            ? Outcome<Curve>.Say($"Aucune mesure des capteurs « {type.Name} » sur la période ({periodLabel}).")
            : Outcome<Curve>.Drawn(curve);
    }

    // For each channel, the weekly maximum across the type's sensors; a channel with no reading has no series.
    // rows: [0]=DateTime, [1]=sensorId, [2]=channel1, [3]=channel2, ...
    private static Curve WeeklyMaxPerChannel(List<object[]> rows, List<ChannelDataType> channels)
    {
        var curve = new Curve(new List<Dictionary<object, double>>(), new List<string> { "Date" });
        for (int ch = 0; ch < channels.Count; ch++)
        {
            int dataIndex = ch + 2;
            var weeklyMax = rows
                .Where(r => r[0] is DateTime && r.Length > dataIndex && r[dataIndex] != null)
                .GroupBy(r => InfluxService.WeekStart((DateTime)r[0]))
                .OrderBy(g => g.Key)
                .ToDictionary(g => (object)g.Key, g => Math.Round(g.Max(r => (double)r[dataIndex]), CurveDecimals));

            if (weeklyMax.Count > 0)
            {
                curve.Indices.Add(weeklyMax);
                curve.Headers.Add(channels[ch].Name);
            }
        }
        return curve;
    }

    private Task DrawCurveAsync(Curve curve, CancellationToken ct) => curveGraph.DisplayData(curve.Indices, curve.Headers);

    private Task ClearCurveAsync() => curveGraph.DisplayData(NoSeries(), DateHeaderOnly());
}
