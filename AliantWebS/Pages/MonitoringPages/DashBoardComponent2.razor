@page "/DashBoard2/"
@using AliantWebS.Data
@using AliantWebS.Models
@using System.Text.Json;
@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject AppData appData
@inject IStringLocalizer<Languages> L
@inject IJSRuntime js

<style>
    .chart-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 10px;
    padding: 10px;
    width: 100%;
    height: auto;
    overflow: auto;
    max-height: 600px;
    min-width: 100%;
    }



    .radzen-chart {
    height: 300px; /* Fixed height for each chart */
    width: 100%; /* Chart width is responsive to the grid column width */
    }

    .chart-container {
    text-align: center; /* Centers the label and chart within the container */
    margin: 10px; /* Optional: Adds some space around each chart container */
    }

    .chart-label {
    margin-bottom: 5px; /* Spacing between the label and the chart */
    }

</style>

<NavigationLock OnBeforeInternalNavigation="appData.OnBeforeInternalNavigation" ConfirmExternalNavigation="appData.SaveConfirmation&& appData.SaveChanges" />



<RadzenSplitter Orientation="Radzen.Orientation.Horizontal" style="height: 80vh; border: 1px solid rgba(0,0,0,.08);">
    <RadzenSplitterPane Size="50%">

        <RadzenSplitter Orientation="Radzen.Orientation.Vertical" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
            <RadzenSplitterPane Size="25%">

                <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
                    <RadzenSplitterPane Size="33%">
                        <div style="display: flex; flex-direction: column; align-items: center; width: 100%; height: 100%;">
                            <div id="chart1" style="margin-top:15px; width:100%;"></div>
                            <Label>Taux de travail moyen</Label>
                        </div>
                    </RadzenSplitterPane>
                    <RadzenSplitterPane Size="33%">
                        <div style="display: flex; flex-direction: column; align-items: center; width: 100%; height: 100%;">

                            <div id="chart2" style="margin-top:15px; width:100%"></div>
                            <Label>Taux de travail maximal</Label>
                        </div>
                    </RadzenSplitterPane>
                    <RadzenSplitterPane Size="33%">
                        <div style="display: flex; flex-direction: column; align-items: center; width: 100%; height: 100%;">

                            <div id="chart3" style="margin-top:15px; width:100%"></div>
                            <Label>Pourcentage d'éléments critiques </Label>
                        </div>
                    </RadzenSplitterPane>
                </RadzenSplitter>


            </RadzenSplitterPane>

            <RadzenSplitterPane Size="75%">
                <AliantWebS.Pages.InventoryElementPages.BIMComponent Rigidities="rigidities" Structure="appData.Structure"></AliantWebS.Pages.InventoryElementPages.BIMComponent>

            </RadzenSplitterPane>

            @*                <RadzenSplitterPane Size="33%">

            </RadzenSplitterPane>*@
        </RadzenSplitter>


    </RadzenSplitterPane>

    <RadzenSplitterPane Size="50%">

        <RadzenSplitter Orientation="Radzen.Orientation.Vertical" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
            <RadzenSplitterPane Size="50%">
                @*                 @if (@present)
                {

                <h4>Rigidités des elements structuraux</h4>
                <RadzenChart style="height: 600px; width:600px">
                <RadzenBarSeries Data="@revenue2020" CategoryProperty="Quarter" Title="Rigidité" LineType="LineType.Dashed" ValueProperty="Revenue">
                <RadzenSeriesDataLabels Visible="@showDataLabels" />
                </RadzenBarSeries>

                <RadzenValueAxis>
                <RadzenGridLines Visible="true" />
                <RadzenAxisTitle Text="Rigidité" />
                </RadzenValueAxis>
                <RadzenBarOptions Radius="5" />
                </RadzenChart>

                } *@
                <IndicesInTimeComponent GraphId="g2" Headers="headers" Indices="indices"></IndicesInTimeComponent>
            </RadzenSplitterPane>

            <RadzenSplitterPane Size="50%">
                @* <ModalShapesComponent structure="appData.Structure"></ModalShapesComponent> *@
                @* <ModalShapesDygraphsComponent structure="appData.Structure"></ModalShapesDygraphsComponent> *@

                <div class="chart-grid">
                    @foreach (var d in dataItemsLists)
                    {
                        <div class="chart-container">
                            <div class="chart-label">
                                <Label>@d.Key</Label>
                            </div>
                            <RadzenChart class="radzen-chart">
                                <RadzenPieSeries TItem="DataItem" Data="@d.Value" CategoryProperty="Quarter" Title="@d.Key" ValueProperty="Revenue">
                                    <RadzenSeriesDataLabels Visible="@showDataLabels" />
                                </RadzenPieSeries>
                            </RadzenChart>
                        </div>
                    }
                </div>
            </RadzenSplitterPane>

        </RadzenSplitter>
    </RadzenSplitterPane>
</RadzenSplitter>

@code {

    private int value1;
    private int value2;
