    private DateTime GetStartDateFromRange(string range)
    {
        return range switch
        {
            "1w" => DateTime.UtcNow.AddDays(-7),
            "1m" => DateTime.UtcNow.AddMonths(-1),
            "3m" => DateTime.UtcNow.AddMonths(-3),
            "6m" => DateTime.UtcNow.AddMonths(-6),
            "1y" => DateTime.UtcNow.AddYears(-1),
            "5y" => DateTime.UtcNow.AddYears(-5),
            "10y" => DateTime.UtcNow.AddYears(-10),
            _ => new DateTime(2020, 1, 1, 0, 0, 0, DateTimeKind.Utc) // "all"
        };
    }

    /// <summary>
    /// Computes gauge indicator values (chart1/2/3) from InfluxDB shackle sensor data
    /// over the selected reference period.
    /// </summary>
    private async Task ComputeGaugeIndicators()
    {
        if (shackleSensors.Count == 0 || weightChannelDataType == null)
        {
            value1 = 0; value2 = 0; value3 = 0;
            return;
        }

        DateTime startDate = GetStartDateFromRange(selectedRefPeriod);
        DateTime endDate = DateTime.UtcNow;

        var sensorIds = shackleSensors.Select(s => s.ElementId.ToString()).ToList();
        var channelIds = new List<string> { weightChannelDataType.ChannelDataTypeId.ToString() };

        try
        {
            var bucketName = ReportsService.BucketName;

            // Query per-sensor mean weight over the reference period (one row per sensor)
            var meanData = await InfluxService.GetData(sensorIds, channelIds, startDate, endDate, bucketName,
                aggregateWindowDuration: "36500d", aggregateFn: "mean", cancellationToken: _cts.Token);

            // Query per-sensor max weight over the reference period (one row per sensor)
            var maxData = await InfluxService.GetData(sensorIds, channelIds, startDate, endDate, bucketName,
                aggregateWindowDuration: "36500d", aggregateFn: "max", cancellationToken: _cts.Token);

            // Each sensor is rated against its OWN alarm threshold, so the gauges aggregate
            // per-sensor RATIOS instead of dividing a shared total by one rated load. Sensors with
            // no threshold for this channel are left out entirely — nothing is assumed for them.
            var unreadableThresholds = new List<(Guid ElementId, string Value)>();
            var thresholds = await SensorChargeRatioHelper.LoadThresholdsAsync(
                dbContextFactory, shackleSensors, weightChannelDataType?.Name, unreadableThresholds);
            LogUnreadableThresholds(unreadableThresholds);

            double? RatioFor(string sensorId, double value)
                => Guid.TryParse(sensorId, out var id) && thresholds.TryGetValue(id, out var t) && t != 0
                    ? value / t
                    : (double?)null;

            // value1: Taux de travail moyen = average of per-sensor (mean / its own threshold)
            if (meanData != null && meanData.Count > 0)
            {
                var meanRatios = meanData
                    .Where(r => r[2] != null)
                    .GroupBy(r => (string)r[1])
                    .Select(g => RatioFor(g.Key, g.Average(r => (double)r[2])))
                    .Where(x => x.HasValue)
                    .Select(x => x.Value)
                    .ToList();

                value1 = meanRatios.Count > 0
                    ? Math.Clamp((int)(meanRatios.Average() * 100), 0, 100)
                    : 0;
            }
            else
            {
                value1 = 0;
            }

            // value2 & value3 from per-sensor max ratios
            if (maxData != null && maxData.Count > 0)
            {
                var perSensorMax = maxData
                    .Where(r => r[2] != null)
                    .GroupBy(r => (string)r[1])
                    .ToDictionary(g => g.Key, g => g.Max(r => (double)r[2]));

                var maxRatios = new List<double>();
                foreach (var kvp in perSensorMax)
                {
                    var ratio = RatioFor(kvp.Key, kvp.Value);
                    if (ratio.HasValue) maxRatios.Add(ratio.Value);
                }

                if (perSensorMax.Count != maxRatios.Count)
                    Console.WriteLine($"[Dashboard] {perSensorMax.Count - maxRatios.Count} sensor(s) "
                                    + "excluded from the gauges: no alarm threshold for this channel.");

                // Taux de travail maximum = the highest ratio across all sensors
                value2 = maxRatios.Count > 0
                    ? Math.Clamp((int)(maxRatios.Max() * 100), 0, 100)
                    : 0;

                // Pourcentage d'éléments critiques = share of sensors above 80% of their threshold
                int criticalCount = maxRatios.Count(v => v > 0.80);
                value3 = maxRatios.Count > 0
                    ? Math.Clamp((int)((double)criticalCount / maxRatios.Count * 100), 0, 100)
                    : 0;
            }
            else
            {
                value2 = 0;
                value3 = 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error computing gauge indicators: {ex.Message}");
            value1 = 0; value2 = 0; value3 = 0;
        }
    }

    // An unreadable threshold is no threshold, for the gauges, the charge curve and the alarms alike, and
    // nothing else says so: the gauges simply fall. Name the sensors, so the cause is in the log.
    private void LogUnreadableThresholds(List<(Guid ElementId, string Value)> unreadable)
    {
        if (unreadable.Count == 0) return;

        var names = shackleSensors.ToDictionary(s => s.ElementId, s => s.Name);
        var examples = unreadable
            .Take(5)
            .Select(u => $"{(names.TryGetValue(u.ElementId, out var n) ? n : u.ElementId.ToString())} '{u.Value}'");

        Console.WriteLine($"[Dashboard] {unreadable.Count} sensor(s) whose alarm threshold cannot be read in full "
                        + $"(an unreadable part is a threshold for no channel): "
                        + $"{string.Join(", ", examples)}{(unreadable.Count > 5 ? ", ..." : "")}. "
                        + $"Expected channel:value, e.g. {AlarmThresholdFormat.Example}.");
    }

