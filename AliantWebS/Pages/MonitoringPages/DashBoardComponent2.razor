    // {
    //     "Date","Index1","Index2","Index3" };

    Dictionary<string, DataItem[]> dataItemsLists = new Dictionary<string, DataItem[]>();
    Structural.IdentificationResult ir = new Structural.IdentificationResult();
    protected override async Task OnInitializedAsync()
    {
        //// exemple de save
        // Structural.IdentificationResult ir = new Structural.IdentificationResult();
        // ir.Kpi1 = 76;
        // ir.Kpi2 = 85;
        // ir.Kpi3 = 58;
        // Dictionary<Guid, double> d = new Dictionary<Guid, double>();

        // var eles = await entitiesService.GetFilteredEntitiesAsync<Element>(x => (x.StructureId == appData.Structure.StructureId) && (x.ElementType?.Name == "Beam2d"), "ElementType");
        // var ll = new List<double>() { 1.0075, 0.9982, 0.9747, 0.9801, 1.0098, 1.0015, 0.9829, 0.9749, 0.9731, 0.9753, 0.9907, 0.9983, 1.014, 0.9677, 0.9569, 1.013, 0.9965, 1, 1.0004, 0.9945, 0.989, 0.9908, 0.9991, 0.9966, 0.9873, 0.991, 1.0008, 0.9973 };
        // int j = 0;
        // foreach(var e in eles)
        // {
        //     d.Add(e.ElementId, ll[j]);
        //     j++;
        // }

        // ir.Rigidités = d;


        // await ir.Save(appData.Structure);

        if (appData.Structure == null)
        {
            navigationManager.NavigateTo(@"/Structures");
        }


        try
        {
            ir = await ir.Load(appData.Structure);

            if (ir != null)
            {
                value1 = (int)(ir.TauxMoyen * 100);
                value2 = (int)(ir.TauxMaximal * 100 * 0.93);
                value3 = (int)(ir.Ptaux75_100 * 100);

                //    rigidities = ir.TauxDetravail;
            }
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", ex.Message + " Most likely Identification was not done");
            return;
        }







        // indices.Add(series1);
