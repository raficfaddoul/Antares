        // indices.Add(tauxDic);
        // headers.Add("Taux d'utilisation Moyen");
        await GetElementsPercentages();// not awaited on purpose so it dosnnt block BIM display



    }


    private async Task GetElementsPercentages()
    {


        DataItem[] dataItem = new DataItem[4];

        if (ir != null)
        {

            dataItem[0] = new DataItem() { Quarter = "0-25%", Revenue = (int)(ir.Ptaux0_25 * 100) };
            dataItem[1] = new DataItem() { Quarter = "25-50%", Revenue = (int)(ir.Ptaux25_50 * 100) };
            dataItem[2] = new DataItem() { Quarter = "50-75%", Revenue = (int)(ir.Ptaux50_75 * 100) };
            dataItem[3] = new DataItem() { Quarter = "75-100%", Revenue = (int)(ir.Ptaux75_100 * 100) };

            string title = "Taux de travail";
            dataItemsLists.Add(title, dataItem);

        }


        StateHasChanged();

    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await js.InvokeVoidAsync("renderChart", value1, value2, value3);
            List<Element> els = await entitiesService.GetFilteredEntitiesAsync<Element>(x => x.StructureId == appData.Structure.StructureId && x.ElementType != null && x.ElementType.Name == "Beam3d", "ElementType");
            Dictionary<long, Guid> instanceIdsList = els
                .Where(x => x.BimId.HasValue)
                .ToDictionary(x => x.BimId.Value, x => x.ElementId);

            var colors = AliantWebS.Pages.InventoryElementPages.BIMComponent.GenerateBlueToRedColors(101);

            if (ir != null)
            {
                int i = 0;
                foreach (var inst in instanceIdsList)
                //for (int i =0; i<l.Count; i++)
                {
                    if (!ir.TauxDetravail.Keys.Contains(inst.Value)) continue;
                    var tt = (int)ir.TauxDetravail[inst.Value] * 100;

                    List<long> ins = new List<long>() { inst.Key };

                    await js.InvokeVoidAsync("ColorElement", tt, ins.ToArray(), colors[tt].r, colors[tt].g, colors[tt].b);
                    i++;
                }
            }
            this.StateHasChanged();
        }
    }
}
