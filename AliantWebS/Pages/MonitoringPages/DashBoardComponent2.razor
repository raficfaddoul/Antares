        // indices.Add(series3);

        present = true;

        if ((appData.Structure.Events is null) || (appData.Structure.Events.Count == 0))
        {
            entitiesService.LoadCollection(appData.Structure, "Events");
        }
        Dictionary<object, double> tauxDic = new Dictionary<object, double>();
        foreach(var ev in appData.Structure.Events)
        {
            if ((ev.StartDate != null) && (ev.TauxMoyen != null))
            {
                tauxDic.Add((DateTime)ev.StartDate, (double)ev.TauxMoyen);
            }
        }



        headers.Add("Date");
        indices.Add(tauxDic);
        headers.Add("Taux d'utilisation Moyen");
