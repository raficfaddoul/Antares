    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Deferred heavy load (see LoadAllDataAsync). Paints the shell first, then fills in.
            try
            {
                await LoadAllDataAsync();
            }
            catch (OperationCanceledException)
            {
                return;   // component disposed mid-load (navigated away) — nothing to render
            }
            StateHasChanged();
            return;
        }

        // Render gauges once data is loaded and DOM is ready
        if (dataLoaded && !gaugesRendered)
        {
            gaugesRendered = true;
            await js.InvokeVoidAsync("renderChart", value1, value2, value3);
        }

        // Update charts after components are rendered and data is loaded
        if (dataLoaded)
        {
            if (iitc != null && indices.Count > 0)
            {
                await iitc.DisplayData(indices, headers, pointNotes: chargePeakNotes);
            }

            if (iitc2 != null && indices2.Count > 0)
            {
                await iitc2.DisplayData(indices2, headers2);
            }
        }
    }

    /// <summary>
    /// Loads weekly max data for graph3 based on whatever sensor type is selected
    /// in the inclination dropdown. Discovers channels dynamically from the loaded sensor metadata.
    /// </summary>
    private async Task LoadGraph3Data()
    {
        indices2.Clear();
        if (headers2.Count > 1)
            headers2.RemoveRange(1, headers2.Count - 1);

        // Get sensors for the selected type from allSensors (which has ElementType + channels loaded)
        List<Element> graph3Sensors;
        if (selectedInclinoTypeId == null || selectedInclinoTypeId == Guid.Empty)
            graph3Sensors = allSensors.ToList();
        else
            graph3Sensors = allSensors.Where(s => s.ElementTypeId == selectedInclinoTypeId).ToList();

        if (graph3Sensors.Count == 0) return;

        // Get distinct channel data types for these sensors
        var channelDataTypes = graph3Sensors
            .Where(s => s.ElementType?.ChannelDataTypeElementTypes != null)
            .SelectMany(s => s.ElementType.ChannelDataTypeElementTypes)
            .Where(cdtet => cdtet.ChannelDataType != null)
            .Select(cdtet => cdtet.ChannelDataType)
            .DistinctBy(cdt => cdt.ChannelDataTypeId)
            .ToList();

        if (channelDataTypes.Count == 0) return;

        var sensorIds = graph3Sensors.Select(s => s.ElementId.ToString()).ToList();
        var channelIds = channelDataTypes.Select(cdt => cdt.ChannelDataTypeId.ToString()).ToList();

        DateTime startDate = GetStartDateFromRange(selectedTimeRange);
        DateTime endDate = DateTime.UtcNow;

        List<object[]> rawData;
        try
        {
            var bucketName = ReportsService.BucketName;
            rawData = await InfluxService.GetData(sensorIds, channelIds, startDate, endDate, bucketName,
                aggregateWindowDuration: InfluxService.WeeklyWindow, aggregateFn: "max", cancellationToken: _cts.Token);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error querying InfluxDB for graph3 data: {ex.Message}");
            return;
        }

        if (rawData == null || rawData.Count == 0) return;

        // For each channel, group by week and compute weekly max across all sensors
        // rawData layout: [0]=DateTime, [1]=sensorId, [2]=channel1, [3]=channel2, ...
        for (int ch = 0; ch < channelDataTypes.Count; ch++)
        {
            int dataIndex = ch + 2;

            var weeklyMax = new Dictionary<object, double>();

            var grouped = rawData
                .Where(r => r[0] is DateTime && r.Length > dataIndex && r[dataIndex] != null)
                .GroupBy(r =>
                {
                    var dt = (DateTime)r[0];
                    int diff = (7 + (dt.DayOfWeek - DayOfWeek.Monday)) % 7;
                    return dt.Date.AddDays(-diff);
                })
                .OrderBy(g => g.Key);

            foreach (var weekGroup in grouped)
            {
                double maxVal = weekGroup.Max(r => (double)r[dataIndex]);
                weeklyMax.Add(weekGroup.Key, Math.Round(maxVal, 4));
            }

            if (weeklyMax.Count > 0)
            {
                indices2.Add(weeklyMax);
                headers2.Add(channelDataTypes[ch].Name);
            }
        }
    }
