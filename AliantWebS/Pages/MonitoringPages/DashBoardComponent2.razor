    private async Task LoadWeeklyMaxCharge()
    {
        indices.Clear();
        chargePeakNotes = null;
        if (headers.Count > 1)
            headers.RemoveRange(1, headers.Count - 1);

        if (shackleSensors.Count == 0 || weightChannelDataType == null) return;

        DateTime startDate = GetStartDateFromRange(selectedTimeRange);
        DateTime endDate = DateTime.UtcNow;

        var sensorIds = shackleSensors.Select(s => s.ElementId.ToString()).ToList();
        var channelIds = new List<string> { weightChannelDataType.ChannelDataTypeId.ToString() };

        List<object[]> rawData;
        try
        {
            var bucketName = ReportsService.BucketName;
            rawData = await InfluxService.GetData(sensorIds, channelIds, startDate, endDate, bucketName,
                aggregateWindowDuration: InfluxService.WeeklyWindow, aggregateFn: "max", cancellationToken: _cts.Token);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error querying InfluxDB for shackle data: {ex.Message}");
            return;
        }

        if (rawData == null || rawData.Count == 0) return;

        // Each reading is rated against its own sensor's threshold before taking the weekly peak,
        // so the curve is "worst utilisation that week" rather than raw kilograms.
        var weekThresholds = await SensorChargeRatioHelper.LoadThresholdsAsync(
            dbContextFactory, shackleSensors, weightChannelDataType?.Name);
        var peaks = SensorChargeRatioHelper.WeeklyPeaks(rawData, weekThresholds);

        if (peaks.Count == 0) return;   // no sensor had a threshold — nothing to plot

        indices.Add(peaks.ToDictionary(p => (object)p.Week, p => Math.Round(p.Ratio, 4)));
        headers.Add(ChargeSeries);

        // Every queried sensor is one of shackleSensors; the id stands in only for a sensor with no name.
        var names = shackleSensors.ToDictionary(s => s.ElementId, s => s.Name);
        string ShackleName(Guid id) => names.TryGetValue(id, out var n) && !string.IsNullOrWhiteSpace(n) ? n : id.ToString();

        chargePeakNotes = new Dictionary<string, IReadOnlyDictionary<DateTime, string>>
        {
            [ChargeSeries] = peaks.ToDictionary(p => p.Week, p => "Manille : " + ShackleName(p.SensorId)),
        };
    }

    private async Task LoadWeeklyMaxInclination()
    {
        indices2.Clear();
        if (headers2.Count > 1)
            headers2.RemoveRange(1, headers2.Count - 1);

        if (inclinometerSensors.Count == 0 || xAxisChannelDataType == null || yAxisChannelDataType == null) return;

        DateTime startDate = GetStartDateFromRange(selectedTimeRange);
        DateTime endDate = DateTime.UtcNow;

        var sensorIds = inclinometerSensors.Select(s => s.ElementId.ToString()).ToList();
        // Query both x_axis and y_axis — weekly max computed server-side by InfluxDB
        var channelIds = new List<string>
        {
            xAxisChannelDataType.ChannelDataTypeId.ToString(),
            yAxisChannelDataType.ChannelDataTypeId.ToString()
        };

        List<object[]> rawData;
        try
        {
            var bucketName = ReportsService.BucketName;
            rawData = await InfluxService.GetData(sensorIds, channelIds, startDate, endDate, bucketName,
                aggregateWindowDuration: InfluxService.WeeklyWindow, aggregateFn: "max", cancellationToken: _cts.Token);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error querying InfluxDB for inclinometer data: {ex.Message}");
            return;
        }

        if (rawData == null || rawData.Count == 0) return;

        // rawData layout: [0]=DateTime, [1]=sensorId, [2]=x_axis, [3]=y_axis
        // Compute inclination magnitude = sqrt(x² + y²) per row,
        // then group by week across all sensors and take the max, divided by 0.10°.
        Dictionary<object, double> weeklyMaxInclination = new Dictionary<object, double>();

        var grouped = rawData
            .Where(r => r[0] is DateTime && r[2] != null && r[3] != null)
            .GroupBy(r =>
            {
                var dt = (DateTime)r[0];
                int diff = (7 + (dt.DayOfWeek - DayOfWeek.Monday)) % 7;
                return dt.Date.AddDays(-diff);
            })
            .OrderBy(g => g.Key);

        foreach (var weekGroup in grouped)
        {
            double maxMagnitude = weekGroup.Max(r =>
            {
                double x = (double)r[2];
                double y = (double)r[3];
                return Math.Sqrt(x * x + y * y);
            });
            double normalized = maxMagnitude / 0.10;
            weeklyMaxInclination.Add(weekGroup.Key, Math.Round(normalized, 4));
        }

        indices2.Add(weeklyMaxInclination);
        headers2.Add("Inclinaison max / 0.10°");
    }

