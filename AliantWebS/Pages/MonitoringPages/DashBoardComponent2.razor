    // interactive circuit, so the dashboard paints immediately (spinner) and fills in afterwards.
    // Cancelled when the component is disposed (navigating away / switching tab), so the sequential
    // Influx queries below stop instead of running on — each one otherwise costs up to the 60s
    // HttpClient timeout on a full-year, all-sensor scan for a page nobody is looking at.
    private readonly System.Threading.CancellationTokenSource _cts = new();

    public void Dispose()
    {
        try { _cts.Cancel(); } catch { }
        _cts.Dispose();
    }

    private async Task LoadAllDataAsync()
    {
        if (appData.Structure == null)
        {
            navigationManager.NavigateTo(@"Structures");
            return;
        }

        try
        {
            ir = await ir.Load(appData.Structure);
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", ex.Message + " Most likely Identification was not done");
        }

        present = true;


        var ct = _cts.Token;

        // Before the Influx work below: the event carries Point0, and without it the plan's origin marker,
        // the coordinate readout and every exported DXF coordinate sit on the wrong origin.
        await LoadEventAsync();
        if (ct.IsCancellationRequested) return;

        // Load SVG component data first (needed for graph3 generic channel discovery)
        await LoadSvgData();
        if (ct.IsCancellationRequested) return;

        // Load shackle (manille) sensors of type weight_scale
        await LoadShackleSensors();
        allShackleSensors = shackleSensors.ToList();
        if (ct.IsCancellationRequested) return;

        // Compute gauge indicators from InfluxDB shackle data
        await ComputeGaugeIndicators();
        if (ct.IsCancellationRequested) return;

        await ComputeSensorChargeRatios();
        if (ct.IsCancellationRequested) return;

        headers.Add("Date");
        await LoadWeeklyMaxCharge();
        if (ct.IsCancellationRequested) return;

        headers2.Add("Date");
        await LoadGraph3Data();
        if (ct.IsCancellationRequested) return;

        await GetElementsPercentages();

        dataLoaded = true;
    }

    /// <summary>
    /// Loads the current event, whose Point0 is the origin the SVG draws and exports against.
    /// </summary>
    private async Task LoadEventAsync()
    {
        // Landing straight on the dashboard without having opened an event is legitimate: leave the event
        // null and the SVG keeps its 0/0 default, exactly as the "?? 0" of the other call sites does.
        if (appData.EventID == Guid.Empty) return;

        try
        {
            selectedEvent = await entitiesService.GetEntityAsync<AliantWebS.Models.Event>(appData.EventID);
        }
        catch (Exception ex)
        {
            // A monitoring page must keep drawing: a failed lookup costs the origin, not the plan.
            Console.WriteLine($"[Dashboard] Could not load event {appData.EventID}: {ex.Message}");
        }
    }

    private async Task LoadSvgData()
    {
        if (appData.Structure == null) return;

        using var context = await dbContextFactory.CreateDbContextAsync();

        allSensors = await context.Elements
            .Include(e => e.ElementType)
                .ThenInclude(et => et.Category)
            .Include(e => e.ElementType)
                .ThenInclude(et => et.ChannelDataTypeElementTypes)
                    .ThenInclude(cdtet => cdtet.ChannelDataType)
            .Include(e => e.AttributeElements)
                .ThenInclude(ae => ae.AttributeType)
            .Where(e => e.StructureId == appData.Structure.StructureId
                     && e.ElementType != null
                     && e.ElementType.Category != null
                     && e.ElementType.Category.Name == "sensing device")
            .AsNoTracking()
            .ToListAsync();

        // Build sensor type dropdown options from distinct element types
        sensorTypeOptions = allSensors
            .Where(s => s.ElementType != null)
            .Select(s => s.ElementType)
            .DistinctBy(et => et.ElementTypeId)
            .OrderBy(et => et.Name)
            .Select(et => new SensorTypeOption { Text = et.Name, Value = et.ElementTypeId })
            .ToList();

        // Add "Tous" as the first option so it is always available
        sensorTypeOptions.Insert(0, new SensorTypeOption { Text = "Tous", Value = Guid.Empty });

        // Default main dropdown to Manille
        var manilleOption = sensorTypeOptions.FirstOrDefault(o => o.Text.Contains("Manille", StringComparison.OrdinalIgnoreCase));
        if (manilleOption != null)
            selectedSensorTypeId = manilleOption.Value;
        else if (sensorTypeOptions.Count > 0)
            selectedSensorTypeId = sensorTypeOptions[0].Value;

        // Default inclination dropdown to Inclinomètre
        var inclinoOption = sensorTypeOptions.FirstOrDefault(o => o.Text.Contains("Inclin", StringComparison.OrdinalIgnoreCase));
        if (inclinoOption != null)
            selectedInclinoTypeId = inclinoOption.Value;
        else if (sensorTypeOptions.Count > 0)
            selectedInclinoTypeId = sensorTypeOptions[0].Value;

        // Apply initial SVG filter (show only Manille sensors by default)
        filteredSensors = selectedSensorTypeId != null && selectedSensorTypeId != Guid.Empty
            ? allSensors.Where(s => s.ElementTypeId == selectedSensorTypeId).ToList()
            : allSensors.ToList();

        palonniers = await context.Set<MotherGridPalonnier>()
            .Where(x => x.Famille == false)
            .AsNoTracking()
            .ToListAsync();

        motherGrids = await context.Set<MotherGridPalonnier>()
            .Where(x => x.Famille == true)
            .AsNoTracking()
            .ToListAsync();
    }

    /// <summary>
    /// Called when the sensor type dropdown changes — refilters SVG, recomputes gauges and charts.
    /// </summary>
    private async Task OnSensorTypeChanged()
