    private async Task ColorElements()
    {
        if (ColorMapping == null || ColorMapping.Count == 0) return;

        try
        {
            // Prepare arrays matching the JS function signature
            var styleNums = ColorMapping.Keys.ToArray();

            var styleToEntities = ColorMapping.ToDictionary(
                kvp => kvp.Key.ToString(),
                kvp => kvp.Value.EntityIds.ToArray()
            );

            var rgbValues = ColorMapping.Values
                .Select(v => new int[] { v.Color.R, v.Color.G, v.Color.B })
                .ToArray();

            await js.InvokeVoidAsync("ColorElements", styleNums, styleToEntities, rgbValues);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ColorElements error: {ex.Message}");
        }
    }

    /// <summary>
    /// Re-apply a colour map + taux tooltip map to the already-loaded model. Call this (via @ref)
    /// after recomputing taux at runtime — colours are otherwise only applied on firstRender.
    /// Self-contained: takes the maps as arguments so it doesn't depend on parameter re-binding.
    /// </summary>
    public async Task ApplyColorsAsync(
        Dictionary<int, (List<long> EntityIds, (int R, int G, int B) Color)> colorMapping,
        Dictionary<long, double> tauxMap)
    {
        try
        {
            if (colorMapping != null && colorMapping.Count > 0)
            {
                var styleNums = colorMapping.Keys.ToArray();
                var styleToEntities = colorMapping.ToDictionary(
                    kvp => kvp.Key.ToString(),
                    kvp => kvp.Value.EntityIds.ToArray());
                var rgbValues = colorMapping.Values
                    .Select(v => new int[] { v.Color.R, v.Color.G, v.Color.B })
                    .ToArray();
                await js.InvokeVoidAsync("ColorElements", styleNums, styleToEntities, rgbValues);
            }

            if (tauxMap != null && tauxMap.Count > 0)
                await js.InvokeVoidAsync("SetTauxMap", tauxMap);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ApplyColorsAsync error: {ex.Message}");
        }
    }
