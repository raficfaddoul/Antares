    public static async Task<string> transformToWexBim(string fileName)
    {
        string wexBimFilename = string.Empty;

        //const string fileName = @"C:\Users\rafic\Desktop\AliantWebS\AliantWebS\AliantWebS\wwwroot\data\OneWall.ifc";

        try
        {

            using (var model = Xbim.Ifc.IfcStore.Open(fileName))
            {
                var context = new Xbim3DModelContext(model);
                context.CreateContext(null, false);

                wexBimFilename = Path.ChangeExtension(fileName, "wexBIM");
                using (var wexBiMfile = File.Create(wexBimFilename))
                {
                    using (var wexBimBinaryWriter = new BinaryWriter(wexBiMfile))
                    {
                        model.SaveAsWexBim(wexBimBinaryWriter);
                        wexBimBinaryWriter.Close();
                    }
                    wexBiMfile.Close();
                }
            }

        }
        catch (Exception ex)
        {
            int k = 1;
        }




        return wexBimFilename;


    }


