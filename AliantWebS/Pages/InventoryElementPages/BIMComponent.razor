    public static (double x, double y, double?z, double?t) ProjectPointOnSegment(
    double x0, double y0, double z0,
    double x1, double y1, double z1,
    double x, double y, double z)
    {
        // Direction vector from (X0, Y0, Z0) to (X1, Y1, Z1)
        double dx = x1 - x0;
        double dy = y1 - y0;
        double dz = z1 - z0;

        // Vector from (X0, Y0, Z0) to (PX, PY, PZ)
        double vx = x - x0;
        double vy = y - y0;
        double vz = z - z0;

        // Compute the dot products
        double dotProduct = vx * dx + vy * dy + vz * dz;
        double lenSq = dx * dx + dy * dy + dz * dz;

        // Calculate the projection parameter of the point on the line
        double t = dotProduct / lenSq;

        // Ensure t is within the bounds of the segment
        t = Math.Max(0, Math.Min(1, t));

        // Calculate the projection coordinates using parameter t
        double projX = x0 + t * dx;
        double projY = y0 + t * dy;
        double projZ = z0 + t * dz;

        return (projX, projY, projZ,t);
    }


