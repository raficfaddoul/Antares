    public static (double r, double g, double b)[] GenerateBlueToRedColors(int numColors)
    {
        (double r, double g, double b)[] colorArray = new (double r, double g, double b)[numColors];
        int startR = 0, startG = 0, startB = 255;  // Blue
        int endR = 255, endG = 0, endB = 0;        // Red

        for (int i = 0; i < numColors; i++)
        {
            // Calculate the interpolation factor
            double fraction = (double)i / (numColors - 1);

            // Interpolate the red, green, and blue values
            int r = (int)(startR + fraction * (endR - startR));
            int g = (int)(startG + fraction * (endG - startG));
            int b = (int)(startB + fraction * (endB - startB));

            // Create the color and add it to the array
            colorArray[i] = (r, g, b);
        }

        return colorArray;
    }

    static public (int R, int G, int B) CalculateRgb(double rigidity)
    {

        double lt = 0.98, ht = 1;


        int R, G, B;
        double mid = lt + (ht - lt) / 2;

        if (rigidity >= mid)
        {
            // Green to Blue transition
            R = 0;
            G = Convert.ToInt32(255 * (1 - (rigidity - mid) / 0.2));
            B = Convert.ToInt32(255 * ((rigidity - mid) / 0.2));
        }
        else if (rigidity > lt)
        {
            // Blue to Red transition
            R = Convert.ToInt32(255 * ((rigidity - lt) / 0.2));
            G = 0;
            B = Convert.ToInt32(255 * (1 - (rigidity - lt) / 0.2));
        }
        else
        {
            // Rigidity is 0.6 or less, color is red
            R = 255;
            G = 0;
            B = 0;
        }

        // Clamp the values to ensure they are within the valid range for RGB components
        R = Math.Clamp(R, 0, 255);
        G = Math.Clamp(G, 0, 255);
        B = Math.Clamp(B, 0, 255);

        return (R, G, B);
    }

