@page "/AddElement/{StructureId:guid}/{ListJson}"
@using AliantWebS.Data
@using AliantWebS.Models
@inject EntitiesService entitiesService
@inject NavigationManager NavigationManager
@using System.Text.Json;
@inject AppData appData;

@layout ElementsLayout

<NavigationLock OnBeforeInternalNavigation="appData.OnBeforeInternalNavigation" ConfirmExternalNavigation="appData.SaveConfirmation&& appData.SaveChanges" />


<h2>Add Element</h2>
<hr />
@if (!updating)
{
    <ElementFormComponent creating="true" ButtonText="Create Element" Element="@elementPrototype" OnValidSubmit="@CreateElement"></ElementFormComponent>
}

@code {

    [Parameter]
    public EditContext EditContext { get; set; }

    bool updating = false;

    [Parameter]
    public Structure Structure { get; set; }

    [Parameter]
    public Guid StructureId { get; set; }

    //[Parameter]
    // public int? parentID { get; set; }

    [Parameter]
    public string ListJson { get; set; }


    Element elementPrototype = new Element();
    //   List<Element> elements = new List<Element>();
    List<Guid?> parentsIDs;

    public override async Task SetParametersAsync(ParameterView parameters)
    {

        await base.SetParametersAsync(parameters);


        if (appData.Structure != null)
        {
            Structure = appData.Structure;

        }
        else
        {
            Structure = await entitiesService.GetEntityAsync<Structure>(StructureId);
        }
        elementPrototype.Structure = Structure;
        elementPrototype.StructureId = Structure.StructureId;
        //  elementPrototype.ParentId = parentID;
        appData.Element = elementPrototype;
        //EditContext = new EditContext(elementPrototype);
        parentsIDs = JsonSerializer.Deserialize<List<Guid?>>(ListJson);

    }

    protected override async Task OnInitializedAsync()
    {

    }


    protected async void CreateElement()
    {
        updating = true;

        foreach (Guid? parentID in parentsIDs)
        {

            Element element = (Element)entitiesService._appDBContext.Entry(elementPrototype).CurrentValues.ToObject();
            element.ParentId = parentID;
            Structure.Elements.Add(element);
            await AddAttributes(element);

        }



        await entitiesService.UpdateEntityAsync(Structure);


        // await entitiesService.InsertEntitiesAsync<Element>(elements);
        if (parentsIDs.Contains(null))
        {
            appData.RootEmployeesChange();
        }
        appData.NSC();
        updating = false;

        NavigationManager.NavigateTo("BlankElement/");

    }

    private async Task AddAttributes(Element element)
    {
        var elementTypeID = element.ElementTypeId;

        if (elementTypeID is null) return;

        List<AttributeTypeElementType> atet = await entitiesService.GetFilteredEntitiesAsync<AttributeTypeElementType>(a => a.ElementTypeId == element.ElementTypeId, "AttributeType");

        var attributeTypesList = atet.Select(x => x.AttributeType);

        // Old data stores some element-type/attribute-type links twice, and one row per link gave
        // the element two rows for the same attribute: the value went into one, and the empty twin
        // was then spread to other elements by Paste. So at most one row per attribute type, and
        // none for a type the element already carries.
        var attributeTypeIds = element.AttributeElements.Select(x => x.AttributeTypeId).ToHashSet();

        foreach (var v in attributeTypesList)
        {
                if (v is null || !attributeTypeIds.Add(v.AttributeTypeId)) continue;

                AttributeElement ae = new AttributeElement();
                ae.ElementId = element.ElementId;
                ae.AttributeTypeId = v.AttributeTypeId;
                element.AttributeElements.Add(ae);      
           
        }    
    }
    //    "/AddElement/{structureID:int}/{parentID:int?}"
}
