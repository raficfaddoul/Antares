@page "/ElementsLayout/{StructureId:guid}"
@inherits LayoutComponentBase
@using AliantWebS.Data
@inject AppData appData;

@layout MainLayout



@*    <RadzenDialog />
    <RadzenNotification />
    <RadzenContextMenu />
    <RadzenTooltip />*@

<div style="width:100vw">
    <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
        <RadzenSplitterPane Size="13%">
            <div class="sidebar" style="height:100vh;">
                <ElementComponent></ElementComponent>
            </div>
        </RadzenSplitterPane>

        <RadzenSplitterPane Size="87%">
            @if (appData.BIMInElementLayout)
            {
                <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
                    <RadzenSplitterPane Size="70%">
                    @Body
                </RadzenSplitterPane>

                <RadzenSplitterPane Size="30%">
                    <BIMComponent Structure="appData.Structure"></BIMComponent>
                </RadzenSplitterPane>
                </RadzenSplitter>
            }
            else
            {
                @Body
            }
        </RadzenSplitterPane>
    </RadzenSplitter>
</div>


@code {



    [Parameter]
    public int StructureId { get; set; }


    }
