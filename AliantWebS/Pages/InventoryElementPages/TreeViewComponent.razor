    private int? ProposeNameSubFunction(Element element, Element el, int? maximum)
    {
        if (el.ElementId == element.ElementId) return maximum;

        var v1 = Helpers.Helpers.SplitStringInStringAndNum(el.Name);
        var v2 = Helpers.Helpers.SplitStringInStringAndNum(element.Name);

        if (v1.Item1 == v2.Item1)
        {
            if (v1.Item2 == null)
            {
                return 0;
            }
            if (v1.Item2 > maximum)
            {
                maximum = v1.Item2;
            }
        }

        return maximum;
    }

    private string ProposeName(Element parent, Element element)
    {
        //List<string> listOfBrothersName = new List<string>();

        int? maximum = -4589;


        if (parent != null)
        {

            foreach (Element el in parent.InverseParent)
            {
                if (el.Name == null) continue;
                maximum = ProposeNameSubFunction(element, el, maximum);
            }
        }
        else
        {
            foreach (Element el in Structure.Elements)
            {
                if (el.Name == null) el.Name = "";
                maximum = ProposeNameSubFunction(element, el, maximum);
            }
        }
        string proposedName;
        if (maximum != -4589)
        {

            proposedName = Helpers.Helpers.SplitStringInStringAndNum(element.Name).Item1 + (maximum + 1).ToString();
        }
        else
        {
            proposedName = element.Name;
        }

        return proposedName;


    }

    async Task PasteElement(Guid? parentId, Element el, List<Guid> forbidens)
    {

        // if (depth >= maxDepth) return;
        // depth++;



        Element parent;
        updating = true;
        if (parentId != null)
        {
            parent = await entitiesService.GetEntityAsync<Element>((Guid)parentId);
        }
        else
        {
            parent = null;
        }



        Element element = (Element)entitiesService._appDBContext.Entry(el).CurrentValues.ToObject();
        element.ElementId = Guid.Empty;
        element.ParentId = parentId;
        element.Name = ProposeName(parent, element);
        if (copyAttributes)
        {
            // Not el.AttributeElements: the tree loads elements without their attributes, so that
            // collection holds only the rows another page happened to track - all of them once the
            // element was opened in EditElement, none otherwise - and LoadCollection would not
            // refresh it once marked loaded. Pasting elements nobody had opened copied no attribute
            // at all (Membrure F-1..F-20 and Membrure 2-1, 2026-09-14). Read the source's rows from
            // the database.
            var sourceAttributes = await entitiesService.QueryCollectionAsync(el, e => e.AttributeElements);

            // The source can still hold two rows for one attribute type (a valued row and an empty
            // twin left by doubled type links); copying both is how the twins reached hundreds of
            // elements. Copy one row per type, preferring the one that holds a value, then a date.
            // ElementId is left unset: EF takes it from element.AttributeElements when the new
            // element is inserted, and the source element's id has no place on the copy.
            var attributesToCopy = sourceAttributes
                .GroupBy(a => a.AttributeTypeId)
                .Select(g => g.OrderByDescending(a => !string.IsNullOrWhiteSpace(a.Value))
                              .ThenByDescending(a => a.Date != null)
                              .First());

            foreach (var att in attributesToCopy)
            {
                AttributeElement attribute = new AttributeElement();
                //attribute.AttributeType = att.AttributeType;
                attribute.AttributeTypeId = att.AttributeTypeId;
                attribute.Value = att.Value;
                attribute.Date = att.Date;

                element.AttributeElements.Add(attribute);
            }
        }
        element = await entitiesService.InsertEntityAsync(element);
        if (element == null)
        {
            // InsertEntityAsync returns null when the insert fails. There is no new element to
            // attach the children to, so this branch is left unpasted instead of adding null to
            // the structure and failing on its id.
            updating = false;
            return;
        }
        Structure.Elements.Add(element);



        updating = false;
        forbidens.Add(element.ElementId);

        // el.InverseParent was loaded with the tree and is not refreshed: children added since by
        // another user or through an owned context are missing from it. Ask the database, and keep
        // only the rows whose parent is still el in this circuit (a row the shared context tracks
        // keeps its in-memory ParentId, which is what its next save writes). The copy just made is
        // among them when pasting an element into itself; forbidens skips it.
        var children = await entitiesService.QueryCollectionAsync(el, e => e.InverseParent);
        foreach (Element childEl in children.Where(c => c.ParentId == el.ElementId))
        {

            if (forbidens.Contains(childEl.ElementId)) continue;
            await PasteElement(element.ElementId, childEl, forbidens);
        }


    }

    private int CalculateDepth(Element element, int depth)
    {
        depth++;
        int maxLocalDepth = depth;


        foreach (Element el in element.InverseParent)
        {
            int dep = CalculateDepth(el, depth);
            if (dep > maxLocalDepth) maxLocalDepth = dep;
        }


        return maxLocalDepth;
    }



    async Task OnClickPaste()
    {
        if (copiedElements is null || copiedElements.Count() == 0)
        {
            await JsRuntime.InvokeVoidAsync("alert", "No elements in the clipboard....");
            return;
        }


        if (appData.CheckedNodeObjects is null || appData.CheckedNodeObjects.Count() == 0)
        {
            if (clipboardIsCut)
            {
                foreach (Element v1 in copiedElements)
                {
                    v1.ParentId = null;
                    await entitiesService.UpdateEntityAsync(v1);
                }
                // Moved; pasting them again copies them, as it always has after a move.
                clipboardIsCut = false;
            }
            else
            {

                foreach (Element v1 in copiedElements)
                {
                    //int maxDepth = CalculateDepth(v1,0);
                    List<Guid> forbidens = new List<Guid>();
                    await PasteElement(null, v1, forbidens);
                    appData.RootEmployeesChange();
                }
            }

        }
        else
        {
            if (clipboardIsCut)
            {
                foreach (Element v in appData.CheckedNodeObjects)
                {

                    foreach (Element v1 in copiedElements)
                    {
                        v1.ParentId = v.ElementId;
                        await entitiesService.UpdateEntityAsync(v1);
                    }

                }
                clipboardIsCut = false;

            }
            else
            {
                /////////////
                foreach (Element v in appData.CheckedNodeObjects)
                {

                    foreach (Element v1 in copiedElements)
                    {
                        //int maxDepth = CalculateDepth(v1, 0);
                        List<Guid> forbidens = new List<Guid>();
                        await PasteElement(v.ElementId, v1, forbidens);
                    }

                }
            }
        }
    }

