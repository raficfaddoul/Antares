    public static Dictionary<string, object> ProcessLine(string line)
    {
        //string pattern = @"(\w+):\s*(\w+),?";
        string pattern = @"([^:]+):\s*([^,]+),?";
        var matches = Regex.Matches(line, pattern);

        Dictionary<string, object> dict = new Dictionary<string, object>();

        // Keys are trimmed, so "Ix" and " Ix " on the same line are the same key: the first value
        // is kept and the repeat ignored, rather than throwing and abandoning the whole import.
        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            string key = match.Groups[1].Value.Trim();
            string value = match.Groups[2].Value.Trim();
            bool booleanValue;
            int intValue;

            if (int.TryParse(value, out intValue))
            {
                dict.TryAdd(key, intValue);
            }
            else if (bool.TryParse(value, out booleanValue))
            {
                dict.TryAdd(key, booleanValue);
            }
            else
            {
                dict.TryAdd(key, value);
            }
        }

        return dict;
    }

    async void OnClickImportStructure(InputFileChangeEventArgs e)
    {
        isImporting = true;

        // An import is ONE user action that happens to write hundreds of rows. Per-entity journal
        // rows would bury the rest of the journal (and double the writes), so the blanket coverage
        // is muted here and a single summary row is written at the end instead.
        entitiesService.SuppressJournal = true;
        int importedElements = 0;

        List<string> categoriesWanted = new List<string>();
        List<string> channelDataTypesWanted = new List<string>();
        Dictionary<string, object> elementsTypesWanted = new Dictionary<string, object>();
        Dictionary<string, object> attributesTypesWanted = new Dictionary<string, object>();
        Dictionary<string, object> attributeTypeElementTypesWanted = new Dictionary<string, object>();

        List<string> categoriesExcluded = new List<string>();
        List<string> channelDataTypesExcluded = new List<string>();
        List<string> elementsTypesExcluded = new List<string>();
        List<string> attributesTypesExcluded = new List<string>();
        List<string> attributeTypeElementTypesExcluded = new List<string>();

        var categories = await entitiesService.GetAllEntitiesAsync<Category>();

        Stream stream = e.File.OpenReadStream();

        try
        {
        using (StreamReader reader = new StreamReader(stream))
        {
            string content = await reader.ReadToEndAsync();

            // Split content into lines and process each line
            string[] lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.None);


            foreach(var line in lines)
            //     while ((line = await reader.ReadLineAsync(System.Threading.CancellationToken.None)) != null)
            {
                StateHasChanged();
                if (line.Trim() == String.Empty) continue;
                Element el = null;


                var dict = ProcessLine(line);

                if (dict["Object"].ToString().ToLower() == "element")
                {
                    dict.Remove("Object");
                    //nodes = entitiesService.GetFilteredEntitiesAsync<Element>(a => (elList.Contains(a.ElementId) && (a.ElementType?.Name == "Node")), "ElementType", "AttributeElements.AttributeType").Result;
                    // elements = entitiesService.GetFilteredEntitiesAsync<Element>(a => (elList.Contains(a.ElementId) && ((a.ElementType?.Name == "Beam2d"))), "ElementType", "AttributeElements.AttributeType").Result;




                    string categoryName = string.Empty;
                    if (dict.Keys.Contains("category"))
                    {
                        categoryName = dict["category"].ToString().Trim();
                        dict.Remove("category");
                    }

                    Category category = null;

                    if (!categoriesWanted.Contains(categoryName) && !categoriesExcluded.Contains(categoryName) && !(categoryName == string.Empty))
                    {
                        category = categories.Find(a => a.Name == categoryName);
                        if (category == null)
                        {
                            var isConfirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"The Category {categoryName} does not exist.\nDo you want to create one automatically?");

                            if (isConfirmed)
                            {

                                Category cat = new Category();
                                cat.Name = categoryName;
                                category = await entitiesService.InsertEntityAsync(cat);
                                categoriesWanted.Add(category.Name);
                            }
                            else
                            {
                                categoriesExcluded.Add(categoryName);
                            }

                        }
                        else
                        {
                            categoriesWanted.Add(category.Name);
                        }
                    }
                    else
                    {
                        category = categories.Find(a => a.Name == categoryName);
                    }

                    ////////////////////////////
                    List<string> channelDataTypesNames = new List<string>();
                    if (dict.Keys.Contains("channelDataType"))
                    {
                        channelDataTypesNames = dict["channelDataType"].ToString().Split('|').ToList();
                        dict.Remove("channelDataType");
                    }

                    foreach (string cdtn in channelDataTypesNames)
                    {

                        ChannelDataType channelDataType = null;



                        if (!channelDataTypesWanted.Contains(cdtn) && !channelDataTypesExcluded.Contains(cdtn) && !(cdtn == string.Empty))
                        {
                            channelDataType = await entitiesService.GetFilteredFirstEntityAsync<ChannelDataType>(a => a.Name == cdtn);
                            if (channelDataType == null)
                            {
                                var isConfirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"The ChannelDataType {cdtn} does not exist.\nDo you want to create one automatically?");

                                if (isConfirmed)
                                {

                                    ChannelDataType cdt = new ChannelDataType();
                                    cdt.Name = cdtn;
                                    channelDataType = await entitiesService.InsertEntityAsync(cdt);
                                    channelDataTypesWanted.Add(channelDataType.Name);
                                }
                                else
                                {
                                    channelDataTypesExcluded.Add(cdtn);
                                }

                            }
                            else
                            {
                                channelDataTypesWanted.Add(channelDataType.Name);
                            }
                        }
                    }///
                    ///////////////////////////

                    var v = await Helpers.Helpers.CreateElementType(entitiesService, category, dict, elementsTypesWanted,
                        elementsTypesExcluded, JsRuntime);

                    var elementType = v.elementType;
                    var typeName = v.typeName;

                    ////////////////////////////////
                    if (elementType != null)
                    {
                        var channelDataTypes = await entitiesService.GetFilteredEntitiesAsync<ChannelDataType>(a => channelDataTypesNames.Contains(a.Name));
                        var channelDataTypesIds = channelDataTypes.Select(x => x.ChannelDataTypeId);

                        foreach (Guid guid in channelDataTypesIds)
                        {
                            ChannelDataTypeElementType cdtet = await entitiesService.GetFilteredFirstEntityAsync<ChannelDataTypeElementType>(a => ((a.ElementTypeId == elementType.ElementTypeId) && (guid == a.ChannelDataTypeId)));
                            if (cdtet == null)
                            {
                                cdtet = new ChannelDataTypeElementType() { ChannelDataTypeId = guid, ElementTypeId = elementType.ElementTypeId };
                                cdtet = await entitiesService.InsertEntityAsync(cdtet);
                            }
                        }
                    }


                    el = new Element();
                    if (typeName != null)
                    {
                        el.ElementTypeId = ((ElementType)elementsTypesWanted[typeName]).ElementTypeId;
                    }

                    string elementName = string.Empty;
                    if (dict.Keys.Contains("name"))
                    {
                        elementName = dict["name"].ToString()?.Trim();
                        dict.Remove("name");
                    }
                    el.Name = elementName;
                    el.StructureId = Structure.StructureId;

                    string parentName = string.Empty;
                    if (dict.Keys.Contains("parent"))
                    {
                        parentName = dict["parent"].ToString();
                        dict.Remove("parent");
                    }
                    Element parentElement = await entitiesService.GetFilteredFirstEntityAsync<Element>(a => (a.Name == parentName) && (a.StructureId == Structure.StructureId));
                    if (parentElement != null)
                    {
                        el.ParentId = parentElement.ElementId;
                    }

                    el = await entitiesService.InsertEntityAsync(el);
                    if (el != null) importedElements++;




                    // An element gets at most one row per attribute type; if two keys of the line
                    // resolve to the same type, the first one is kept.
                    HashSet<Guid> importedAttributeTypeIds = new HashSet<Guid>();

                    foreach (var pair in dict)
                    {
                        AttributeType attributeType = null;

                        // One trimmed key for every lookup and insert below, so a type is never
                        // cached under one spelling and looked up under another.
                        string attributeKey = pair.Key.Trim();

                        if (!attributesTypesWanted.Keys.Contains(attributeKey) && !attributesTypesExcluded.Contains(attributeKey))
                        {

                            attributeType = await entitiesService.GetFilteredFirstEntityAsync<AttributeType>(a => a.Name == attributeKey);

                            if (attributeType == null)
                            {
                                var isConfirmed = true;// await JsRuntime.InvokeAsync<bool>("confirm", $"The Attibute Type {pair.Key} does not exist.\nDo you want to create one automatically?");

                                if (isConfirmed)
                                {

                                    AttributeType at = new AttributeType();
                                    at.Name = attributeKey;
                                    attributeType = await entitiesService.InsertEntityAsync(at);
                                    attributesTypesWanted[attributeKey] = attributeType;

                                }
                                else
                                {
                                    attributesTypesExcluded.Add(attributeKey);
                                    continue;
                                }

                            }
                            else
                            {
                                attributesTypesWanted[attributeKey] = attributeType;
                            }
                        }

                        attributeType = (AttributeType)attributesTypesWanted[attributeKey];

                        AttributeTypeElementType attributeTypeElementType = null;
                        string attributeTypeElementTypeKey = attributeKey + el.ElementTypeId.ToString();

                        if (!attributeTypeElementTypesWanted.Keys.Contains(attributeTypeElementTypeKey) && !attributeTypeElementTypesExcluded.Contains(attributeTypeElementTypeKey))
                        {

                            attributeTypeElementType = await entitiesService.GetFilteredFirstEntityAsync<AttributeTypeElementType>((a => (a.AttributeTypeId == attributeType.AttributeTypeId) && (a.ElementTypeId == ((ElementType)elementsTypesWanted[typeName]).ElementTypeId)));

                            if (attributeTypeElementType == null)
                            {

                                AttributeTypeElementType atet = new AttributeTypeElementType();
                                atet.ElementTypeId = ((ElementType)elementsTypesWanted[typeName]).ElementTypeId;
                                atet.AttributeTypeId = attributeType.AttributeTypeId;
                                attributeTypeElementType = await entitiesService.InsertEntityAsync(atet);
                                attributeTypeElementTypesWanted[attributeTypeElementTypeKey] = atet;

                            }
                            else
                            {
                                attributeTypeElementTypesWanted[attributeTypeElementTypeKey] = attributeTypeElementType;
                            }
                        }

                        if (!importedAttributeTypeIds.Add(attributeType.AttributeTypeId)) continue;

                        AttributeElement ae = new AttributeElement();
                        ae.ElementId = el.ElementId;
                        ae.AttributeTypeId = attributeType.AttributeTypeId;
                        ae.Value = pair.Value.ToString()?.Trim();
                        ae = await entitiesService.InsertEntityAsync(ae);
                        appData.RootEmployeesChange();
                        this.StateHasChanged();


                        //AttributeTypeElementType atet = new AttributeTypeElementType();
                        //atet.ElementTypeId = ((ElementType)elementsTypesWanted[typeName]).ElementTypeId;
                        //atet.AttributeTypeId = attributeType.AttributeTypeId;





                        // Console.WriteLine($"{pair.Key}: {pair.Value}");
                    }
                }

            }// end while lines

            isImporting = false;
            StateHasChanged();

            await journal.WriteAsync(JournalCategory.Edition, "structure.import", e.File?.Name,
                $"{importedElements} élément(s) importé(s) dans « {Structure?.Name} »",
                severity: 1, structureId: Structure?.StructureId);

            await JsRuntime.InvokeVoidAsync("alert", "Creation completed...");
        }
        }
        finally
        {
            // Never leave journaling switched off for the rest of the circuit, even if the import
            // throws half-way through.
            entitiesService.SuppressJournal = false;
        }

    }


