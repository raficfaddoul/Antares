@implements IDisposable
@using AliantWebS.Data
@using Models
@using Microsoft.EntityFrameworkCore
@inject AliantWebS.Data.AppData appData
@inject EntitiesService entitiesService
@inject IStringLocalizer<Languages> L

@typeparam TItem1
@typeparam TItem2
@typeparam TItem3



<Div Style="display: flex">
    <h3>@Titre</h3>
    <div style="margin-left: auto; ">
        <Label> @L["Page Size"]: &nbsp;&nbsp;</Label>
        <RadzenNumeric @bind-Value="PageSize" Style="width:60px"></RadzenNumeric>
    </div>
</Div>
@if (InspectionResultTypeList is null)
{
    <p><em>@L["Loading"]... !</em></p>
}
else
{
    <EditForm Model="@InspectionResultTypeElementTypesCollection" id="JunctionFormId" OnValidSubmit="@OnValidSubmit">
        <RadzenDataGrid class="RadzenDataGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize"
                    Data="@InspectionResultTypeList" TItem="TItem2" ColumnWidth="150px">
            <Columns>
                @* <RadzenDataGridColumn TItem="TItem2" Property="@TItem2IdName" Title="@TItem2IdName"></RadzenDataGridColumn> *@
                <RadzenDataGridColumn TItem="TItem2" Property="Name" Title="Name"></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TItem2" Property="Description" Title="Description"></RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="TItem2" Property="Length" Title="Action">
                    <Template Context="inspectionResultType">
                        <RadzenCheckBox TValue=bool Value=@GetValue(inspectionResultType) Change=@(args => OnChange(args, inspectionResultType))></RadzenCheckBox>

                    </Template>

                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

@*        <br />
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <button type="submit" class="btn btn-success">
                        Submit
                    </button>
                </div>
            </div>
        </div>*@
    </EditForm>
}

@code {

    [Parameter] public string ButtonText { get; set; } = "Save";

    //[Parameter]
    //public EditContext EditContext { get; set; }

    int PageSize { get; set; } = 10;

    [Parameter]
    public string Titre { get; set; }

    [Parameter]
    public Guid CallerID { get; set; }

    [Parameter]
    public ICollection<TItem3> InspectionResultTypeElementTypesCollection { get; set; }

    [Parameter]
    public string TItem1IdName { get; set; }

    [Parameter]
    public string TItem2IdName { get; set; }

    [Parameter] public EventCallback OnValidSubmit { get; set; }


    TItem1 elementType;



    List<TItem2> InspectionResultTypeList;



    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(entitiesService.tasksList);
        elementType = (TItem1)appData.obj1;
        //  InspectionResultTypeElementTypesList = ((ICollection<InspectionResultTypeElementType>)AppData.obj).ToList();
        InspectionResultTypeList = await Task.Run(() => entitiesService.GetAllEntitiesAsync<TItem2>());


        //EditContext.OnFieldChanged -= FieldChanged;
        //EditContext.OnFieldChanged += FieldChanged;
        appData.ButtonText = ButtonText;

        appData.FormId = "JunctionFormId";
        appData.DisplaySubmitButton = true;


    }

    //private void FieldChanged(object sender, FieldChangedEventArgs arg)
    //{
    //    AppData.SaveChanges = true;
    //}

    object reflexion(object ob, string IdName)
    {
        var v = ob.GetType().GetProperties().First(x => x.Name == IdName).GetValue(ob);
        return v;
    }


    bool GetValue(TItem2 inspectionResultType)
    {
        if (InspectionResultTypeElementTypesCollection.Count(x => ((Guid)reflexion(x, TItem2IdName)) == ((Guid)reflexion(inspectionResultType, TItem2IdName))) > 0)
        { return true; }
        else
        {
            return false;
        }
    }

    // Ids whose unlinking is still being saved. Checking the same row again before that delete has
    // finished must not queue a second link next to the one being deleted: the check is ignored, and
    // the checkbox shows unchecked when the delete ends.
    readonly HashSet<Guid> removing = new HashSet<Guid>();

    async Task OnChange(bool args, TItem2 inspectionResultType)
    {
        Guid id = (Guid)reflexion(inspectionResultType, TItem2IdName);

        if (args && !GetValue(inspectionResultType) && !removing.Contains(id))
        {

            TItem3 inspectionResultTypeElementType = new TItem3();

            typeof(TItem3).GetProperties().First(x => x.Name == TItem2IdName).SetValue(inspectionResultTypeElementType, id);
            typeof(TItem3).GetProperties().First(x => x.Name == TItem1IdName).SetValue(inspectionResultTypeElementType, CallerID);


            InspectionResultTypeElementTypesCollection.Add(inspectionResultTypeElementType);

            //     (await entitiesService.InsertEntityAsync(elementType)
        }

        if (!args && GetValue(inspectionResultType))
        {
            // Every entry for this id, not only the first: rows saved before the unique indexes existed
            // can hold two links to the same type, and unchecking must leave none behind.
            var links = InspectionResultTypeElementTypesCollection.Where(x => ((Guid)reflexion(x, TItem2IdName)) == id).ToList();
            var toDelete = new List<TItem3>();

            removing.Add(id);
            try
            {
                foreach (var link in links)
                {
                    // Read, and its state set, while the link is still in the list. Entry() also detects changes
                    // on the parent the list belongs to, and a saved link already gone from it is a severed
                    // required relationship: where that relationship is not Cascade (channel data types,
                    // structure types) EF throws instead of deleting it, and the circuit ends.
                    var entry = entitiesService._appDBContext.Entry((object)link);

                    if (entry.State == EntityState.Added)
                    {
                        // Checked in this session and never saved: there is no row to delete. Handing it to
                        // DeleteEntityAsync is how the duplicate links were made - EF attached the entity as
                        // Added, then refused to mark it Deleted because its key was only a temporary value;
                        // the error alert showed, the entity stayed Added though it was no longer in the list,
                        // and the next Save inserted it next to the one checked again. Forget it instead.
                        entry.State = EntityState.Detached;
                    }
                    else if (entry.State != EntityState.Detached || entry.IsKeySet)
                    {
                        // A saved row (a detached entry with a key came from the database too).
                        entry.State = EntityState.Deleted;
                        toDelete.Add(link);
                    }
                    // Otherwise Detached with no key: never tracked, never saved; leaving the list is enough.

                    // Out of the list before anything is awaited, so a second Change event arriving
                    // meanwhile finds nothing left to remove.
                    InspectionResultTypeElementTypesCollection.Remove(link);
                }

                foreach (var link in toDelete)
                {
                    var entry = entitiesService._appDBContext.Entry((object)link);
                    // Already deleted by a save that ran meanwhile - the one for an earlier link of this id, or
                    // another page's.
                    if (entry.State != EntityState.Deleted) continue;

                    if (!await entitiesService.DeleteEntityAsync(link))
                    {
                        // DeleteEntityAsync has alerted the user. A delete left queued in the circuit's
                        // shared context would be sent again, and fail again, by every later save.
                        Console.WriteLine($"JunctionsComponent: deleting the {typeof(TItem3).Name} link to {id} failed.");
                        entry.State = EntityState.Detached;
                    }
                }
            }
            finally
            {
                removing.Remove(id);
            }
        }
        appData.SaveChanges = true;
    }

    void IDisposable.Dispose()
    {
        // Unsubscribe from the event when our component is disposed
        //EditContext.OnFieldChanged -= FieldChanged;

    }

}
