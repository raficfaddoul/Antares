@using AliantWebS.Data

@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject IJSRuntime js
@using Models
@inject AliantWebS.Data.AppData AppData
@inject IStringLocalizer<Languages> L







<Div Style="display: flex">
    <h3>@L["Attributes Types"]</h3>
    <div style="margin-left: auto; ">
        <Label> @L["Page Size"]: &nbsp;&nbsp;</Label>
        <RadzenNumeric @bind-Value="PageSize" Style="width:60px"></RadzenNumeric>
    </div>
</Div>
@if (attributeTypeList is null)
{
    <p><em>@L["Loading"]... !</em></p>
}
else
{
    <a class="nav-link" @onclick="@(args => InsertAttributeType())" @onclick:preventDefault="true" href="">
    <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
</a>
    <EditForm Model="@attributeTypeList">


        <RadzenDataGrid class="RadzenDataGrid" @ref="attributesTypesGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize"
                        Data="@attributeTypeList" TItem="AttributeType" ColumnWidth="150px" @bind-Value="@SelectedAttributeTypes">
            <Columns>

                <RadzenDataGridColumn Width="50" TItem="AttributeType" Property="Name">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Name"]</span>                    <br />
                    </HeaderTemplate>
                    <EditTemplate Context="attributeType">
                        <InputTextArea @bind-Value="attributeType.Name" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Width="50" TItem="AttributeType" Property="Description">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Description"]</span>                    <br />
                    </HeaderTemplate>
                    <EditTemplate Context="attributeType">
                        <InputTextArea @bind-Value="attributeType.Description" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Width="50" TItem="AttributeType" Property="Units">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Units"]</span>                    <br />
                    </HeaderTemplate>
                    <EditTemplate Context="attributeType">
                        <InputTextArea @bind-Value="attributeType.Units" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>


                <RadzenDataGridColumn Width="50" TItem="AttributeType" Property="PULMONARY_TOXICITY" Title="Action" Filterable="false" Sortable="false">
                    <Template Context="data">
                        <a title="@L["Edit"]" class="nav-link" @onclick="@(args => EditRow(data))" @onclick:preventDefault="true" href="">
                            <!--href="/patient/EditSideEffectComponent/@data.SideEffectID-->
                            <span class="oi oi-pencil" aria-hidden="true"></span>
                        </a>
                        <a title="@L["End Edit"]" class="nav-link" @onclick="@(args => UpdateRow(data))" @onclick:preventDefault="true" href="">
                            <span class="oi oi-check" aria-hidden="true"></span>
                        </a>
                        <a title="@L["Delete"]" class="nav-link" @onclick="@(() => DeleteAttributeType(data))" @onclick:preventDefault="true" href="">
                            <span class="oi oi-trash" aria-hidden="true"></span>
                        </a>
                    </Template>

                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </EditForm>

}


@code {

    int PageSize { get; set; } = 10;

    IList<AttributeType> SelectedAttributeTypes { get; set; }

    RadzenDataGrid<AttributeType> attributesTypesGrid;

    List<AttributeType> attributeTypeList;



    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(entitiesService.tasksList);
        attributeTypeList = await entitiesService.GetAllEntitiesAsync<AttributeType>();


    }



    async Task DeleteAttributeType(AttributeType attributeType)
    {

        if (await entitiesService.DeleteEntityAsync(attributeType))
        {
            if (attributeTypeList.Remove(attributeType))
            {
                await attributesTypesGrid.Reload();

            }
        }


        //    await js.InvokeVoidAsync("alert", $"Updated Successfully!");
        //    sideEffectsList = await httpClient.GetFromJsonAsync<SideEffect[]>($"api/sideEffect/4/{EvaluationID}");
        // uriHelper.NavigateTo("/patient/evaluations/" + PatientID);

    }

    void EditRow(AttributeType attributeType)
    {

            attributesTypesGrid.EditRow(attributeType);

    }

    async Task InsertAttributeType()
    {
        AttributeType attributeType = new AttributeType();

        if ((await entitiesService.InsertEntityAsync(attributeType)) != null)
        {
            attributeTypeList.Add(attributeType);
   
                await attributesTypesGrid.InsertRow(attributeType);
    
        }
        else
        {
            await js.InvokeVoidAsync("alert", $"Update Unsuccessfull!");
        }


    }

    async Task UpdateRow(AttributeType attributeType)
    {
        if (await entitiesService.UpdateEntityAsync(attributeType))
        {
            await attributesTypesGrid.UpdateRow(attributeType);
        }
    }




}
