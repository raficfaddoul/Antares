@page "/DefectTypeAttributeTypes/{CallerID:guid}"
@using Models
@using AliantWebS.Data
@inject AliantWebS.Data.AppData AppData
@inject EntitiesService entitiesService




<AliantWebS.Pages.TypesPages.JunctionsComponent Titre=@titre
                                                TItem1="DefectType"
                                                TItem2="AttributeType"
                                                TItem3="AttributeTypeDefectType"
                                                CallerID=@CallerID
                                                TItem1IdName="DefectTypeId"
                                                TItem2IdName="AttributeTypeId"
                                                InspectionResultTypeElementTypesCollection=@callerType.AttributeTypeDefectTypes
                                                OnValidSubmit="@Update">

</AliantWebS.Pages.TypesPages.JunctionsComponent>



@code {

    //[Parameter]
    //public EditContext EditContext { get; set; }

    [Parameter]
    public Guid CallerID { get; set; }

    public string titre { get; set; }

    DefectType callerType;

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        callerType = (DefectType)AppData.obj1;
        entitiesService.LoadCollection(callerType, "AttributeTypeDefectTypes");
        //EditContext = new EditContext(callerType.AttributeTypeDefectTypes);
        await base.SetParametersAsync(parameters);
    }

    protected override async Task OnInitializedAsync()
    {

        titre = "Defect Type \"" + callerType.Name + "\" Attribute Types Association";
    }

    protected async void Update()
    {
        await entitiesService.UpdateEntityAsync(callerType);
    }

}
