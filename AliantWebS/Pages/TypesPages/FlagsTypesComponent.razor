@using AliantWebS.Data
@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject IJSRuntime js
@using Models
@inject AliantWebS.Data.AppData AppData
@inject IStringLocalizer<Languages> L






<Div Style="display: flex">
    <h3>@L["Flag Types"]</h3>
    <div style="margin-left: auto; ">
        <Label> @L["Page Size"]: &nbsp;&nbsp;</Label>
        <RadzenNumeric @bind-Value="PageSize" Style="width:60px"></RadzenNumeric>
    </div>
</Div>
@if (flagTypeList is null)
{
    <p><em>@L["Loading"]... !</em></p>
}
else
{
    <a class="nav-link" @onclick="@(args => InsertFlagType())" @onclick:preventDefault="true" href="">
    <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
</a>
    <EditForm Model="@flagTypeList">


        <RadzenDataGrid class="RadzenDataGrid" @ref="flagTypesGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize"
                    Data="@flagTypeList" TItem="FlagType" ColumnWidth="150px" @bind-Value="@SelectedFlagTypes">
            <Columns>

                <RadzenDataGridColumn Width="50" TItem="FlagType" Property="Name">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Name"]</span>                    <br />
                    </HeaderTemplate>
                    <EditTemplate Context="flagType">
                        <InputTextArea @bind-Value="flagType.Name" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Width="50" TItem="FlagType" Property="Description">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Description"]</span>                    <br />
                    </HeaderTemplate>
                    <EditTemplate Context="flagType">
                        <InputTextArea @bind-Value="flagType.Description" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="50" TItem="FlagType" Property="PULMONARY_TOXICITY" Title="@L["Action"]" Filterable="false" Sortable="false">
                    <Template Context="data">
                        <Div Style="display: flex">
                            <a title="@L["Edit"]" class="nav-link" @onclick="@(args => EditRow(data))" @onclick:preventDefault="true" href="">
                                <!--href="/patient/EditSideEffectComponent/@data.SideEffectID-->
                                <span class="oi oi-pencil" aria-hidden="true"></span>
                            </a>
                            <a title="@L["End Edit"]" class="nav-link" @onclick="@(args => UpdateRow(data))" @onclick:preventDefault="true" href="">
                                <span class="oi oi-check" aria-hidden="true"></span>
                            </a>
                            <a title="@L["Delete"]" class="nav-link" @onclick="@(() => DeleteFlagType(data))" @onclick:preventDefault="true" href="">
                                <span class="oi oi-trash" aria-hidden="true"></span>
                            </a>
                        </Div>
                    </Template>

                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </EditForm>

}


@code {

    int PageSize { get; set; } = 10;

    IList<FlagType> SelectedFlagTypes { get; set; }

    RadzenDataGrid<FlagType> flagTypesGrid;

    List<FlagType> flagTypeList;



    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(entitiesService.tasksList);
        flagTypeList = await entitiesService.GetAllEntitiesAsync<FlagType>();


    }



    async Task DeleteFlagType(FlagType flagType)
    {
        if (await entitiesService.DeleteEntityAsync(flagType))
        {
            if (flagTypeList.Remove(flagType))
            {
                await flagTypesGrid.Reload();

            }
        }


        //    await js.InvokeVoidAsync("alert", $"Updated Successfully!");
        //    sideEffectsList = await httpClient.GetFromJsonAsync<SideEffect[]>($"api/sideEffect/4/{EvaluationID}");
        // uriHelper.NavigateTo("/patient/evaluations/" + PatientID);

    }

    void EditRow(FlagType flagType)
    {

        flagTypesGrid.EditRow(flagType);

    }

    async Task InsertFlagType()
    {
        FlagType flagType = new FlagType();

        if ((await entitiesService.InsertEntityAsync(flagType)) != null)
        {
            flagTypeList.Add(flagType);

            await flagTypesGrid.InsertRow(flagType);

        }

        else
        {
            await js.InvokeVoidAsync("alert", $"Update Unsuccessfull!");
        }


    }

    async Task UpdateRow(FlagType flagType)
    {
        if (await entitiesService.UpdateEntityAsync(flagType))
        {
            await flagTypesGrid.UpdateRow(flagType);
        }
    }




}