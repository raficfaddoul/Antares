@using AliantWebS.Data
@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject IJSRuntime js
@using Models
@inject AliantWebS.Data.AppData AppData
@inject IStringLocalizer<Languages> L





<Div Style="display: flex">
    <h3>Categories List</h3>
    <div style="margin-left: auto; ">
        <Label> @L["Page Size"]: &nbsp;&nbsp;</Label>
        <RadzenNumeric @bind-Value="PageSize" Style="width:60px"></RadzenNumeric>
    </div>
</Div>
@if (CategoriesList is null)
{
    <p><em>@L["Loading"]... !</em></p>
}
else
{
    <a class="nav-link" @onclick="@(args => InsertElementCategoryType())" @onclick:preventDefault="true" href="">
        <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
    </a>
    <EditForm Model="@CategoriesList">


        <RadzenDataGrid class="RadzenDataGrid" @ref="CategoriesGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize"
                    Data="@CategoriesList" TItem="Category" ColumnWidth="150px" @bind-Value="@SelectedCategories">
            <Columns>

                <RadzenDataGridColumn Width="50" TItem="Category" Property="Name">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Name"]</span>                    <br />
                    </HeaderTemplate>
                    <EditTemplate Context="category">
                        <InputTextArea @bind-Value="category.Name" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Width="50" TItem="Category" Property="Description">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Description"]</span>                    <br />
                    </HeaderTemplate>
                    <EditTemplate Context="category">
                        <InputTextArea @bind-Value="category.Description" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="50" TItem="Category" Property="PULMONARY_TOXICITY" Title="@L["Action"]" Filterable="false" Sortable="false">
                    <Template Context="data">
                        <Div Style="display: flex">
                            <a title="@L["Edit"]" class="nav-link" @onclick="@(args => EditRow(data))" @onclick:preventDefault="true" href="">
                                <!--href="/patient/EditSideEffectComponent/@data.SideEffectID-->
                                <span class="oi oi-pencil" aria-hidden="true"></span>
                            </a>
                            <a title="@L["End Edit"]" class="nav-link" @onclick="@(args => UpdateRow(data))" @onclick:preventDefault="true" href="">
                                <span class="oi oi-check" aria-hidden="true"></span>
                            </a>
                            <a title="@L["Delete"]" class="nav-link" @onclick="@(() => DeleteFlagType(data))" @onclick:preventDefault="true" href="">
                                <span class="oi oi-trash" aria-hidden="true"></span>
                            </a>
                        </Div>
                    </Template>

                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </EditForm>

}


@code {

    int PageSize { get; set; } = 10;

    IList<Category> SelectedCategories { get; set; }

    RadzenDataGrid<Category> CategoriesGrid;

    List<Category> CategoriesList;




    protected override async Task OnInitializedAsync()
    {
        //if (entitiesService.cts.IsCancellationRequested)
        //{
        //    entitiesService.cts = new System.Threading.CancellationTokenSource();
        //}
        //else
        //{

        //    entitiesService.cts.Cancel();
        // //   await Task.WhenAll(entitiesService.tasksList);
        //    entitiesService.cts = new System.Threading.CancellationTokenSource();
        //}

        await Task.WhenAll(entitiesService.tasksList);
        CategoriesList = await entitiesService.GetAllEntitiesAsync<Category>();


    }



    async Task DeleteFlagType(Category category)
    {
        if (await entitiesService.DeleteEntityAsync(category))
        {
            if (CategoriesList.Remove(category))
            {
                await CategoriesGrid.Reload();

            }
        }


        //    await js.InvokeVoidAsync("alert", $"Updated Successfully!");
        //    sideEffectsList = await httpClient.GetFromJsonAsync<SideEffect[]>($"api/sideEffect/4/{EvaluationID}");
        // uriHelper.NavigateTo("/patient/evaluations/" + PatientID);

    }

    void EditRow(Category category)
    {

        CategoriesGrid.EditRow(category);

    }

    async Task InsertElementCategoryType()
    {
        Category category = new Category();

        if ((await entitiesService.InsertEntityAsync(category)) != null)
        {
            CategoriesList.Add(category);

            await CategoriesGrid.InsertRow(category);

        }
        else
        {
            await js.InvokeVoidAsync("alert", $"Update Unsuccessfull!");
        }


    }

    async Task UpdateRow(Category category)
    {
        if (await entitiesService.UpdateEntityAsync(category))
        {
            await CategoriesGrid.UpdateRow(category);
        }
    }




}