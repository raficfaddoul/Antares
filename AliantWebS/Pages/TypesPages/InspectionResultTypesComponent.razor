@using AliantWebS.Data
@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject IJSRuntime js
@inject AliantWebS.Data.AppData AppData
@using Models
@inject IStringLocalizer<Languages> L



<Div Style="display: flex">
    <h3>@L["Condition States Types"]</h3>
    <div style="margin-left: auto; ">
        <Label> @L["Page Size"]: &nbsp;&nbsp;</Label>
        <RadzenNumeric @bind-Value="PageSize" Style="width:60px"></RadzenNumeric>
    </div>
</Div>
@if (inspectionResultTypeList is null)
{
    <p><em>@L["Loading"]... !</em></p>
}
else
{
    <a class="nav-link" @onclick="@(args => InsertInspectionResultType())" @onclick:preventDefault="true" href="">
        <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
    </a>
    <EditForm Model="@inspectionResultTypeList">


        <RadzenDataGrid class="RadzenDataGrid" @ref="inspectionResultTypesGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize"
                        Data="@inspectionResultTypeList" TItem="InspectionResultType" ColumnWidth="150px" @bind-Value="@SelectedInspectionResultTypes">
            <Columns>

                <RadzenDataGridColumn Width="50" TItem="InspectionResultType" Property="Name">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Name"]</span>                    <br />
                    </HeaderTemplate>
                    <EditTemplate Context="inspectionResultType">
                        <InputTextArea @bind-Value="inspectionResultType.Name" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Width="50" TItem="InspectionResultType" Property="Description">
                    <HeaderTemplate>
                        <span class="gridColumndStyle">@L["Description"]</span>                    <br />
                    </HeaderTemplate>
                    <EditTemplate Context="defectType">
                        <InputTextArea @bind-Value="defectType.Description" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>



                <RadzenDataGridColumn Width="50" TItem="InspectionResultType" Property="PULMONARY_TOXICITY" Title="@L["Action"]" Filterable="false" Sortable="false">
                    <Template Context="data">
                        <Div Style="display: flex">
                            <a title="@L["Edit"]" class="nav-link" @onclick="@(args => EditRow(data))" @onclick:preventDefault="true" href="">
                                <!--href="/patient/EditSideEffectComponent/@data.SideEffectID-->
                                <span class="oi oi-pencil" aria-hidden="true"></span>
                            </a>
                            <a title="@L["End Edit"]" class="nav-link" @onclick="@(args => UpdateRow(data))" @onclick:preventDefault="true" href="">
                                <span class="oi oi-check" aria-hidden="true"></span>
                            </a>
                            <a title="@L["Delete"]" class="nav-link" @onclick="@(() => DeleteRow(data))" @onclick:preventDefault="true" href="">
                                <span class="oi oi-trash" aria-hidden="true"></span>
                            </a>
                        </Div>
                        <Div Style="display: flex">
                            <a title="@L["Flag Types"]" class="nav-link" @onclick="@(args => FlagTypes(data))" @onclick:preventDefault="true" href="">
                                <span class="oi oi-flag" aria-hidden="true"></span>
                            </a>
                            <a title="@L["Element Types"]" class="nav-link" @onclick="@(args => ElementTypes(data))" @onclick:preventDefault="true" href="">
                                <span class="fab fa-elementor" aria-hidden="true"></span>
                            </a>
                        </Div>
                    </Template>

                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </EditForm>

}


@code {

    int PageSize { get; set; } = 10;
    IList<InspectionResultType> SelectedInspectionResultTypes { get; set; }

    RadzenDataGrid<InspectionResultType> inspectionResultTypesGrid;

    List<InspectionResultType> inspectionResultTypeList;




    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(entitiesService.tasksList);
        inspectionResultTypeList = await entitiesService.GetAllEntitiesAsync<InspectionResultType>();


    }



    async Task DeleteRow(InspectionResultType inspectionResultType)
    {
        if (await entitiesService.DeleteEntityAsync(inspectionResultType))
        {
            if (inspectionResultTypeList.Remove(inspectionResultType))
            {
                await inspectionResultTypesGrid.Reload();

            }
        }


    }

    void EditRow(InspectionResultType inspectionResultType)
    {

            inspectionResultTypesGrid.EditRow(inspectionResultType);

    }

    async Task InsertInspectionResultType()
    {
        InspectionResultType inspectionResultType = new InspectionResultType();

        if ((await entitiesService.InsertEntityAsync(inspectionResultType)) != null)
        {
            inspectionResultTypeList.Add(inspectionResultType);

                await inspectionResultTypesGrid.InsertRow(inspectionResultType);
        
        }
        else
        {
            await js.InvokeVoidAsync("alert", $"Update Unsuccessfull!");
        }


    }

    async Task UpdateRow(InspectionResultType inspectionResultType)
    {
        if (await entitiesService.UpdateEntityAsync(inspectionResultType))
        {
            await inspectionResultTypesGrid.UpdateRow(inspectionResultType);
        }
    }

    async Task FlagTypes(InspectionResultType inspectionResultType)
    {
        AppData.obj = inspectionResultType;

        navigationManager.NavigateTo("/InspectionResultTypeFlagTypes/" + inspectionResultType.InspectionResultTypeId);
    }

    async Task ElementTypes(InspectionResultType inspectionResultType)
    {
        AppData.obj = inspectionResultType;

        navigationManager.NavigateTo("/InspectionResultTypeElementTypes/" + inspectionResultType.InspectionResultTypeId);
    }


}

