@page "/DeepLearning"
@using AI
@using AliantWebS.Models
@using AliantWebS.Data
@using Microsoft.AspNetCore.Hosting
@inject NavigationManager navigationManager
@inject AppData appData;
@inject EntitiesService entitiesService
@inject IWebHostEnvironment Environment
@inject IJSRuntime js

@layout LearningLayout






<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <button type="button" class="btn btn-success" @onclick="@Simulation">
                Simulate
            </button>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <button type="button" class="btn btn-success" @onclick="@Train">
                Train
            </button>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <button type="button" class="btn btn-success" @onclick="@Predict">
                Predict
            </button>
        </div>
    </div>
</div>

@code {

    RadzenStack sidebar;



        Structure structure;

    protected override async Task OnInitializedAsync()
    {
        structure = (Structure)appData.obj;
    }





    void Simulation()
    {

        navigationManager.NavigateTo("Simulation");
    }

    void Train()
    {
        navigationManager.NavigateTo("Training");


    }

    async Task Predict()
    {
                navigationManager.NavigateTo("Prediction");

    }

    void ToggleSidebar()
    {
    
    }

}
