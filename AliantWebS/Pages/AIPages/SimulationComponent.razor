@page "/Simulation"
@using AliantWebS.Models
@using AliantWebS.Data
@using Microsoft.AspNetCore.Hosting
@inject AppData appData;
@inject EntitiesService entitiesService
@inject IWebHostEnvironment Environment
@inject NavigationManager navigationManager
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<Languages> L

@layout LearningLayout

<h3>Simulation</h3>

<EditForm Model="simPa" >
    <DataAnnotationsValidator />
    <Blazorise.Row>
        <Column ColumnSize="ColumnSize.Is8" >
            <div class="form-group">
                <label>@L["Simulation Identifier"]:</label>
                <div>
                    <InputText @bind-Value="@simPa.SimulationID" />
                    <ValidationMessage For="@(() => simPa.SimulationID)" />
                </div>
            </div>
            <div class="form-group">
                <label>@L["Short Description"] :</label>
                <div>
                    <textarea @bind="@simPa.ShortDescription" class="form-control"></textarea>
                    <ValidationMessage For="@(() => simPa.ShortDescription)" />
                </div>
            </div>
            <div class="form-group ">
                <div>
                    <label>@L["Signal Length (seconds)"]:</label>
                    <div>
                        <InputNumber @bind-Value="@simPa.Duree" />
                        <ValidationMessage For="@(() => simPa.Duree)" />
                    </div>
                </div>
            </div>
            <div class="form-group ">
                <div>
                    <label>@L["Sampling Frequency"] :</label>
                    <div>
                        <InputNumber @bind-Value="@simPa.SamplingFrequency" />
                        <ValidationMessage For="@(() => simPa.SamplingFrequency)" />
                    </div>
                </div>
            </div>
        </Column>
        <Column ColumnSize="ColumnSize.Is4" >
            <div class="form-group ">
                <div>
                    <label>@L["File Batches"]:</label>
                    <div>
                        <InputNumber @bind-Value="@simPa.FileOpens" />
                        <ValidationMessage For="@(() => simPa.FileOpens)" />
                    </div>
                </div>
            </div>

            <div class="form-group ">
                <div>
                    <label>@L["Number of simulations per batch"]:</label>
                    <div>
                        <InputNumber @bind-Value="@simPa.SimulationNum" />
                        <ValidationMessage For="@(() => simPa.SimulationNum)" />
                    </div>
                </div>
            </div>

            <div class="form-group ">
                <div>
                    <label>@L["Divider"]:</label>
                    <div>
                        <InputNumber @bind-Value="@simPa.Divider" />
                        <ValidationMessage For="@(() => simPa.Divider)" />
                    </div>
                </div>
            </div>

            <div class="form-group ">
                <div>
                        <label>@L["Multiplicity"]:</label>
                    <div>
                        <InputNumber @bind-Value="@simPa.Multiplicity" />
                        <ValidationMessage For="@(() => simPa.Multiplicity)" />
                    </div>
                </div>
            </div>

            <div class="form-group ">
                <div>
                        <label>@L["One Element At a Time"]:</label>
                    <div>
                        <InputCheckbox @bind-Value="simPa.oneElementAtATime"></InputCheckbox>
                    </div>
                </div>
            </div>


            <div class="form-group ">
                <div>
                        <label>@L["Simulation Seed"]:</label>
                    <div>
                        <InputNumber @bind-Value="@simPa.GlobalSeed" />
                        <ValidationMessage For="@(() => simPa.GlobalSeed)" />
                    </div>
                </div>
            </div>


        </Column>
    </Blazorise.Row>

    <br />
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <button type="button" class="btn btn-success" @onclick="@Simulate">
                            @L["Simulate"]
                </button>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                @*   Number of structures simulated :*@

                <RadzenProgressBar @bind-Value="@ss" />

            </div>
        </div>
    </div>

</EditForm>




@code {
    //InputText it;

    string simulatedStructures { get; set; }

    double ss { get; set; }

    Structural.SimulationParameters simPa;

    public Structural.Structure structuralStructure;

    Structure structure;

    Structural.Simulation sim = new Structural.Simulation();

    protected override async Task OnInitializedAsync()
    {
        structure = appData.Structure;

        if (structure == null)
        {
            navigationManager.NavigateTo("Structures");
        }


        simPa = new Structural.SimulationParameters();


        string path = Path.Combine(Environment.ContentRootPath, "TrainingSets");

        path = Path.Combine(path, structure.StructureId.ToString());

        simPa.Path = path;

        if (!Directory.Exists(path))
        {
            Directory.CreateDirectory(path);
        }

        //   public SimulationParameters(AliantWebS.Models.Structure structure, EntitiesService entitiesService)



        sim.SimulationProgressing += SimulationProgress;
    }

    async Task Simulate()
    {
        try
        {
            structuralStructure = await Structural.Simulation.CreateStructure(structure,null, entitiesService);
        }
        catch (Exception ex)
        {

            string m = "Could not create Structural twin... Error: " + ex.Message;

            await JsRuntime.InvokeVoidAsync("alert", m);
            return;
        }


        await sim.Simulate(structuralStructure, simulationParameters: simPa);


    }



    private async Task SimulationProgress(object sender, params string[] str)
    {


        simulatedStructures = str[0];
        ss = Convert.ToDouble(simulatedStructures) * 5;




        await InvokeAsync(this.StateHasChanged);


    }


    public void Dispose()
    {
        sim.SimulationProgressing -= SimulationProgress;
    }





}
