@page "/Prediction"
@using AliantWebS.Models
@using AliantWebS.Data
@using Microsoft.AspNetCore.Hosting
@using AI
@using HDF5CSharp;

@inject AppData appData;
@inject EntitiesService entitiesService
@inject IWebHostEnvironment Environment
@inject IJSRuntime js

@inject IStringLocalizer<Languages> L


@layout LearningLayout


<h3>@L["Prediction Component"]</h3>

<EditForm Model="pPa">
    <DataAnnotationsValidator />
    <Blazorise.Row>
        <Column ColumnSize="ColumnSize.Is6">
            <div class="form-group">
                <label>@L["Prediction Identifier"] :</label>
                <div>
                    <InputText @bind-Value="@pPa.PredictionID" />
                    <ValidationMessage For="@(() => pPa.PredictionID)" />
                </div>
            </div>
            <div class="form-group">
                <label>@L["Short Description"] :</label>
                <div>
                    <textarea @bind="@pPa.ShortDescription" class="form-control"></textarea>
                    <ValidationMessage For="@(() => pPa.ShortDescription)" />
                </div>
            </div>
            <div style="display: flex; justify-content: space-between;">
            <div class="form-group">
                <label>@L["Model Identifier"] :</label>
                <div>
                    <InputText @bind-Value="@pPa.ModelID" />
                    <ValidationMessage For="@(() => pPa.ModelID)" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <button type="button" class="btn btn-success" @onclick="@Predict">
                            @L["Predict"]
                        </button>
                    </div>
                </div>
            </div>
            </div>

        </Column>
        <Column ColumnSize="ColumnSize.Is6">


            <div class="form-group">
                <label>@L["H5 Data"] :</label>
                <div>
                    <InputSelect TValue="string" @bind-Value="@SelectedPath" class="form-control">
                        <option value="NoFileSelected">ppp.H5</option>

                        @foreach (string p in pathsForFiles)
                        {
                            <option value="@p">@Path.GetFileName(p)</option>
                        }

                    </InputSelect>
                </div>
            </div>









        </Column>
    </Blazorise.Row>




</EditForm>
@if (@present)
{
    <div class="col-sm-6">
        <h4>Rigidités des elements structuraux</h4>
        <RadzenChart  style="height: 600px">
            <RadzenBarSeries Data="@revenue2020" CategoryProperty="Quarter" Title="2020" LineType="LineType.Dashed" ValueProperty="Revenue">
                <RadzenSeriesDataLabels Visible="@showDataLabels" />
            </RadzenBarSeries>

            <RadzenValueAxis>
                <RadzenGridLines Visible="true" />
                <RadzenAxisTitle Text="Rigidité" />
            </RadzenValueAxis>
            <RadzenBarOptions Radius="5" />
        </RadzenChart>
    </div>
}




@code {

    bool showDataLabels = true;
    class DataItem
    {
        public string Quarter { get; set; }
        public double Revenue { get; set; }
    }

    DataItem[] revenue2020 = new DataItem[28];
    bool present = false;


    List<double> l = new List<double>() { 1.0075, 0.9982, 0.9747, 0.9801, 1.0098, 1.0015, 0.9829, 0.9749, 0.9731, 0.9753, 0.9907, 0.9983, 1.014, 0.9677, 0.9569, 1.013, 0.9965, 1, 1.0004, 0.9945, 0.989, 0.9908, 0.9991, 0.9966, 0.9873, 0.991, 1.0008, 0.9973 };

    Structural.SimulationParameters simParameters = new Structural.SimulationParameters();

    Structural.PredictionParameters pPa = new Structural.PredictionParameters();

    Structure structure;

    List<string> pathsForFiles = new List<string>();


    private string selectedPath;
    [Parameter]
    public string SelectedPath
    {
        get => selectedPath;
        set
        {
            if (selectedPath == value) return;
            selectedPath = value;

            if (selectedPath == "NoFileSelected") return;

            if (!File.Exists(selectedPath))
            {
                throw new FileNotFoundException(selectedPath);
            }

            if (selectedPath != null)
            {
                using (simParameters = new Structural.SimulationParameters())
                {
                    long fileId = Hdf5.OpenFile(selectedPath, true);



                    simParameters = Hdf5.ReadObject(fileId, simParameters, "simulationParameters");

                    Hdf5.CloseFile(fileId);

                }
            }


        }
    }




    protected override async Task OnInitializedAsync()
    {
        structure = (Structure)appData.obj;

        var pff = await FileManagementService.GetPathForFilesAsync(structure,false, @"TrainingSets\");
        pathsForFiles.AddRange(pff);
        //SelectedPath = pathsForFiles.FirstOrDefault();
        selectedPath = "NoFileSelected";

        for (int i = 0; i < 28; i++)
        {
            revenue2020[i] = new DataItem() { Quarter = "p"+i.ToString(), Revenue = l[i] };
        }
        present = true;
    }

    async void Predict()
    {
        string NNModelPath = Path.Combine(Environment.ContentRootPath, "NNModels");


        NNModelPath = Path.Combine(NNModelPath, structure.StructureId.ToString());
        var s = Path.Combine(NNModelPath, "Temp.H5");
        structure = entitiesService.GetFilteredEntitiesAsync<Structure>(a => a.StructureId == structure.StructureId, "Elements.ElementType.Category").Result.FirstOrDefault();


        var v = Structural.Simulation.GetSensedNodes(structure, entitiesService._appDBContext);

        var sensedNdes = v.sensedNodesIndex.Values.ToArray();


        if (selectedPath == "NoFileSelected")
        {

            simParameters = new Structural.SimulationParameters();

            simParameters.SamplingFrequency = 1000;
            simParameters.Duree = 5;
            simParameters.Divider = 1;
            simParameters.Multiplicity = 1;


            var listSensors = v.Item2.ToArray();

            if (sensedNdes.Count() != listSensors.Count())
            {
                throw new Exception();
            }

            List<(string, int)> csvsFilesPaths = new List<(string, int)>();


            int idd = 0;
            foreach (Element sensor in listSensors)
            {
                var pff = await FileManagementService.GetPathForFilesAsync(sensor,false, @"CSVs\");

                csvsFilesPaths.Add((pff.FirstOrDefault(), sensedNdes[idd]));

                idd++;
            }

            Structural.Simulation.CSVsToH5(csvsFilesPaths: csvsFilesPaths, outputH5FilePath: s, simPa: simParameters,v.Item4.Count*3);
        }



        string prompted = await js.InvokeAsync<string>("prompt", "Enter Element(s) Index:");

        var elementsIndexes = Helpers.ListFromString<int>(prompted).ToList();

        List<double> predictions = new List<double>();

        foreach (int i in elementsIndexes)
        {

            string modelFile = Path.Combine(NNModelPath, pPa.ModelID + "nnmodel" + i.ToString() + ".dat");

            double r = -1;
            if (File.Exists(modelFile))
            {
                if (selectedPath == "NoFileSelected")
                {

                    r = PredictW.Predictt(h5File: s, modelFile: modelFile, sensedNodes: sensedNdes, elementIndex: i).FirstOrDefault();
                }
                else
                {
                    r = PredictW.Predictt(h5File: selectedPath, modelFile: modelFile, sensedNodes: sensedNdes, elementIndex: i).FirstOrDefault();

                }

            }
            predictions.Add(r);
        }

        var per = predictions.Select(x => x.ToString("F2"));

        //await js.InvokeVoidAsync("alert", string.Join(',', per));

        //  AI.Predict.DoPrediction();



    }












}
