@page "/Python"
@using IronPython.Hosting
@using Microsoft.Scripting.Hosting;
@using System.Text;
<h3>PythonComponent</h3>

@code {



    protected override async Task OnInitializedAsync()
    {
        //1- Create Engine
        Microsoft.Scripting.Hosting.ScriptEngine engine = Python.CreateEngine();

         ICollection<string> searchPaths = engine.GetSearchPaths();

        // 2- Provode script and arguments
        string scriptPath = @"C:\Users\rafic\Desktop\AliantWebS\AliantWebS\AliantWebS\PythonCode\script.py";

                    searchPaths.Add("..\\..\\Lib");
            engine.SetSearchPaths(searchPaths);

        ScriptSource source = engine.CreateScriptSourceFromFile(scriptPath);

        var argv = new List<string>();
        argv.Add("");

        engine.GetSysModule().SetVariable("argv", argv);

        //3- output ridirect
        var eIO = engine.Runtime.IO;

        var errors = new MemoryStream();
        eIO.SetErrorOutput(errors, Encoding.Default);

        var results = new MemoryStream();
        eIO.SetOutput(results, Encoding.Default);

        //4 - Execute Script
        var scope = engine.CreateScope();
        source.Execute(scope);

        //5- Display Output
        string str(byte[] x) => Encoding.Default.GetString(x);

        Console.WriteLine("Errors");
        Console.WriteLine(str(errors.ToArray()));
        Console.WriteLine();
        Console.WriteLine("Results");
        Console.WriteLine(str(errors.ToArray()));


    }

}
