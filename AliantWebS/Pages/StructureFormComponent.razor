@implements IDisposable
@using AliantWebS.Models
@using AliantWebS.Data
@using System.Text.Json
@using AliantWebS.Pages.InventoryElementPages
@using Microsoft.EntityFrameworkCore
@using OpenAI.Chat;

@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject AppData appData;
@inject IStringLocalizer<Languages> L
@inject Radzen.DialogService DialogService
@inject IJSRuntime js


@if (ButtonText != "Create")
{
    <div style="display: flex">
        <div style="display: flex">
            <div class="file-input-zone">
                <NavLink title="BIM" class="nav-link" href="dgfrdgh" @onclick:preventDefault="true">
                    <span align="center" style="width:30px" class="fa fa-cube" aria-hidden="true"></span>
                </NavLink>
                <InputFile OnChange="@LoadFiles" />
            </div>
            <div class="file-input-zone">
                <a title="Create BIM" class="nav-link" @onclick="@CreateIFC" href="dgfrdgh" @onclick:preventDefault="true">
                    @if (!isCreatingIFC)
                    {
                        <span align="center" style="width:30px" class="fa fa-cube" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="fas fa-spinner fa-spin"></i>
                    }

                </a>

            </div>
        </div>

        <div style="margin-left: auto; display: flex">
            <Blazorise.Button Clicked="@OnCADButtonClicked" Color="Blazorise.Color.Primary">@L["CAD"]</Blazorise.Button>
        </div>

        <div style="margin-left: auto; display: flex">
            <Blazorise.Button Clicked="@OnEventsButtonClicked" Color="Blazorise.Color.Primary">@L["Edit Structure Events"]</Blazorise.Button>
        </div>
        <div style="margin-left: auto; display: flex">

            <Blazorise.Button Clicked="@OnEquipementsButtonClicked" Color="Blazorise.Color.Primary">@L["Edit Structure Equipements"]</Blazorise.Button>
        </div>
        <div style="margin-left: auto; display: flex">

            <Blazorise.Button Clicked="@OnElementsButtonClicked" Color="Blazorise.Color.Primary">@L["Edit Structure Elements"]</Blazorise.Button>
        </div>
    </div>
}
<hr />
@if (structureTypesList is null)
{
    <p><em>Loading... !</em></p>
}
else
{
    <RadzenSplitter Orientation="Radzen.Orientation.Vertical" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
        <RadzenSplitterPane Size="auto">
            <EditForm EditContext="@appData.StructureEditContext" id="StructureFormId" OnValidSubmit="@OnValidSubmit">
                <DataAnnotationsValidator />
                <Blazorise.Row>
                    <Column ColumnSize="ColumnSize.Is6">
                        <div class="form-group">
                            <label>@L["Structure Name"] :</label>
                            <div>
                                <InputText @bind-Value="@Structure.Name" @oninput='(() =>areachanged("Name"))' />
                                <ValidationMessage For="@(() => Structure.Name)" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>@L["Short Description"] :</label>
                            <div>
                                <textarea lang="fr" @bind="@Structure.ShortDescription" @oninput='(() =>areachanged("ShortDescription"))' class="form-control"></textarea>
                                <ValidationMessage For="@(() => Structure.ShortDescription)" />
                            </div>
                        </div>
                        <div class="form-group ">
                            <div>
                                <label>@L["Structure Size"] :</label>
                                <div>
                                    <InputNumber @bind-Value="@Structure.Length" @oninput='(() =>areachanged("Length"))' />
                                    <ValidationMessage For="@(() => Structure.Length)" />
                                </div>
                            </div>
                        </div>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is6">
                        <Blazorise.Row>
                            <Column ColumnSize="ColumnSize.Is5">
                                <div class="form-group ">
                                    <div>
                                        <label>@L["Year Built"] :</label>
                                        <div>
                                            <InputDate @bind-Value="@Structure.YearBuilt" />
                                            <ValidationMessage For="@(() => Structure.YearBuilt)" />
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group ">
                                    <div>
                                        <label>@L["Design Load"] :</label>
                                        <div>
                                            <InputNumber @bind-Value="@Structure.DesignLoad" />
                                            <ValidationMessage For="@(() => Structure.DesignLoad)" />
                                        </div>
                                    </div>
                                </div>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is7">
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="flex-item">
                                            <label>Latitude</label>
                                            <InputNumber TValue="double" @bind-Value="@Structure.Geolocation.Coordinate.X" class="form-control"></InputNumber>
                                            @* <ValidationMessage For="@(() => Structure.Geolocation)" /> *@
                                        </div>
                                        <div class="flex-item">
                                            <label>Longitude</label>
                                            <InputNumber @bind-Value="@Structure.Geolocation.Coordinate.Y" class="form-control"></InputNumber>
                                            @* <ValidationMessage For="@(() => Structure.Geolocation)" /> *@
                                        </div>
                                        <div class="flex-item button-container">
                                            <Blazorise.Button Clicked="@OnLongLatButtonClicked" Color="Blazorise.Color.Primary">
                                                <i class="fas fa-map-marker-alt"></i> <!-- Replace with your actual icon class -->
                                            </Blazorise.Button>
                                        </div>
                                    </div>
                                </div>

                            </Column>
                        </Blazorise.Row>

                        <div class="form-group">
                            <label for="Category" class="control-label">@L["Structure Type"]</label>
                            <InputSelect TValue="Guid?" class="form-control" @bind-Value="Structure.StructureTypeId">
                                <option value="">@L["Select"]...</option>
                                @foreach (var structureType in structureTypesList)
                                {
                                    <option value="@structureType.StructureTypeId">@structureType.Name</option>

                                }
                            </InputSelect>
                        </div>

                        <div class="form-group">
                            <label for="Category" class="control-label">@L["Site"]</label>
                            <InputSelect TValue="Guid?" class="form-control" @bind-Value="Structure.SiteId">
                                <option value="">@L["Select"]...</option>
                                @foreach (var site in sitesList)
                                {
                                    <option value="@site.SiteId">@site.Name</option>

                                }
                            </InputSelect>
                        </div>
                    </Column>
                </Blazorise.Row>
            </EditForm>
        </RadzenSplitterPane>
        <RadzenSplitterPane>

            @if (Title != @L["Add Structure"])
            {

                <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" Style="height: auto; border: 1px solid rgba(0,0,0,.08);">
                    <RadzenSplitterPane Style="height:auto">
                        @if (!((@Structure.AttributeStructures == null) || (@Structure.AttributeStructures.Count == 0)))
                        {
                            <AttributesComponent Titem1="AttributeStructure" Titem2="Structure" Titem3="StructureTypeAttributeType" CallerIdName="StructureId"
                            CallerTypeIdName="StructureTypeId" CallerTypeName="Structure" JunctionPropName="AttributeStructures"
                            element="Structure"></AttributesComponent>
                        }
                        @if (coordinates != null)
                        {
                            <AliantWebS.Pages.SharedComponents.MapComponent Coordinates="coordinates" ValueChanged=@OnMapClicked Scale="13"></AliantWebS.Pages.SharedComponents.MapComponent>
                        }
                    </RadzenSplitterPane>
                    <RadzenSplitterPane Style="height:auto">
                        @* <div style="width:100%"> *@
                        <div style="height:auto">
                            <MediaComponent selectedObject="Structure"></MediaComponent>
                        </div>

                    </RadzenSplitterPane>
                </RadzenSplitter>
            }

        </RadzenSplitterPane>
    </RadzenSplitter>
    <br />
    <div class="row">

        <div class="form-group">
            @*                    <button type="submit" class="btn btn-success">
        @ButtonText
        </button>*@
            <button disabled="@(Structure.StructureTypeId is null)" type="button" class="btn btn-success" @onclick="@InspectionButtonClick">
                @L["Condition State"]
            </button>
            <button type="button" class="btn btn-success" @onclick="@Cancel">
                @L["Cancel"]
            </button>
            <button type="button" class="btn btn-success" @onclick="@DeepLearning">
                @L["Deep Learning"]
            </button>
            <button type="button" class="btn btn-success" @onclick="@FiniteElements">
                @L["Finite Elements"]
            </button>
        </div>

    </div>



}




