@implements IDisposable
@using AliantWebS.Models
@using AliantWebS.Data
@using System.Text.Json
@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject AppData appData;
@inject IStringLocalizer<Languages> L
@inject IJSRuntime js

@if (EditContext == null)
{
    <p><em>@L["Loading"]... !</em></p>
}
else
{
    @if (ButtonText != "Create")
    {
        <Div Style="display: flex">
            <h2>@Title</h2>
            <div style="margin-left: auto; ">
                <Blazorise.Button Clicked="@OnStructuresButtonClicked" Color="Blazorise.Color.Primary">Edit Site Structures</Blazorise.Button>
            </div>
        </Div>
    }
    <hr />

    <EditForm EditContext="@EditContext" id="SiteFormId" OnValidSubmit="@OnValidSubmit">
        <DataAnnotationsValidator />
        <Blazorise.Row>
            <Column ColumnSize="ColumnSize.Is6">
                <div class="form-group">
                    <label>@L["Site Name"] :</label>
                    <div>
                        <InputText @bind-Value="@Site.Name" @oninput='(() =>areachanged("Name"))' />
                        <ValidationMessage For="@(() => Site.Name)" />
                    </div>
                </div>
                <div class="form-group">
                    <label>@L["Short Description"] :</label>
                    <div>
                        <textarea style="height:150px" @bind="@Site.ShortDescription" @oninput='(() =>areachanged("ShortDescription"))' class="form-control"></textarea>
                        <ValidationMessage For="@(() => Site.ShortDescription)" />
                    </div>
                </div>

            </Column>
            <Column ColumnSize="ColumnSize.Is6">
                <div class="form-group">
                    <label>@L["Address"] :</label>
                    <div>
                        <textarea @bind="@Site.Address" @oninput='(() =>areachanged("Address"))' class="form-control"></textarea>
                        <ValidationMessage For="@(() => Site.ShortDescription)" />
                    </div>
                </div>
                <div class="form-group">
                    <div class="input-group">
                        <div class="flex-item">
                            <label>Latitude</label>
                            <InputNumber TValue="double" @bind-Value="@Site.Geolocation.Coordinate.X" class="form-control"></InputNumber>
                            @* <ValidationMessage For="@(() => Structure.Geolocation)" /> *@
                        </div>
                        <div class="flex-item">
                            <label>Longitude</label>
                            <InputNumber @bind-Value="@Site.Geolocation.Coordinate.Y" class="form-control"></InputNumber>
                            @* <ValidationMessage For="@(() => Structure.Geolocation)" /> *@
                        </div>
                        <div class="flex-item button-container">
                            <Blazorise.Button Clicked="@OnLongLatButtonClicked" Color="Blazorise.Color.Primary">
                                <i class="fas fa-map-marker-alt"></i> <!-- Replace with your actual icon class -->
                            </Blazorise.Button>
                        </div>
                    </div>
                </div>


            </Column>
        </Blazorise.Row>
        <Blazorise.Row>
            <Column ColumnSize="ColumnSize.Is6">

                <AliantWebS.Pages.SharedComponents.MapComponent Coordinates="coordinates" ValueChanged=@OnMapClicked Scale="13"></AliantWebS.Pages.SharedComponents.MapComponent>
        
@*                <MapView Longitude="@Site.Geolocation.Coordinate.Y" Latitude="@Site.Geolocation.Coordinate.X" Zoom="1" Style="height: 400px; width: 100%;">


       <WebMap>
                        <PortalItem Id="e691172598f04ea8881cd2a4adaa45ba" />
       </WebMap>
             
       <ScaleBarWidget Position="OverlayPosition.BottomLeft" />
       <LocateWidget UseHeadingEnabled="false" Scale="1500" Position="OverlayPosition.TopLeft" />
                    <SearchWidget Position="OverlayPosition.TopRight" />
                    <BasemapToggleWidget NextBasemapName="arcgis-imagery" Position="OverlayPosition.BottomRight" />
                    <BasemapGalleryWidget ContainerId="gallery-box" />
                    <ScaleBarWidget Position="OverlayPosition.BottomLeft" />
               <LegendWidget Position="OverlayPosition.TopRight" />
                    <HomeWidget Position="OverlayPosition.TopLeft" />
                     <CompassWidget Position="OverlayPosition.TopLeft" />
                </MapView>*@

            </Column>
            <Column ColumnSize="ColumnSize.Is6">
                <br />
                <MediaComponent selectedObject="Site"></MediaComponent>

            </Column>
        </Blazorise.Row>
        <br />
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <button type="button" class="btn btn-success" @onclick="@Cancel">
                        Cancel
                    </button>
                </div>
            </div>
        </div>

    </EditForm>
}


@code {

    [Parameter] public string ButtonText { get; set; } = "Save";

    [Parameter]
    public EditContext EditContext { get; set; }

    [Parameter] public string Title { get; set; }


    [Parameter] public EventCallback OnValidSubmit { get; set; }

    [Parameter] public Site Site { get; set; }


    private DotNetObjectReference<SiteFormComponent>? objRef;

    public List<(string id, string Type, string Name, double X, double Y, double C)?> coordinates;
    List<Structure> structureList;

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        await base.SetParametersAsync(parameters);
        if (EditContext == null)
        {
            navigationManager.NavigateTo("Sites");
            return;
        }

        EditContext.OnFieldChanged -= FieldChanged;
        EditContext.OnFieldChanged += FieldChanged;
        if (Site.Geolocation == null)
        {
            Site.Geolocation = NetTopologySuite.Geometries.Geometry.DefaultFactory.CreatePoint(new NetTopologySuite.Geometries.Coordinate(0,0));
            Site.Geolocation.SRID = 4326;
        }
    }

    protected override async Task OnInitializedAsync()
    {

        appData.ButtonText = ButtonText;

        appData.FormId = "SiteFormId";
        appData.DisplaySubmitButton = true;
        objRef = DotNetObjectReference.Create(this);
        structureList = await entitiesService.GetFilteredEntitiesAsync<Structure>(x => x.SiteId == Site.SiteId);

        coordinates = new List<(string id, string Type, string Name, double X, double Y, double C)?>()
        {
            ((Site.SiteId.ToString(),"Site", Site.Name, Site.Geolocation.Coordinate.X, Site.Geolocation.Coordinate.Y, 100))
        };
        coordinates.AddRange(structureList.Select(a => a.Geolocation != null ? (a.StructureId.ToString(), "Structure", a.Name, a.Geolocation.Coordinate.X, a.Geolocation.Coordinate.Y, 100) : ((string, string, string, double, double, double)?)null).ToList());

    }


    private async Task OnLongLatButtonClicked()
    {
        var result = await js.InvokeAsync<JsonElement>("getCoords");

        List<double> l = result.Deserialize<List<double>>();

        Site.Geolocation.Coordinate.X = l[1];
        Site.Geolocation.Coordinate.Y = l[0];
        appData.SaveChanges = true;   
        coordinates = new List<(string id, string Type, string Name, double X, double Y, double C)?>()
        {
            ((Site.SiteId.ToString(), "Site", Site.Name, Site.Geolocation.Coordinate.X, Site.Geolocation.Coordinate.Y, 100))
        };
    }


    public void OnMapClicked((double x, double y) coor)
    {
        Site.Geolocation.Coordinate.X = coor.x;
        Site.Geolocation.Coordinate.Y = coor.y;
        appData.SaveChanges = true;
        this.StateHasChanged();
    }

    private void areachanged(string s)
    {
        EditContext.NotifyFieldChanged(EditContext.Field(s));
    }

    private void FieldChanged(object sender, FieldChangedEventArgs arg)
    {
        appData.SaveChanges = true;
    }


    void OnStructuresButtonClicked()
    {
        navigationManager.NavigateTo("Structures/" + Site.SiteId);
    }

    void Cancel()
    {
        navigationManager.NavigateTo("Sites");
    }




    void IDisposable.Dispose()
    {
        // Unsubscribe from the event when our component is disposed
        if (EditContext != null)
        {
            EditContext.OnFieldChanged -= FieldChanged;
        }

    }


}
