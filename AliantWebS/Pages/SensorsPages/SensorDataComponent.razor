                var rrr = Structural.SP.FFT2(ttt.ToArray());
                ar.SetColumn(i + 1, rrr.Select(x => Convert.ChangeType(x.Magnitude, typeof(object))).Cast<object>().ToArray());

                //  data.Add(sc);

            }
            index++;
        }



        List<string[]> headers = glo.Item2;

        if (v.Count > 0)
        {
