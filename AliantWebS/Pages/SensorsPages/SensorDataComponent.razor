        }

        if (vv.Count > 0)
        {
            PlotData(vv, elementsNames, headers, data1);

        }
    }

    void PlotData(List<object[,]> v, List<string> names, List<string[]> headers, IList<ITrace> data)
    {
        data.Clear();

        int index = 0;
        foreach (var ar in v)
        {
            for (int i = 0; i < (ar.Columns() - 1); i++)
            {
                Scatter sc = new Scatter();
                sc.Name = names[index] + "Channel " + headers[index][i + 1];
                sc.XCalendar = Plotly.Blazor.Traces.ScatterLib.XCalendarEnum.Gregorian;

                sc.Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines | Plotly.Blazor.Traces.ScatterLib.ModeFlag.Markers;
                sc.X = (ar.GetColumn(0)).ToList();
                sc.Y = (ar.GetColumn(i + 1)).ToList();

                data.Add(sc);

            }
            index++;
        }


    }

