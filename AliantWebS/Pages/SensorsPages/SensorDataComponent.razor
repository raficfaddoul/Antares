    private (List<object[,]>, List<string[]>) ReadFromCSV(List<string> filesPaths, List<int> channelNums, char SplitChar)
    {
        List<object[,]> aa = new List<object[,]>();
        List<string[]> headers = new List<string[]>();

        int ind = 0;
        foreach (string filePath in filesPaths)
        {

            object[,] a = new object[0, channelNums[ind] + 1];
            var reader = new StreamReader(File.OpenRead(filePath));

            string line = string.Empty;


            int index = 0;
            line = reader.ReadLine();
            line = reader.ReadLine();
            headers.Add(line.Split(SplitChar));

            while (!reader.EndOfStream)
            {
                line = reader.ReadLine();
                var values = line.Split(SplitChar);
                object[] d = new object[channelNums[ind] + 1];
                try
                {
                    d[0] = (values[0]);
                    for (int i = 0; i < channelNums[ind]; i++)
                    {

                        d[i + 1] = (values[i + 1]);

                    }
                    a = a.InsertRow(d);
                    index++;

                }
                catch (Exception ex)
                {
                    throw new Exception();
                }


            }
            ind++;
            aa.Add(a);
        }

        return (aa, headers);
    }

