@page "/TableaudeBord"
@using AliantWebS.IndicatorCalculator
@using AliantWebS.Models
@using AliantWebS.Data
@inject IJSRuntime JS
@inject IStringLocalizer<Languages> L
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject AppData appData
@inject EntitiesService entitiesService
@inject NavigationManager NavigationManager
@layout TrafficLayout

<div class="dashboard-container">
    <div class="dashboard-header">
        <h3 class="dashboard-subtitle">
            Indicateurs de santé structurelle
            @if (appData.Structure != null)
            {
                <span class="structure-name">(@appData.Structure.Name)</span>
            }
        </h3>
        <div class="header-controls">
            <div class="indicators-count-control">
                <label class="count-label">Nombre d'indicateurs:</label>
                <RadzenNumeric @bind-Value="@numberOfIndicators" 
                              TValue="int" 
                              Min="1" 
                              Max="@maxNumberOfIndicators" 
                              Step="1"
                              Change="@OnNumberOfIndicatorsChanged"
                              Style="width: 80px;" />
            </div>
            <button class="configure-button" @onclick="NavigateToConfiguration">
                ⚙️ Configurer
            </button>
        </div>
    </div>
    
    <div class="dashboard-content">
        <!-- Indicateurs en haut avec défilement horizontal et flèches fixes -->
        <div class="indicators-section-wrapper">
            <div class="indicators-scroll-container">
                <!-- Flèche gauche fixe -->
                @if (numberOfIndicators > 4)
                {
                    <button class="scroll-btn-fixed scroll-left" @onclick="ScrollLeft" title="Faire défiler vers la gauche">
                        ◀
                    </button>
                }
                
                <div class="indicators-section @(numberOfIndicators > 4 ? "scrollable" : "")">
                    @for (int i = 0; i < numberOfIndicators; i++)
                    {
                        var index = i;
                        var dashboardIndicator = index < dashboardIndicators.Count ? dashboardIndicators[index] : null;
                        
                        <div class="indicator-group">
                            <div class="gauge-container">
                                <canvas id="@($"gauge{index + 1}")" 
                                        class="gauge-canvas @(selectedIndicatorIndex == index ? "selected" : "")" 
                                        width="140" 
                                        height="70"
                                        @onclick="() => SelectIndicator(index)"
                                        tabindex="0"></canvas>
                                <button class="change-indicator-btn" 
                                        @onclick="() => ShowIndicatorSelector(index)"
                                        title="Changer l'indicateur">
                                    ⚙️
                                </button>
                                <div class="indicator-label">
                                    @if (dashboardIndicator?.CustomIndicator != null)
                                    {
                                        @($"{dashboardIndicator.CustomIndicator.Name} ({dashboardIndicator.CurrentValue:F1})")
                                    }
                                    else
                                    {
                                        @($"Slot {index + 1} (Non configuré)")
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                
                <!-- Flèche droite fixe -->
                @if (numberOfIndicators > 4)
                {
                    <button class="scroll-btn-fixed scroll-right" @onclick="ScrollRight" title="Faire défiler vers la droite">
                        ▶
                    </button>
                }
            </div>
            
            <!-- Information de défilement en bas -->
            @if (numberOfIndicators > 4)
            {
                <div class="scroll-info-bottom">
                    @(numberOfIndicators) indicateurs
                </div>
            }
        </div>
        
        <!-- Debug info (peut être supprimé plus tard) -->
        @if (showDebugInfo)
        {
            <div class="debug-info">
                <strong>Debug Info:</strong><br/>
                Selected Indicator: @selectedIndicatorIndex<br/>
                Available Indicators: @availableIndicators.Count<br/>
                Dashboard Indicators: @string.Join(", ", dashboardIndicators.Select((ind, i) => $"Slot {i + 1}: {(ind?.CustomIndicator?.Name ?? "Empty")}"))<br/>
                Gauges Updated: @gaugesUpdated<br/>
                Chart Component Key: @currentChartKey
            </div>
        }
        
        <!-- Section graphique principal avec IndicesInTimeComponent -->
        <div class="main-chart-section">
            <div class="chart-header">@GetSelectedIndicatorTitle()</div>
            <div class="chart-content">
                @if (selectedIndicatorIndex < dashboardIndicators.Count && dashboardIndicators[selectedIndicatorIndex]?.CustomIndicator != null)
                {
                    <AliantWebS.Pages.MonitoringPages.IndicesInTimeComponent @key="@currentChartKey"
                                    GraphId="@($"dashboardChart{selectedIndicatorIndex}")" 
                                    Headers="@chartHeaders" 
                                    Indices="@GetSelectedIndicatorData()" />
                }
                else
                {
                    <div class="no-chart-data">
                        <p>Aucun indicateur configuré pour ce slot</p>
                        <p class="no-chart-subtitle">Cliquez sur ⚙️ pour sélectionner un indicateur</p>
                    </div>
                }
            </div>
            <div class="chart-description">
                @GetSelectedIndicatorDescription()
            </div>
        </div>
        
        <!-- Section inférieure -->
        <div class="bottom-section">
            <!-- État du système avec pourcentages sur la même ligne -->
            <div class="system-status">
                <div class="status-title">Disponibilité système (7j)</div>
                <div class="status-items-container">
                    <div class="status-item">
                        <div class="status-indicator"></div>
                        <span class="status-label">Global</span>
                        <span class="status-value">100 %</span>
                    </div>
                    <div class="status-item">
                        <div class="status-indicator"></div>
                        <span class="status-label">Pesage</span>
                        <span class="status-value">100 %</span>
                    </div>
                    <div class="status-item">
                        <div class="status-indicator"></div>
                        <span class="status-label">Mesure</span>
                        <span class="status-value">100%</span>
                    </div>
                </div>
            </div>
            
            <!-- Bouton export SANS les boutons debug/refresh -->
            <div class="export-section">
                <button class="export-button" @onclick="ExportData" title="Exporter les données">
                    📊
                </button>
                <span class="export-label">Export</span>
            </div>
        </div>
    </div>
</div>

<!-- Modal de sélection d'indicateur -->
@if (showIndicatorSelector)
{
    <div class="selector-modal" @onclick="CloseIndicatorSelector">
        <div class="selector-content" @onclick:stopPropagation="true">
            <div class="selector-header">
                🔧 Sélectionner un Indicateur pour le Slot @(currentSlotBeingConfigured + 1)
            </div>
            
            @if (!availableIndicators.Any())
            {
                <div class="no-indicators-message">
                    <p><strong>Aucun indicateur disponible</strong></p>
                    <p>Créez d'abord des indicateurs dans la page Configuration des Indicateurs.</p>
                    <RadzenButton Text="Aller à la Configuration" 
                                 ButtonStyle="ButtonStyle.Primary" 
                                 Click="@NavigateToConfiguration" />
                </div>
            }
            else
            {
                @foreach (var indicator in availableIndicators)
                {
                    <div class="indicator-option @(selectedIndicatorForSlot?.Id == indicator.Id ? "selected" : "")"
                         @onclick="() => SelectIndicatorForSlot(indicator)">
                        <div class="indicator-option-name">
                            @indicator.Name
                            <span class="storage-badge @(indicator.StorageMode == "database" ? "database" : "local")">
                                @(indicator.StorageMode == "database" ? "DB" : "LOCAL")
                            </span>
                        </div>
                        <div class="indicator-option-description">@indicator.Description</div>
                        <div class="indicator-option-details">
                            Type: @indicator.Type • Seuil: @indicator.AlertThreshold @indicator.Unit • @indicator.Criteria.Count critère(s)
                        </div>
                    </div>
                }
                
                <!-- Option pour vider le slot -->
                <div class="indicator-option @(selectedIndicatorForSlot == null ? "selected" : "")"
                     @onclick="() => SelectIndicatorForSlot(null)">
                    <div class="indicator-option-name">❌ Vider ce slot</div>
                    <div class="indicator-option-description">Supprimer l'indicateur de ce slot du tableau de bord</div>
                </div>
            }
            
            <div class="selector-buttons">
                <RadzenButton Text="Annuler" 
                             ButtonStyle="ButtonStyle.Secondary" 
                             Click="@CloseIndicatorSelector" />
                <RadzenButton Text="Confirmer" 
                             ButtonStyle="ButtonStyle.Primary" 
                             Click="@ConfirmIndicatorSelection" 
                             Disabled="@(selectedIndicatorForSlot == null && (currentSlotBeingConfigured >= dashboardIndicators.Count || dashboardIndicators[currentSlotBeingConfigured]?.CustomIndicator == null))" />
            </div>
        </div>
    </div>
}

@code {
    private int maxNumberOfIndicators = 15;

    private int selectedIndicatorIndex = 0;
    private bool showDebugInfo = false;
    private bool gaugesUpdated = false;
    private string currentChartKey = "chart0";

    // Configuration du tableau de bord
    private List<CustomIndicator> availableIndicators = new();
    private List<DashboardIndicator?> dashboardIndicators = new();
    private int numberOfIndicators = 3;
    private const string DASHBOARD_CONFIG_KEY = "dashboardConfiguration";
    private const string INDICATORS_STORAGE_KEY = "customIndicators";
    private const string INDICATORS_COUNT_KEY = "dashboardIndicatorsCount";

    // Sélecteur d'indicateur
    private bool showIndicatorSelector = false;
    private int currentSlotBeingConfigured = 0;
    private CustomIndicator? selectedIndicatorForSlot = null;

    // Données pour les graphiques temporels
    private List<string> chartHeaders = new List<string> { "Date", "Valeur" };

    // Calculator instance
    private IndicatorCalculator calculator;

    protected override async Task OnInitializedAsync()
    {
        calculator = new IndicatorCalculator(entitiesService);
        
        await LoadNumberOfIndicators();
        await LoadAvailableIndicators();
        await LoadDashboardConfiguration();
        await GenerateIndicatorData();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Attendre plus longtemps pour s'assurer que tout est chargé
            await Task.Delay(500);
            await UpdateGauges();
            
            // Essayer plusieurs fois si ça ne marche pas
            for (int i = 0; i < 3; i++)
            {
                await Task.Delay(1000);
                await UpdateGauges();
            }
        }
    }
    
    private async Task LoadNumberOfIndicators()
    {
        try
        {
            var storedCount = await localStorage.GetItemAsync<int?>(INDICATORS_COUNT_KEY);
            if (storedCount.HasValue && storedCount.Value >= 1 && storedCount.Value <= maxNumberOfIndicators)
            {
                numberOfIndicators = storedCount.Value;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading indicators count: {ex.Message}");
        }
    }
    
    private async Task LoadAvailableIndicators()
    {
        try
        {
            // Load from both database and local storage
            var databaseIndicators = await LoadIndicatorsFromDatabase();
            var localStorageIndicators = await LoadIndicatorsFromLocalStorage();
            
            availableIndicators.Clear();
            availableIndicators.AddRange(databaseIndicators);
            availableIndicators.AddRange(localStorageIndicators);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading available indicators: {ex.Message}");
        }
    }
    
    private async Task<List<CustomIndicator>> LoadIndicatorsFromDatabase()
    {
        // TODO: Implement database loading logic
        await Task.Delay(10);
        return new List<CustomIndicator>();
    }
    
    private async Task<List<CustomIndicator>> LoadIndicatorsFromLocalStorage()
    {
        try
        {
            var indicators = await localStorage.GetItemAsync<List<CustomIndicator>>(INDICATORS_STORAGE_KEY) ?? new List<CustomIndicator>();
            indicators.ForEach(i => i.StorageMode = "localStorage");
            return indicators;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading from local storage: {ex.Message}");
            return new List<CustomIndicator>();
        }
    }
    
    private async Task OnNumberOfIndicatorsChanged()
    {
        try
        {
            // Sauvegarder le nouveau nombre
            await localStorage.SetItemAsync(INDICATORS_COUNT_KEY, numberOfIndicators);
            
            // Redimensionner la liste des indicateurs
            ResizeDashboardIndicators();
            
            // Ajuster l'index sélectionné si nécessaire
            if (selectedIndicatorIndex >= numberOfIndicators)
            {
                selectedIndicatorIndex = numberOfIndicators - 1;
            }
            
            // Regénérer les données et mettre à jour les jauges
            await GenerateIndicatorData();
            await Task.Delay(100);
            await UpdateGauges();
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error changing number of indicators: {ex.Message}");
        }
    }
    
    private void ResizeDashboardIndicators()
    {
        var currentIndicators = dashboardIndicators.ToList();
        
        // Redimensionner la liste
        dashboardIndicators.Clear();
        for (int i = 0; i < numberOfIndicators; i++)
        {
            if (i < currentIndicators.Count)
            {
                dashboardIndicators.Add(currentIndicators[i]);
            }
            else
            {
                dashboardIndicators.Add(null);
            }
        }
    }
    
    private async Task LoadDashboardConfiguration()
    {
        try
        {
            var config = await localStorage.GetItemAsync<DashboardConfiguration>(DASHBOARD_CONFIG_KEY);
            if (config != null)
            {
                // S'assurer que la liste est de la bonne taille
                ResizeDashboardIndicators();
                
                for (int i = 0; i < Math.Min(numberOfIndicators, config.IndicatorIds.Length); i++)
                {
                    if (config.IndicatorIds[i] != Guid.Empty)
                    {
                        var indicator = availableIndicators.FirstOrDefault(ind => ind.Id == config.IndicatorIds[i]);
                        if (indicator != null)
                        {
                            dashboardIndicators[i] = new DashboardIndicator
                            {
                                CustomIndicator = indicator,
                                CurrentValue = 0,
                                TimeSeriesData = new List<Dictionary<object, double>>()
                            };
                        }
                    }
                }
            }
            else
            {
                // Initialiser avec la bonne taille
                ResizeDashboardIndicators();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard configuration: {ex.Message}");
            ResizeDashboardIndicators();
        }
    }
    
    private async Task SaveDashboardConfiguration()
    {
        try
        {
            var config = new DashboardConfiguration
            {
                IndicatorIds = dashboardIndicators.Select(di => di?.CustomIndicator?.Id ?? Guid.Empty).ToArray(),
                LastModified = DateTime.Now
            };
            
            await localStorage.SetItemAsync(DASHBOARD_CONFIG_KEY, config);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving dashboard configuration: {ex.Message}");
        }
    }
    
    private async Task GenerateIndicatorData()
    {
        for (int i = 0; i < numberOfIndicators; i++)
        {
            if (i < dashboardIndicators.Count && dashboardIndicators[i] != null)
            {
                await GenerateDataForIndicator(i);
            }
        }
    }
    
    private async Task GenerateDataForIndicator(int index)
    {
        if (index >= dashboardIndicators.Count || dashboardIndicators[index] == null) return;
        
        var indicator = dashboardIndicators[index];
        if (indicator?.CustomIndicator == null) return;
        
        try 
        {
            // Si on a une structure sélectionnée, calculer les vraies valeurs
            if (appData.Structure != null)
            {
                var previewResult = await calculator.CalculateIndicatorAsync(indicator.CustomIndicator, appData.Structure);
                indicator.CurrentValue = previewResult.Value;
                
                // Générer des données temporelles basées sur la valeur calculée
                var random = new Random(indicator.CustomIndicator.Id.GetHashCode());
                var startDate = DateTime.Now.AddDays(-30);
                
                indicator.TimeSeriesData = new List<Dictionary<object, double>>();
                indicator.TimeSeriesData.Add(new Dictionary<object, double>());
                
                double baseValue = previewResult.Value;
                
                for (int i = 0; i < 30; i++) 
                {
                    var date = startDate.AddDays(i);
                    var variation = (random.NextDouble() - 0.5) * (baseValue * 0.2); // Variation de ±20% de la valeur de base
                    var value = Math.Max(0, baseValue + variation);
                    
                    indicator.TimeSeriesData[0][date] = Math.Round(value, 2);
                }
            }
            else
            {
                // Simuler des données si aucune structure n'est sélectionnée
                var random = new Random(indicator.CustomIndicator.Id.GetHashCode());
                var startDate = DateTime.Now.AddDays(-30);
                
                indicator.TimeSeriesData = new List<Dictionary<object, double>>();
                indicator.TimeSeriesData.Add(new Dictionary<object, double>());
                
                double baseValue = random.NextDouble() * 10; // Valeur de base entre 0 et 10
                
                for (int i = 0; i < 30; i++) 
                {
                    var date = startDate.AddDays(i);
                    var variation = (random.NextDouble() - 0.5) * 2; // Variation de -1 à +1
                    var value = Math.Max(0, baseValue + variation);
                    
                    indicator.TimeSeriesData[0][date] = Math.Round(value, 2);
                }
                
                // Définir la valeur actuelle comme la dernière valeur
                indicator.CurrentValue = indicator.TimeSeriesData[0].Values.LastOrDefault();
            }
        } 
        catch (Exception ex) 
        {
            Console.WriteLine($"Error generating data for indicator {index}: {ex.Message}");
            // En cas d'erreur, utiliser une valeur par défaut
            indicator.CurrentValue = 0;
        }
    }
    
    private async Task SelectIndicator(int indicatorIndex)
    {
        selectedIndicatorIndex = indicatorIndex;
        currentChartKey = $"chart{indicatorIndex}_{DateTime.Now.Ticks}";
        StateHasChanged();
        
        await Task.Delay(100);
        await UpdateGauges();
    }
    
    private void ShowIndicatorSelector(int slotIndex)
    {
        currentSlotBeingConfigured = slotIndex;
        if (slotIndex < dashboardIndicators.Count)
        {
            selectedIndicatorForSlot = dashboardIndicators[slotIndex]?.CustomIndicator;
        }
        else
        {
            selectedIndicatorForSlot = null;
        }
        showIndicatorSelector = true;
        StateHasChanged();
    }
    
    private void CloseIndicatorSelector()
    {
        showIndicatorSelector = false;
        selectedIndicatorForSlot = null;
        StateHasChanged();
    }
    
    private void SelectIndicatorForSlot(CustomIndicator? indicator)
    {
        selectedIndicatorForSlot = indicator;
        StateHasChanged();
    }
    
    private async Task ConfirmIndicatorSelection()
    {
        // Ensure the list is large enough
        while (dashboardIndicators.Count <= currentSlotBeingConfigured)
        {
            dashboardIndicators.Add(null);
        }
        
        dashboardIndicators[currentSlotBeingConfigured] = selectedIndicatorForSlot != null
            ? new DashboardIndicator
            {
                CustomIndicator = selectedIndicatorForSlot,
                CurrentValue = 0,
                TimeSeriesData = new List<Dictionary<object, double>>()
            }
            : null;
        
        if (dashboardIndicators[currentSlotBeingConfigured] != null)
        {
            await GenerateDataForIndicator(currentSlotBeingConfigured);
        }
        
        await SaveDashboardConfiguration();
        CloseIndicatorSelector();
        
        // Mettre à jour les jauges
        await UpdateGauges();
        StateHasChanged();
    }
    
    private string GetSelectedIndicatorTitle()
    {
        if (selectedIndicatorIndex < dashboardIndicators.Count)
        {
            var indicator = dashboardIndicators[selectedIndicatorIndex];
            return indicator?.CustomIndicator?.Name ?? $"Slot {selectedIndicatorIndex + 1} - Non configuré";
        }
        return $"Slot {selectedIndicatorIndex + 1} - Non configuré";
    }
    
    private string GetSelectedIndicatorDescription()
    {
        if (selectedIndicatorIndex < dashboardIndicators.Count)
        {
            var indicator = dashboardIndicators[selectedIndicatorIndex];
            if (indicator?.CustomIndicator == null)
            {
                return "Aucun indicateur configuré pour ce slot. Cliquez sur ⚙️ pour en sélectionner un.";
            }
            
            var threshold = indicator.CustomIndicator.AlertThreshold?.ToString("F1") ?? "Non défini";
            return $"{indicator.CustomIndicator.Description} • Seuil d'alerte: {threshold} {indicator.CustomIndicator.Unit}";
        }
        return "Aucun indicateur configuré pour ce slot. Cliquez sur ⚙️ pour en sélectionner un.";
    }
    
    private List<Dictionary<object, double>> GetSelectedIndicatorData()
    {
        if (selectedIndicatorIndex < dashboardIndicators.Count)
        {
            var indicator = dashboardIndicators[selectedIndicatorIndex];
            return indicator?.TimeSeriesData ?? new List<Dictionary<object, double>>();
        }
        return new List<Dictionary<object, double>>();
    }
    
    private async Task UpdateGauges()
    {
        try
        {
            // Render each gauge individually with its own maximum value and alert threshold
            for (int i = 0; i < numberOfIndicators; i++)
            {
                DashboardIndicator? dashboardIndicator = null;
                if (i < dashboardIndicators.Count)
                {
                    dashboardIndicator = dashboardIndicators[i];
                }
                
                var value = dashboardIndicator?.CurrentValue ?? 0;
                var maxValue = dashboardIndicator?.CustomIndicator?.MaxValue ?? 10.0;
                var alertThreshold = dashboardIndicator?.CustomIndicator?.AlertThreshold;
                
                var canvasId = $"gauge{i + 1}";
                
                Console.WriteLine($"Updating gauge {canvasId} with value: {value}, max: {maxValue}, threshold: {alertThreshold}");
                
                await JS.InvokeVoidAsync("renderSingleGauge", canvasId, value, maxValue, alertThreshold);
            }
            
            gaugesUpdated = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la mise à jour des jauges: {ex.Message}");
        }
    }
    
    private async Task ScrollLeft()
    {
        await JS.InvokeVoidAsync("scrollIndicators", "left");
    }
    
    private async Task ScrollRight()
    {
        await JS.InvokeVoidAsync("scrollIndicators", "right");
    }
    
    private async Task RefreshGauges()
    {
        await UpdateGauges();
    }
    
    private void ToggleDebugInfo()
    {
        showDebugInfo = !showDebugInfo;
        StateHasChanged();
    }
    
    private async Task ExportData()
    {
        try
        {
            await Task.Delay(500);
            Console.WriteLine("Export des données en cours...");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de l'export: {ex.Message}");
        }
    }
    
    private void NavigateToConfiguration()
    {
        NavigationManager.NavigateTo("/ConfigurationIndicateurs");
    }

    // Classes de support
    public class DashboardIndicator
    {
        public CustomIndicator CustomIndicator { get; set; } = null!;
        public double CurrentValue { get; set; }
        public List<Dictionary<object, double>> TimeSeriesData { get; set; } = new();
    }
    
    public class DashboardConfiguration
    {
        public Guid[] IndicatorIds { get; set; } = Array.Empty<Guid>();
        public DateTime LastModified { get; set; }
    }
}
