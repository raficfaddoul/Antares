@using System.Collections.Generic
@using AliantWebS.Models
@inject IStringLocalizer<Languages> L

<style>
    .vitesse-container {
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 400px;
    }
    
    .chart-section {
        border: 2px solid #ddd;
        border-radius: 8px;
        padding: 30px;
        background-color: white;
        max-width: 600px;
        width: 100%;
    }
    
    .chart-header {
        text-align: center;
        font-weight: bold;
        font-size: 1.3em;
        margin-bottom: 30px;
        padding: 8px;
        color: #333;
    }
    
    .chart-container {
        height: 500px;
        width: 100%;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .chart-title {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        background-color: white;
        border: 1px solid #ccc;
        padding: 8px 16px;
        border-radius: 4px;
        font-weight: bold;
        font-size: 1em;
        font-style: italic;
        color: #555;
    }
    
    .loading-message {
        text-align: center;
        padding: 50px;
        color: #666;
    }
</style>

<div class="vitesse-container">
    @if (shouldRenderCharts)
    {
        <div class="chart-section">
            <div class="chart-header">États de trafic</div>
            <div class="chart-container">
                @if (etatsTrafficData?.Any() == true)
                {
                    <div style="width: 450px; height: 450px; position: relative;">
                        <RadzenChart>
                            <RadzenPieSeries Data="@etatsTrafficData" 
                                             CategoryProperty="Etat" 
                                             ValueProperty="Percentage"
                                             Title=""
                                             Fills="@GetTrafficStateColors()" />
                            <RadzenLegend Position="LegendPosition.Right" />
                        </RadzenChart>
                        <div class="chart-title">États de trafic sur un capteur unique</div>
                    </div>
                }
                else
                {
                    <div class="loading-message">
                        Aucune donnée disponible pour cette période
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="loading-message">
            <p>Chargement en cours...</p>
        </div>
    }
</div>

@code {
    public class EtatTrafficData
    {
        public string Etat { get; set; }
        public double Percentage { get; set; }
        public string Color { get; set; }
    }

    private List<EtatTrafficData> etatsTrafficData = new();
    private bool shouldRenderCharts = false;
    private bool isInitialized = false;
    private bool hasDataLoaded = false;

    // Variables pour détecter les changements de paramètres
    private DateTime lastStartDate = default(DateTime);
    private DateTime lastEndDate = default(DateTime);
    private int lastCategoriesHash = 0;

    // États de trafic avec leurs couleurs spécifiques
    private readonly List<(string Label, string Color)> TrafficStates = new()
    {
        ("Trafic fluide", "#4CAF50"),      // Vert
        ("Trafic chargé", "#8BC34A"),      // Vert clair
        ("Trafic à capacité", "#FFC107"),  // Jaune
        ("Ralentissements", "#FF9800"),    // Orange
        ("Congestion", "#F44336")          // Rouge
    };

    // Paramètres reçus du parent
    [Parameter] public DateTime StartDate { get; set; }
    [Parameter] public DateTime EndDate { get; set; }
    [Parameter] public List<VehicleCategory> VehicleCategories { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnDataLoaded { get; set; }

    protected override async Task OnInitializedAsync()
    {
        isInitialized = true;
        await Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Calculer le hash des catégories sélectionnées pour détecter les changements
        var currentCategoriesHash = VehicleCategories?.Where(c => c.IsSelected).Select(c => c.PropertyName).GetHashCode() ?? 0;
        
        // Vérifier si les paramètres ont vraiment changé
        bool parametersChanged = lastStartDate != StartDate || 
                                lastEndDate != EndDate || 
                                lastCategoriesHash != currentCategoriesHash;

        // Charger les données seulement si les paramètres sont valides ET ont changé
        if (isInitialized && 
            parametersChanged &&
            StartDate != default(DateTime) && 
            EndDate != default(DateTime) && 
            StartDate <= EndDate)
        {
            // Mettre à jour les dernières valeurs
            lastStartDate = StartDate;
            lastEndDate = EndDate;
            lastCategoriesHash = currentCategoriesHash;
            
            await LoadDataSafely();
        }
    }

    private async Task LoadDataSafely()
    {
        shouldRenderCharts = false;
        hasDataLoaded = false;
        StateHasChanged();

        try
        {
            await Task.Delay(50);
            
            GenerateVitesseData();
            
            shouldRenderCharts = true;
            hasDataLoaded = true;
            
            // Notifier le parent UNE SEULE FOIS que le chargement est terminé
            if (OnDataLoaded.HasDelegate && !hasDataLoaded)
            {
                await OnDataLoaded.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des données de vitesse: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void GenerateVitesseData()
    {
        try
        {
            etatsTrafficData.Clear();

            // Générer des données d'états de trafic basées sur la période sélectionnée
            var random = new Random(DateTime.Now.Millisecond + (int)(StartDate - DateTime.MinValue).TotalDays);
            
            // Définir des distributions réalistes pour les états de trafic
            var distributions = new Dictionary<string, (int min, int max)>
            {
                { "Trafic fluide", (35, 55) },      // 35-55%
                { "Trafic chargé", (20, 35) },      // 20-35%
                { "Trafic à capacité", (8, 18) },   // 8-18%
                { "Ralentissements", (5, 15) },     // 5-15%
                { "Congestion", (2, 12) }           // 2-12%
            };

            var totalValue = 0;
            var tempData = new List<(string state, int value, string color)>();

            // Générer des valeurs pour chaque état
            foreach (var state in TrafficStates)
            {
                if (distributions.TryGetValue(state.Label, out var range))
                {
                    var value = random.Next(range.min, range.max + 1);
                    totalValue += value;
                    tempData.Add((state.Label, value, state.Color));
                }
            }

            // Calculer les pourcentages
            foreach (var (state, value, color) in tempData)
            {
                var percentage = Math.Round((double)value / totalValue * 100, 1);
                
                etatsTrafficData.Add(new EtatTrafficData
                {
                    Etat = state,
                    Percentage = percentage,
                    Color = color
                });
            }

            // Normaliser pour s'assurer que le total fait 100%
            NormalizePercentages();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la génération des données de vitesse: {ex.Message}");
        }
    }

    private void NormalizePercentages()
    {
        if (!etatsTrafficData.Any()) return;

        var totalPercentage = etatsTrafficData.Sum(d => d.Percentage);
        if (totalPercentage > 0)
        {
            foreach (var item in etatsTrafficData)
            {
                item.Percentage = Math.Round(item.Percentage / totalPercentage * 100, 1);
            }
        }
    }

    private string[] GetTrafficStateColors()
    {
        return etatsTrafficData.Select(d => d.Color).ToArray();
    }
}