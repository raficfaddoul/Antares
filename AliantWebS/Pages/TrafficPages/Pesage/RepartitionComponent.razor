@using System.Collections.Generic
@using AliantWebS.Models
@inject IStringLocalizer<Languages> L

<style>
    .repartition-container {
        padding: 0;
    }
    
    .charts-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }
    
    .chart-section {
        border: 2px solid #ddd;
        border-radius: 8px;
        padding: 15px;
        background-color: white;
    }
    
    .chart-header {
        text-align: center;
        font-weight: bold;
        font-size: 1.2em;
        margin-bottom: 15px;
        padding: 8px;
        background-color: #f5f5f5;
        border: 1px solid #ccc;
        border-radius: 4px;
    }
    
    .chart-container {
        height: 400px;
        width: 100%;
        position: relative;
    }
    
    .chart-title {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        background-color: white;
        border: 1px solid #ccc;
        padding: 8px 16px;
        border-radius: 4px;
        font-weight: bold;
        font-size: 0.9em;
    }
    
    .total-section {
        border: 2px solid #ddd;
        border-radius: 8px;
        padding: 15px;
        background-color: white;
        margin-top: 20px;
    }
    
    .total-chart-container {
        height: 450px;
        width: 100%;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .legend-section {
        margin-top: 10px;
        padding: 10px;
        background-color: #f8f9fa;
        border-radius: 4px;
    }
    
    .legend-item {
        display: inline-flex;
        align-items: center;
        margin: 4px 8px;
        font-size: 0.85em;
    }
    
    .legend-color {
        width: 12px;
        height: 12px;
        border-radius: 2px;
        margin-right: 6px;
    }
</style>

<div class="repartition-container">
    @if (shouldRenderCharts && VehicleCategories?.Any() == true)
    {
        <!-- Graphiques Sens 1 et Sens 2 côte à côte -->
        <div class="charts-grid">
            <!-- Sens 1 -->
            <div class="chart-section">
                <div class="chart-header">Sens 1</div>
                <div class="chart-container">
                    @if (repartitionSens1?.Any() == true)
                    {
                        <RadzenChart>
                            <RadzenPieSeries Data="@repartitionSens1" 
                                             CategoryProperty="Category" 
                                             ValueProperty="Percentage"
                                             Title=""
                                             Fills="@GetSelectedColors()" />
                            <RadzenLegend Position="LegendPosition.Right" />
                        </RadzenChart>
                        <div class="chart-title">% de répartition type de véhicule</div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 50px; color: #666;">
                            Aucune donnée disponible
                        </div>
                    }
                </div>
            </div>

            <!-- Sens 2 -->
            <div class="chart-section">
                <div class="chart-header">Sens 2</div>
                <div class="chart-container">
                    @if (repartitionSens2?.Any() == true)
                    {
                        <RadzenChart>
                            <RadzenPieSeries Data="@repartitionSens2" 
                                             CategoryProperty="Category" 
                                             ValueProperty="Percentage"
                                             Title=""
                                             Fills="@GetSelectedColors()" />
                            <RadzenLegend Position="LegendPosition.Right" />
                        </RadzenChart>
                        <div class="chart-title">% de répartition type de véhicule</div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 50px; color: #666;">
                            Aucune donnée disponible
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Graphique Total centré -->
        <div class="total-section">
            <div class="chart-header">Total</div>
            <div class="total-chart-container">
                @if (repartitionTotal?.Any() == true)
                {
                    <div style="width: 500px; height: 400px; position: relative;">
                        <RadzenChart>
                            <RadzenPieSeries Data="@repartitionTotal" 
                                             CategoryProperty="Category" 
                                             ValueProperty="Percentage"
                                             Title=""
                                             Fills="@GetSelectedColors()" />
                            <RadzenLegend Position="LegendPosition.Right" />
                        </RadzenChart>
                        <div class="chart-title">% de répartition type de véhicule</div>
                    </div>
                }
                else
                {
                    <div style="text-align: center; padding: 50px; color: #666;">
                        Aucune donnée disponible
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div style="text-align: center; padding: 50px; color: #666;">
            <p>Chargement en cours...</p>
        </div>
    }
</div>

@code {
    public class RepartitionData
    {
        public string Category { get; set; }
        public double Percentage { get; set; }
        public string Color { get; set; }
    }

    private List<RepartitionData> repartitionSens1 = new();
    private List<RepartitionData> repartitionSens2 = new();
    private List<RepartitionData> repartitionTotal = new();

    private bool shouldRenderCharts = false;
    private bool isInitialized = false;
    private bool hasDataLoaded = false;

    // Variables pour détecter les changements de paramètres
    private DateTime lastStartDate = default(DateTime);
    private DateTime lastEndDate = default(DateTime);
    private int lastCategoriesHash = 0;

    // Paramètres reçus du parent
    [Parameter] public DateTime StartDate { get; set; }
    [Parameter] public DateTime EndDate { get; set; }
    [Parameter] public List<VehicleCategory> VehicleCategories { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnDataLoaded { get; set; }

    protected override async Task OnInitializedAsync()
    {
        isInitialized = true;
        await Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Calculer le hash des catégories sélectionnées pour détecter les changements
        var currentCategoriesHash = VehicleCategories?.Where(c => c.IsSelected).Select(c => c.PropertyName).GetHashCode() ?? 0;
        
        // Vérifier si les paramètres ont vraiment changé
        bool parametersChanged = lastStartDate != StartDate || 
                                lastEndDate != EndDate || 
                                lastCategoriesHash != currentCategoriesHash;

        // Charger les données seulement si les paramètres sont valides ET ont changé
        if (isInitialized && 
            parametersChanged &&
            VehicleCategories?.Any() == true && 
            StartDate != default(DateTime) && 
            EndDate != default(DateTime) && 
            StartDate <= EndDate)
        {
            // Mettre à jour les dernières valeurs
            lastStartDate = StartDate;
            lastEndDate = EndDate;
            lastCategoriesHash = currentCategoriesHash;
            
            await LoadDataSafely();
        }
    }

    private async Task LoadDataSafely()
    {
        shouldRenderCharts = false;
        hasDataLoaded = false;
        StateHasChanged();

        try
        {
            await Task.Delay(50);
            
            GenerateRepartitionData();
            
            shouldRenderCharts = true;
            hasDataLoaded = true;
            
            // Notifier le parent UNE SEULE FOIS que le chargement est terminé
            if (OnDataLoaded.HasDelegate && !hasDataLoaded)
            {
                await OnDataLoaded.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des données de répartition: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void GenerateRepartitionData()
    {
        try
        {
            var selectedCategories = VehicleCategories.Where(c => c.IsSelected).ToList();
            if (!selectedCategories.Any()) return;

            repartitionSens1.Clear();
            repartitionSens2.Clear();
            repartitionTotal.Clear();

            var random = new Random(DateTime.Now.Millisecond + (int)(StartDate - DateTime.MinValue).TotalDays);

            // Générer des données de répartition pour Sens 1
            var totalSens1 = selectedCategories.Sum(c => random.Next(50, 200));
            foreach (var category in selectedCategories)
            {
                var value = random.Next(50, 200);
                var percentage = Math.Round((double)value / totalSens1 * 100, 1);
                
                repartitionSens1.Add(new RepartitionData
                {
                    Category = category.Label,
                    Percentage = percentage,
                    Color = category.Color
                });
            }

            // Générer des données de répartition pour Sens 2
            var totalSens2 = selectedCategories.Sum(c => random.Next(40, 180));
            foreach (var category in selectedCategories)
            {
                var value = random.Next(40, 180);
                var percentage = Math.Round((double)value / totalSens2 * 100, 1);
                
                repartitionSens2.Add(new RepartitionData
                {
                    Category = category.Label,
                    Percentage = percentage,
                    Color = category.Color
                });
            }

            // Calculer le total (moyenne des deux sens)
            foreach (var category in selectedCategories)
            {
                var sens1Data = repartitionSens1.FirstOrDefault(r => r.Category == category.Label);
                var sens2Data = repartitionSens2.FirstOrDefault(r => r.Category == category.Label);
                
                if (sens1Data != null && sens2Data != null)
                {
                    var averagePercentage = Math.Round((sens1Data.Percentage + sens2Data.Percentage) / 2, 1);
                    
                    repartitionTotal.Add(new RepartitionData
                    {
                        Category = category.Label,
                        Percentage = averagePercentage,
                        Color = category.Color
                    });
                }
            }

            // Normaliser les pourcentages pour qu'ils totalisent 100%
            NormalizePercentages(repartitionSens1);
            NormalizePercentages(repartitionSens2);
            NormalizePercentages(repartitionTotal);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la génération des données de répartition: {ex.Message}");
        }
    }

    private void NormalizePercentages(List<RepartitionData> data)
    {
        if (!data.Any()) return;

        var totalPercentage = data.Sum(d => d.Percentage);
        if (totalPercentage > 0)
        {
            foreach (var item in data)
            {
                item.Percentage = Math.Round(item.Percentage / totalPercentage * 100, 1);
            }
        }
    }

    private string[] GetSelectedColors()
    {
        return VehicleCategories
            .Where(c => c.IsSelected)
            .Select(c => c.Color)
            .ToArray();
    }
}