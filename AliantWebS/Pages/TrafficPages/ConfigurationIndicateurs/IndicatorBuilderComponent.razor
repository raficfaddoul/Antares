    private void AddCriteria()
    {
        if (CanAddCriteria())
        {
            var criteria = new IndicatorCriteria
            {
                Id = Guid.NewGuid(),
                Name = GenerateCriteriaName(),
                Description = GenerateCriteriaDescription(),
                DataSource = selectedDataSource,
                CalculationMethod = selectedCalculationMethod,
                Weight = currentCriteriaWeight,
                InspectionResultTypeId = selectedDataSource switch
                {
                    "structure_inspections" => selectedInspectionResultType,
                    "element_inspections" => selectedElementInspectionResultType,
                    _ => null
                },
                ElementTypeId = selectedElementType,
                DefectTypeId = selectedDefectType,
                AttributeTypeId = selectedDataSource switch
                {
                    "structure_attributes" => selectedStructureAttributeType,
                    "element_attributes" => selectedElementAttributeType,
                    "defect_attributes" => selectedDefectAttributeType,
                    _ => null
                }
            };
            
            newIndicator.Criteria.Add(criteria);
            
            // Mettre à jour la formule personnalisée si en mode avancé
            if (isCustomFormula)
            {
                newIndicator.CustomFormula = IndicatorCalculator.GetDefaultCustomFormula(newIndicator.Criteria);
            }
            
            ResetCriteriaForm();
        }
    }
    
    private bool CanAddCriteria()
    {
        return selectedDataSource switch
        {
            "structure_attributes" => selectedStructureAttributeType.HasValue,
            "structure_inspections" => selectedInspectionResultType.HasValue,
            "element_attributes" => selectedElementType.HasValue && selectedElementAttributeType.HasValue,
            "element_inspections" => selectedElementType.HasValue && selectedElementInspectionResultType.HasValue,
            "defect_attributes" => selectedElementType.HasValue && selectedDefectAttributeType.HasValue,
            _ => false
        };
    }
    
    private string GenerateCriteriaName()
    {
        return selectedDataSource switch
        {
            "structure_attributes" => $"Structure - Attribut: {GetAttributeTypeName(selectedStructureAttributeType)}",
            "structure_inspections" => $"Structure - Inspection: {GetInspectionResultTypeName(selectedInspectionResultType)}",
            "element_attributes" => $"{GetElementTypeName(selectedElementType)} - Attribut: {GetAttributeTypeName(selectedElementAttributeType)}",
            "element_inspections" => $"{GetElementTypeName(selectedElementType)} - Inspection: {GetInspectionResultTypeName(selectedElementInspectionResultType)}",
            "defect_attributes" => $"{GetElementTypeName(selectedElementType)} - Défaut: {GetAttributeTypeName(selectedDefectAttributeType)}",
            _ => "Critère personnalisé"
        };
    }
    
    private string GenerateCriteriaDescription()
    {
        var method = GetCalculationMethodName(selectedCalculationMethod);
        return selectedDataSource switch
        {
            "structure_attributes" => $"{method} des valeurs d'attribut '{GetAttributeTypeName(selectedStructureAttributeType)}' au niveau structure",
            "structure_inspections" => $"{method} des résultats d'inspection '{GetInspectionResultTypeName(selectedInspectionResultType)}' au niveau structure",
            "element_attributes" => $"{method} des valeurs d'attribut '{GetAttributeTypeName(selectedElementAttributeType)}' pour les éléments de type '{GetElementTypeName(selectedElementType)}'",
            "element_inspections" => $"{method} des résultats d'inspection '{GetInspectionResultTypeName(selectedElementInspectionResultType)}' pour les éléments de type '{GetElementTypeName(selectedElementType)}'",
            "defect_attributes" => $"{method} des valeurs d'attribut '{GetAttributeTypeName(selectedDefectAttributeType)}' pour les défauts des éléments de type '{GetElementTypeName(selectedElementType)}'",
            _ => "Calcul personnalisé"
        };
    }
    
    private void RemoveCriteria(IndicatorCriteria criteria)
    {
        newIndicator.Criteria.Remove(criteria);
        
        // Mettre à jour la formule personnalisée si en mode avancé
        if (isCustomFormula)
        {
            newIndicator.CustomFormula = IndicatorCalculator.GetDefaultCustomFormula(newIndicator.Criteria);
        }
    }
    
    private void ResetCriteriaForm()
    {
        selectedInspectionResultType = null;
        selectedElementType = null;
        selectedElementInspectionResultType = null;
        selectedDefectType = null;
        selectedStructureAttributeType = null;
        selectedElementAttributeType = null;
        selectedDefectAttributeType = null;
        currentCriteriaWeight = 1.0;
    }
    
    private bool CanSaveIndicator()
    {
        var basicValidation = !string.IsNullOrWhiteSpace(newIndicator.Name) && 
                         newIndicator.Criteria.Any() && 
                         newIndicator.AlertThreshold.HasValue;
        
        if (!basicValidation) return false;
        
        // Vérifier si un indicateur avec le même nom existe déjà
        var nameExists = savedIndicators.Any(indicator => 
            string.Equals(indicator.Name.Trim(), newIndicator.Name.Trim(), StringComparison.OrdinalIgnoreCase));
        
        if (nameExists) return false;
        
        // Si en mode formule personnalisée, vérifier qu'elle est valide
        if (isCustomFormula)
        {
            var validationResult = IndicatorCalculator.ValidateFormula(newIndicator.CustomFormula, newIndicator.Criteria);
            return !string.IsNullOrWhiteSpace(newIndicator.CustomFormula) && 
                   string.IsNullOrEmpty(validationResult);
        }
        
        return true;
    }
    
    private string GetSaveButtonText()
    {
        return selectedStorageMode == "database" 
            ? "Sauvegarder en Base" 
            : "Sauvegarder Localement";
    }
    
    private async Task SaveIndicator()
    {
        if (!CanSaveIndicator())
        {
            // Vérifier spécifiquement si le problème est le nom en double
            var nameExists = savedIndicators.Any(indicator => 
                string.Equals(indicator.Name.Trim(), newIndicator.Name.Trim(), StringComparison.OrdinalIgnoreCase));
            
            if (nameExists)
            {
                await jsRuntime.InvokeVoidAsync("alert", 
                    $"⚠️ Un indicateur avec le nom '{newIndicator.Name}' existe déjà. " +
                    "Veuillez choisir un nom différent.");
                return;
            }
            
            // Autres validations
            if (string.IsNullOrWhiteSpace(newIndicator.Name))
            {
                await jsRuntime.InvokeVoidAsync("alert", "⚠️ Le nom de l'indicateur est requis.");
                return;
            }
            
            if (!newIndicator.Criteria.Any())
            {
                await jsRuntime.InvokeVoidAsync("alert", "⚠️ Au moins un critère est requis.");
                return;
            }
            
            if (!newIndicator.AlertThreshold.HasValue)
            {
                await jsRuntime.InvokeVoidAsync("alert", "⚠️ Le seuil d'alerte est requis.");
                return;
            }
            
            if (isCustomFormula)
            {
                var validationResult = IndicatorCalculator.ValidateFormula(newIndicator.CustomFormula, newIndicator.Criteria);
                if (!string.IsNullOrEmpty(validationResult))
                {
                    await jsRuntime.InvokeVoidAsync("alert", $"⚠️ Erreur dans la formule: {validationResult}");
                    return;
                }
            }
            
            return;
        }

        try
        {
            newIndicator.Id = Guid.NewGuid();
            newIndicator.CreatedDate = DateTime.Now;
            newIndicator.UseCustomFormula = isCustomFormula;
            newIndicator.StorageMode = selectedStorageMode;
            
            if (selectedStorageMode == "database")
            {
                await SaveIndicatorToDatabase();
            }
            else
            {
                await SaveIndicatorToLocalStorage();
            }
            
            savedIndicators.Add(newIndicator);
            await OnIndicatorsChanged.InvokeAsync(savedIndicators);
            
            await jsRuntime.InvokeVoidAsync("alert", $"✅ Indicateur '{newIndicator.Name}' sauvegardé avec succès en {(selectedStorageMode == "database" ? "base de données" : "stockage local")}!");
            
            // Clear the original indicator being edited since we saved successfully
            originalIndicatorBeingEdited = null;
            
            ResetForm();
        }
        catch (Exception ex)
        {
            await jsRuntime.InvokeVoidAsync("alert", $"❌ Erreur lors de la sauvegarde: {ex.Message}");
        }
    }
    
    private async Task SaveIndicatorToLocalStorage()
    {
        try
        {
            var existingIndicators = await localStorage.GetItemAsync<List<CustomIndicator>>(LOCAL_STORAGE_KEY) ?? new List<CustomIndicator>();
            
            // Double vérification pour éviter les doublons dans le stockage local
            var nameExists = existingIndicators.Any(indicator => 
                string.Equals(indicator.Name.Trim(), newIndicator.Name.Trim(), StringComparison.OrdinalIgnoreCase));
            
            if (nameExists)
            {
                throw new Exception($"Un indicateur avec le nom '{newIndicator.Name}' existe déjà dans le stockage local.");
            }
            
            existingIndicators.Add(newIndicator);
            await localStorage.SetItemAsync(LOCAL_STORAGE_KEY, existingIndicators);
        }
        catch (Exception ex)
        {
            throw new Exception($"Erreur lors de la sauvegarde en stockage local: {ex.Message}");
        }
    }
    
