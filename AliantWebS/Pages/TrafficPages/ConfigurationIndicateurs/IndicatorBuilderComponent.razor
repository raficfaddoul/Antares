    private void OnFormulaModeToggled(bool isCustomMode)
    {
        this.isCustomFormula = isCustomMode;
        newIndicator.UseCustomFormula = isCustomMode;
        
        if (!isCustomMode)
        {
            newIndicator.CustomFormula = "";
        }
        else if (string.IsNullOrEmpty(newIndicator.CustomFormula))
