    private void ResetForm()
    {
        // If we were editing an indicator, restore it to the list
        if (originalIndicatorBeingEdited != null)
        {
            savedIndicators.Add(originalIndicatorBeingEdited);
            originalIndicatorBeingEdited = null;
        }
        
        // Clear the preview result
        previewResult = null;
        
        // Reset the form to a new indicator
        newIndicator = new CustomIndicator();
        isCustomFormula = false;
        ResetCriteriaForm();
        
        StateHasChanged();
    }
    
    private async Task CalculatePreview()
    {
        try
        {
            if (appData.Structure == null)
            {
                previewResult = new PreviewResult
                {
                    Value = 0,
                    ErrorMessage = "Aucune structure sélectionnée."
                };
                StateHasChanged();
                return;
            }
            
            previewResult = await calculator.CalculateIndicatorAsync(newIndicator, appData.Structure);
        }
        catch (Exception ex)
        {
            previewResult = new PreviewResult
            {
                Value = 0,
                ErrorMessage = $"Erreur lors du calcul de l'aperçu: {ex.Message}",
                CalculatedAt = DateTime.Now
            };
        }
        
        StateHasChanged();
    }

    private string GetPreviewValueColor()
    {
        if (previewResult == null) return "#333";

        if (!string.IsNullOrEmpty(previewResult.ErrorMessage)) return "#f44336";

        if (newIndicator.AlertThreshold.HasValue && previewResult.Value > newIndicator.AlertThreshold.Value)
            return "#f44336";

        if (newIndicator.AlertThreshold.HasValue && previewResult.Value > newIndicator.AlertThreshold.Value * 0.8)
            return "#ff9800";

        return "#4caf50";
    }
    
    private void ToggleIndicatorSelection(Guid indicatorId)
    {
        if (selectedIndicators.Contains(indicatorId))
        {
            selectedIndicators.Remove(indicatorId);
        }
        else
        {
            selectedIndicators.Add(indicatorId);
        }
    }
    
    private void EditIndicator(CustomIndicator indicator)
    {
        // Store the original indicator before editing
        originalIndicatorBeingEdited = indicator.Clone();
        
        newIndicator = indicator.Clone();
        isCustomFormula = indicator.UseCustomFormula;
        selectedStorageMode = indicator.StorageMode ?? "database";
        savedIndicators.Remove(indicator);
    }
    
    private async Task DeleteIndicator(Guid indicatorId)
    {
        var indicator = savedIndicators.FirstOrDefault(x => x.Id == indicatorId);
        if (indicator != null)
        {
            try
            {
                if (indicator.StorageMode == "database")
                {
                    await DeleteIndicatorFromDatabase(indicatorId);
                }
                else
                {
                    await DeleteIndicatorFromLocalStorage(indicatorId);
                }
                
                savedIndicators.RemoveAll(x => x.Id == indicatorId);
                selectedIndicators.Remove(indicatorId);
                
                await jsRuntime.InvokeVoidAsync("alert", "Indicateur supprimé avec succès!");
            }
            catch (Exception ex)
            {
                await jsRuntime.InvokeVoidAsync("alert", $"Erreur lors de la suppression: {ex.Message}");
            }
        }
    }
    
