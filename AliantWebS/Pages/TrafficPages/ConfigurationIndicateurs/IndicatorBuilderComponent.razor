    private async Task DeleteIndicatorFromLocalStorage(Guid indicatorId)
    {
        try
        {
            var existingIndicators = await localStorage.GetItemAsync<List<CustomIndicator>>(LOCAL_STORAGE_KEY) ?? new List<CustomIndicator>();
            existingIndicators.RemoveAll(x => x.Id == indicatorId);
            await localStorage.SetItemAsync(LOCAL_STORAGE_KEY, existingIndicators);
        }
        catch (Exception ex)
        {
            throw new Exception($"Failed to delete from local storage: {ex.Message}");
        }
    }
    
    private async Task LoadSavedIndicators()
    {
        try
        {
            // Load from both sources
            var databaseIndicators = await LoadIndicatorsFromDatabase();
            var localStorageIndicators = await LoadIndicatorsFromLocalStorage();
            
            savedIndicators.Clear();
            savedIndicators.AddRange(databaseIndicators);
            savedIndicators.AddRange(localStorageIndicators);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading saved indicators: {ex.Message}");
        }
    }
    
