@using AliantWebS.Models
@using System.Text.Json
@using Helpers
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<Languages> L
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<style>
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .coupling-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        height: 100%;
        overflow: hidden;
    }

    .controls-section {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
        animation: fadeIn 0.5s ease-out;
        flex-shrink: 0;
    }

    .parameter-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .parameter-label {
        font-size: 0.9em;
        font-weight: 500;
        color: #495057;
    }

    .date-picker-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .date-picker-label {
        font-size: 0.9em;
        font-weight: 500;
        color: #495057;
    }

    .indicator-selection {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        flex-shrink: 0;
    }

    .indicator-selectors {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 15px;
    }

    .indicator-selector {
        background-color: white;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 15px;
    }

    .indicator-selector.indicator-x {
        border-left: 4px solid #007bff;
    }

    .indicator-selector.indicator-y {
        border-left: 4px solid #28a745;
    }

    .selector-title {
        font-weight: bold;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .axis-label {
        padding: 4px 8px;
        border-radius: 4px;
        color: white;
        font-size: 0.8em;
        font-weight: bold;
    }

    .axis-x {
        background-color: #007bff;
    }

    .axis-y {
        background-color: #28a745;
    }

    .chart-container {
        flex: 1;
        overflow: hidden;
        animation: fadeIn 0.8s ease-out;
        display: flex;
        gap: 15px;
        min-height: 400px; /* Added minimum height */
    }

    .coupling-chart {
        flex: 1;
        background-color: white;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        overflow: hidden;
        min-height: 400px; /* Added minimum height */
        position: relative; /* Added for proper positioning */
    }

    .analysis-panel {
        width: 300px;
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        flex-shrink: 0;
        overflow-y: auto;
    }

    .analysis-title {
        font-weight: bold;
        margin-bottom: 15px;
        text-align: center;
        color: #495057;
    }

    .analysis-section {
        background-color: white;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 12px;
        margin-bottom: 15px;
    }

    .analysis-section-title {
        font-weight: bold;
        color: #495057;
        margin-bottom: 8px;
        font-size: 0.9em;
    }

    .metric-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
        font-size: 0.85em;
    }

    .metric-label {
        color: #6c757d;
    }

    .metric-value {
        font-weight: bold;
        color: #333;
    }

    .correlation-indicator {
        text-align: center;
        padding: 10px;
        border-radius: 6px;
        margin: 10px 0;
        font-weight: bold;
    }

    .correlation-strong {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .correlation-moderate {
        background-color: #fff3cd;
        color: #856404;
        border: 1px solid #ffeaa7;
    }

    .correlation-weak {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .trend-line-info {
        background-color: #e3f2fd;
        border: 1px solid #bbdefb;
        border-radius: 4px;
        padding: 8px;
        margin: 8px 0;
        font-size: 0.8em;
    }

    .stats-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 10px;
        margin-top: 15px;
        flex-shrink: 0;
    }

    .stat-item {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 10px;
        text-align: center;
    }

    .stat-value {
        font-size: 1.1em;
        font-weight: bold;
        color: #007bff;
    }

    .stat-label {
        font-size: 0.75em;
        color: #6c757d;
        margin-top: 3px;
    }

    .no-indicators-message {
        text-align: center;
        color: #6c757d;
        padding: 40px;
        font-style: italic;
    }

    /* Fix for chart container sizing */
    #couplingChart {
        width: 100% !important;
        height: 100% !important;
        min-height: 350px;
    }
</style>

<div class="coupling-container">
    <!-- Section des contrôles -->
    <div class="controls-section">
        <div class="date-picker-group">
            <label class="date-picker-label">@L["Date début"]</label>
            <RadzenDatePicker @bind-Value="@startDate"
                              DateFormat="dd/MM/yyyy"
                              Style="width: 150px;"
                              Change="@OnDateChanged" />
        </div>

        <div class="date-picker-group">
            <label class="date-picker-label">@L["Date fin"]</label>
            <RadzenDatePicker @bind-Value="@endDate"
                              DateFormat="dd/MM/yyyy"
                              Style="width: 150px;"
                              Change="@OnDateChanged" />
        </div>

        <div class="parameter-group">
            <label class="parameter-label">@L["Méthode de couplage"]</label>
            <RadzenDropDown @bind-Value="@couplingMethod" 
                            Data="@couplingMethods" 
                            Style="width: 150px;" 
                            Change="@OnParameterChanged" />
        </div>

        <div class="parameter-group">
            <label class="parameter-label">@L["Nombre de points"]</label>
            <RadzenNumeric @bind-Value="@samplePoints" 
                           Min="50" 
                           Max="1000" 
                           Step="50" 
                           Style="width: 120px;"
                           Change="@((int value) => OnParameterChanged())" />
        </div>

        <RadzenButton Text="@L["Analyser le couplage"]" 
                      Icon="scatter_plot" 
                      ButtonStyle="ButtonStyle.Primary" 
                      Click="@AnalyzeCoupling" 
                      IsBusy="@IsLoading" 
                      Disabled="@(!CanAnalyze())"
                      Style="margin-left: auto;" />
    </div>

    <!-- Sélection des indicateurs -->
    <div class="indicator-selection">
        <h6 style="margin: 0 0 10px 0;">@L["Sélectionnez deux indicateurs pour l'analyse de couplage"]</h6>
        
        @if (!availableIndicators.Any())
        {
            <div class="no-indicators-message">
                <p>Aucun indicateur disponible.</p>
                <p>Veuillez d'abord créer des indicateurs dans la section "Configuration Indicateurs".</p>
            </div>
        }
        else
        {
            <div class="indicator-selectors">
                <div class="indicator-selector indicator-x">
                    <div class="selector-title">
                        <span class="axis-label axis-x">AXE X</span>
                        <span>Premier indicateur</span>
                    </div>
                    <RadzenDropDown @bind-Value="@selectedIndicatorX" 
                                    Data="@availableIndicators" 
                                    TextProperty="DisplayName"
                                    ValueProperty="Id"
                                    Placeholder="Sélectionner un indicateur..."
                                    AllowClear="true"
                                    Style="width: 100%;"
                                    Change="@OnIndicatorSelectionChanged" />
                    @if (selectedIndicatorX != null)
                    {
                        var indicator = availableIndicators.FirstOrDefault(i => i.Id == selectedIndicatorX);
                        if (indicator != null)
                        {
                            <div style="margin-top: 8px; font-size: 0.85em; color: #666;">
                                <div><strong>Type :</strong> @indicator.Type</div>
                                <div><strong>Unité :</strong> @indicator.Unit</div>
                                <div><strong>Description :</strong> @indicator.Description</div>
                            </div>
                        }
                    }
                </div>

                <div class="indicator-selector indicator-y">
                    <div class="selector-title">
                        <span class="axis-label axis-y">AXE Y</span>
                        <span>Deuxième indicateur</span>
                    </div>
                    <RadzenDropDown @bind-Value="@selectedIndicatorY" 
                                    Data="@availableIndicators" 
                                    TextProperty="DisplayName"
                                    ValueProperty="Id"
                                    Placeholder="Sélectionner un indicateur..."
                                    AllowClear="true"
                                    Style="width: 100%;"
                                    Change="@OnIndicatorSelectionChanged" />
                    @if (selectedIndicatorY != null)
                    {
                        var indicator = availableIndicators.FirstOrDefault(i => i.Id == selectedIndicatorY);
                        if (indicator != null)
                        {
                            <div style="margin-top: 8px; font-size: 0.85em; color: #666;">
                                <div><strong>Type :</strong> @indicator.Type</div>
                                <div><strong>Unité :</strong> @indicator.Unit</div>
                                <div><strong>Description :</strong> @indicator.Description</div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>

    <!-- Conteneur du graphique et de l'analyse -->
    <div class="chart-container">
        <div class="coupling-chart">
            <div id="couplingChart" style="height: 100%; width: 100%;"></div>
        </div>

        <div class="analysis-panel">
            <div class="analysis-title">Analyse du couplage</div>
            
            @if (analysisResult != null)
            {
                <div class="analysis-section">
                    <div class="analysis-section-title">📊 Corrélation</div>
                    <div class="metric-item">
                        <span class="metric-label">Coefficient :</span>
                        <span class="metric-value">@analysisResult.CorrelationCoefficient.ToString("F3")</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-label">R² :</span>
                        <span class="metric-value">@analysisResult.RSquared.ToString("F3")</span>
                    </div>
                    <div class="correlation-indicator @GetCorrelationClass()">
                        @GetCorrelationDescription()
                    </div>
                </div>

                <div class="analysis-section">
                    <div class="analysis-section-title">📈 Régression linéaire</div>
                    <div class="metric-item">
                        <span class="metric-label">Pente :</span>
                        <span class="metric-value">@analysisResult.Slope.ToString("F4")</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-label">Ordonnée :</span>
                        <span class="metric-value">@analysisResult.Intercept.ToString("F4")</span>
                    </div>
                    <div class="trend-line-info">
                        Y = @analysisResult.Slope.ToString("F4")X + @analysisResult.Intercept.ToString("F4")
                    </div>
                </div>

                <div class="analysis-section">
                    <div class="analysis-section-title">📋 Statistiques</div>
                    <div class="metric-item">
                        <span class="metric-label">Points analysés :</span>
                        <span class="metric-value">@analysisResult.DataPoints</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-label">Écart-type X :</span>
                        <span class="metric-value">@analysisResult.StdDevX.ToString("F3")</span>
                    </div>
                    <div class="metric-item">
                        <span class="metric-label">Écart-type Y :</span>
                        <span class="metric-value">@analysisResult.StdDevY.ToString("F3")</span>
                    </div>
                </div>

                <div class="analysis-section">
                    <div class="analysis-section-title">💡 Interprétation</div>
                    <div style="font-size: 0.85em; line-height: 1.4;">
                        @GetInterpretationText()
                    </div>
                </div>
            }
            else
            {
                <div class="analysis-section">
                    <div style="text-align: center; color: #6c757d; font-style: italic;">
                        Sélectionnez deux indicateurs et cliquez sur "Analyser le couplage" pour voir les résultats.
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Résumé des statistiques -->
    <div class="stats-summary">
        <div class="stat-item">
            <div class="stat-value">@(analysisResult?.DataPoints ?? 0)</div>
            <div class="stat-label">@L["Points de données"]</div>
        </div>
        <div class="stat-item">
            <div class="stat-value">@(analysisResult?.CorrelationCoefficient.ToString("F3") ?? "--")</div>
            <div class="stat-label">@L["Corrélation"]</div>
        </div>
        <div class="stat-item">
            <div class="stat-value">@(analysisResult?.RSquared.ToString("F3") ?? "--")</div>
            <div class="stat-label">@L["R-carré"]</div>
        </div>
        <div class="stat-item">
            <div class="stat-value">@GetTrendDescription()</div>
            <div class="stat-label">@L["Tendance"]</div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnDataLoaded { get; set; }
    [Parameter] public EventCallback<DateTime> OnStartDateChanged { get; set; }
    [Parameter] public EventCallback<DateTime> OnEndDateChanged { get; set; }

    private DateTime startDate = DateTime.Today.AddDays(-7);
    private DateTime endDate = DateTime.Today;
    private string couplingMethod = "Pearson";
    private List<string> couplingMethods = new List<string> { "Pearson", "Spearman", "Kendall" };
    private int samplePoints = 200;

    // Sélection des indicateurs
    private List<IndicatorDisplayInfo> availableIndicators = new();
    private Guid? selectedIndicatorX;
    private Guid? selectedIndicatorY;

    // Résultats d'analyse
    private CouplingAnalysisResult? analysisResult;
    private List<CouplingDataPoint> couplingData = new();

    private const string LOCAL_STORAGE_KEY = "customIndicators";

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableIndicators();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeChart();
        }
    }

    private async Task LoadAvailableIndicators()
    {
        try
        {
            // Load indicators from local storage (you can extend this to load from database too)
            var localStorageIndicators = await localStorage.GetItemAsync<List<CustomIndicator>>(LOCAL_STORAGE_KEY) ?? new List<CustomIndicator>();
            
            availableIndicators = localStorageIndicators.Select(indicator => new IndicatorDisplayInfo
            {
                Id = indicator.Id,
                Name = indicator.Name,
                Type = indicator.Type,
                Unit = indicator.Unit,
                Description = indicator.Description,
                DisplayName = $"{indicator.Name} ({indicator.Unit})"
            }).ToList();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des indicateurs : {ex.Message}");
        }
    }

    private async Task InitializeChart()
    {
        // Add a small delay to ensure DOM is ready
        await Task.Delay(100);
        await JSRuntime.InvokeVoidAsync("initializeCouplingChart", "couplingChart");
    }

    private async Task OnDateChanged(DateTime? newDate)
    {
        if (newDate.HasValue)
        {
            if (newDate == startDate)
                await OnStartDateChanged.InvokeAsync(startDate);
            else if (newDate == endDate)
                await OnEndDateChanged.InvokeAsync(endDate);

            if (CanAnalyze())
            {
                await AnalyzeCoupling();
            }
        }
    }

    private async Task OnParameterChanged()
    {
        if (CanAnalyze())
        {
            await AnalyzeCoupling();
        }
    }

    private async Task OnIndicatorSelectionChanged()
    {
        if (CanAnalyze())
        {
            await AnalyzeCoupling();
        }
    }

    private bool CanAnalyze()
    {
        return selectedIndicatorX.HasValue && 
               selectedIndicatorY.HasValue && 
               selectedIndicatorX != selectedIndicatorY;
    }

    private async Task AnalyzeCoupling()
    {
        if (!CanAnalyze()) return;

        try
        {
            IsLoading = true;
            StateHasChanged();

            await Task.Delay(500); // Simulate processing time

            // Generate coupling data and perform analysis
            GenerateCouplingData();
            PerformCouplingAnalysis();
            await UpdateChart();
            await OnDataLoaded.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur dans l'analyse de couplage : {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void GenerateCouplingData()
    {
        couplingData.Clear();
        Random rand = new Random();

        var indicatorX = availableIndicators.FirstOrDefault(i => i.Id == selectedIndicatorX);
        var indicatorY = availableIndicators.FirstOrDefault(i => i.Id == selectedIndicatorY);

        if (indicatorX == null || indicatorY == null) return;

        // Generate sample data points with some correlation
        double correlationStrength = 0.3 + rand.NextDouble() * 0.6; // 0.3 to 0.9
        bool positiveCorrelation = rand.NextDouble() > 0.3; // 70% chance of positive correlation

        for (int i = 0; i < samplePoints; i++)
        {
            // Generate base values
            double baseX = rand.NextDouble() * 10;
            double baseY = rand.NextDouble() * 10;

            // Apply correlation
            if (positiveCorrelation)
            {
                baseY = baseY * (1 - correlationStrength) + baseX * correlationStrength + rand.NextGaussian() * 0.5;
            }
            else
            {
                baseY = baseY * (1 - correlationStrength) + (10 - baseX) * correlationStrength + rand.NextGaussian() * 0.5;
            }

            // Ensure values are positive
            baseX = Math.Max(0.1, baseX);
            baseY = Math.Max(0.1, baseY);

            couplingData.Add(new CouplingDataPoint
            {
                XValue = baseX,
                YValue = baseY,
                Timestamp = startDate.AddDays(i * (endDate - startDate).TotalDays / samplePoints)
            });
        }
    }

    private void PerformCouplingAnalysis()
    {
        if (!couplingData.Any()) return;

        var xValues = couplingData.Select(d => d.XValue).ToArray();
        var yValues = couplingData.Select(d => d.YValue).ToArray();

        // Calculate correlation coefficient
        double correlation = CalculateCorrelation(xValues, yValues);

        // Calculate linear regression
        var (slope, intercept) = CalculateLinearRegression(xValues, yValues);

        // Calculate R-squared
        double rSquared = Math.Pow(correlation, 2);

        // Calculate standard deviations
        double stdDevX = CalculateStandardDeviation(xValues);
        double stdDevY = CalculateStandardDeviation(yValues);

        analysisResult = new CouplingAnalysisResult
        {
            CorrelationCoefficient = correlation,
            RSquared = rSquared,
            Slope = slope,
            Intercept = intercept,
            DataPoints = couplingData.Count,
            StdDevX = stdDevX,
            StdDevY = stdDevY
        };
    }

    private double CalculateCorrelation(double[] x, double[] y)
    {
        if (x.Length != y.Length || x.Length == 0) return 0;

        double meanX = x.Average();
        double meanY = y.Average();

        double numerator = x.Zip(y, (xi, yi) => (xi - meanX) * (yi - meanY)).Sum();
        double denominator = Math.Sqrt(x.Sum(xi => Math.Pow(xi - meanX, 2)) * y.Sum(yi => Math.Pow(yi - meanY, 2)));

        return denominator == 0 ? 0 : numerator / denominator;
    }

    private (double slope, double intercept) CalculateLinearRegression(double[] x, double[] y)
    {
        if (x.Length != y.Length || x.Length == 0) return (0, 0);

        double meanX = x.Average();
        double meanY = y.Average();

        double numerator = x.Zip(y, (xi, yi) => (xi - meanX) * (yi - meanY)).Sum();
        double denominator = x.Sum(xi => Math.Pow(xi - meanX, 2));

        double slope = denominator == 0 ? 0 : numerator / denominator;
        double intercept = meanY - slope * meanX;

        return (slope, intercept);
    }

    private double CalculateStandardDeviation(double[] values)
    {
        if (values.Length == 0) return 0;

        double mean = values.Average();
        double variance = values.Sum(v => Math.Pow(v - mean, 2)) / values.Length;
        return Math.Sqrt(variance);
    }

    private async Task UpdateChart()
    {
        var indicatorX = availableIndicators.FirstOrDefault(i => i.Id == selectedIndicatorX);
        var indicatorY = availableIndicators.FirstOrDefault(i => i.Id == selectedIndicatorY);

        if (indicatorX == null || indicatorY == null) return;

        var chartData = new
        {
            dataPoints = couplingData.Select(d => new { x = d.XValue, y = d.YValue }).ToArray(),
            trendLine = GenerateTrendLineData(),
            xAxisTitle = $"{indicatorX.Name} ({indicatorX.Unit})",
            yAxisTitle = $"{indicatorY.Name} ({indicatorY.Unit})",
            correlation = analysisResult?.CorrelationCoefficient ?? 0
        };

        await JSRuntime.InvokeVoidAsync("updateCouplingChart", "couplingChart", chartData);
    }

    private object[] GenerateTrendLineData()
    {
        if (analysisResult == null || !couplingData.Any()) return new object[0];

        var minX = couplingData.Min(d => d.XValue);
        var maxX = couplingData.Max(d => d.XValue);

        return new object[]
        {
            new { x = minX, y = analysisResult.Slope * minX + analysisResult.Intercept },
            new { x = maxX, y = analysisResult.Slope * maxX + analysisResult.Intercept }
        };
    }

    private string GetCorrelationClass()
    {
        if (analysisResult == null) return "correlation-weak";

        var absCorrelation = Math.Abs(analysisResult.CorrelationCoefficient);
        if (absCorrelation >= 0.7) return "correlation-strong";
        if (absCorrelation >= 0.4) return "correlation-moderate";
        return "correlation-weak";
    }

    private string GetCorrelationDescription()
    {
        if (analysisResult == null) return "Aucune donnée";

        var absCorrelation = Math.Abs(analysisResult.CorrelationCoefficient);
        var direction = analysisResult.CorrelationCoefficient >= 0 ? "positive" : "négative";

        if (absCorrelation >= 0.7)
            return $"Forte corrélation {direction}";
        else if (absCorrelation >= 0.4)
            return $"Corrélation {direction} modérée";
        else
            return $"Faible corrélation {direction}";
    }

    private string GetTrendDescription()
    {
        if (analysisResult == null) return "--";

        if (Math.Abs(analysisResult.Slope) < 0.1)
            return "Stable";
        else if (analysisResult.Slope > 0)
            return "Croissante";
        else
            return "Décroissante";
    }

    private string GetInterpretationText()
    {
        if (analysisResult == null) return "";

        var absCorrelation = Math.Abs(analysisResult.CorrelationCoefficient);
        var direction = analysisResult.CorrelationCoefficient >= 0 ? "positive" : "négative";

        string strength = absCorrelation >= 0.7 ? "forte" : 
                         absCorrelation >= 0.4 ? "modérée" : "faible";

        string text = $"Une corrélation {direction} {strength} a été détectée entre les deux indicateurs. ";

        if (absCorrelation >= 0.7)
        {
            text += "Cette relation forte suggère que les deux indicateurs évoluent de manière très liée.";
        }
        else if (absCorrelation >= 0.4)
        {
            text += "Cette relation modérée indique une certaine dépendance entre les indicateurs.";
        }
        else
        {
            text += "Cette relation faible suggère que les indicateurs évoluent de manière relativement indépendante.";
        }

        return text;
    }

    // Classes d'aide
    public class IndicatorDisplayInfo
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
    }

    public class CouplingDataPoint
    {
        public double XValue { get; set; }
        public double YValue { get; set; }
        public DateTime Timestamp { get; set; }
    }

    public class CouplingAnalysisResult
    {
        public double CorrelationCoefficient { get; set; }
        public double RSquared { get; set; }
        public double Slope { get; set; }
        public double Intercept { get; set; }
        public int DataPoints { get; set; }
        public double StdDevX { get; set; }
        public double StdDevY { get; set; }
    }
}

<script>
    window.initializeCouplingChart = function(elementId) {
        // Wait for the DOM element to be properly sized
        setTimeout(function() {
            var element = document.getElementById(elementId);
            if (!element) {
                console.error('Élément du graphique non trouvé :', elementId);
                return;
            }

            // Ensure the container has dimensions
            var container = element.parentElement;
            if (container.offsetWidth === 0 || container.offsetHeight === 0) {
                console.warn('Le conteneur du graphique n\'a pas de dimensions, nouvelle tentative...');
                // Retry after a short delay
                setTimeout(function() {
                    window.initializeCouplingChart(elementId);
                }, 250);
                return;
            }

            var layout = {
                title: 'Analyse de couplage entre indicateurs',
                xaxis: { 
                    title: 'Indicateur X',
                    gridcolor: '#e0e0e0'
                },
                yaxis: { 
                    title: 'Indicateur Y',
                    gridcolor: '#e0e0e0'
                },
                margin: { l: 60, r: 50, t: 50, b: 60 },
                paper_bgcolor: 'rgba(0,0,0,0)',
                plot_bgcolor: 'white',
                autosize: true,
                showlegend: true
            };
            
            var config = {
                responsive: true,
                displayModeBar: true
            };
            
            // Initialize with empty data but proper layout
            Plotly.newPlot(elementId, [], layout, config).then(function() {
                // Force a resize after initialization
                setTimeout(function() {
                    window.dispatchEvent(new Event('resize'));
                    Plotly.Plots.resize(elementId);
                }, 100);
            });
        }, 50);
    };

    window.updateCouplingChart = function(elementId, data) {
        var element = document.getElementById(elementId);
        if (!element) {
            console.error('Élément du graphique non trouvé pour la mise à jour :', elementId);
            return;
        }

        var traces = [];
        
        // Scatter plot of data points
        traces.push({
            x: data.dataPoints.map(d => d.x),
            y: data.dataPoints.map(d => d.y),
            mode: 'markers',
            type: 'scatter',
            marker: {
                color: 'rgba(54, 162, 235, 0.7)',
                size: 6
            },
            name: 'Points de données'
        });
        
        // Trend line
        if (data.trendLine && data.trendLine.length > 0) {
            traces.push({
                x: data.trendLine.map(d => d.x),
                y: data.trendLine.map(d => d.y),
                mode: 'lines',
                type: 'scatter',
                line: {
                    color: 'red',
                    width: 2
                },
                name: 'Ligne de tendance'
            });
        }
        
        var layout = {
            title: 'Couplage : ' + data.xAxisTitle + ' vs ' + data.yAxisTitle,
            xaxis: { 
                title: data.xAxisTitle,
                gridcolor: '#e0e0e0'
            },
            yaxis: { 
                title: data.yAxisTitle,
                gridcolor: '#e0e0e0'
            },
            margin: { l: 80, r: 50, t: 60, b: 80 },
            paper_bgcolor: 'rgba(0,0,0,0)',
            plot_bgcolor: 'white',
            autosize: true,
            showlegend: true,
            annotations: [
                {
                    x: 0.02,
                    y: 0.98,
                    xref: 'paper',
                    yref: 'paper',
                    text: 'R = ' + data.correlation.toFixed(3),
                    showarrow: false,
                    font: { size: 14, color: 'red' },
                    bgcolor: 'rgba(255,255,255,0.8)',
                    bordercolor: 'red',
                    borderwidth: 1
                }
            ]
        };
        
        var config = {
            responsive: true,
            displayModeBar: true
        };
        
        // Use Plotly.react for better performance and proper resizing
        Plotly.react(elementId, traces, layout, config).then(function() {
            // Force a resize after the chart is updated
            setTimeout(function() {
                Plotly.Plots.resize(elementId);
            }, 100);
        });
    };

    // Add window resize handler for proper chart resizing
    window.addEventListener('resize', function() {
        var chartElement = document.getElementById('couplingChart');
        if (chartElement && typeof Plotly !== 'undefined') {
            Plotly.Plots.resize('couplingChart');
        }
    });
</script>