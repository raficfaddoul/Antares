@using AliantWebS.Models
@using System.Text.Json
@using Helpers
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<Languages> L

<style>
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .correlation-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
        height: 100%;
        overflow: hidden;
    }

    .controls-section {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
        animation: fadeIn 0.5s ease-out;
        flex-shrink: 0;
    }

    .parameter-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .parameter-label {
        font-size: 0.9em;
        font-weight: 500;
        color: #495057;
    }

    .date-picker-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .date-picker-label {
        font-size: 0.9em;
        font-weight: 500;
        color: #495057;
    }

    .chart-container {
        flex: 1;
        overflow: hidden;
        animation: fadeIn 0.8s ease-out;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .correlation-heatmap {
        flex: 1;
        background-color: white;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        overflow: hidden;
    }

    .sensor-selection {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        max-height: 200px;
        overflow-y: auto;
        flex-shrink: 0;
    }

    .sensor-checkboxes {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 10px;
    }

    .sensor-checkbox-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px;
        background-color: white;
        border: 1px solid #e9ecef;
        border-radius: 4px;
        transition: background-color 0.2s;
    }

    .sensor-checkbox-item:hover {
        background-color: #f8f9fa;
    }

    .sensor-icon {
        width: 16px;
        height: 16px;
    }

    .stats-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 10px;
        margin-top: 10px;
    }

    .stat-item {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 10px;
        text-align: center;
    }

    .stat-value {
        font-size: 1.2em;
        font-weight: bold;
        color: #007bff;
    }

    .stat-label {
        font-size: 0.8em;
        color: #6c757d;
        margin-top: 3px;
    }
</style>

<div class="correlation-container">
    <!-- Section des contrôles -->
    <div class="controls-section">
        <div class="date-picker-group">
            <label class="date-picker-label">@L["Date début"]</label>
            <RadzenDatePicker @bind-Value="@startDate"
                              DateFormat="dd/MM/yyyy"
                              Style="width: 150px;"
                              Change="@OnDateChanged" />
        </div>

        <div class="date-picker-group">
            <label class="date-picker-label">@L["Date fin"]</label>
            <RadzenDatePicker @bind-Value="@endDate"
                              DateFormat="dd/MM/yyyy"
                              Style="width: 150px;"
                              Change="@OnDateChanged" />
        </div>

        <div class="parameter-group">
            <label class="parameter-label">@L["Méthode de corrélation"]</label>
            <RadzenDropDown @bind-Value="@correlationMethod" 
                            Data="@correlationMethods" 
                            Style="width: 150px;" 
                            Change="@OnParameterChanged" />
        </div>

        <div class="parameter-group">
            <label class="parameter-label">@L["Taille de l'échantillon"]</label>
            <RadzenNumeric @bind-Value="@sampleSize" 
                           Min="100" 
                           Max="10000" 
                           Step="100" 
                           Style="width: 120px;"
                           Change="@((int value) => OnParameterChanged())" />
        </div>

        <RadzenButton Text="@L["Calculer la corrélation"]" 
                      Icon="analytics" 
                      ButtonStyle="ButtonStyle.Primary" 
                      Click="@CalculateCorrelation" 
                      IsBusy="@IsLoading" 
                      Style="margin-left: auto;" />
    </div>

    <!-- Sélection des capteurs -->
    <div class="sensor-selection">
        <h6 style="margin: 0 0 10px 0;">@L["Sélectionnez les capteurs"] (@selectedSensors.Count @L["sélectionné(s)"])</h6>
        <div class="sensor-checkboxes">
            @foreach (var sensor in availableSensors)
            {
                <div class="sensor-checkbox-item">
                    <RadzenCheckBox @bind-Value="sensor.IsSelected" 
                                    Change="@((bool value) => OnSensorSelectionChanged(sensor, value))" />
                    <span class="sensor-icon">🔧</span>
                    <span>@sensor.Name (@sensor.Type)</span>
                </div>
            }
        </div>
    </div>

    <!-- Conteneur du graphique -->
    <div class="chart-container">
        <div class="correlation-heatmap">
            <div id="correlationHeatmap" style="height: 100%; width: 100%;"></div>
        </div>

        <!-- Résumé des statistiques -->
        <div class="stats-summary">
            <div class="stat-item">
                <div class="stat-value">@totalPairs</div>
                <div class="stat-label">@L["Paires totales"]</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">@maxCorrelation.ToString("F3")</div>
                <div class="stat-label">@L["Corrélation max"]</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">@minCorrelation.ToString("F3")</div>
                <div class="stat-label">@L["Corrélation min"]</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">@avgCorrelation.ToString("F3")</div>
                <div class="stat-label">@L["Corrélation moyenne"]</div>
            </div>
            <div class="stat-item">
                <div class="stat-value">@strongCorrelations</div>
                <div class="stat-label">@L["Corrélations fortes"] (&gt;0.7)</div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnDataLoaded { get; set; }
    [Parameter] public EventCallback<DateTime> OnStartDateChanged { get; set; }
    [Parameter] public EventCallback<DateTime> OnEndDateChanged { get; set; }

    private DateTime startDate = DateTime.Today.AddDays(-7);
    private DateTime endDate = DateTime.Today;
    private string correlationMethod = "Pearson";
    private List<string> correlationMethods = new List<string> { "Pearson", "Spearman", "Kendall" };
    private int sampleSize = 1000;

    // Capteurs
    private List<SensorInfo> availableSensors = new();
    private List<SensorInfo> selectedSensors = new();

    // Résultats de corrélation
    private double[,] correlationMatrix;
    private List<string> sensorLabels = new();
    
    // Statistiques
    private int totalPairs = 0;
    private double maxCorrelation = 0.0;
    private double minCorrelation = 0.0;
    private double avgCorrelation = 0.0;
    private int strongCorrelations = 0;

    protected override async Task OnInitializedAsync()
    {
        InitializeAvailableSensors();
        // Sélectionner par défaut les premiers capteurs
        for (int i = 0; i < Math.Min(4, availableSensors.Count); i++)
        {
            availableSensors[i].IsSelected = true;
            selectedSensors.Add(availableSensors[i]);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeChart();
            await CalculateCorrelation();
        }
    }

    private void InitializeAvailableSensors()
    {
        availableSensors = new List<SensorInfo>
        {
            new SensorInfo { Id = 1, Name = "Inclinomètre Nord", Type = "Inclinomètre", Unit = "°", IsSelected = false },
            new SensorInfo { Id = 2, Name = "Inclinomètre Sud", Type = "Inclinomètre", Unit = "°", IsSelected = false },
            new SensorInfo { Id = 3, Name = "Inclinomètre Est", Type = "Inclinomètre", Unit = "°", IsSelected = false },
            new SensorInfo { Id = 4, Name = "Inclinomètre Ouest", Type = "Inclinomètre", Unit = "°", IsSelected = false },
            new SensorInfo { Id = 5, Name = "Accéléromètre X", Type = "Accéléromètre", Unit = "m/s²", IsSelected = false },
            new SensorInfo { Id = 6, Name = "Accéléromètre Y", Type = "Accéléromètre", Unit = "m/s²", IsSelected = false },
            new SensorInfo { Id = 7, Name = "Accéléromètre Z", Type = "Accéléromètre", Unit = "m/s²", IsSelected = false },
            new SensorInfo { Id = 8, Name = "Température Ambiante", Type = "Température", Unit = "°C", IsSelected = false },
            new SensorInfo { Id = 9, Name = "Température Structure", Type = "Température", Unit = "°C", IsSelected = false },
            new SensorInfo { Id = 10, Name = "Extensomètre Câble 1", Type = "Extensomètre", Unit = "mm", IsSelected = false },
            new SensorInfo { Id = 11, Name = "Extensomètre Câble 2", Type = "Extensomètre", Unit = "mm", IsSelected = false },
            new SensorInfo { Id = 12, Name = "Extensomètre Tablier", Type = "Extensomètre", Unit = "mm", IsSelected = false },
            new SensorInfo { Id = 13, Name = "Jauge de Contrainte 1", Type = "Contrainte", Unit = "MPa", IsSelected = false },
            new SensorInfo { Id = 14, Name = "Jauge de Contrainte 2", Type = "Contrainte", Unit = "MPa", IsSelected = false }
        };
    }

    private async Task InitializeChart()
    {
        await JSRuntime.InvokeVoidAsync("initializeCorrelationHeatmap", "correlationHeatmap");
    }

    private async Task OnDateChanged(DateTime? newDate)
    {
        if (newDate.HasValue)
        {
            if (newDate == startDate)
                await OnStartDateChanged.InvokeAsync(startDate);
            else if (newDate == endDate)
                await OnEndDateChanged.InvokeAsync(endDate);

            await CalculateCorrelation();
        }
    }

    private async Task OnParameterChanged()
    {
        await CalculateCorrelation();
    }

    private async Task OnSensorSelectionChanged(SensorInfo sensor, bool isSelected)
    {
        if (isSelected)
        {
            if (!selectedSensors.Contains(sensor))
                selectedSensors.Add(sensor);
        }
        else
        {
            selectedSensors.Remove(sensor);
        }

        if (selectedSensors.Count >= 2)
        {
            await CalculateCorrelation();
        }
    }

    private async Task CalculateCorrelation()
    {
        if (selectedSensors.Count < 2) return;

        try
        {
            IsLoading = true;
            StateHasChanged();

            await Task.Delay(500); // Simuler le temps de traitement

            await GenerateCorrelationData();
            await UpdateChart();
            CalculateStatistics();
            await OnDataLoaded.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du calcul de la corrélation : {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task GenerateCorrelationData()
    {
        int sensorCount = selectedSensors.Count;
        correlationMatrix = new double[sensorCount, sensorCount];
        sensorLabels = selectedSensors.Select(s => s.Name).ToList();

        Random rand = new Random();

        // Générer une matrice de corrélation réaliste
        for (int i = 0; i < sensorCount; i++)
        {
            for (int j = 0; j < sensorCount; j++)
            {
                if (i == j)
                {
                    correlationMatrix[i, j] = 1.0; // Auto-corrélation parfaite
                }
                else if (i < j)
                {
                    double correlation = GenerateSensorCorrelation(selectedSensors[i], selectedSensors[j], rand);
                    correlationMatrix[i, j] = correlation;
                    correlationMatrix[j, i] = correlation; // Matrice symétrique
                }
            }
        }
    }

    private double GenerateSensorCorrelation(SensorInfo sensor1, SensorInfo sensor2, Random rand)
    {
        // Générer des corrélations plus réalistes en fonction des types de capteurs
        if (sensor1.Type == sensor2.Type)
        {
            // Les capteurs du même type ont une corrélation plus élevée
            return 0.3 + rand.NextDouble() * 0.6; // 0.3 à 0.9
        }
        else if ((sensor1.Type == "Inclinomètre" && sensor2.Type == "Accéléromètre") ||
                 (sensor1.Type == "Accéléromètre" && sensor2.Type == "Inclinomètre"))
        {
            // Les inclinomètres et les accéléromètres sont souvent corrélés
            return 0.2 + rand.NextDouble() * 0.5; // 0.2 à 0.7
        }
        else if ((sensor1.Type == "Température" && sensor2.Type == "Extensomètre") ||
                 (sensor1.Type == "Extensomètre" && sensor2.Type == "Température"))
        {
            // La température affecte les extensomètres
            return 0.1 + rand.NextDouble() * 0.4; // 0.1 à 0.5
        }
        else
        {
            // Corrélation aléatoire pour d'autres combinaisons
            return -0.3 + rand.NextDouble() * 0.6; // -0.3 à 0.3
        }
    }

    private async Task UpdateChart()
    {
        var data = new
        {
            z = ConvertMatrixToJagged(correlationMatrix),
            x = sensorLabels,
            y = sensorLabels,
            type = "heatmap",
            colorscale = "RdBu",
            zmid = 0,
            text = GetCorrelationText(),
            texttemplate = "%{text}",
            textfont = new { size = 12, color = "white" },
            hoverongaps = false,
            showscale = true
        };

        await JSRuntime.InvokeVoidAsync("updateCorrelationHeatmap", "correlationHeatmap", data, sensorLabels);
    }

    private double[][] ConvertMatrixToJagged(double[,] matrix)
    {
        int rows = matrix.GetLength(0);
        int cols = matrix.GetLength(1);
        double[][] result = new double[rows][];
        
        for (int i = 0; i < rows; i++)
        {
            result[i] = new double[cols];
            for (int j = 0; j < cols; j++)
            {
                result[i][j] = matrix[i, j];
            }
        }
        
        return result;
    }

    private string[][] GetCorrelationText()
    {
        int rows = correlationMatrix.GetLength(0);
        int cols = correlationMatrix.GetLength(1);
        string[][] result = new string[rows][];
        
        for (int i = 0; i < rows; i++)
        {
            result[i] = new string[cols];
            for (int j = 0; j < cols; j++)
            {
                result[i][j] = correlationMatrix[i, j].ToString("F2");
            }
        }
        
        return result;
    }

    private void CalculateStatistics()
    {
        if (correlationMatrix == null) return;

        int size = correlationMatrix.GetLength(0);
        totalPairs = (size * (size - 1)) / 2; // Seulement la partie supérieure, excluant la diagonale

        List<double> correlations = new();
        strongCorrelations = 0;

        for (int i = 0; i < size; i++)
        {
            for (int j = i + 1; j < size; j++)
            {
                double corr = correlationMatrix[i, j];
                correlations.Add(corr);
                
                if (Math.Abs(corr) > 0.7)
                    strongCorrelations++;
            }
        }

        if (correlations.Any())
        {
            maxCorrelation = correlations.Max();
            minCorrelation = correlations.Min();
            avgCorrelation = correlations.Average();
        }
    }

    public class SensorInfo
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string Unit { get; set; } = string.Empty;
        public bool IsSelected { get; set; }
    }
}

<script>
    window.initializeCorrelationHeatmap = function(elementId) {
        var layout = {
            title: 'Corrélation entre Capteurs',
            margin: { l: 150, r: 50, t: 50, b: 150 },
            paper_bgcolor: 'rgba(0,0,0,0)',
            plot_bgcolor: 'rgba(0,0,0,0)',
            autosize: true,
            xaxis: {
                tickangle: -45,
                side: 'bottom'
            },
            yaxis: {
                tickangle: 0
            }
        };
        
        var config = {
            responsive: true,
            displayModeBar: true
        };
        
        Plotly.newPlot(elementId, [], layout, config);
    };

    window.updateCorrelationHeatmap = function(elementId, data, labels) {
        var layout = {
            title: 'Corrélation entre ' + labels.length + ' Capteurs',
            margin: { l: 150, r: 50, t: 50, b: 150 },
            paper_bgcolor: 'rgba(0,0,0,0)',
            plot_bgcolor: 'rgba(0,0,0,0)',
            autosize: true,
            xaxis: {
                tickangle: -45,
                side: 'bottom',
                tickfont: { size: 10 }
            },
            yaxis: {
                tickangle: 0,
                tickfont: { size: 10 }
            }
        };
        
        var config = {
            responsive: true,
            displayModeBar: true
        };
        
        Plotly.newPlot(elementId, [data], layout, config);
    };
</script>