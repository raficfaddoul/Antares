@page "/settingsFolder/optimizer-manual"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Developer")]
@using AliantWebS.Manual
@inject NavigationManager navigationManager

@* The optimiser's manual, read on screen. The text is not written here: it is the embedded document the
   Word export prints as well (Shared/ScenarioHelpers/Manual/OptimizerManual.md, read by ManualDocument),
   so the page and the file can never say different things. This page only decides what a block looks like. *@

<style>
    .manual-page {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 20px;
    }

    .manual-shell {
        max-width: 1500px;
        margin: 0 auto;
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }

    .manual-toc {
        flex: 0 0 320px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        padding: 20px 18px;
        position: sticky;
        top: 20px;
        max-height: calc(100vh - 40px);
        overflow-y: auto;
    }

    .manual-toc h2 {
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #718096;
        margin: 0 0 12px 0;
    }

    .manual-toc a {
        display: block;
        padding: 5px 8px;
        border-radius: 6px;
        color: #2d3748;
        text-decoration: none;
        font-size: 14px;
        line-height: 1.35;
    }

    .manual-toc a:hover {
        background: #eef2ff;
        color: #4c51bf;
    }

    .manual-toc a.chapter {
        font-weight: 700;
        margin-top: 10px;
    }

    .manual-toc a.section {
        padding-left: 20px;
        color: #4a5568;
        font-size: 13px;
    }

    .manual-paper {
        flex: 1 1 auto;
        min-width: 0;
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        padding: 34px 40px 60px 40px;
    }

    .manual-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        flex-wrap: wrap;
        border-bottom: 3px solid #667eea;
        padding-bottom: 18px;
        margin-bottom: 28px;
    }

    .manual-title {
        font-size: 32px;
        font-weight: 700;
        color: #2d3748;
        margin: 0;
    }

    .manual-subtitle {
        color: #718096;
        font-size: 15px;
        margin-top: 8px;
        max-width: 60ch;
    }

    .manual-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .manual-btn {
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .manual-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
    }

    .manual-btn-word {
        background: #2b579a;
        color: white;
    }

    .manual-btn-back {
        background: #edf2f7;
        color: #2d3748;
    }

    .manual-body {
        color: #1a202c;
        font-size: 16px;
        line-height: 1.65;
        max-width: 82ch;
    }

    .manual-body h2 {
        font-size: 25px;
        font-weight: 700;
        color: #1f3864;
        margin: 46px 0 14px 0;
        padding-top: 10px;
        border-top: 1px solid #e2e8f0;
        scroll-margin-top: 20px;
    }

    .manual-body h2:first-of-type {
        border-top: none;
        margin-top: 10px;
    }

    .manual-body h3 {
        font-size: 20px;
        font-weight: 700;
        color: #2e5aac;
        margin: 30px 0 10px 0;
        scroll-margin-top: 20px;
    }

    .manual-body h4 {
        font-size: 17px;
        font-weight: 700;
        color: #374151;
        margin: 22px 0 6px 0;
    }

    .manual-body p {
        margin: 0 0 14px 0;
    }

    .manual-body ul,
    .manual-body ol {
        margin: 0 0 16px 0;
        padding-left: 26px;
    }

    .manual-body li {
        margin-bottom: 6px;
    }

    .manual-body code {
        background: #f2f4f7;
        color: #1f3864;
        border-radius: 4px;
        padding: 1px 5px;
        font-family: Consolas, "Courier New", monospace;
        font-size: 14px;
    }

    .manual-note {
        background: #fff4ce;
        border-left: 5px solid #e0a800;
        border-radius: 0 10px 10px 0;
        padding: 12px 16px;
        margin: 16px 0 18px 0;
    }

    .manual-code {
        background: #f2f4f7;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 14px 16px;
        margin: 0 0 18px 0;
        overflow-x: auto;
        font-family: Consolas, "Courier New", monospace;
        font-size: 13.5px;
        line-height: 1.45;
        white-space: pre;
        color: #1f3864;
    }

    .manual-table-wrap {
        overflow-x: auto;
        margin: 0 0 18px 0;
    }

    .manual-body table {
        border-collapse: collapse;
        width: 100%;
        font-size: 14.5px;
    }

    .manual-body th,
    .manual-body td {
        border: 1px solid #cbd5e0;
        padding: 7px 10px;
        text-align: left;
        vertical-align: top;
    }

    .manual-body th {
        background: #e8eaf0;
        font-weight: 700;
    }

    @@media (max-width: 1100px) {
        .manual-toc {
            display: none;
        }

        .manual-paper {
            padding: 24px 20px 40px 20px;
        }
    }

    @@media print {
        .manual-page {
            background: white;
            padding: 0;
        }

        .manual-toc, .manual-actions {
            display: none;
        }

        .manual-paper {
            box-shadow: none;
            border-radius: 0;
            padding: 0;
        }
    }
</style>

<div class="manual-page">
    <div class="manual-shell">

        <nav class="manual-toc">
            <h2>Sommaire</h2>
            @foreach (var entry in manual.Contents)
            {
                <a class="@(entry.Kind == ManualBlockKind.Chapter ? "chapter" : "section")"
                   href="@($"#{entry.Anchor}")">@ManualDocument.Plain(entry.Text)</a>
            }
        </nav>

        <div class="manual-paper">
            <div class="manual-header">
                <div>
                    <h1 class="manual-title">@manual.Title</h1>
                    <div class="manual-subtitle">
                        Comment l'implantation est calculée : les règles, les tolérances, les refus, et où
                        chacun se trouve dans le code. Le document Word exporté ici est exactement ce texte.
                    </div>
                </div>
                <div class="manual-actions">
                    <a class="manual-btn manual-btn-back" href="settings">
                        <span>←</span> Réglages
                    </a>
                    @* A link to the controller, not a JS download: the bytes travel over HTTP rather than
                       through the circuit, and the file is built from the same document as this page.
                       target="_blank" is what keeps it a real navigation - Blazor intercepts same-origin
                       anchors and would hand this one to the router, which has no page at that address. *@
                    <a class="manual-btn manual-btn-word" target="_blank" rel="noopener"
                       href="@AliantWebS.Controllers.OptimizerManualController.DownloadUrl">
                        <span>📄</span> Exporter en Word
                    </a>
                </div>
            </div>

            <div class="manual-body">
                @foreach (var block in manual.Blocks)
                {
                    switch (block.Kind)
                    {
                        case ManualBlockKind.Title:
                            break;

                        case ManualBlockKind.Chapter:
                            <h2 id="@block.Anchor">@RenderRuns(block.Text)</h2>
                            break;

                        case ManualBlockKind.Section:
                            <h3 id="@block.Anchor">@RenderRuns(block.Text)</h3>
                            break;

                        case ManualBlockKind.SubSection:
                            <h4>@RenderRuns(block.Text)</h4>
                            break;

                        case ManualBlockKind.Paragraph:
                            <p>@RenderRuns(block.Text)</p>
                            break;

                        case ManualBlockKind.Note:
                            <div class="manual-note">@RenderRuns(block.Text)</div>
                            break;

                        case ManualBlockKind.Bullets:
                            <ul>
                                @foreach (var item in block.Items)
                                {
                                    <li>@RenderRuns(item)</li>
                                }
                            </ul>
                            break;

                        case ManualBlockKind.Steps:
                            <ol>
                                @foreach (var item in block.Items)
                                {
                                    <li>@RenderRuns(item)</li>
                                }
                            </ol>
                            break;

                        case ManualBlockKind.Code:
                            <div class="manual-code">@block.Text</div>
                            break;

                        case ManualBlockKind.Table:
                            <div class="manual-table-wrap">
                                <table>
                                    @for (int r = 0; r < block.Rows.Count; r++)
                                    {
                                        <tr>
                                            @foreach (var cell in block.Rows[r])
                                            {
                                                @if (r == 0)
                                                {
                                                    <th>@RenderRuns(cell)</th>
                                                }
                                                else
                                                {
                                                    <td>@RenderRuns(cell)</td>
                                                }
                                            }
                                        </tr>
                                    }
                                </table>
                            </div>
                            break;
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private ManualDocument manual = ManualDocument.Load();

    // Bold, italic and code spans, rendered as elements rather than as markup: the manual's text is never
    // handed to the browser as HTML, so nothing in it can be read as a tag.
    private RenderFragment RenderRuns(string text) => builder =>
    {
        int sequence = 0;

        foreach (var run in ManualDocument.Runs(text))
        {
            if (run.Code)
            {
                builder.OpenElement(sequence++, "code");
                builder.AddContent(sequence++, run.Text);
                builder.CloseElement();
                continue;
            }

            if (run.Bold) builder.OpenElement(sequence++, "strong");
            if (run.Italic) builder.OpenElement(sequence++, "em");

            builder.AddContent(sequence++, run.Text);

            if (run.Italic) builder.CloseElement();
            if (run.Bold) builder.CloseElement();
        }
    };
}
