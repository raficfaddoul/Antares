    DateTime? timestampOverrideDate { get; set; }
    bool timestampOverrideApplied = false;

    void ApplyTimestampOverride()
    {
        if (!timestampOverrideDate.HasValue) return;

        long unixTimestamp = new DateTimeOffset(timestampOverrideDate.Value, TimeSpan.Zero).ToUnixTimeSeconds();
        ReportsService.SetTimestampOverride(unixTimestamp);

        timestampOverrideApplied = true;
        _= Task.Run(async () =>
        {
            await Task.Delay(4000);
            timestampOverrideApplied = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var cac = await localStorage.GetItemAsync<bool?>("capturePreview");
        CapturePreview = (cac ?? false);

        cac = await localStorage.GetItemAsync<bool?>("settingEditElementOnSelect");
        SettingEditElementOnSelect = (cac ?? true);

        cac = await localStorage.GetItemAsync<bool?>("saveConfirmation");
        SaveConfirmation = (cac ?? true);

        cac = await localStorage.GetItemAsync<bool?>("copyAttributes");
        CopyAttributes = (cac ?? false);

        StateHasChanged();
    }

