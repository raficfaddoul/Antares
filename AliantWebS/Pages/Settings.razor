    bool isBackingUp = false;
    bool isRestoring = false;

    private async Task BackupDatabase()
    {
        try
        {
            if (await appData.GetRole() != "Administrator")
                return; // server-side guard (the UI is admin-gated; this is defense in depth)

            // Show the Save-As dialog FIRST, while the click's transient activation is
            // still valid (the backup below is slow, and a Blazor Server round-trip would
            // otherwise lose the gesture the picker requires).
            // >0 = user chose a location, 0 = browser lacks the picker (normal download),
            // -1 = user cancelled.
            int handleId = await js.InvokeAsync<int>("openSaveDialog", "AliantWeb.bak");
            if (handleId == -1) return;

            isBackingUp = true;
            StateHasChanged();

            // Build connection string
            var dbHost     = System.Environment.GetEnvironmentVariable("DB_HOST");
            var dbName     = System.Environment.GetEnvironmentVariable("DB_NAME");
            var dbPassword = System.Environment.GetEnvironmentVariable("DB_SA_PASSWORD");

            string connectString = !string.IsNullOrEmpty(dbHost)
                ? $"Data Source={dbHost};Initial Catalog={dbName};User ID=sa;Password={dbPassword};TrustServerCertificate=true;Encrypt=False;"
                : configuration.GetConnectionString("DefaultConnection");

            string backupPath = configuration["BackupPath"];
            if (string.IsNullOrEmpty(backupPath))
                backupPath = Path.GetTempPath();

            // Unique name so the download endpoint targets exactly this backup and
            // concurrent backups can't collide.
            string fileName = $"AliantWeb_{DateTime.Now:yyyyMMdd_HHmmss}_{Guid.NewGuid():N}.bak";

            // SQL Server writes the .bak into the shared /backups volume (server-side).
            await Task.Run(() => DatabaseManagement.BackupDatabase(connectString, backupPath, fileName));

            // Pull the file from a plain HTTP endpoint that streams it (and deletes it
            // afterwards) — the bytes never travel over the SignalR circuit, so there's no
            // base64 inflation or server-side buffering regardless of DB size.
            // ToAbsoluteUri honours UsePathBase (BasePath).
            string url = navigationManager
                .ToAbsoluteUri($"Backup/Download?file={Uri.EscapeDataString(fileName)}")
                .ToString();

            if (handleId > 0)
                await js.InvokeVoidAsync("streamToHandle", handleId, url); // user-chosen folder
            else
                await js.InvokeVoidAsync("triggerFileDownload", url);      // fallback download

            await journal.WriteAsync(JournalCategory.Donnees, "database.backup", fileName,
                                     "Sauvegarde de la base téléchargée");
        }
        catch (Exception ex)
        {
            await js.InvokeVoidAsync("alert", L["Error"] + ": " + ex.Message);
        }
        finally
        {
            isBackingUp = false;
            StateHasChanged();
        }
    }

    private async Task OnRestoreFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return; // no file chosen

        if (await appData.GetRole() != "Administrator")
            return; // server-side guard (the UI is admin-gated; this is defense in depth)

        isRestoring = true;
        StateHasChanged();

        // Write the upload into the SHARED backup folder, not /tmp. RESTORE FROM DISK
        // runs inside the SQL Server container, which cannot see the web app's local
        // temp dir. BackupPath (/backups) is volume-mounted into both containers —
        // the same folder backup already uses.
        string restoreFolder = configuration["BackupPath"];
        if (string.IsNullOrEmpty(restoreFolder))
            restoreFolder = Path.GetTempPath();

        string tempFile = Path.Combine(restoreFolder, "AliantWeb_restore.bak");

        try
        {
            // Stream the upload straight to disk. <InputFile> chunks the transfer over
            // a dedicated stream, so it is NOT bound by SignalR's MaximumReceiveMessageSize
            // (the 1 MB limit that broke the old base64-over-JS-interop upload).
            const long maxSize = 10L * 1024 * 1024 * 1024; // 10 GB cap
            await using (var fs = new FileStream(tempFile, FileMode.Create, FileAccess.Write))
            await using (var upload = file.OpenReadStream(maxSize))
            {
                await upload.CopyToAsync(fs);
            }

            // Build connection string
            var dbHost     = System.Environment.GetEnvironmentVariable("DB_HOST");
            var dbName     = System.Environment.GetEnvironmentVariable("DB_NAME");
            var dbPassword = System.Environment.GetEnvironmentVariable("DB_SA_PASSWORD");

            string connectString = !string.IsNullOrEmpty(dbHost)
                ? $"Data Source={dbHost};Initial Catalog={dbName};User ID=sa;Password={dbPassword};TrustServerCertificate=true;Encrypt=False;"
                : configuration.GetConnectionString("DefaultConnection");

            // Run the restore on a background thread
            await Task.Run(() => DatabaseManagement.Restore(connectString, tempFile));

            // Journaled AFTER the restore, deliberately: the restore replaces the whole database,
            // Journal included, so a row written beforehand would be overwritten. This one lands in
            // the restored database, which is where somebody would look to explain the discontinuity.
            await journal.WriteAsync(JournalCategory.Donnees, "database.restore", file.Name,
                                     $"Base restaurée depuis « {file.Name} » ({file.Size} octets)", severity: 2);

            // Force a full page reload — data in memory is now stale
            await js.InvokeVoidAsync("alert", L["Restore completed. The page will now reload."].Value);
            navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Restore failed: {ex}");
            await js.InvokeVoidAsync("alert", L["Error"] + ": " + ex.Message);
        }
        finally
        {
            try { if (File.Exists(tempFile)) File.Delete(tempFile); } catch { /* best-effort cleanup */ }
            isRestoring = false;
            StateHasChanged();
        }
    }


