<SurveyPrompt Title="How is Blazor working for you?" />*@

<CascadingAuthenticationState>
 <!-- banner -->
    <div class="jumbotron jumbotron-fluid" id="banner" style="margin:-20px;/*margin:-75px -30px 75px -30px;*/ height:85vh; background-size: cover;background-repeat: no-repeat; background-position: center; background-image: url(img/20210622_101236resized.jpg);">
        <div class="container text-center text-md-left">
            <header>
                <div class="row justify-content-between">
                    <div class="col-2">
                        <img src="img/logo.png" alt="logo">
                    </div>
                    <div class="col-6 align-self-center text-right">
                        <a href="#" class="text-white lead">About</a>
                    </div>
                </div>
            </header>
            <h1 data-aos="fade" data-aos-easing="linear" data-aos-duration="1000" data-aos-once="true" class="display-3 text-white font-weight-bold my-5">
