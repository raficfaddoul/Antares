    private Point GetRealCoordinatesFromSVG(Point pt)
    {
        double x = (pt.X / width) * realWidth;
        double y = (pt.Y / height) * realHeight;

        return new Point(x, y);
    }

    private Point GetSVGCoordinatesFromReal(Point pt)
    {
        double x = (pt.X / realWidth) * width;
        double y = (pt.Y / realHeight) * height;

        return new Point(x, y);
    }

