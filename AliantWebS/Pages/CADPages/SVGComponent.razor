        {
            await OnErase.InvokeAsync(toErase);
            if (SelectedPalonnier != null)
                await SelectedPalonnierChanged.InvokeAsync(null);
            else
                await SelectedMotherGridChanged.InvokeAsync(null);
            StateHasChanged();
        }
    }

    private async Task HandleChargeClick(ChargeMp charge)
    {
        if (!isSelectingEnabled) return;
        await SelectedChargeChanged.InvokeAsync(charge);
        await SelectedPalonnierChanged.InvokeAsync(null);
        await SelectedMotherGridChanged.InvokeAsync(null);
        StateHasChanged();
    }

    private async Task EndDrawing(MouseEventArgs e)
    {
        if (isDrawing)
        {
            // The same conversion as the start and the rubber band (ClientToSvgPoint), so the line saved is the
            // line shown. The JS getSvgCoordinates reads the page's first <svg>, which need not be this one.
            var endPoint = GetRealCoordinatesFromSVG(ClientToSvgPoint(e.ClientX, e.ClientY));

            if (isSnappingEnabled)
            {
                var nearestCircle = FindNearestCircle(endPoint, SnapDistanceMm);
                if (nearestCircle != null)
                {
                    endPoint = nearestCircle.Center;
                }
            }

            if (isMotherGridsSnappingEnabled)
            {
                var nearestPoint = FindNearestMotherGrid(endPoint, SnapDistanceMm);
                if (nearestPoint != null)
                {
                    endPoint = nearestPoint;
                }
            }

            if (isPalonniersSnappingEnabled)
            {
                var nearestPoint = FindNearestPalonnier(endPoint, SnapDistanceMm);
                if (nearestPoint != null)
                {
                    endPoint = nearestPoint;
                }
            }

            if (currentLine.HasValue)
            {
                currentLine = (currentLine.Value.Item1, endPoint);
                if (Distance(currentLine.Value.Item1, currentLine.Value.Item2) > 500)
                {
                    await LineDrawn.InvokeAsync((
                        currentLine.Value.Item1.X / MmToM - Point0X,
                        currentLine.Value.Item1.Y / MmToM - Point0Y,
                        currentLine.Value.Item2.X / MmToM - Point0X,
                        currentLine.Value.Item2.Y / MmToM - Point0Y));
                }

                currentLine = null;
                StateHasChanged();
            }
            isDrawing = false;
        }
    }

    private double Distance(Point p1, Point p2)
    {
        double distance = Math.Sqrt(Math.Pow(p1.X - p2.X, 2) + Math.Pow(p1.Y - p2.Y, 2));
        return distance;
    }

    /// <summary>
    /// A point of the page (client pixels) in SVG user units, by the JS getSvgCoordinates. It reads the page's FIRST
    /// svg element, so the answer is this plan's only while no other svg comes before it on the page. The sensor
    /// positioning of the Surveillance tab relies on it (RadzenTabs renders only the open tab there); this
    /// component's own drawing, hover and selection use ClientToSvgPoint.
    /// </summary>
    public async Task<Point> GetSvgCoordinates(double clientX, double clientY)
    {
        return await js.InvokeAsync<Point>("getSvgCoordinates", clientX, clientY);
    }

    /// <summary>
    /// A point of the plan (SVG user units) in the component's "real" coordinates: the grid's axes, absolute
    /// millimetres. The inverse of GetSVGCoordinatesFromReal.
    /// </summary>
    public Point GetRealCoordinatesFromSVG(Point pt)
    {
        var (x, y) = PlanView.FromSvg(pt.X, pt.Y, Point0X, Point0Y);
        return new Point(x, y);
    }

    /// <summary>
    /// A "real" point - the grid's axes, absolute millimetres - on the plan, in the studies' orientation: taken
    /// relative to Point0, converted to the studies' axes, study X to the right and study Y up (PlanView).
    /// </summary>
    private Point GetSVGCoordinatesFromReal(Point pt)
    {
        var (x, y) = PlanView.ToSvg(pt.X, pt.Y, Point0X, Point0Y);
        return new Point(x, y);
    }

    public void AddLine(double x1, double y1, double x2, double y2)
    {
        lines.Add((new Point(x1, y1), new Point(x2, y2)));
        StateHasChanged();
    }

    private Circle FindNearestCircle(Point pt, double threshold)
    {
        Circle nearestCircle = null;
        double minDistance = double.MaxValue;

        foreach (var circle in circles)
        {
            double distance = Math.Sqrt(Math.Pow(circle.Center.X - pt.X, 2) + Math.Pow(circle.Center.Y - pt.Y, 2));
            if (distance < minDistance && distance <= threshold)
            {
                minDistance = distance;
                nearestCircle = circle;
            }
        }

        return nearestCircle;
    }

    private Point FindNearestPalonnier(Point pt, double threshold)
    {
        if (Palonniers == null || Palonniers.Count == 0)
            return null;

        Point nearestPoint = null;
        double minDistance = double.MaxValue;

        foreach (var pal in Palonniers)
        {
            if (pal.X1 == null || pal.Y1 == null || pal.X2 == null || pal.Y2 == null)
                continue;

            // Element ends are stored in metres from Point0; pt is in absolute millimetres, as the circles are.
            var p1 = new Point(((double)pal.X1 + Point0X) * MmToM, ((double)pal.Y1 + Point0Y) * MmToM);
            var p2 = new Point(((double)pal.X2 + Point0X) * MmToM, ((double)pal.Y2 + Point0Y) * MmToM);
            
            double distance = Math.Sqrt(Math.Pow(p1.X - pt.X, 2) + Math.Pow(p1.Y - pt.Y, 2));
            if (distance < minDistance && distance <= threshold)
            {
                minDistance = distance;
                nearestPoint = p1;
            }

            distance = Math.Sqrt(Math.Pow(p2.X - pt.X, 2) + Math.Pow(p2.Y - pt.Y, 2));
            if (distance < minDistance && distance <= threshold)
            {
                minDistance = distance;
                nearestPoint = p2;
            }
        }

        return nearestPoint;
    }

    private Point FindNearestMotherGrid(Point pt, double threshold)
    {
        if (MotherGrids == null || MotherGrids.Count == 0)
            return null;

        Point nearestPoint = null;
        double minDistance = double.MaxValue;

        foreach (var moth in MotherGrids)
        {
            if (moth.X1 == null || moth.Y1 == null || moth.X2 == null || moth.Y2 == null)
                continue;

            // Element ends are stored in metres from Point0; pt is in absolute millimetres, as the circles are.
            var p1 = new Point(((double)moth.X1 + Point0X) * MmToM, ((double)moth.Y1 + Point0Y) * MmToM);
            var p2 = new Point(((double)moth.X2 + Point0X) * MmToM, ((double)moth.Y2 + Point0Y) * MmToM);
            
            double distance = Math.Sqrt(Math.Pow(p1.X - pt.X, 2) + Math.Pow(p1.Y - pt.Y, 2));
            if (distance < minDistance && distance <= threshold)
            {
                minDistance = distance;
                nearestPoint = p1;
            }

            distance = Math.Sqrt(Math.Pow(p2.X - pt.X, 2) + Math.Pow(p2.Y - pt.Y, 2));
            if (distance < minDistance && distance <= threshold)
            {
                minDistance = distance;
                nearestPoint = p2;
            }
        }

        return nearestPoint;
    }

    private void ZoomToExtent()
    {
        FitView();
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        // The plan is drawn relative to Point0. When the event's origin arrives after the first render, or
        // changes, move the view by as much, so it keeps showing the same place of the charpente.
        if (planReady && viewPoint0X is { } oldX && viewPoint0Y is { } oldY && (oldX != Point0X || oldY != Point0Y))
        {
            var before = PlanView.ToSvg(0, 0, oldX, oldY);
            var after = PlanView.ToSvg(0, 0, Point0X, Point0Y);
            SetViewBox(_vx + after.X - before.X, _vy + after.Y - before.Y, _vw, _vh);
        }
        viewPoint0X = Point0X;
        viewPoint0Y = Point0Y;
    }

    // The whole plan: the picture's footprint, which frames the charpente and its labels. The plan is taller
    // than wide in the studies' orientation; the SVG fits it into its box (xMidYMid meet).
    private void FitView()
    {
        var (x, y, w, h) = PlanView.Extent(Point0X, Point0Y);
        SetViewBox(x, y, w, h);
        viewPoint0X = Point0X;
        viewPoint0Y = Point0Y;
    }

    private void SetViewBox(double x, double y, double w, double h)
    {
        viewBox = $"{Fmt(x)} {Fmt(y)} {Fmt(w)} {Fmt(h)}";
        ParseViewBox();
    }

