    [Parameter] public MotherGridPalonnier SelectedPalonnier { get; set; }
    [Parameter] public EventCallback<MotherGridPalonnier> SelectedPalonnierChanged { get; set; }
    [Parameter] public MotherGridPalonnier SelectedMotherGrid { get; set; }
    [Parameter] public EventCallback<MotherGridPalonnier> SelectedMotherGridChanged { get; set; }
    [Parameter] public ChargeMp SelectedCharge { get; set; }
    [Parameter] public EventCallback<ChargeMp> SelectedChargeChanged { get; set; }

    // ── Replace HandleSvgClick ────────────────────────────────────────────────
    private async Task HandleSvgClick(MouseEventArgs e)
    {
        if (!IsPositioningMode && isSelectingEnabled)
        {
            // Measured with the element's box as it is now: the page may have scrolled since the box was last read.
            await RefreshSvgRect();
            var (palonnier, motherGrid) = ElementAt(GetRealCoordinatesFromSVG(ClientToSvgPoint(e.ClientX, e.ClientY)));

            if (palonnier != null)
                await SelectedPalonnierChanged.InvokeAsync(palonnier);
            else if (motherGrid != null)
                await SelectedMotherGridChanged.InvokeAsync(motherGrid);
            else
            {
                // Away from every element: nothing stays selected, so "Erase Selected" has nothing to erase.
                await SelectedPalonnierChanged.InvokeAsync(null);
                await SelectedMotherGridChanged.InvokeAsync(null);
            }
            StateHasChanged();
        }

        await SvgClicked.InvokeAsync(e);
    }

    // The element under the mouse: the palonnier or the mother line within PickTolerancePx of it on the screen -
    // the nearer of the two, the palonnier on a tie - or neither, away from every element. A click selects it and
    // hover highlights it, so what lights up under the mouse is what a click takes.
    private (MotherGridPalonnier Palonnier, MotherGridPalonnier MotherGrid) ElementAt(Point realPt)
    {
        // Element ends are stored in metres from Point0, in the grid's axes; realPt is in absolute millimetres, in
        // the same axes. The plan draws those axes at one scale in every direction (PlanView), so a distance
        // measured here is the one seen on the screen.
        var p = new Point(realPt.X / MmToM - Point0X, realPt.Y / MmToM - Point0Y);
        double tolerance = PickToleranceM;

        (MotherGridPalonnier Element, double Metres) Nearest(List<MotherGridPalonnier> elements)
        {
            MotherGridPalonnier nearest = null;
            double min = double.MaxValue;
            if (elements == null) return (nearest, min);
            foreach (var el in elements)
            {
                if (el.X1 == null || el.Y1 == null || el.X2 == null || el.Y2 == null) continue;
                double d = GetPerpendicularDistance(p,
                    new Point((double)el.X1, (double)el.Y1),
                    new Point((double)el.X2, (double)el.Y2));
                if (d < min && d <= tolerance) { min = d; nearest = el; }
            }
            return (nearest, min);
        }

        var palonnier = Nearest(Palonniers);
        var motherGrid = Nearest(MotherGrids);
        if (palonnier.Element != null && palonnier.Metres <= motherGrid.Metres)
            return (palonnier.Element, null);
        return (null, motherGrid.Element);
    }

    // PickTolerancePx on the plan, in metres at the current zoom: the unit of the distances ElementAt measures.
    private double PickToleranceM => PlanView.SvgToMetres(PickTolerancePx / PxPerSvgUnit);

    private async Task EraseSelected()
    {
