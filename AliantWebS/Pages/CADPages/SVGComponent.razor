@page "/SVG"
@using BlazorSvgEditor
@using BlazorSvgEditor.SvgEditor
@using BlazorSvgEditor.SvgEditor.Misc;
@using BlazorSvgEditor.SvgEditor.Shapes;
@using Models
@using AliantWebS.Data
@inject IJSRuntime js

<style>
    .toolbar-button {
        width: 30px; /* Set a fixed width */
        height: 40px; /* Set a fixed height if needed */
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<PageTitle>BlazorSvgEditor Demo</PageTitle>


@if (origPt != null)
{
    <div style="position: relative; display: inline-block;">
        <svg id="no-scroll-svg" width="@width" height="@height" viewBox="@viewBox"
             @onmousedown="OnMouseDown"
             @onmousemove="OnMouseMove"
             @onmouseup="OnMouseUp"
             @onwheel="OnWheel"
             @onwheel:stopPropagation
             @onwheel:preventDefault
             @onclick="OnClick"
             style="border: 1px solid black; cursor: @(isPanning ? "grabbing" : "default");">
            <image href="PLAN ANTARES-ALIANT.jpg" x="@GetSVGCoordinatesFromReal(origPt).X" y="@GetSVGCoordinatesFromReal(origPt).Y"
                   width="@($"{imageScale * 100}%")" height="@($"{imageScale * 100}%")"
                   preserveAspectRatio="xMidYMid meet" />
            @if (currentLine != null)
            {
                <line x1="@GetSVGCoordinatesFromReal(currentLine?.Item1).X" y1="@GetSVGCoordinatesFromReal(currentLine?.Item1).Y" x2="@GetSVGCoordinatesFromReal(currentLine?.Item2).X" y2="@GetSVGCoordinatesFromReal(currentLine?.Item2).Y" stroke="black" stroke-width="2" />
            }

            @foreach (var line in lines)
            {
                <line x1="@GetSVGCoordinatesFromReal(line.Item1).X
                                    " y1="@GetSVGCoordinatesFromReal(line.Item1).Y
                                    " x2="@GetSVGCoordinatesFromReal(line.Item2).X
                                    " y2="@GetSVGCoordinatesFromReal(line.Item2).Y
                                    " stroke="black" stroke-width="2" />
            }
            @if (Palonniers != null)
            {
                @foreach (var pal in Palonniers)
                {
                    if ((pal.X1 != null) && (pal.Y1 != null) && (pal.X2 != null) && (pal.Y2 != null))
                    {
                        var p1 = new Point((double)pal.X1, (double)pal.Y1);
                        var p2 = new Point((double)pal.X2, (double)pal.Y2);
                        <line x1="@GetSVGCoordinatesFromReal(p1).X
                                                                " y1="@GetSVGCoordinatesFromReal(p1).Y
                                                                " x2="@GetSVGCoordinatesFromReal(p2).X
                                                                " y2="@GetSVGCoordinatesFromReal(p2).Y"
                              stroke="@(pal == selectedPalonnier ? "red" : pal == hoveredPalonnier ? "orange" : "green")"
                              stroke-width="@(pal == selectedPalonnier ? "4" : pal == hoveredPalonnier ? "3" : "2")" />
                    }
                    }
                }
            }
            @if (MotherGrids != null)
            {
                @foreach (var moth in MotherGrids)
                {
                    if ((moth.X1 != null) && (moth.Y1 != null) && (moth.X2 != null) && (moth.Y2 != null))
                    {
                        var p1 = new Point((double)moth.X1, (double)moth.Y1);
                        var p2 = new Point((double)moth.X2, (double)moth.Y2);
                        <line x1="@GetSVGCoordinatesFromReal(p1).X
                                                                        " y1="@GetSVGCoordinatesFromReal(p1).Y
                                                                        " x2="@GetSVGCoordinatesFromReal(p2).X
                                                                        " y2="@GetSVGCoordinatesFromReal(p2).Y"
                              stroke="@(moth == selectedPalonnier ? "blue" : moth == hoveredMotherGrid ? "orange" : "yellow")"
                              stroke-width="@(moth == selectedPalonnier ? "4" : moth == hoveredMotherGrid ? "3" : "2")" />
                    }
                }
            }

            @foreach (var circle in circles)
            {
                <circle cx="@GetSVGCoordinatesFromReal(circle.Center).X" cy="@GetSVGCoordinatesFromReal(circle.Center).Y" r="@circle.Radius" fill="@circle.Color" />
            }

        </svg>
        <div style="position: absolute; top: 10px; left: calc(100% + 10px);">
            <button class="toolbar-button" @onclick="ZoomToExtent" title="Zoom to Extent">
                <i class="fas fa-expand-arrows-alt"></i> <!-- FontAwesome icon -->
            </button>
            <button class="toolbar-button" @onclick="ToggleSnapping" title="Toggle Node Snapping"
                    style="background-color: @(isSnappingEnabled ? "green" : "gray");">
                <i class="fas fa-magnet"></i>
            </button>
            <button class="toolbar-button" @onclick="TogglePSnapping" title="Toggle Palonniers Snapping"
                    style="background-color: @(isPalonniersSnappingEnabled ? "green" : "gray");">
                P<i class="fas fa-magnet"></i>
            </button>
            <button class="toolbar-button" @onclick="ToggleMSnapping" title="Toggle Mothergrids Snapping"
                    style="background-color: @(isMotherGridsSnappingEnabled ? "green" : "gray");">
                M<i class="fas fa-magnet"></i>
            </button>
            <button class="toolbar-button" @onclick="ToggleSelecting" title="Selection"
                    style="background-color: @(isSelectingEnabled ? "green" : "gray");">
                <i class="fas fa-mouse-pointer"></i>
            </button>
            <button class="toolbar-button" @onclick="EraseSelected" title="Erase Selected"
                    style="background-color: red; color: white;">
                <i class="fas fa-eraser"></i>
            </button>
        </div>
    </div>
}

