    /// <summary>
    /// Returns a color from green → yellow → orange → red based on a 0–1+ charge ratio.
    /// </summary>
    private string GetSensorColor(Element sensor)
    {
        if (sensor == selectedSensor) return "#ff4444";
        if (sensor == hoveredSensor) return "#ff8800";

        if (SensorChargeRatios != null && SensorChargeRatios.TryGetValue(sensor.ElementId, out double ratio))
        {
            // Clamp to 0–1 for color interpolation
            double t = Math.Clamp(ratio, 0.0, 1.0);
            // Green (0%) → Yellow (50%) → Orange (75%) → Red (100%)
            int r, g;
            if (t < 0.5)
            {
                // Green → Yellow
                r = (int)(255 * (t / 0.5));
                g = 255;
            }
            else
            {
                // Yellow → Red
                r = 255;
                g = (int)(255 * (1 - (t - 0.5) / 0.5));
            }
            return $"rgb({r},{g},0)";
        }

        return "#4CAF50"; // default green
    }

    private string GetSensorStrokeColor(Element sensor)
    {
        if (sensor == selectedSensor) return "#ff4444";
        if (SensorChargeRatios != null && SensorChargeRatios.ContainsKey(sensor.ElementId))
            return GetSensorColor(sensor);
        return "#4CAF50";
    }

    private double GetPerpendicularDistance(Point p, Point p1, Point p2)
    {
        double A = p.X - p1.X;
        double B = p.Y - p1.Y;
        double C = p2.X - p1.X;
        double D = p2.Y - p1.Y;

        double dot = A * C + B * D;
        double len_sq = C * C + D * D;
        double param = len_sq != 0 ? dot / len_sq : -1;

        double xx, yy;
        if (param < 0)       { xx = p1.X; yy = p1.Y; }
        else if (param > 1)  { xx = p2.X; yy = p2.Y; }
        else                 { xx = p1.X + param * C; yy = p1.Y + param * D; }

        double dx = p.X - xx;
        double dy = p.Y - yy;
        return Math.Sqrt(dx * dx + dy * dy);
    }

    // ── Cached SVG viewport ───────────────────────────────────────────────────
    private double _svgLeft, _svgTop, _svgCssWidth = 754, _svgCssHeight = 400;

    // ── Cached parsed viewBox (avoids Split+Parse on every mouse move) ────────
    private double _vx, _vy, _vw = 754, _vh = 400;

    private class SvgRect
    {
        public double Left   { get; set; }
        public double Top    { get; set; }
        public double Width  { get; set; }
        public double Height { get; set; }
    }

    // The element's box, read again on every mouse-down, on a selection click and when the mouse comes onto the
    // plan (@onpointerenter - @onmouseenter is declared twice in this project, which Razor refuses): a page scrolled
    // while the mouse was elsewhere moves the box without resizing it, which the resize observer does not see, and
    // hover and selection work to a few pixels.
    private async Task RefreshSvgRect()
    {
        var r = await js.InvokeAsync<SvgRect>("getSvgBoundingRect", "no-scroll-svg");
        _svgLeft     = r.Left;
        _svgTop      = r.Top;
        _svgCssWidth  = r.Width  > 0 ? r.Width  : 754;
        _svgCssHeight = r.Height > 0 ? r.Height : 400;
    }

    /// <summary>Call whenever viewBox string is updated.</summary>
    private void ParseViewBox()
    {
        var p = viewBox.Split(' ');
        _vx = double.Parse(p[0], Inv);
        _vy = double.Parse(p[1], Inv);
        _vw = double.Parse(p[2], Inv);
        _vh = double.Parse(p[3], Inv);
    }

    // CSS pixels per SVG unit at the current zoom: xMidYMid meet (the SVG default) fits the viewBox into the
    // element's box at one scale in both directions, centred.
    private double PxPerSvgUnit => Math.Min(_svgCssWidth / _vw, _svgCssHeight / _vh);

    /// <summary>Synchronous replacement for the async JS GetSvgCoordinates call.</summary>
    private Point ClientToSvgPoint(double clientX, double clientY)
    {
        double scale  = PxPerSvgUnit;
        double padX   = (_svgCssWidth  - _vw * scale) / 2.0;
        double padY   = (_svgCssHeight - _vh * scale) / 2.0;
        return new Point(
            _vx + (clientX - _svgLeft - padX) / scale,
            _vy + (clientY - _svgTop  - padY) / scale
        );
    }

    private void UpdateViewBox(double dx, double dy)
    {
        // dx/dy are CSS pixels; divide by scale to convert to SVG units
        double scale = PxPerSvgUnit;
        viewBox = $"{Fmt(_vx - dx / scale)} {Fmt(_vy - dy / scale)} {Fmt(_vw)} {Fmt(_vh)}";
        ParseViewBox();
        StateHasChanged();
    }

    // ── DXF Export ────────────────────────────────────────────────────────────
    private bool showDxfSettings = false;
    private bool dxfExportMotherGrid    = true;
    private bool dxfExportPalonniers    = true;
    private bool dxfExportCharges       = true;
    private bool dxfExportPalonnierLoads = true;
    private bool dxfExportIntersections = true;
    private bool dxfExportSensors       = true;
    private bool dxfExportOrigin        = true;
    private bool dxfExportBackgroundImage = false;

    // Base file name suggested by the JPG export (the dialog's own file-name box drives the DXF).
    private string ExportBaseName =>
        string.IsNullOrWhiteSpace(dxfExportFileName) ? "plan" : dxfExportFileName.Replace("'", "");

    private void OpenDxfSettings()  => showDxfSettings = true;
    private void CloseDxfSettings() => showDxfSettings = false;
    private string dxfExportFileName = "export";

    private async Task ExportDxfAndClose()
    {
        showDxfSettings = false;
        await ExportDxf();
    }

    private async Task ExportDxf()
    {
        const string imgFile = PlanView.BackgroundImage;

        // The drawing is written in METRES in the studies' axes - the coordinates the studies print and the
        // pages show: the origin at Point0 (E5), X along the beams towards point 9, Y across them towards J.
        // Two conventions feed into it:
        //   • palonniers / mothergrids / charges / intersections : the grid's axes, METRES from Point0
        //   • sensors (X/Y attributes)                            : the grid's axes, absolute MILLIMETRES
        // These helpers bring each into the studies' axes.
        (double X, double Y) Stored(double gridXm, double gridYm) => global::Helpers.StudyAxes.ToStudy(gridXm, gridYm);
        (double X, double Y) Absolute(double gridXmm, double gridYmm) => PlanView.StudyMetres(gridXmm, gridYmm, Point0X, Point0Y);

        // The picture, turned as on the screen: where the corner that was its lower left lands, and its width
        // (running down, towards A) and height (running right, towards point 9), in metres.
        var (imgX, imgY, imgW, imgH) = PlanView.ImageInStudyMetres(Point0X, Point0Y);

        // netDxf writes the file. Hand-authoring the DXF skeleton (handles, AcDb subclass markers,
        // symbol tables, block records and the raster-image dictionary chain) proved too easy to get
        // subtly wrong — the library owns all of that and emits a valid document.
        var doc = new netDxf.DxfDocument(netDxf.Header.DxfVersion.AutoCad2000);
        doc.DrawingVariables.InsUnits = netDxf.Units.DrawingUnits.Meters;

        netDxf.Tables.Layer L(string name, short aci)
        {
            var layer = new netDxf.Tables.Layer(name) { Color = new netDxf.AciColor(aci) };
            doc.Layers.Add(layer);
            return layer;
        }

        var layBackground    = L("BACKGROUND",    8);
        var layMotherGrid    = L("MOTHERGRID",    1);
        var layPalonniers    = L("PALONNIERS",    5);
        var layCharges       = L("CHARGES",       3);
        var layPalLoads      = L("PAL_LOADS",     6);
        var layIntersections = L("INTERSECTIONS", 1);
        var laySensors       = L("SENSORS",       4);
        var layOrigin        = L("ORIGIN",        7);
        var layDrawingData   = L("DRAWING_DATA",  2);

        void AddLine(netDxf.Tables.Layer layer, double x1, double y1, double x2, double y2)
            => doc.Entities.Add(new netDxf.Entities.Line(
                   new netDxf.Vector2(x1, y1), new netDxf.Vector2(x2, y2)) { Layer = layer });

        void AddCircle(netDxf.Tables.Layer layer, double cx, double cy, double r)
            => doc.Entities.Add(new netDxf.Entities.Circle(new netDxf.Vector2(cx, cy), r) { Layer = layer });

        void AddText(netDxf.Tables.Layer layer, double x, double y, double height, string text)
        {
            if (string.IsNullOrWhiteSpace(text)) return;
            // DXF stores one value per line, so strip newlines out of names.
            var clean = text.Replace("\r", " ").Replace("\n", " ");
            doc.Entities.Add(new netDxf.Entities.Text(clean, new netDxf.Vector2(x, y), height) { Layer = layer });
        }

        // Background raster. DXF cannot embed image data — the entity only stores a path — so the
        // .jpg is saved next to the .dxf (see downloadDxfWithImage).
        if (dxfExportBackgroundImage)
        {
            // Its true size in pixels, and pixels per centimetre: CAD lays the file's pixels out by these.
            var imgDef = new netDxf.Objects.ImageDefinition(
                imgFile, imgFile,
                PlanView.ImageWidthPx, PlanView.ImageWidthPx / (imgW * 100.0),
                PlanView.ImageHeightPx, PlanView.ImageHeightPx / (imgH * 100.0),
                netDxf.Units.ImageResolutionUnits.Centimeters);

            // A quarter turn clockwise, as on the screen: its width runs down towards A and its height right
            // towards point 9, from the corner that was its lower left.
            doc.Entities.Add(new netDxf.Entities.Image(imgDef, new netDxf.Vector2(imgX, imgY), imgW, imgH)
            {
                Layer = layBackground,
                Rotation = PlanView.ImageRotationDeg,
            });
        }

        // Origin axes
        if (dxfExportOrigin)
        {
            // Point0 is the origin: X along the beams towards point 9, Y across them towards J.
            AddLine(layOrigin, 0, 0, 2, 0);
            AddLine(layOrigin, 0, 0, 0, 2);
            AddText(layOrigin, 2.1,  0,    0.3, "X");
            AddText(layOrigin, 0,    2.3,  0.3, "Y");
            AddText(layOrigin, 0.2, -0.5,  0.2, "(0,0)");
        }

        // Mother Grids
        if (dxfExportMotherGrid && MotherGrids != null)
            foreach (var m in MotherGrids)
            {
                if (m.X1 == null || m.Y1 == null || m.X2 == null || m.Y2 == null) continue;
                var (x1, y1) = Stored((double)m.X1, (double)m.Y1);
                var (x2, y2) = Stored((double)m.X2, (double)m.Y2);
                AddLine(layMotherGrid, x1, y1, x2, y2);
                AddText(layMotherGrid, (x1 + x2) / 2, (y1 + y2) / 2, 0.15, m.Name);
            }

        // Palonniers
        if (dxfExportPalonniers && Palonniers != null)
            foreach (var p in Palonniers)
            {
                if (p.X1 == null || p.Y1 == null || p.X2 == null || p.Y2 == null) continue;
                var (x1, y1) = Stored((double)p.X1, (double)p.Y1);
                var (x2, y2) = Stored((double)p.X2, (double)p.Y2);
                AddLine(layPalonniers, x1, y1, x2, y2);
                AddText(layPalonniers, (x1 + x2) / 2, (y1 + y2) / 2, 0.15, p.Name);
            }

        // Charges Scéniques
        if (dxfExportCharges && ChargesSceniques != null)
            foreach (var c in ChargesSceniques)
            {
                if (c.X == null || c.Y == null || c.Charge == null) continue;
                var (cx, cy) = Stored((double)c.X, (double)c.Y);
                AddCircle(layCharges, cx, cy, 0.1);
                AddText(layCharges, cx + 0.15, cy, 0.12, $"{c.Name ?? "Charge"}: {c.Charge:F1}");
            }

        // Palonnier Loads
        if (dxfExportPalonnierLoads && PalonnierLoads != null)
            foreach (var charge in PalonnierLoads)
            {
                var pal = CarrierOf(charge);   // a palonnier, or a mother line the charge hangs from directly
                if (pal == null || pal.X1 == null || pal.Y1 == null || pal.X2 == null || pal.Y2 == null || charge.X == null) continue;
                double lx1 = (double)pal.X1, ly1 = (double)pal.Y1;
                double lx2 = (double)pal.X2, ly2 = (double)pal.Y2;
                double len = Math.Sqrt(Math.Pow(lx2 - lx1, 2) + Math.Pow(ly2 - ly1, 2));
                double ratio = len > 0 ? (charge.X ?? 0) / len : 0;
                var (cx, cy) = Stored(lx1 + ratio * (lx2 - lx1), ly1 + ratio * (ly2 - ly1));
                AddCircle(layPalLoads, cx, cy, 0.08);
                AddText(layPalLoads, cx + 0.12, cy, 0.1, $"{charge.Name ?? "Load"}: {charge.Charge:F1}");
            }

        // Intersections
        if (dxfExportIntersections && IntersectionPoints != null)
            foreach (var kvp in IntersectionPoints)
                foreach (var pt in kvp.Value)
                    AddCircle(layIntersections, Stored(pt.X, pt.Y).X, Stored(pt.X, pt.Y).Y, 0.12);

        // Sensors — their X/Y attributes are absolute MILLIMETRES, unlike the event-relative metres
        // used above, so they need converting.
        if (dxfExportSensors && Sensors != null)
            foreach (var sensor in Sensors)
            {
                var xAttr = sensor.AttributeElements?.FirstOrDefault(ae => ae.AttributeType?.Name == "X");
                var yAttr = sensor.AttributeElements?.FirstOrDefault(ae => ae.AttributeType?.Name == "Y");
                if (xAttr == null || yAttr == null) continue;
                if (!double.TryParse(xAttr.Value, System.Globalization.NumberStyles.Float, Inv, out double sxMm)) continue;
                if (!double.TryParse(yAttr.Value, System.Globalization.NumberStyles.Float, Inv, out double syMm)) continue;
                var (sx, sy) = Absolute(sxMm, syMm);
                AddCircle(laySensors, sx, sy, 0.1);
                AddText(laySensors, sx + 0.15, sy, 0.12, sensor.Name ?? "Sensor");
            }

        // ── Drawing data ──────────────────────────────────────────────────────────────────
        // A titled block of metadata on its own layer, laid out below the plan so it never
        // overlaps the geometry. Freeze or turn off DRAWING_DATA in CAD to hide it.
        {
            var info = new List<string>();
            if (!string.IsNullOrWhiteSpace(ModuleName))    info.Add($"Module : {ModuleName}");
            if (!string.IsNullOrWhiteSpace(StructureName)) info.Add($"Structure : {StructureName}");
            if (!string.IsNullOrWhiteSpace(EventName))     info.Add($"Événement : {EventName}");
            if (EventId.HasValue && EventId != Guid.Empty) info.Add($"ID événement : {EventId}");
            if (!string.IsNullOrWhiteSpace(ScenarioName))  info.Add($"Scénario : {ScenarioName}");
            if (ScenarioId.HasValue && ScenarioId != Guid.Empty) info.Add($"ID scénario : {ScenarioId}");
            info.Add($"Date d'export : {DateTime.Now.ToString("dd/MM/yyyy HH:mm", Inv)}");
            info.Add("Unités : mètres");
            // The origin is whatever Point0 the calling page passes, so say which one: naming E5
            // unconditionally told the reader the wrong origin on every page that passes none.
            info.Add((Point0X == 0 && Point0Y == 0
                          ? "Axes : ceux des études — aucun Point0 défini, origine au (0,000 ; 0,000) du plan"
                          : $"Axes : ceux des études — origine au Point0 ({Point0X.ToString("0.000", Fr)} ; "
                            + $"{Point0Y.ToString("0.000", Fr)})")
                     + ", X le long des poutres vers le point 9, Y en travers des poutres vers la poutre J");

            var exported = new List<string>();
            if (dxfExportBackgroundImage)  exported.Add("fond de plan");
            if (dxfExportMotherGrid)       exported.Add("mothergrids");
            if (dxfExportPalonniers)       exported.Add("palonniers");
            if (dxfExportCharges)          exported.Add("charges scéniques");
            if (dxfExportPalonnierLoads)   exported.Add("charges palonniers");
            if (dxfExportIntersections)    exported.Add("intersections");
            if (dxfExportSensors)          exported.Add("capteurs");
            if (dxfExportOrigin)           exported.Add("origine");
            if (exported.Count > 0) info.Add($"Calques exportés : {string.Join(", ", exported)}");

            const double titleH = 0.6, lineH = 0.35, gap = 0.55;
            double tx = imgX;                                // align with the plan's left edge
            double ty = imgY - imgW - 1.2;                         // start below the drawing
            AddText(layDrawingData, tx, ty, titleH, "DONNÉES DU DESSIN");
            ty -= gap;
            AddLine(layDrawingData, tx, ty + 0.15, tx + 25, ty + 0.15);
            foreach (var line in info)
            {
                ty -= gap;
                AddText(layDrawingData, tx, ty, lineH, line);
            }
        }

        string content;
        using (var ms = new MemoryStream())
        {
            doc.Save(ms);
            ms.Position = 0;
            using var reader = new StreamReader(ms);
            content = reader.ReadToEnd();
        }

        var fileName = string.IsNullOrWhiteSpace(dxfExportFileName) ? "export" : dxfExportFileName.Trim();
        if (fileName.EndsWith(".dxf", StringComparison.OrdinalIgnoreCase))
            fileName = fileName[..^4];

        if (dxfExportBackgroundImage)
        {
            // The DXF only references the picture by name, so ship the .jpg alongside it —
            // otherwise CAD opens the drawing with an empty image frame.
            await js.InvokeVoidAsync("downloadDxfWithImage", $"{fileName}.dxf", content, imgFile, imgFile);
        }
        else
        {
            await js.InvokeVoidAsync("downloadTextFile", $"{fileName}.dxf", content);
        }

        await journal.WriteAsync(JournalCategory.Donnees, "export.dxf", $"{fileName}.dxf",
            $"Module {ModuleName}, structure {StructureName}, événement {EventName}"
            + (dxfExportBackgroundImage ? " — avec image de fond" : ""),
            eventId: EventId);
    }
