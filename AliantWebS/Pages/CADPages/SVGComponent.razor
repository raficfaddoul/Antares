@page "/SVG"
@using AliantWebS.Models
@using AliantWebS.Data
@using AliantWebS.Plan
@using System.Globalization
@using System.Runtime.CompilerServices
@inject IJSRuntime js
@inject AliantWebS.Data.JournalService journal
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider fileVersions

@implements IAsyncDisposable

@*
    The CAD plan. The server draws it from the model - every input first brought into one frame (PlanData), then placed
    and labelled (PlanScene) - and the browser owns the view and the mouse (wwwroot/js/svg-plan.js): pan, zoom, full page,
    hover, tooltips, the rubber band, snapping and what counts as a click. The browser tells this component only what means
    something to the page: a line drawn, an element or a sensor clicked, a point placed. See the module's header for the
    attributes it reads here.
*@

<style>
    .toolbar-button {
        width: 30px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .plan-host {
        position: relative;
        width: 100%;
        height: 100%;
    }

    /* Full page: data-full-page is the browser's, set while the plan fills the window. Over the page and its bars (the
       conception layout's top row is 1000 too, but comes earlier in the page), under what must stay in sight: Radzen's
       dialogs (1001) and notifications (1002), the reload bar (1100), the alarm-failure banners (2000) and the plan's own
       tooltip (2000). */
    .plan-host[data-full-page] {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: #fff;
    }

    .plan-host:not([data-full-page]) [data-plan-action="leave-full-page"],
    .plan-host[data-full-page] [data-plan-action="full-page"] {
        display: none;
    }
</style>

@{
    var scene = BuildScene();
}

<div class="plan-host" @ref="hostRef">
    @* The viewBox is the one of the first render and never changes here: from then on the browser owns the view. *@
    <svg @ref="svgRef" class="plan-svg" width="100%" height="100%" viewBox="@initialViewBox"
         data-mode="@ModeAttribute"
         data-snap-nodes="@Bool(isSnappingEnabled)"
         data-snap-mothers="@Bool(isMotherGridsSnappingEnabled)"
         data-snap-palonniers="@Bool(isPalonniersSnappingEnabled)"
         data-sensors-clickable="@Bool(IsSensorSelectionEnabled)"
         data-extent="@Numbers(scene.Extent.X, scene.Extent.Y, scene.Extent.Width, scene.Extent.Height)"
         data-study="@Numbers(scene.SvgToStudy.ToArray())"
         data-snap-distance="@Fmt(scene.SnapDistance)"
         style="display: block; user-select: none; touch-action: pinch-zoom;">

        @* Inside the svg so the JPG export, which draws a copy of the svg on its own, keeps it. Scoped by .plan-svg. *@
        <style>
            .plan-svg { cursor: default; }
            .plan-svg[data-mode="view"], .plan-svg[data-mode="select"] { cursor: grab; }
            .plan-svg[data-mode="place"] { cursor: crosshair; }
            .plan-svg[data-mode="select"] [data-charge-key],
            .plan-svg[data-sensors-clickable="true"] [data-sensor-key] { cursor: pointer; }
            .plan-svg[data-panning], .plan-svg[data-panning] * { cursor: grabbing; }
            .plan-svg .plan-mark { transform: scale(var(--plan-mark, 1)); }
            .plan-svg .plan-element[data-kind="palonnier"][data-hover]:not([data-selected]) .plan-line { stroke: #aaccff; stroke-width: 3px; }
            .plan-svg .plan-element[data-kind="mother"][data-hover]:not([data-selected]) .plan-line { stroke: #ffaaaa; stroke-width: 3px; }
        </style>

        @* Markers, symbols and their text sit in a .plan-mark group: drawn in CSS pixels, scaled by --plan-mark, which the
           browser sets on .plan-root at every zoom, so they keep one size on the screen. The picture and the grid labels
           over its own grow with the plan. Layer groups (class="dxf-layer-*") let the JPG export leave out what the dialog
           unticks. *@
        <g class="plan-root">

            <g class="dxf-layer-background">
                <image href="@PlanView.BackgroundImage" x="0" y="0"
                       width="@PlanView.ImageWidthPx" height="@PlanView.ImageHeightPx"
                       preserveAspectRatio="none"
                       transform="@scene.ImageTransform" />
            </g>

            @* Beam letters and point numbers, upright, over the picture's own. Kept in every export. *@
            <g class="plan-grid-labels" style="pointer-events: none;">
                @foreach (var label in scene.GridLabels)
                {
                    <g transform="translate(@Fmt(label.X), @Fmt(label.Y))">
                        <circle cx="0" cy="0" r="@Fmt(PlanView.LabelRadius)" fill="white" stroke="#1e88e5" stroke-width="0.8" />
                        <text x="0" y="0" font-size="6.5" font-weight="bold" fill="#1a1a1a" text-anchor="middle"
                              dominant-baseline="central" font-family="Arial, Helvetica, sans-serif">@label.Text</text>
                    </g>
                }
            </g>

            @* Mothers and palonniers: a wide transparent line to hover for the title, and the line itself, which the browser
               reads to pick and snap. Hover is the browser's (data-hover), selection the page's (data-selected). *@
            <g class="dxf-layer-palonniers">
                @foreach (var segment in scene.Palonniers)
                {
                    var selected = segment.Source == SelectedPalonnier;
                    <g class="plan-element" data-kind="palonnier" data-key="@KeyOf(segment.Source)" data-selected="@(selected ? "" : null)">
                        <title>@segment.Title</title>
                        <line class="plan-hit" x1="@Fmt(segment.X1)" y1="@Fmt(segment.Y1)" x2="@Fmt(segment.X2)" y2="@Fmt(segment.Y2)"
                              stroke="transparent" stroke-width="10" vector-effect="non-scaling-stroke" />
                        <line class="plan-line" x1="@Fmt(segment.X1)" y1="@Fmt(segment.Y1)" x2="@Fmt(segment.X2)" y2="@Fmt(segment.Y2)"
                              stroke="@(selected ? "#99bbff" : "#4488ff")" stroke-width="@(selected ? "4" : "2")"
                              vector-effect="non-scaling-stroke" />
                    </g>
                }
            </g>

            <g class="dxf-layer-mothergrids">
                @foreach (var segment in scene.MotherGrids)
                {
                    var selected = segment.Source == SelectedMotherGrid;
                    <g class="plan-element" data-kind="mother" data-key="@KeyOf(segment.Source)" data-selected="@(selected ? "" : null)">
                        <title>@segment.Title</title>
                        <line class="plan-hit" x1="@Fmt(segment.X1)" y1="@Fmt(segment.Y1)" x2="@Fmt(segment.X2)" y2="@Fmt(segment.Y2)"
                              stroke="transparent" stroke-width="10" vector-effect="non-scaling-stroke" />
                        <line class="plan-line" x1="@Fmt(segment.X1)" y1="@Fmt(segment.Y1)" x2="@Fmt(segment.X2)" y2="@Fmt(segment.Y2)"
                              stroke="@(selected ? "#ff8888" : "#cc2222")" stroke-width="@(selected ? "4" : "2")"
                              vector-effect="non-scaling-stroke" />
                    </g>
                }
            </g>

            @* The charpente points drawing snaps to (data-node). Drawn under every marker, so a charpente load keeps its colour
               over its point; they let the mouse through to a load on the same point, and its tooltip. *@
            <g class="plan-nodes" style="pointer-events: none;">
                @foreach (var node in scene.Nodes)
                {
                    <g transform="translate(@Fmt(node.X), @Fmt(node.Y))" data-node="@node.Key" data-x="@Fmt(node.X)" data-y="@Fmt(node.Y)">
                        <g class="plan-mark">
                            <circle cx="0" cy="0" r="5" fill="red" />
                        </g>
                    </g>
                }
            </g>

            <g class="dxf-layer-intersections">
                @foreach (var dot in scene.Intersections)
                {
                    @* Dark slate, not red: on this plan red means a point loaded past its capacity. Drawn under the charpente
                       loads and the selected palonnier's hanging marks, which can sit on the same points. *@
                    <g transform="translate(@Fmt(dot.X), @Fmt(dot.Y))">
                        <g class="plan-mark">
                            <circle cx="0" cy="0" r="4.5" fill="#37474f" stroke="white" stroke-width="1.5" opacity="0.9">
                                <title>@dot.Title</title>
                            </circle>
                        </g>
                    </g>
                }
            </g>

            @* Where the selected palonnier hangs, as the page computed it (HangingMarks): a green dot where it is hooked, a
               red cross where it crosses a mother without being hooked, each inside a ring of its colour. Drawn over the
               intersections and under the charpente loads, which can sit on the same points (a crossing at a column line
               is a charpente point): there the load's disc covers the dot and keeps its colour and tooltip, and the ring,
               wider than the disc, still shows around it and gives the mark's tooltip. Under the scenic and carried loads
               too, so a load's symbol stays clickable. An editing aid, left out of every export. *@
            <g class="plan-editing-only">
                @foreach (var hang in scene.HangingMarks)
                {
                    var hangColor = hang.Hooked ? "#1e9e4a" : "#d11a2a";
                    <g transform="translate(@Fmt(hang.X), @Fmt(hang.Y))">
                        <g class="plan-mark">
                            <title>@hang.Title</title>
                            <circle cx="0" cy="0" r="13" fill="none" stroke="white" stroke-width="5" />
                            <circle cx="0" cy="0" r="13" fill="none" stroke="@hangColor" stroke-width="3" />
                            @if (hang.Hooked)
                            {
                                <circle cx="0" cy="0" r="6" fill="@hangColor" stroke="white" stroke-width="1.5" />
                            }
                            else
                            {
                                <circle cx="0" cy="0" r="6" fill="white" stroke="@hangColor" stroke-width="2" />
                                <line x1="-4" y1="-4" x2="4" y2="4" stroke="@hangColor" stroke-width="2" />
                                <line x1="-4" y1="4" x2="4" y2="-4" stroke="@hangColor" stroke-width="2" />
                            }
                        </g>
                    </g>
                }
            </g>

            @* Loads on the charpente points, from the load calculation (PlanScene.CharpenteLoadStyle): green, yellow, red by
               load over capacity; grey without a capacity on record; blue for a point being lifted; a thick dark ring when
               the point needs attention. A white disc under each keeps its edge and ring visible over the picture's own
               black point symbols; the value is dark on a white halo, readable whatever the colour. Drawn over the snap
               points and the hanging marks. No layer class: always in the JPG. *@
            <g class="plan-charpente-loads">
                @foreach (var load in scene.CharpenteLoads)
                {
                    <g transform="translate(@Fmt(load.X), @Fmt(load.Y))"
                       data-tip-title="@load.TipTitle" data-tip="@load.Tip" data-tip-color="@load.Color">
                        <g class="plan-mark">
                            <circle cx="0" cy="0" r="@(load.Overloaded ? "10.5" : "9.5")" fill="white" />
                            <circle cx="0" cy="0" r="8" fill="@load.Color"
                                    stroke="@(load.Overloaded ? "#7f0000" : "#424242")" stroke-width="@(load.Overloaded ? "3" : "1")" />
                            @* x 16: clear of a hanging mark's ring (r 13, stroke 3), which the halo would otherwise cut. *@
                            <text x="16" y="5" font-size="12" font-weight="bold" fill="#1a1a1a" font-family="Arial, Helvetica, sans-serif"
                                  stroke="white" stroke-width="3" paint-order="stroke">@load.Value</text>
                        </g>
                    </g>
                }
            </g>

            @* Point0 is the SVG origin. The axes belong to the beams, not to the screen (PlanView): X - along the beams,
               towards point 9 - points UP, and Y - across them, towards J - points LEFT. Drawn over the charpente loads, with a
               white halo on its text: Point0 is usually a charpente point (E5), often a loaded one. *@
            <g class="dxf-layer-origin" style="pointer-events: none;">
                <g class="plan-mark">
                    <line x1="0" y1="0" x2="0" y2="-20" stroke="#2255cc" stroke-width="1.5" />
                    <polygon points="0,-20 -3,-15 3,-15" fill="#2255cc" />
                    <text x="3" y="-23" font-size="8" fill="#2255cc" font-weight="bold" font-family="monospace"
                          stroke="white" stroke-width="2.5" paint-order="stroke">X</text>

                    <line x1="0" y1="0" x2="-20" y2="0" stroke="#cc2222" stroke-width="1.5" />
                    <polygon points="-20,0 -15,-3 -15,3" fill="#cc2222" />
                    <text x="-30" y="-3" font-size="8" fill="#cc2222" font-weight="bold" font-family="monospace"
                          stroke="white" stroke-width="2.5" paint-order="stroke">Y</text>

                    <circle cx="0" cy="0" r="3" fill="black" />
                    <text x="5" y="-5" font-size="8" fill="black" font-weight="bold" font-family="monospace"
                          stroke="white" stroke-width="2.5" paint-order="stroke">(0, 0)</text>
                </g>
            </g>

            @* Scenic loads. Symbol and value show the tooltip; a press on either pans or draws, as anywhere on the plan. *@
            <g class="dxf-layer-charges">
                @foreach (var load in scene.ScenicLoads)
                {
                    <g transform="translate(@Fmt(load.X), @Fmt(load.Y))"
                       data-tip-title="@load.TipTitle" data-tip="@load.Tip" data-tip-color="@load.Color">
                        <g class="plan-mark">
                            <rect x="-7" y="-21" width="14" height="28" fill="transparent" />
                            <line x1="0" y1="-20" x2="0" y2="-5" stroke="@load.Color" stroke-width="2" />
                            <polygon points="0,-5 -4,-10 4,-10" fill="@load.Color" stroke="@load.Color" stroke-width="1" />
                            <circle cx="0" cy="0" r="6" fill="@load.Color" stroke="white" stroke-width="1.5" opacity="0.85" />
                            <text x="8" y="-12" font-size="11" font-weight="bold" fill="@load.Color" font-family="Arial, Helvetica, sans-serif"
                                  stroke="white" stroke-width="0.5" paint-order="stroke">@load.Value</text>
                        </g>
                    </g>
                }
            </g>

            @* Loads on palonniers, and on the mothers they hang from directly. In Select mode a click on the symbol
               (data-charge-key) selects the load; anywhere else it is part of the plan. *@
            <g class="dxf-layer-palonnierloads">
                @foreach (var load in scene.CarriedLoads)
                {
                    var selected = load.Source == SelectedCharge;
                    <g transform="translate(@Fmt(load.X), @Fmt(load.Y))"
                       data-tip-title="@load.TipTitle" data-tip="@load.Tip" data-tip-color="@load.Color">
                        <g class="plan-mark">
                            <g data-charge-key="@KeyOf(load.Source)">
                                <rect x="-7" y="-21" width="14" height="28" fill="transparent" />
                                <line x1="0" y1="-20" x2="0" y2="-5" stroke="@load.Color" stroke-width="2" />
                                <polygon points="0,-5 -4,-10 4,-10" fill="@load.Color" stroke="@load.Color" stroke-width="1" />
                                @if (selected)
                                {
                                    <circle cx="0" cy="0" r="10" fill="none" stroke="yellow" stroke-width="2.5" />
                                }
                                <circle cx="0" cy="0" r="6" fill="@load.Color"
                                        stroke="@(selected ? "yellow" : "white")" stroke-width="@(selected ? "2.5" : "1.5")"
                                        opacity="0.8" />
                            </g>
                            <text x="8" y="-12" font-size="11" font-weight="bold" fill="@load.Color" font-family="Arial, Helvetica, sans-serif"
                                  stroke="white" stroke-width="0.5" paint-order="stroke">@load.Value</text>
                        </g>
                    </g>
                }
            </g>

            @* Sensors, coloured by their charge ratio, with the status drawn over them. A click on one reaches the page only
               where the page allows it (data-sensors-clickable). *@
            <g class="dxf-layer-sensors">
                @foreach (var sensor in scene.Sensors)
                {
                    var selected = sensor.Source == selectedSensor;
                    <g transform="translate(@Fmt(sensor.X), @Fmt(sensor.Y))">
                        <g class="plan-mark">
                            <g class="sensor-marker" data-sensor-key="@KeyOf(sensor.Source)">
                                <circle r="8" fill="@(selected ? "#ff4444" : PlanScene.SensorFill(sensor.Ratio))"
                                        stroke="white" stroke-width="2" opacity="0.9">
                                    <title>@sensor.Title</title>
                                </circle>
                                <circle r="12" fill="none" stroke="@(selected ? "#ff4444" : PlanScene.SensorStroke(sensor.Ratio))"
                                        stroke-width="1" opacity="0.5" style="pointer-events: none;" />
                                <text x="16" y="5" font-size="11" font-weight="500" fill="#333" font-family="Arial, Helvetica, sans-serif" stroke="white" stroke-width="0.5"
                                      paint-order="stroke" style="pointer-events: none;">@sensor.Name</text>
                            </g>
                            @if (sensor.Statut == "Panne")
                            {
                                <g style="pointer-events: none;">
                                    <polygon points="0,-9 9,7 -9,7" fill="#e53935" stroke="white" stroke-width="1" />
                                    <text x="0" y="5" font-size="11" font-weight="bold" text-anchor="middle" fill="white" font-family="Arial, Helvetica, sans-serif">!</text>
                                    <title>@sensor.Name — Panne</title>
                                </g>
                            }
                            else if (sensor.Statut == "Inactif")
                            {
                                <g style="pointer-events: none;">
                                    <line x1="-7" y1="-7" x2="7" y2="7" stroke="white" stroke-width="4" stroke-linecap="round" />
                                    <line x1="-7" y1="-7" x2="7" y2="7" stroke="#555555" stroke-width="2" stroke-linecap="round" />
                                    <title>@sensor.Name — Inactif</title>
                                </g>
                            }
                        </g>
                    </g>
                }
            </g>

            @* The browser's own drawing - the rubber band - goes here; the server leaves it empty. *@
            <g class="plan-overlay"></g>
        </g>
    </svg>

    @* ── Toolbar ── *@
    <div style="position: absolute; top: 10px; right: 10px; display: flex; flex-direction: column; gap: 4px; z-index: 10;
                background: rgba(255,255,255,0.75); border-radius: 6px; padding: 4px; backdrop-filter: blur(4px);">
        @* The plan over the whole window, and back (or Esc), handled by the browser; the style above shows one of the two. *@
        <button type="button" class="toolbar-button" data-plan-action="full-page" title="Full page">
            <i class="fas fa-expand"></i>
        </button>
        <button type="button" class="toolbar-button" data-plan-action="leave-full-page" title="Leave full page (Esc)">
            <i class="fas fa-compress"></i>
        </button>
        <button type="button" class="toolbar-button" data-plan-action="fit" title="Zoom to Extent">
            <i class="fas fa-vector-square"></i>
        </button>
        @if (Edits)
        {
            <button type="button" class="toolbar-button" @onclick="ToggleSnapping" title="Toggle Node Snapping"
                    style="background-color: @(isSnappingEnabled ? "green" : "gray");">
                <i class="fas fa-magnet"></i>
            </button>
            <button type="button" class="toolbar-button" @onclick="TogglePSnapping" title="Toggle Palonniers Snapping"
                    style="background-color: @(isPalonniersSnappingEnabled ? "green" : "gray");">
                P<i class="fas fa-magnet"></i>
            </button>
            <button type="button" class="toolbar-button" @onclick="ToggleMSnapping" title="Toggle Mothergrids Snapping"
                    style="background-color: @(isMotherGridsSnappingEnabled ? "green" : "gray");">
                M<i class="fas fa-magnet"></i>
            </button>
            <button type="button" class="toolbar-button" @onclick="ToggleSelecting" title="Selection"
                    style="background-color: @(Mode == PlanMode.Select ? "green" : "gray");">
                <i class="fas fa-mouse-pointer"></i>
            </button>
            <button type="button" class="toolbar-button" @onclick="EraseSelected" title="Erase Selected"
                    style="background-color: red; color: white;">
                <i class="fas fa-eraser"></i>
            </button>
        }
        @* ── DXF export buttons ── *@
        <button type="button" class="toolbar-button" @onclick="OpenDxfSettings" title="DXF Export Settings"
                style="background-color: #555; color: white;">
            <i class="fas fa-cog"></i>
        </button>
        <button type="button" class="toolbar-button" @onclick="ExportDxf" title="Export to DXF"
                style="background-color: #1565C0; color: white;">
            <i class="fas fa-file-export"></i>
        </button>
    </div>

    @* ── DXF Settings Modal ── *@
    @if (showDxfSettings)
    {
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                    background: rgba(0,0,0,0.45); z-index: 100; display: flex; align-items: center; justify-content: center;"
             @onclick="CloseDxfSettings">
            <div id="@DialogId"
                 style="background: white; border-radius: 10px; padding: 24px; min-width: 300px; box-shadow: 0 4px 24px rgba(0,0,0,0.3);"
                 @onclick:stopPropagation="true">
                <h5 id="@(DialogId)-header" style="margin-bottom: 16px; font-weight: bold;"
                    title="Glisser pour déplacer">
                    <i class="fas fa-arrows-alt" style="color:#9aa2b1; margin-right:6px;"></i>
                    <i class="fas fa-file-export"></i> DXF Export Settings
                </h5>

                @* ── File name ── *@
                <div style="margin-bottom: 14px;">
                    <label style="font-size:13px; font-weight:600; display:block; margin-bottom:4px;">File name</label>
                    <div style="display:flex; align-items:center; gap:4px;">
                        <input type="text" @bind="dxfExportFileName" data-plan-file-name
                               style="flex:1; padding:4px 8px; border:1px solid #ccc; border-radius:4px; font-size:13px;"
                               placeholder="export" />
                        <span style="font-size:13px; color:#666;">.dxf</span>
                    </div>
                </div>

                @* ── Layer selection: data-plan-layer names the layer group the JPG export leaves out when unticked ── *@
                <div style="display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="checkbox" data-plan-layer="dxf-layer-mothergrids" @bind="dxfExportMotherGrid" /> Mother Grids
                    </label>
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="checkbox" data-plan-layer="dxf-layer-palonniers" @bind="dxfExportPalonniers" /> Palonniers
                    </label>
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="checkbox" data-plan-layer="dxf-layer-charges" @bind="dxfExportCharges" /> Charges Scéniques
                    </label>
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="checkbox" data-plan-layer="dxf-layer-palonnierloads" @bind="dxfExportPalonnierLoads" /> Palonnier Loads
                    </label>
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="checkbox" data-plan-layer="dxf-layer-intersections" @bind="dxfExportIntersections" /> Intersection Points
                    </label>
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="checkbox" data-plan-layer="dxf-layer-sensors" @bind="dxfExportSensors" /> Sensors
                    </label>
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="checkbox" data-plan-layer="dxf-layer-origin" @bind="dxfExportOrigin" /> Origin / Axes
                    </label>
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;"
                           title="DXF: image linked by path (keep the .jpg next to the .dxf). JPG: drawn into the picture.">
                        <input type="checkbox" data-plan-layer="dxf-layer-background" @bind="dxfExportBackgroundImage" /> Background Picture
                    </label>
                    @if (dxfExportBackgroundImage)
                    {
                        <div style="font-size:11px; color:#666; margin:-4px 0 0 26px; line-height:1.4;">
                            Le DXF référence l'image par son nom : deux fenêtres
                            « Enregistrer sous » s'ouvrent — le .dxf puis le .jpg, qui se place
                            par défaut dans le même dossier. Gardez les deux côte à côte.
                        </div>
                    }
                </div>

                <div style="display:flex; gap:8px; margin-top: 20px; justify-content: flex-end;">
                    <button type="button" class="btn btn-secondary btn-sm" data-plan-action="close-dialog" @onclick="CloseDxfSettings">Cancel</button>
                    @* Handled by the browser module inside the click: the Save As picker needs the click's user activation,
                       which a round trip to the server would expire. The name and the layers are read from the dialog as it
                       is on the screen (data-plan-file-name, data-plan-layer). *@
                    <button type="button" class="btn btn-info btn-sm" style="color:white;"
                            data-plan-action="export-jpg">
                        <i class="fas fa-image"></i> Export JPG
                    </button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="ExportDxfAndClose">
                        <i class="fas fa-download"></i> Export DXF
                    </button>
                </div>
            </div>
        </div>
    }

    @* The mouse's position in the studies' axes, written by the browser; the server leaves it empty. *@
    <div class="plan-readout" style="position: absolute; bottom: 10px; left: 10px; z-index: 10;
         background: rgba(255,255,255,0.75); border-radius: 4px; padding: 2px 8px;
         font-size: 11px; font-family: monospace; pointer-events: none;"></div>
</div>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private static string Fmt(double value) => value.ToString(Inv);
    private static string Bool(bool value) => value ? "true" : "false";
    private static string Numbers(params double[] values) => string.Join(" ", values.Select(Fmt));

    // ── What the page says ────────────────────────────────────────────────────────────────────

    /// <summary>What a press on the plan does. Nothing is inferred from the callbacks bound: a page that draws says Draw. A
    /// page offering both Draw and Select binds it (@bind-Mode): the toolbar's Selection button switches between the two.</summary>
    [Parameter] public PlanMode Mode { get; set; } = PlanMode.View;
    [Parameter] public EventCallback<PlanMode> ModeChanged { get; set; }

    /// <summary>A line drawn in Draw mode: the grid's axes, metres from Point0 - how element ends are stored. Lines of
    /// 500 mm or less are not reported.</summary>
    [Parameter] public EventCallback<(double x1, double y1, double x2, double y2)> LineDrawn { get; set; }

    [Parameter] public EventCallback<MotherGridPalonnier> OnErase { get; set; }

    /// <summary>A point clicked in PlaceSensor mode: absolute millimetres in the grid's axes, as sensor positions are
    /// stored. A click on an existing sensor is that sensor's (OnSensorClicked), not a placement.</summary>
    [Parameter] public EventCallback<PlanPoint> PointPlaced { get; set; }

    [Parameter] public EventCallback<Element> OnSensorClicked { get; set; }

    /// <summary>Sensor markers are clickable (OnSensorClicked).</summary>
    [Parameter] public bool IsSensorSelectionEnabled { get; set; }

    // ── What the plan shows ───────────────────────────────────────────────────────────────────

    /// <summary>Sensors, placed by their X/Y attributes: absolute millimetres in the grid's axes.</summary>
    [Parameter] public List<Element> Sensors { get; set; }

    [Parameter] public List<MotherGridPalonnier> MotherGrids { get; set; }

    [Parameter] public List<MotherGridPalonnier> Palonniers { get; set; }

    [Parameter] public Dictionary<Guid, List<(double X, double Y)>> IntersectionPoints { get; set; } = new();

    /// <summary>Charpente point name (e.g. "E5") → load in kilograms.</summary>
    [Parameter] public Dictionary<string, double> CharpenteLoads { get; set; } = new();

    /// <summary>The venue load book by TCharpente name (points "E5", beam totals "E10"), in kilograms, for the charpente
    /// loads' colours and tooltips (PlanData.CapacitiesOf).</summary>
    [Parameter] public Dictionary<string, double> CharpenteCapacities { get; set; } = new();

    [Parameter] public List<ChargesScenique> ChargesSceniques { get; set; }

    /// <summary>Loads on palonniers, and on mothers they hang from directly.</summary>
    [Parameter] public List<ChargeMp> PalonnierLoads { get; set; }

    /// <summary>Sensor ElementId → its charge ratio (0 to 1 and beyond), for the markers' colour.</summary>
    [Parameter] public Dictionary<Guid, double> SensorChargeRatios { get; set; } = new();

    /// <summary>Where the selected palonnier hangs (PlanHangingMarks.For), drawn as an editing aid.</summary>
    [Parameter] public IReadOnlyList<PlanHangingMark> HangingMarks { get; set; }

    /// <summary>The event's origin, absolute metres in the grid's axes. The plan is drawn relative to it.</summary>
    [Parameter] public double Point0X { get; set; }

    [Parameter] public double Point0Y { get; set; }

    [Parameter] public MotherGridPalonnier SelectedPalonnier { get; set; }
    [Parameter] public EventCallback<MotherGridPalonnier> SelectedPalonnierChanged { get; set; }
    [Parameter] public MotherGridPalonnier SelectedMotherGrid { get; set; }
    [Parameter] public EventCallback<MotherGridPalonnier> SelectedMotherGridChanged { get; set; }
    [Parameter] public ChargeMp SelectedCharge { get; set; }
    [Parameter] public EventCallback<ChargeMp> SelectedChargeChanged { get; set; }

    // ── Drawing data, written to the DRAWING_DATA layer of the exported DXF ───────────────────

    [Parameter] public string EventName { get; set; }
    [Parameter] public Guid? EventId { get; set; }
    [Parameter] public string ScenarioName { get; set; }
    [Parameter] public Guid? ScenarioId { get; set; }
    [Parameter] public string StructureName { get; set; }

    /// <summary>Page the export was launched from, recorded in the DXF drawing data.</summary>
    [Parameter] public string ModuleName { get; set; }

    // ── State ─────────────────────────────────────────────────────────────────────────────────

    private ElementReference hostRef, svgRef;

    // Fitted to the Point0 of the first render. The browser refits when Point0 arrives or changes (data-extent).
    private string initialViewBox = "";

    // Ids of this plan's dialog, unique on the page.
    private readonly string instance = Guid.NewGuid().ToString("N")[..8];
    private string DialogId => $"plan-{instance}-dxf";

    private bool isSnappingEnabled;
    private bool isMotherGridsSnappingEnabled;
    private bool isPalonniersSnappingEnabled;

    private Element selectedSensor;

    private IJSObjectReference module, controller;
    private DotNetObjectReference<SVGComponent> selfRef;
    private bool disposed;

    private string ModeAttribute => Mode switch
    {
        PlanMode.Draw => "draw",
        PlanMode.Select => "select",
        PlanMode.PlaceSensor => "place",
        _ => "view",
    };

    // The toolbar's editing buttons belong to Draw and Select.
    private bool Edits => Mode is PlanMode.Draw or PlanMode.Select;

    protected override void OnInitialized()
    {
        var (x, y, w, h) = PlanView.Extent(Point0X, Point0Y);
        initialViewBox = Numbers(x, y, w, h);
    }

    /// <summary>Draws the plan again, for a page that changed the lists it passed without passing new ones.</summary>
    public async Task RefreshVisualization()
    {
        await InvokeAsync(StateHasChanged);
    }

    // ── Keys: how the browser names what it clicked or snapped to ─────────────────────────────
    // A key per object, stable while the object lives, so a click on the page as drawn a moment ago still finds the
    // row; the map is rebuilt at every render, so a row no longer drawn is not found.

    private readonly ConditionalWeakTable<object, string> keys = new();
    private readonly Dictionary<string, object> keyed = new();
    private int lastKey;

    private string KeyOf(object source)
    {
        var key = keys.GetValue(source, _ => "k" + (++lastKey).ToString(Inv));
        keyed[key] = source;
        return key;
    }

    private object Keyed(string key) => key != null && keyed.TryGetValue(key, out var source) ? source : null;

    private PlanData Data() => new()
    {
        Point0X = Point0X,
        Point0Y = Point0Y,
        MotherGrids = MotherGrids ?? new List<MotherGridPalonnier>(),
        Palonniers = Palonniers ?? new List<MotherGridPalonnier>(),
        IntersectionPoints = IntersectionPoints ?? new Dictionary<Guid, List<(double X, double Y)>>(),
        CharpenteLoads = CharpenteLoads ?? new Dictionary<string, double>(),
        CharpenteCapacities = CharpenteCapacities ?? new Dictionary<string, double>(),
        ChargesSceniques = ChargesSceniques ?? new List<ChargesScenique>(),
        PalonnierLoads = PalonnierLoads ?? new List<ChargeMp>(),
        Sensors = Sensors ?? new List<Element>(),
        SensorChargeRatios = SensorChargeRatios ?? new Dictionary<Guid, double>(),
    };

    // Built at every render: pages change their lists in place, and renders are rare now the browser owns the mouse.
    private PlanScene BuildScene()
    {
        keyed.Clear();
        return PlanScene.Build(Data(), HangingMarks);
    }

    // ── The browser module ────────────────────────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AttachModule();
            await WarnIfModeMissing();
        }

        // The DXF dialog is re-created each time it opens, so wire up dragging on its new element.
        if (showDxfSettings)
        {
            await js.InvokeVoidAsync("makeElementDraggable", DialogId, DialogId + "-header");
        }
    }

    // The component can be disposed at any await below - the page left while the module was loading. Whatever arrives
    // afterwards is released, and nothing is reported as a failure.
    private async Task AttachModule()
    {
        try
        {
            // Versioned, so a browser never keeps an older module (nginx lets .js files be cached for an hour). The
            // "./" path is resolved against the page's base, so a base path (e.g. /Aliant1) keeps working.
            var path = fileVersions.AddFileVersionToPath(default, "/js/svg-plan.js");
            module = await js.InvokeAsync<IJSObjectReference>("import", "." + path);
            if (disposed) return;
            selfRef = DotNetObjectReference.Create(this);
            controller = await module.InvokeAsync<IJSObjectReference>("create", hostRef, svgRef, selfRef);
        }
        catch (Exception ex) when (IsInteropFailure(ex))
        {
            if (!disposed && ex is not JSDisconnectedException)
                await TryConsole("error", "Plan: the interaction module did not load, so the plan cannot be panned, zoomed or drawn on. " + ex.Message);
        }
        finally
        {
            if (disposed) await ReleaseModule();
        }
    }

    // Nothing is inferred from the callbacks a page binds: a page that draws or selects must say so. A page written for the
    // component before Mode existed would otherwise build and quietly lose its drawing.
    private async Task WarnIfModeMissing()
    {
        if (Mode == PlanMode.View && (LineDrawn.HasDelegate || OnErase.HasDelegate || SelectedPalonnierChanged.HasDelegate
                                      || SelectedMotherGridChanged.HasDelegate || SelectedChargeChanged.HasDelegate))
            await TryConsole("warn", "Plan: this page binds drawing or selection callbacks but leaves Mode at View, so nothing can be drawn or selected. Set Mode (e.g. @bind-Mode starting at PlanMode.Draw).");
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        await ReleaseModule();
    }

    // Safe to run twice (DisposeAsync while AttachModule is still waiting): each run takes the references off the fields
    // before its first await, so each releases only what had arrived by then. A controller that arrives later, from a
    // 'create' already under way, is released by AttachModule's finally.
    private async Task ReleaseModule()
    {
        var (releasedController, releasedModule, releasedSelf) = (controller, module, selfRef);
        (controller, module, selfRef) = (null, null, null);

        if (releasedController is not null)
        {
            await Quietly(() => releasedController.InvokeVoidAsync("dispose").AsTask());
            await Quietly(() => releasedController.DisposeAsync().AsTask());
        }
        if (releasedModule is not null)
            await Quietly(() => releasedModule.DisposeAsync().AsTask());
        releasedSelf?.Dispose();
    }

    // The page may be gone: the browser dropped everything with it.
    private static bool IsInteropFailure(Exception ex) =>
        ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException;

    private static async Task Quietly(Func<Task> interop)
    {
        try { await interop(); }
        catch (Exception ex) when (IsInteropFailure(ex)) { }
    }

    private Task TryConsole(string level, string message) => Quietly(() => js.InvokeVoidAsync("console." + level, message).AsTask());

    /// <summary>One end of a line drawn in the browser: where it is (SVG units), and what it snapped to, if anything - a
    /// charpente point ("node", its name) or a mother's or palonnier's end ("mother"/"palonnier", its key, end 1 or 2).</summary>
    public sealed record PlanDrawEnd(double X, double Y, string SnapKind, string SnapKey, int SnapEnd);

    private const double MinLineMm = 500;

    [JSInvokable]
    public Task OnPlanLineDrawn(PlanDrawEnd start, PlanDrawEnd end) => InvokeAsync(async () =>
    {
        if (Mode != PlanMode.Draw || start is null || end is null) return;

        var data = Data();
        var a = StoredEnd(data, start);
        var b = StoredEnd(data, end);
        if (Math.Sqrt(Math.Pow(b.X - a.X, 2) + Math.Pow(b.Y - a.Y, 2)) * PlanView.MmPerM <= MinLineMm) return;

        await LineDrawn.InvokeAsync((a.X, a.Y, b.X, b.Y));
    });

    // An end in the stored frame. A snapped end takes the exact position of what it snapped to, as stored, rather than
    // its position read back from the screen.
    private (double X, double Y) StoredEnd(PlanData data, PlanDrawEnd end)
    {
        if (end.SnapKind == "node" && data.TryCharpentePoint(end.SnapKey, out var nodeX, out var nodeY))
            return (nodeX, nodeY);
        if (end.SnapKind is "mother" or "palonnier" && Keyed(end.SnapKey) is MotherGridPalonnier element
            && PlanData.TryEnds(element, out var ends))
            return end.SnapEnd == 2 ? (ends.X2, ends.Y2) : (ends.X1, ends.Y1);
        return PlanView.SvgToStored(end.X, end.Y);
    }

    [JSInvokable]
    public Task OnPlanElementClicked(string kind, string key) => InvokeAsync(async () =>
    {
        if (Mode != PlanMode.Select) return;

        var source = Keyed(key);
        switch (kind)
        {
            case "palonnier" when source is MotherGridPalonnier palonnier:
                await SelectedPalonnierChanged.InvokeAsync(palonnier);
                break;
            case "mother" when source is MotherGridPalonnier mother:
                await SelectedMotherGridChanged.InvokeAsync(mother);
                break;
            case "charge" when source is ChargeMp charge:
                await SelectedChargeChanged.InvokeAsync(charge);
                await SelectedPalonnierChanged.InvokeAsync(null);
                await SelectedMotherGridChanged.InvokeAsync(null);
                break;
            case "none":
                // Away from every element: nothing stays selected, so "Erase Selected" has nothing to erase.
                await SelectedPalonnierChanged.InvokeAsync(null);
                await SelectedMotherGridChanged.InvokeAsync(null);
                break;
        }
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnPlanSensorClicked(string key) => InvokeAsync(async () =>
    {
        if (!IsSensorSelectionEnabled || Keyed(key) is not Element sensor) return;
        selectedSensor = sensor;
        StateHasChanged();
        await OnSensorClicked.InvokeAsync(sensor);
    });

    [JSInvokable]
    public Task OnPlanPointPlaced(double x, double y) => InvokeAsync(async () =>
    {
        if (Mode != PlanMode.PlaceSensor) return;
        var (xMm, yMm) = PlanView.FromSvg(x, y, Point0X, Point0Y);
        await PointPlaced.InvokeAsync(new PlanPoint(xMm, yMm));
    });

    // ── Toolbar ───────────────────────────────────────────────────────────────────────────────

    private void ToggleSnapping() => isSnappingEnabled = !isSnappingEnabled;
    private void TogglePSnapping() => isPalonniersSnappingEnabled = !isPalonniersSnappingEnabled;
    private void ToggleMSnapping() => isMotherGridsSnappingEnabled = !isMotherGridsSnappingEnabled;

    private Task ToggleSelecting() => ModeChanged.InvokeAsync(Mode == PlanMode.Select ? PlanMode.Draw : PlanMode.Select);

    private async Task EraseSelected()
    {
        var toErase = SelectedPalonnier ?? SelectedMotherGrid;
        if (toErase != null)
        {
            await OnErase.InvokeAsync(toErase);
            if (SelectedPalonnier != null)
                await SelectedPalonnierChanged.InvokeAsync(null);
            else
                await SelectedMotherGridChanged.InvokeAsync(null);
        }
    }

    // ── Export ────────────────────────────────────────────────────────────────────────────────

    private bool showDxfSettings = false;
    private bool dxfExportMotherGrid = true;
    private bool dxfExportPalonniers = true;
    private bool dxfExportCharges = true;
    private bool dxfExportPalonnierLoads = true;
    private bool dxfExportIntersections = true;
    private bool dxfExportSensors = true;
    private bool dxfExportOrigin = true;
    private bool dxfExportBackgroundImage = false;
    private string dxfExportFileName = "export";

    private void OpenDxfSettings() => showDxfSettings = true;
    private void CloseDxfSettings() => showDxfSettings = false;

    private async Task ExportDxfAndClose()
    {
        showDxfSettings = false;
        await ExportDxf();
    }

    private async Task ExportDxf()
    {
        var content = PlanDxfExporter.Write(Data(),
            new PlanDxfOptions
            {
                MotherGrids = dxfExportMotherGrid,
                Palonniers = dxfExportPalonniers,
                Charges = dxfExportCharges,
                PalonnierLoads = dxfExportPalonnierLoads,
                Intersections = dxfExportIntersections,
                Sensors = dxfExportSensors,
                Origin = dxfExportOrigin,
                BackgroundImage = dxfExportBackgroundImage,
            },
            new PlanDxfInfo
            {
                ModuleName = ModuleName,
                StructureName = StructureName,
                EventName = EventName,
                EventId = EventId,
                ScenarioName = ScenarioName,
                ScenarioId = ScenarioId,
                ExportedAt = DateTime.Now,
            });

        var fileName = string.IsNullOrWhiteSpace(dxfExportFileName) ? "export" : dxfExportFileName.Trim();
        if (fileName.EndsWith(".dxf", StringComparison.OrdinalIgnoreCase))
            fileName = fileName[..^4];

        if (dxfExportBackgroundImage)
        {
            // The DXF only references the picture by name, so ship the .jpg alongside it —
            // otherwise CAD opens the drawing with an empty image frame.
            await js.InvokeVoidAsync("downloadDxfWithImage", $"{fileName}.dxf", content, PlanView.BackgroundImage, PlanView.BackgroundImage);
        }
        else
        {
            await js.InvokeVoidAsync("downloadTextFile", $"{fileName}.dxf", content);
        }

        await journal.WriteAsync(JournalCategory.Donnees, "export.dxf", $"{fileName}.dxf",
            $"Module {ModuleName}, structure {StructureName}, événement {EventName}"
            + (dxfExportBackgroundImage ? " — avec image de fond" : ""),
            eventId: EventId);
    }
}
