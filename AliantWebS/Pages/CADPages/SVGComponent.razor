@page "/SVG"
@using BlazorSvgEditor
@using BlazorSvgEditor.SvgEditor
@using BlazorSvgEditor.SvgEditor.Misc;
@using BlazorSvgEditor.SvgEditor.Shapes;
@using AliantWebS.Models
@using AliantWebS.Data
@using Microsoft.AspNetCore.Components
@using System.Globalization
@inject IJSRuntime js
@inject AliantWebS.Data.JournalService journal

@implements IAsyncDisposable

<style>
    .toolbar-button {
        width: 30px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<PageTitle>BlazorSvgEditor Demo</PageTitle>

@if (planReady)
{
    <div style="position: relative; width: 100%; height: 100%;">
        <svg id="no-scroll-svg" width="100%" height="100%" viewBox="@viewBox"
             @onmousedown="OnMouseDown"
             @onpointerenter="RefreshSvgRect"
             @onmousemove="OnMouseMove"
             @onmouseup="OnMouseUp"
             @onwheel="OnWheel"
             @onwheel:stopPropagation
             @onwheel:preventDefault
             @onclick="HandleSvgClick"
             style="display: block; cursor: @(isPanning ? "grabbing" : IsPositioningMode ? "crosshair" : "default");">
    
            @* Line 36 - image element *@
    
                @* Layer groups (class="dxf-layer-*") let the export hide what the dialog unticks. *@
                @* The picture draws the grid a quarter turn from the plan (beams vertical, J at the left): it is
                   turned a quarter turn clockwise onto the charpente points, by the measured positions of its own
                   grid lines (PlanView). *@
                <g class="dxf-layer-background">
                    <image href="@PlanView.BackgroundImage" x="0" y="0"
                           width="@PlanView.ImageWidthPx" height="@PlanView.ImageHeightPx"
                           preserveAspectRatio="none"
                           transform="@PlanView.ImageTransform(Point0X, Point0Y)" />
                </g>

                @* Beam letters and point numbers, upright. The picture's own turn on their side with it: the
                   numbers and the right-hand letters are drawn over them. Kept in every export. *@
                <g class="plan-grid-labels" style="pointer-events: none;">
                    @foreach (var label in PlanView.GridLabels)
                    {
                        var at = GetSVGCoordinatesFromReal(new Point(label.GridXmm, label.GridYmm));
                        <g transform="translate(@Fmt(at.X), @Fmt(at.Y))">
                            <circle cx="0" cy="0" r="@Fmt(PlanView.LabelRadius)" fill="white" stroke="#1e88e5" stroke-width="0.8" />
                            <text x="0" y="0" font-size="6.5" font-weight="bold" fill="#1a1a1a" text-anchor="middle"
                                  dominant-baseline="central" font-family="Arial, Helvetica, sans-serif">@label.Text</text>
                        </g>
                    }
                </g>
           
            @* Origin landmark *@
            @{
                var originSvg = GetSVGCoordinatesFromReal(new Point(Point0X * MmToM, Point0Y * MmToM));

            }
            <g class="dxf-layer-origin" transform="translate(@Fmt(originSvg.X), @Fmt(originSvg.Y))" style="pointer-events: none;">
                @* The axes belong to the beams, not to the screen (PlanView): the plan is horizontal, so X - along
                   the beams, towards point 9 - points UP, and Y - across them, towards J - points LEFT. *@

                @* X axis ↑ *@
                <line x1="0" y1="0" x2="0" y2="-20" stroke="#2255cc" stroke-width="1.5" />
                <polygon points="0,-20 -3,-15 3,-15" fill="#2255cc" />
                <text x="3" y="-23" font-size="8" fill="#2255cc" font-weight="bold" font-family="monospace">X</text>

                @* Y axis ← *@
                <line x1="0" y1="0" x2="-20" y2="0" stroke="#cc2222" stroke-width="1.5" />
                <polygon points="-20,0 -15,-3 -15,3" fill="#cc2222" />
                <text x="-30" y="-3" font-size="8" fill="#cc2222" font-weight="bold" font-family="monospace">Y</text>

                @* Origin dot + label *@
                <circle cx="0" cy="0" r="3" fill="black" />
                <text x="5" y="-5" font-size="8" fill="black" font-weight="bold" font-family="monospace">
                    (0, 0)
                </text>
            </g>
                   @if (currentLine != null && isDrawing && !IsPositioningMode)
            {
                <line x1="@Fmt(GetSVGCoordinatesFromReal(currentLine?.Item1).X)"
                      y1="@Fmt(GetSVGCoordinatesFromReal(currentLine?.Item1).Y)"
                      x2="@Fmt(GetSVGCoordinatesFromReal(currentLine?.Item2).X)"
                      y2="@Fmt(GetSVGCoordinatesFromReal(currentLine?.Item2).Y)"
                      stroke="black" stroke-width="2" />
            }

            @foreach (var line in lines)
            {
                <line x1="@Fmt(GetSVGCoordinatesFromReal(line.Item1).X)"
                      y1="@Fmt(GetSVGCoordinatesFromReal(line.Item1).Y)"
                      x2="@Fmt(GetSVGCoordinatesFromReal(line.Item2).X)"
                      y2="@Fmt(GetSVGCoordinatesFromReal(line.Item2).Y)"
                      stroke="black" stroke-width="2" />
            }

            <g class="dxf-layer-palonniers">
            @if (Palonniers != null)
            {
                @foreach (var pal in Palonniers)
                {
                    if ((pal.X1 != null) && (pal.Y1 != null) && (pal.X2 != null) && (pal.Y2 != null))
                    {
                        var p1 = new Point((double)pal.X1 * MmToM + Point0X * MmToM, (double)pal.Y1 * MmToM + Point0Y * MmToM);
                        var p2 = new Point((double)pal.X2 * MmToM + Point0X * MmToM, (double)pal.Y2 * MmToM + Point0Y * MmToM);
                        var svgP1 = GetSVGCoordinatesFromReal(p1);
                        var svgP2 = GetSVGCoordinatesFromReal(p2);
                        <g>
                            <title>@(pal.Name ?? "Palonnier") — @Ends(pal)</title>
                            <line x1="@Fmt(svgP1.X)" y1="@Fmt(svgP1.Y)"
                                  x2="@Fmt(svgP2.X)" y2="@Fmt(svgP2.Y)"
                                  stroke="transparent" stroke-width="10" />
                            <line x1="@Fmt(svgP1.X)" y1="@Fmt(svgP1.Y)"
                                  x2="@Fmt(svgP2.X)" y2="@Fmt(svgP2.Y)"
                                  stroke="@(pal == SelectedPalonnier ? "#99bbff" : pal == hoveredPalonnier ? "#aaccff" : "#4488ff")"
                                  stroke-width="@(pal == SelectedPalonnier ? "4" : pal == hoveredPalonnier ? "3" : "2")" />
                        </g>
                    }
                }
            }
            </g>

            <g class="dxf-layer-mothergrids">
            @if (MotherGrids != null)
            {
                @foreach (var moth in MotherGrids)
                {
                    if ((moth.X1 != null) && (moth.Y1 != null) && (moth.X2 != null) && (moth.Y2 != null))
                    {
                        var p1 = new Point((double)moth.X1 * MmToM + Point0X * MmToM, (double)moth.Y1 * MmToM + Point0Y * MmToM);
                        var p2 = new Point((double)moth.X2 * MmToM + Point0X * MmToM, (double)moth.Y2 * MmToM + Point0Y * MmToM);
                        var svgP1 = GetSVGCoordinatesFromReal(p1);
                        var svgP2 = GetSVGCoordinatesFromReal(p2);
                        <g>
                            <title>@(moth.Name ?? "MotherGrid") — @Ends(moth)</title>
                            <line x1="@Fmt(svgP1.X)" y1="@Fmt(svgP1.Y)"
                                  x2="@Fmt(svgP2.X)" y2="@Fmt(svgP2.Y)"
                                  stroke="transparent" stroke-width="10" />
                            <line x1="@Fmt(svgP1.X)" y1="@Fmt(svgP1.Y)"
                                  x2="@Fmt(svgP2.X)" y2="@Fmt(svgP2.Y)"
                                  stroke="@(moth == SelectedMotherGrid ? "#ff8888" : moth == hoveredMotherGrid ? "#ffaaaa" : "#cc2222")"
                                  stroke-width="@(moth == SelectedMotherGrid ? "4" : moth == hoveredMotherGrid ? "3" : "2")" />
                        </g>
                    }
                }
            }

            </g>

            @* Where the selected palonnier hangs: a green dot where it is hooked, a red cross where it crosses a
               mother without being hooked. An editing aid, left out of every export. *@
            <g class="plan-editing-only">
            @if (SelectedPalonnier is { Famille: false } && MotherGrids != null)
            {
                var hanging = global::Helpers.PalonnierHanging.Resolve(SelectedPalonnier, MotherGrids);
                foreach (var crossing in hanging.Crossings)
                {
                    var at = crossing.HungFrom ?? crossing.Candidates[0];
                    var mark = GetSVGCoordinatesFromReal(new Point(at.X * MmToM + Point0X * MmToM, at.Y * MmToM + Point0Y * MmToM));
                    var why = global::Helpers.PalonnierHanging.DescribeDecision(crossing);
                    if (crossing.Hooked)
                    {
                        <circle cx="@Fmt(mark.X)" cy="@Fmt(mark.Y)" r="6" fill="#1e9e4a" stroke="white" stroke-width="1.5">
                            <title>Accroché à @(at.Mother.Name) — @why</title>
                        </circle>
                    }
                    else
                    {
                        <g>
                            <title>Non accroché à @(at.Mother.Name) — @why</title>
                            <circle cx="@Fmt(mark.X)" cy="@Fmt(mark.Y)" r="6" fill="white" stroke="#d11a2a" stroke-width="2" />
                            <line x1="@Fmt(mark.X - 4)" y1="@Fmt(mark.Y - 4)" x2="@Fmt(mark.X + 4)" y2="@Fmt(mark.Y + 4)" stroke="#d11a2a" stroke-width="2" />
                            <line x1="@Fmt(mark.X - 4)" y1="@Fmt(mark.Y + 4)" x2="@Fmt(mark.X + 4)" y2="@Fmt(mark.Y - 4)" stroke="#d11a2a" stroke-width="2" />
                        </g>
                    }
                }
            }
            </g>

            @* Afficher les points d'intersection *@
            <g class="dxf-layer-intersections">
            @if (IntersectionPoints != null && IntersectionPoints.Any())
            {
                @foreach (var kvp in IntersectionPoints)
                {
                    @foreach (var point in kvp.Value)
                    {
                        var svgPoint = GetSVGCoordinatesFromReal(new Point(point.X * MmToM + Point0X * MmToM, point.Y * MmToM + Point0Y * MmToM));
                        <circle cx="@Fmt(svgPoint.X)" cy="@Fmt(svgPoint.Y)" r="5" fill="red" stroke="darkred" stroke-width="2" opacity="0.8">
                            <title>Intersection : @StudyPair(point.X, point.Y) m</title>
                        </circle>
                    }
                }
            }

            </g>

            @* Afficher les charges sur la charpente *@
            @if (CharpenteLoads != null && CharpenteLoads.Any())
            {
                @foreach (var load in CharpenteLoads)
                {
                    var coords = CharpenteCoordinates.GetCoordinates(load.Key);
                    if (coords.HasValue)
                    {
                        var svgPoint = GetSVGCoordinatesFromReal(new Point(coords.Value.X * MmToM, coords.Value.Y * MmToM));
                        var color = load.Value > 100 ? "red" : load.Value > 50 ? "orange" : "green";
                        var loadText = load.Value.ToString("F1");
                        
                        @* Cercle coloré *@
                        <circle cx="@Fmt(svgPoint.X)" cy="@Fmt(svgPoint.Y)" r="8" 
                                fill="@color" stroke="black" stroke-width="1" opacity="0.7">
                            <title>@load.Key: @load.Value.ToString("F2")</title>
                        </circle>
                        
                        @* Afficher la valeur de la charge - émettre via MarkupString *@
                        @SvgLabel(svgPoint.X + 12, svgPoint.Y + 5, color, loadText)
                    }
                }
            }

            @* Afficher les charges utilisateur (ChargesSceniques) *@
            <g class="dxf-layer-charges">
            @if (ChargesSceniques != null && ChargesSceniques.Any())
            {
                @foreach (var load in ChargesSceniques)
                {
                    if (load.X is not null && load.Y is not null && load.Charge is not null)
                    {
                        @* load.X/Y are in user/event coords → convert to absolute real coords for SVG *@
                        var svgPoint = GetSVGCoordinatesFromReal(new Point(load.X.Value * MmToM + Point0X * MmToM, load.Y.Value * MmToM + Point0Y * MmToM));
                        var chargeValue = load.Charge.Value;
                        var color = chargeValue > 500 ? "darkred" : chargeValue > 200 ? "darkorange" : "darkgreen";
                        var loadText = chargeValue.ToString("F1");

                        <g transform="translate(@Fmt(svgPoint.X), @Fmt(svgPoint.Y))"
                           style="pointer-events: none;">
                            <line x1="0" y1="-20" x2="0" y2="-5"
                                  stroke="@color" stroke-width="2" />
                            <polygon points="0,-5 -4,-10 4,-10"
                                     fill="@color" stroke="@color" stroke-width="1" />
                            <circle cx="0" cy="0" r="6"
                                    fill="@color" stroke="white" stroke-width="1.5" opacity="0.85">
                                <title>@(load.Name ?? "Charge") : @chargeValue.ToString("0.00", Fr) kg — @StudyPair(load.X.Value, load.Y.Value) m</title>
                            </circle>
                            <text x="8" y="-12"
                                  font-size="11"
                                  font-weight="bold"
                                  fill="@color"
                                  stroke="white"
                                  stroke-width="0.5"
                                  paint-order="stroke"
                                  style="pointer-events: none;">@loadText</text>
                        </g>
                    }
                }
            }

            </g>

            @* Afficher les charges sur les palonniers, et sur les mothers auxquels elles sont accrochées directement *@
            <g class="dxf-layer-palonnierloads">
            @if (PalonnierLoads != null && PalonnierLoads.Any())
            {
                @foreach (var charge in PalonnierLoads)
                {
                    var palonnier = CarrierOf(charge);   // a palonnier, or a mother line the charge hangs from directly
                    if (palonnier != null && palonnier.X1 != null && palonnier.Y1 != null &&
                        palonnier.X2 != null && palonnier.Y2 != null && charge.X != null)
                    {
                        double x1 = (double)palonnier.X1;
                        double y1 = (double)palonnier.Y1;
                        double x2 = (double)palonnier.X2;
                        double y2 = (double)palonnier.Y2;

                        double palonnierLength = Math.Sqrt(Math.Pow(x2 - x1, 2) + Math.Pow(y2 - y1, 2));
                        double ratio = palonnierLength > 0 ? (charge.X ?? 0) / palonnierLength : 0;

                        double chargeX = x1 + ratio * (x2 - x1);
                        double chargeY = y1 + ratio * (y2 - y1);

                        var svgChargePos = GetSVGCoordinatesFromReal(new Point(
                            chargeX * MmToM + Point0X * MmToM,
                            chargeY * MmToM + Point0Y * MmToM));

                        var chargeValue = charge.Charge ?? 0;
                        var color = chargeValue > 500 ? "darkred" : chargeValue > 200 ? "darkorange" : "darkgreen";
                        var loadText = chargeValue.ToString("F1");
                        var isSelected = charge == SelectedCharge;
                        var currentCharge = charge; // Capture for closure

                        <g transform="translate(@Fmt(svgChargePos.X), @Fmt(svgChargePos.Y))"
                           @onclick="@(async () => await HandleChargeClick(currentCharge))"
                           @onclick:stopPropagation="true"
                           @onmousedown:stopPropagation="true"
                           @onmouseup:stopPropagation="true"
                           style="cursor: @(isSelectingEnabled ? "pointer" : "default");">
                            <line x1="0" y1="-20" x2="0" y2="-5" stroke="@color" stroke-width="2" />
                            <polygon points="0,-5 -4,-10 4,-10" fill="@color" stroke="@color" stroke-width="1" />
                            @if (isSelected)
                            {
                                <circle cx="0" cy="0" r="10" fill="none" stroke="yellow" stroke-width="2.5" />
                            }
                            <circle cx="0" cy="0" r="6"
                                    fill="@color"
                                    stroke="@(isSelected ? "yellow" : "white")"
                                    stroke-width="@(isSelected ? "2.5" : "1.5")"
                                    opacity="0.8">
                                <title>@(charge.Name ?? "Charge"): @chargeValue.ToString("F2") (@palonnier.Name)</title>
                            </circle>
                            <text x="8" y="-12" font-size="11" font-weight="bold" fill="@color"
                                  stroke="white" stroke-width="0.5" paint-order="stroke"
                                  style="pointer-events: none;">@loadText</text>
                        </g>
                    }
                }
            }

            </g>

            @foreach (var circle in circles)
            {
                <circle cx="@Fmt(GetSVGCoordinatesFromReal(circle.Center).X)" cy="@Fmt(GetSVGCoordinatesFromReal(circle.Center).Y)" r="@circle.Radius" fill="@circle.Color" />
            }

            @* Sensors rendering *@
            <g class="dxf-layer-sensors">
            @if (Sensors != null)
            {
                @foreach (var sensor in Sensors)
                {
                    var xAttr = sensor.AttributeElements?.FirstOrDefault(ae => ae.AttributeType?.Name == "X");
                    var yAttr = sensor.AttributeElements?.FirstOrDefault(ae => ae.AttributeType?.Name == "Y");
                    
                    if (xAttr != null && yAttr != null && 
                        double.TryParse(xAttr.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out double sensorX) && 
                        double.TryParse(yAttr.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out double sensorY))
                    {
                        var sensorPos = new Point(sensorX, sensorY);
                        var svgPos = GetSVGCoordinatesFromReal(sensorPos);
                        var currentSensor = sensor; // Capture for closure
                        var fillColor = GetSensorColor(sensor);
                        var strokeColor = GetSensorStrokeColor(sensor);
                        var hasRatio = SensorChargeRatios != null && SensorChargeRatios.TryGetValue(sensor.ElementId, out double displayRatio);
                        var ratioText = hasRatio ? $" — Charge: {SensorChargeRatios[sensor.ElementId] * 100:F0}%" : "";
                        
                        @if (IsSensorSelectionEnabled)
                        {
                            <g transform="translate(@Fmt(svgPos.X), @Fmt(svgPos.Y))" 
                               class="sensor-marker"
                               @onclick="@(async () => await HandleSensorClick(currentSensor))"
                               @onclick:stopPropagation="true"
                               @onmousedown:stopPropagation="true"
                               @onmouseup:stopPropagation="true">
                                <circle r="8" 
                                        fill="@fillColor" 
                                        stroke="white" 
                                        stroke-width="2"
                                        opacity="0.9"
                                        style="cursor: pointer;">
                                    <title>@sensor.Name@ratioText</title>
                                </circle>
                                
                                <circle r="12" 
                                        fill="none" 
                                        stroke="@strokeColor" 
                                        stroke-width="1"
                                        opacity="0.5" />
                                
                                <text x="16" y="5" 
                                      font-size="11" 
                                      font-weight="500"
                                      fill="#333" 
                                      stroke="white"
                                      stroke-width="0.5"
                                      paint-order="stroke"
                                      style="pointer-events: none;">@sensor.Name</text>
                            </g>
                        }
                        else
                        {
                            @* Non-interactive sensor display - allows drawing through sensors *@
                            <g transform="translate(@Fmt(svgPos.X), @Fmt(svgPos.Y))" 
                               class="sensor-marker"
                               style="pointer-events: none;">
                                <circle r="8" 
                                        fill="@fillColor" 
                                        stroke="white" 
                                        stroke-width="2"
                                        opacity="0.9"
                                        style="pointer-events: all;">
                                    <title>@sensor.Name@ratioText</title>
                                </circle>
                                
                                <circle r="12" 
                                        fill="none" 
                                        stroke="@strokeColor" 
                                        stroke-width="1"
                                        opacity="0.5" />
                                
                                <text x="16" y="5" 
                                      font-size="11" 
                                      font-weight="500"
                                      fill="#333" 
                                      stroke="white"
                                      stroke-width="0.5"
                                      paint-order="stroke">@sensor.Name</text>
                            </g>
                        }

                        @* Status overlay (Inactif / Panne) drawn on top of the sensor icon *@
                        @if (GetStatut(sensor) == "Panne")
                        {
                            @* Red warning triangle with "!", centred on the sensor icon *@
                            <g transform="translate(@Fmt(svgPos.X), @Fmt(svgPos.Y))" style="pointer-events: none;">
                                <polygon points="0,-9 9,7 -9,7" fill="#e53935" stroke="white" stroke-width="1" />
                                <text x="0" y="5" font-size="11" font-weight="bold" text-anchor="middle" fill="white">!</text>
                                <title>@sensor.Name — Panne</title>
                            </g>
                        }
                        else if (GetStatut(sensor) == "Inactif")
                        {
                            @* Grey "inactive" slash, centred on the sensor icon (white halo for contrast) *@
                            <g transform="translate(@Fmt(svgPos.X), @Fmt(svgPos.Y))" style="pointer-events: none;">
                                <line x1="-7" y1="-7" x2="7" y2="7" stroke="white" stroke-width="4" stroke-linecap="round" />
                                <line x1="-7" y1="-7" x2="7" y2="7" stroke="#555555" stroke-width="2" stroke-linecap="round" />
                                <title>@sensor.Name — Inactif</title>
                            </g>
                        }
                    }
                }
            }
            </g>
        </svg>
        @* ── Toolbar ── *@
        <div style="position: absolute; top: 10px; right: 10px; display: flex; flex-direction: column; gap: 4px; z-index: 10;
                    background: rgba(255,255,255,0.75); border-radius: 6px; padding: 4px; backdrop-filter: blur(4px);">
            <button class="toolbar-button" @onclick="ZoomToExtent" title="Zoom to Extent">
                <i class="fas fa-expand-arrows-alt"></i>
            </button>
            <button class="toolbar-button" @onclick="ToggleSnapping" title="Toggle Node Snapping"
                    style="background-color: @(isSnappingEnabled ? "green" : "gray");">
                <i class="fas fa-magnet"></i>
            </button>
            <button class="toolbar-button" @onclick="TogglePSnapping" title="Toggle Palonniers Snapping"
                    style="background-color: @(isPalonniersSnappingEnabled ? "green" : "gray");">
                P<i class="fas fa-magnet"></i>
            </button>
            <button class="toolbar-button" @onclick="ToggleMSnapping" title="Toggle Mothergrids Snapping"
                    style="background-color: @(isMotherGridsSnappingEnabled ? "green" : "gray");">
                M<i class="fas fa-magnet"></i>
            </button>
            <button class="toolbar-button" @onclick="ToggleSelecting" title="Selection"
                    style="background-color: @(isSelectingEnabled ? "green" : "gray");">
                <i class="fas fa-mouse-pointer"></i>
            </button>
            <button class="toolbar-button" @onclick="EraseSelected" title="Erase Selected"
                    style="background-color: red; color: white;">
                <i class="fas fa-eraser"></i>
            </button>
            @* ── DXF export buttons ── *@
            <button class="toolbar-button" @onclick="OpenDxfSettings" title="DXF Export Settings"
                    style="background-color: #555; color: white;">
                <i class="fas fa-cog"></i>
            </button>
            <button class="toolbar-button" @onclick="ExportDxf" title="Export to DXF"
                    style="background-color: #1565C0; color: white;">
                <i class="fas fa-file-export"></i>
            </button>
        </div>

        @* ── DXF Settings Modal ── *@
        @if (showDxfSettings)
        {
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                        background: rgba(0,0,0,0.45); z-index: 100; display: flex; align-items: center; justify-content: center;"
                 @onclick="CloseDxfSettings">
                <div id="dxfSettingsPanel"
                     style="background: white; border-radius: 10px; padding: 24px; min-width: 300px; box-shadow: 0 4px 24px rgba(0,0,0,0.3);"
                     @onclick:stopPropagation="true">
                    <h5 id="dxfSettingsHeader" style="margin-bottom: 16px; font-weight: bold;"
                        title="Glisser pour déplacer">
                        <i class="fas fa-arrows-alt" style="color:#9aa2b1; margin-right:6px;"></i>
                        <i class="fas fa-file-export"></i> DXF Export Settings
                    </h5>

                    @* ── File name ── *@
                    <div style="margin-bottom: 14px;">
                        <label style="font-size:13px; font-weight:600; display:block; margin-bottom:4px;">File name</label>
                        <div style="display:flex; align-items:center; gap:4px;">
                            <input type="text" @bind="dxfExportFileName"
                                   style="flex:1; padding:4px 8px; border:1px solid #ccc; border-radius:4px; font-size:13px;"
                                   placeholder="export" />
                            <span style="font-size:13px; color:#666;">.dxf</span>
                        </div>
                    </div>

                    @* ── Layer selection ── *@
                    <div style="display: flex; flex-direction: column; gap: 10px; font-size: 14px;">
                        <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
