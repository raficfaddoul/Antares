        var zoom = e.DeltaY > 0 ? (1 - scaleFactor) : (1 + scaleFactor);

        double mouseX = _vx + _vw / 2;
        double mouseY = _vy + _vh / 2;

        var newWidth  = _vw * zoom;
        var newHeight = _vh * zoom;
        var newX      = _vx + (mouseX - _vx) - (mouseX - _vx) * zoom;
        var newY      = _vy + (mouseY - _vy) - (mouseY - _vy) * zoom;

        SetViewBox(newX, newY, newWidth, newHeight);
        StateHasChanged();
    }

    // ── Replace the private field ─────────────────────────────────────────────
