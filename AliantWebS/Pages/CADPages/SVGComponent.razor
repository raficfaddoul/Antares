    private async Task OnMouseDown(MouseEventArgs e)
    {
        if (e.ShiftKey) // Check if Shift key is pressed for panning
        {
            lastPanPoint = new Point(e.ClientX, e.ClientY);
            //panStart = new Point(e.ClientX, e.ClientY);
            isPanning = true;
        }
        else // Otherwise, start drawing
        {
            if (!isSelectingEnabled)
            {
                await StartDrawing(e);
            }
        }
    }

    private async Task OnMouseMove(MouseEventArgs e)
    {
        if ((Palonniers != null) && (MotherGrids != null))
        {
            var hoverPoint = await GetSvgCoordinates(e.ClientX, e.ClientY);
            hoverPoint = GetRealCoordinatesFromSVG(hoverPoint);

            MotherGridPalonnier nearestPalonnier = null;
            MotherGridPalonnier nearestMotherGrid = null;
            double minPerpendicularDistance = double.MaxValue;

            // Check for closest Palonnier
            foreach (var pal in Palonniers)
            {
                var p1 = new Point((double)pal.X1, (double)pal.Y1);
                var p2 = new Point((double)pal.X2, (double)pal.Y2);
                double perpendicularDistance = GetPerpendicularDistance(hoverPoint, p1, p2);

                if (perpendicularDistance < minPerpendicularDistance && perpendicularDistance <= snapDistThreshold)
                {
                    minPerpendicularDistance = perpendicularDistance;
                    nearestPalonnier = pal;
                }
            }
        
        // Check for closest MotherGrid

            foreach (var moth in MotherGrids)
            {
                var p1 = new Point((double)moth.X1, (double)moth.Y1);
                var p2 = new Point((double)moth.X2, (double)moth.Y2);
                double perpendicularDistance = GetPerpendicularDistance(hoverPoint, p1, p2);

                if (perpendicularDistance < minPerpendicularDistance && perpendicularDistance <= snapDistThreshold)
                {
                    minPerpendicularDistance = perpendicularDistance;
                    nearestMotherGrid = moth;
                }
            }
            // Update hover state
            hoveredPalonnier = nearestPalonnier;
            hoveredMotherGrid = nearestMotherGrid;
        }

  

        StateHasChanged(); // Trigger re-render to update hover effect
        
        
        if (isPanning)
        {
            var dx = e.ClientX - lastPanPoint.X;
            var dy = e.ClientY - lastPanPoint.Y;
            UpdateViewBox(dx, dy);
            lastPanPoint = new Point(e.ClientX, e.ClientY);
        }
        else if (isDrawing && !isSelectingEnabled)
        {
            await Draw(e);
        }
    }

    private void UpdateViewBox(double dx, double dy)
    {
        // Parse current viewBox
        var parts = viewBox.Split(' ');
        var x = double.Parse(parts[0]);
        var y = double.Parse(parts[1]);
        var width = double.Parse(parts[2]);
        var height = double.Parse(parts[3]);

        // Update viewBox to new position
        viewBox = $"{x - dx} {y - dy} {width} {height}";
        StateHasChanged();
    }

    private async Task OnMouseUp(MouseEventArgs e)
    {
        if (isPanning)
        {
            isPanning = false;
            StateHasChanged();
        }
        else if (isDrawing && !isSelectingEnabled)
        {
            await EndDrawing(e);
        }
    }

    private async void OnWheel(WheelEventArgs e)
    {
        const double scaleFactor = 0.1; // How much to zoom in or out
        var zoom = e.DeltaY > 0 ? (1 - scaleFactor) : (1 + scaleFactor); // Reversing the direction for a more intuitive zoom

        var parts = viewBox.Split(' ');
        var x = double.Parse(parts[0]);
        var y = double.Parse(parts[1]);
        var width = double.Parse(parts[2]);
        var height = double.Parse(parts[3]);


        // var mousePoint = await GetSvgCoordinates(e.ClientX, e.ClientY);
        // var mouseX = mousePoint.X; // These should be SVG coordinates, convert from client if necessary
        // var mouseY = mousePoint.Y;

        // Simplified: Assume mouse is at the center of the current viewBox
        double mouseX = x + width / 2;
        double mouseY = y + height / 2;

        // Calculate new width and height
        var newWidth = width * zoom;
        var newHeight = height * zoom;




        // Adjust x and y to keep the zoom centered around the mouse cursor
        var newX = x + (mouseX - x) - (mouseX - x) * zoom;
        var newY = y + (mouseY - y) - (mouseY - y) * zoom;

        viewBox = $"{newX} {newY} {newWidth} {newHeight}";
        imageScale /= zoom;
        StateHasChanged();
    }
    private async Task<MotherGridPalonnier> OnClick(MouseEventArgs e)
    {
        MotherGridPalonnier nearestObject = null;
        double minPerpendicularDistance = double.MaxValue;

        if (isSelectingEnabled)
        {
            var clickPoint = await GetSvgCoordinates(e.ClientX, e.ClientY);
            clickPoint = GetRealCoordinatesFromSVG(clickPoint);

            // Check Palonniers
            foreach (var pal in Palonniers)
            {
                var p1 = new Point((double)pal.X1, (double)pal.Y1);
                var p2 = new Point((double)pal.X2, (double)pal.Y2);

                // Calculate perpendicular distance from the clickPoint to the line segment defined by p1 and p2
                double perpendicularDistance = GetPerpendicularDistance(clickPoint, p1, p2);

                // Check if this is the closest object within the snap distance threshold
                if (perpendicularDistance < minPerpendicularDistance && perpendicularDistance <= snapDistThreshold)
                {
                    minPerpendicularDistance = perpendicularDistance;
                    nearestObject = pal; // Update to the closest palonnier
                }
            }

            // Check MotherGrids
            foreach (var moth in MotherGrids)
            {
                var p1 = new Point((double)moth.X1, (double)moth.Y1);
                var p2 = new Point((double)moth.X2, (double)moth.Y2);

                // Calculate perpendicular distance from the clickPoint to the line segment defined by p1 and p2
                double perpendicularDistance = GetPerpendicularDistance(clickPoint, p1, p2);

                // Check if this is the closest object within the snap distance threshold
                if (perpendicularDistance < minPerpendicularDistance && perpendicularDistance <= snapDistThreshold)
                {
                    minPerpendicularDistance = perpendicularDistance;
                    nearestObject = moth; // Update to the closest mothergrid
                }
            }
        }

        selectedPalonnier = nearestObject; // Update the selected object

        // Optionally: Call StateHasChanged() if needed to re-render
        StateHasChanged();

        return nearestObject;
    }


    // Helper method to calculate the perpendicular distance from a point to a line segment
    private double GetPerpendicularDistance(Point p, Point p1, Point p2)
    {
        // Vector A to B
        double A = p.X - p1.X;
        double B = p.Y - p1.Y;
        double C = p2.X - p1.X;
        double D = p2.Y - p1.Y;

        // Dot product of vector AB and vector AC
        double dot = A * C + B * D;
        double len_sq = C * C + D * D;
        double param = -1;

        // Avoid division by zero (case when p1 and p2 are the same point)
        if (len_sq != 0) // if not a zero-length line segment
        {
            param = dot / len_sq;
        }

        double xx, yy;

        if (param < 0)
        {
            xx = p1.X;
            yy = p1.Y;
        }
        else if (param > 1)
        {
            xx = p2.X;
            yy = p2.Y;
        }
        else
        {
            xx = p1.X + param * C;
            yy = p1.Y + param * D;
        }

        // Calculate the distance from point p to the nearest point on the line segment
        double dx = p.X - xx;
        double dy = p.Y - yy;
        return Math.Sqrt(dx * dx + dy * dy);
    }




    private async Task StartDrawing(MouseEventArgs e)
    {
        startPoint = await GetSvgCoordinates(e.ClientX, e.ClientY);
        startPoint = GetRealCoordinatesFromSVG(startPoint);


        if (isSnappingEnabled)
        {
            var nearestCircle = FindNearestCircle(startPoint, snapDistThreshold); // Adjust the threshold as needed
            if (nearestCircle != null)
            {
                startPoint = nearestCircle.Center; // Snap to the center of the nearest circle
            }
        }

        if (isMotherGridsSnappingEnabled)
        {
            var nearestPoint = FindNearestMotherGrid(startPoint, snapDistThreshold); // Adjust the threshold as needed
            if (nearestPoint != null)
            {
                startPoint = nearestPoint;
            }
        }

        if (isPalonniersSnappingEnabled)
        {
            var nearestPoint = FindNearestPalonnier(startPoint, snapDistThreshold); // Adjust the threshold as needed
            if (nearestPoint != null)
            {
                startPoint = nearestPoint;
            }
        }


        isDrawing = true;
        currentLine = (startPoint, startPoint);
    }

    private async Task Draw(MouseEventArgs e)
    {
        if (freeSketch)
        {
            if (isDrawing)
            {
                var currentPoint = await GetSvgCoordinates(e.ClientX, e.ClientY);
                currentPoint = GetRealCoordinatesFromSVG(currentPoint);
                lines.Add((startPoint, currentPoint));
                startPoint = currentPoint;
                StateHasChanged();
            }
        }
        else
        {
            var currentPoint = await GetSvgCoordinates(e.ClientX, e.ClientY);
            currentPoint = GetRealCoordinatesFromSVG(currentPoint);

            if (isSnappingEnabled)
            {
                var nearestCircle = FindNearestCircle(currentPoint, snapDistThreshold); // Adjust the threshold as needed
                if (nearestCircle != null)
                {
                    currentPoint = nearestCircle.Center; // Snap to the center of the nearest circle
                }
            }

            if (isMotherGridsSnappingEnabled)
            {
                var nearestPoint = FindNearestMotherGrid(currentPoint, snapDistThreshold); // Adjust the threshold as needed
                if (nearestPoint != null)
                {
                    currentPoint = nearestPoint;
                }
            }

            if (isPalonniersSnappingEnabled)
            {
                var nearestPoint = FindNearestPalonnier(currentPoint, snapDistThreshold); // Adjust the threshold as needed
                if (nearestPoint != null)
                {
                    currentPoint = nearestPoint;
                }
            }



            if (currentLine.HasValue)
            {
                currentLine = (startPoint, currentPoint);
            }
        }
    }

    private async Task EndDrawing(MouseEventArgs e)
    {
        if (isDrawing)
        {
            var endPoint = await GetSvgCoordinates(e.ClientX, e.ClientY);
            endPoint = GetRealCoordinatesFromSVG(endPoint);

            if (isSnappingEnabled)
            {
                var nearestCircle = FindNearestCircle(endPoint, snapDistThreshold); // Use the same threshold as in Draw
                if (nearestCircle != null)
                {
                    endPoint = nearestCircle.Center; // Snap to the center of the nearest circle
                }
            }

            if (isMotherGridsSnappingEnabled)
            {
                var nearestPoint = FindNearestMotherGrid(endPoint, snapDistThreshold); // Adjust the threshold as needed
                if (nearestPoint != null)
                {
                    endPoint = nearestPoint;
                }
            }

            if (isPalonniersSnappingEnabled)
            {
                var nearestPoint = FindNearestPalonnier(endPoint, snapDistThreshold); // Adjust the threshold as needed
                if (nearestPoint != null)
                {
                    endPoint = nearestPoint;
                }
            }



            if (currentLine.HasValue)
            {
                currentLine = (currentLine.Value.Item1, endPoint);
                // lines.Add(currentLine.Value);
                if (Distance(currentLine.Value.Item1, currentLine.Value.Item2) > 500)
                {
                    await LineDrawn.InvokeAsync((currentLine.Value.Item1.X,
       currentLine.Value.Item1.Y, currentLine.Value.Item2.X, currentLine.Value.Item2.Y));
                }

                currentLine = null;
                StateHasChanged();
            }
            isDrawing = false;
        }
    }

    private double Distance(Point p1,Point p2)
    {
        double distance = Math.Sqrt(Math.Pow(p1.X - p2.X, 2) + Math.Pow(p1.Y - p2.Y, 2));

        return distance;
    }

