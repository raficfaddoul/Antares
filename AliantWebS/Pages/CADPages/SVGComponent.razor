            var dx = e.ClientX - lastPanPoint.X;
            var dy = e.ClientY - lastPanPoint.Y;
            UpdateViewBox(dx, dy);             // calls StateHasChanged internally
            lastPanPoint = new Point(e.ClientX, e.ClientY);
            return;
        }

        if (isDrawing && !isSelectingEnabled)
        {
            UpdateDrawing(e);   // synchronous Draw (renamed below)
            stateChanged = true;
        }

        if (stateChanged)
            StateHasChanged();
    }

    // Renamed from Draw — now fully synchronous, no more async JS call
    private void UpdateDrawing(MouseEventArgs e)
    {
        var currentPoint = ClientToSvgPoint(e.ClientX, e.ClientY); // ← synchronous
        currentPoint = GetRealCoordinatesFromSVG(currentPoint);

        if (isSnappingEnabled)
        {
            var nearestCircle = FindNearestCircle(currentPoint, SnapDistanceMm);
            if (nearestCircle != null) currentPoint = nearestCircle.Center;
        }
        if (isMotherGridsSnappingEnabled)
        {
            var nearestPoint = FindNearestMotherGrid(currentPoint, SnapDistanceMm);
            if (nearestPoint != null) currentPoint = nearestPoint;
        }
        if (isPalonniersSnappingEnabled)
        {
            var nearestPoint = FindNearestPalonnier(currentPoint, SnapDistanceMm);
            if (nearestPoint != null) currentPoint = nearestPoint;
        }

        if (currentLine.HasValue)
            currentLine = (startPoint, currentPoint);
    }

    private async Task OnMouseUp(MouseEventArgs e)
