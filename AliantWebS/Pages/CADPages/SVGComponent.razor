    private MarkupString SvgLabel(double x, double y, string color, string text, double fontSize = 12, string fontWeight = "bold")
    {
        // Invariant culture to avoid commas in SVG numbers
        var xi = x.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var yi = y.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var fsi = fontSize.ToString(System.Globalization.CultureInfo.InvariantCulture);
        return new MarkupString(
            $"<text x='{xi}' y='{yi}' font-size='{fsi}' fill='{color}' font-weight='{fontWeight}'>{text}</text>");
    }

