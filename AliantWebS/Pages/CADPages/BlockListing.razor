@page "/BlockListing"
@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment Env
@inject IJSRuntime js

@using netDxf
@using netDxf.Blocks
@using System.IO
@using System.Text
<input type="file" id="dxfFileInput"  />
<div class="file-input-zone">
    <NavLink title="BIM" class="nav-link" href="dgfrdgh" @onclick:preventDefault="true">
        <span align="center" style="width:30px" class="fa fa-cube" aria-hidden="true"></span>
    </NavLink>
    <InputFile OnChange="@LoadAndListBlocks" />
</div>
@* <canvas @ref="_canvasElement" id="v-canvas" style="width: 100%; height: 100%;"></canvas> *@
@* <div  style="height:100%; width:100%" id="dxf-canvas"></div> *@


<div id="dxfContainer" style="width: 800px; height: 600px;"></div>

@if (blockNames != null && blockNames.Any())
{
    <h3>Blocks in the DXF file:</h3>
    <ul>
        @foreach (var name in blockNames)
        {
            <li>@name</li>
        }
    </ul>
}
else if (blockNames != null)
{
    <p>No blocks found in the file.</p>
}

