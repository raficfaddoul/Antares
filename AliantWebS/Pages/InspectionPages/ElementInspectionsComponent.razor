@page "/ElementInspections/{ElementID:guid}"
@using AliantWebS.Data
@inject EntitiesService entitiesService
@using Models
@inject AliantWebS.Data.AppData AppData
@inject IJSRuntime js
@inject IStringLocalizer<Languages> L


<Div Style="display: flex">
    <h3>@title</h3>
    <div style="margin-left: auto; ">
        <Label> Page Size: &nbsp;&nbsp;</Label>
        <RadzenNumeric @bind-Value="PageSize" Style="width:60px"></RadzenNumeric>
    </div>
</Div>
@if (element.InspectionResults is null)
{
    <p><em>@L["Loading"]... !</em></p>
}
else if (InspectionResultTypesList.Count() == 0)
{
    <h1><em>@L["No Condition state types are defined for this type of element"]...!</em></h1>
}
else
{
    <a class="nav-link" @onclick="@(args => InsertInspectionResult())" @onclick:preventDefault="true" href="">
        <span class="oi oi-plus" aria-hidden="true">@L["Add New"]</span>
    </a>

    <RadzenDataGrid @ref="inspectionResultsGrid" AllowFiltering="true" AllowPaging="true" AllowSorting="true" PageSize="PageSize" RowSelect=@RowSelect
                Data="@element.InspectionResults" TItem="InspectionResult" ColumnWidth="150px">
        <Columns>
@*            <RadzenDataGridColumn TItem="InspectionResult" Property="InspectionResultId" Title="Id"></RadzenDataGridColumn>*@
            <RadzenDataGridColumn TItem="InspectionResult" Title="@L["Inspection result Type"]">
                <Template Context="inspectionResult">
                    @inspectionResult?.InspectionResultType?.Name
                </Template>
                <EditTemplate Context="inspectionResult">
                    <InputSelect class="form-control" @bind-Value=inspectionResult.InspectionResultTypeId>
                        @foreach (var InspectionResultType in InspectionResultTypesList)
                        {
                            <option value="@InspectionResultType.InspectionResultTypeId">@InspectionResultType.Name</option>
                        }
                    </InputSelect>

                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="InspectionResult" Title="@L["Date"]">
                <Template Context="inspectionResult">
                    @inspectionResult?.Date
                </Template>
                <EditTemplate Context="inspectionResult">
                    <InputDate @bind-Value="inspectionResult.Date"></InputDate>
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="InspectionResult" Title="@L["Value"]">
                <Template Context="inspectionResult">
                    <Blazorise.Slider @bind-Value="inspectionResult.ResultNumeric"></Blazorise.Slider>
                </Template>
                <EditTemplate Context="inspectionResult">
                    <Blazorise.Slider @bind-Value="inspectionResult.ResultNumeric"></Blazorise.Slider>

                </EditTemplate>
            </RadzenDataGridColumn>


            <RadzenDataGridColumn TItem="InspectionResult" Property="Length" Title="@L["Action"]">
                <Template Context="data">
                    <Div Style="display: flex">
                        <a title="@L["Edit"]" class="nav-link" @onclick="@(args => EditRow(data))" @onclick:preventDefault="true" href="">
                            <!--href="/patient/EditSideEffectComponent/@data.SideEffectID-->
                            <span class="oi oi-pencil" aria-hidden="true"></span>
                        </a>
                        <a title="@L["End Edit"]" class="nav-link" @onclick="@(args => UpdateRow(data))" @onclick:preventDefault="true" href="">
                            <span class="oi oi-check" aria-hidden="true"></span>
                        </a>
                        <a title="@L["Delete"]" class="nav-link" @onclick="@(() => DeleteRow(data))" @onclick:preventDefault="true" href="">
                            <span class="oi oi-trash" aria-hidden="true"></span>
                        </a>
                    </Div>
                </Template>

            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>


    @*   <Carousel @bind-SelectedSlide="@selectedSlide" ShowIndicators="true" ShowControls="true" Background="Background.Dark">
                @foreach (string path in pathsForFiles)
                {

                    <CarouselSlide Name=@Path.GetFileNameWithoutExtension(path)>
                        <div Style="text-align:right">
                            <Image Source=@path Text=@Path.GetFileNameWithoutExtension(path) Display="Display.Block" Style="width: 80%; height: 30em;" />
                        </div>
                    </CarouselSlide>
                }
            </Carousel>*@

}


@code {
    int PageSize { get; set; } = 10;

    [Parameter]
    public Guid ElementID { get; set; }

    string ScrollHeight { get; set; }

    RadzenDataGrid<InspectionResult> inspectionResultsGrid;

    Element element;

    string title;

    InspectionResult selectedInspectionResult;


    IEnumerable<InspectionResultType> InspectionResultTypesList;



    protected override async Task OnInitializedAsync()
    {
        ScrollHeight = "400px";
        element = (Element)AppData.obj1;


        entitiesService.LoadCollection(element, "InspectionResults");


        ///rafic te be reviewd for optimality
        /*   foreach (var v in element.InspectionResults)
           {

               entitiesService.LoadReference(v, "InspectionResultType");
           }*/

        Guid? elementTypeID = element.ElementTypeId;

        title = "Element " + element.Name + " Inspections";

        IEnumerable<InspectionResultTypeElementType> ertet = await entitiesService.GetFilteredEntitiesAsync<InspectionResultTypeElementType>(a => a.ElementTypeId == elementTypeID, "InspectionResultType");

        InspectionResultTypesList = ertet.Select(x => x.InspectionResultType);

        //    InspectionResultTypesList = await entitiesService.GetFilteredEntitiesAsync<InspectionResultType>(a => InspectionResultTypeIDsList.Contains(a.InspectionResultTypeId));

    }



    async Task DeleteRow(InspectionResult inspectionResult)
    {
        if (await entitiesService.DeleteEntityAsync(inspectionResult))
        {
            //    if (inspectionResultTypeList.Remove(inspectionResultType))
            {
                await inspectionResultsGrid.Reload();

            }
        }


    }

    void EditRow(InspectionResult inspectionResult)
    {

        inspectionResultsGrid.EditRow(inspectionResult);

    }

    async Task InsertInspectionResult()
    {
        //if (element.ElementType.InspectionResultTypeElementTypes.Count == 0)
        //{

        //    await js.InvokeVoidAsync("alert", $"Non Condition types are defined for this type of element");
        //    return;
        //}

        InspectionResult inspectionResult = new InspectionResult();
        inspectionResult.ElementId = element.ElementId;
        inspectionResult.InspectionResultTypeId = element.ElementType.InspectionResultTypeElementTypes.FirstOrDefault().InspectionResultTypeId;
        inspectionResult.Date = DateOnly.FromDateTime(DateTime.Now);

        element.InspectionResults.Add(inspectionResult);
        await entitiesService.UpdateEntityAsync(element);

        await inspectionResultsGrid.Reload();

        /*  if (await entitiesService.InsertEntityAsync(inspectionResultType))
          {
              inspectionResultTypeList.Add(inspectionResultType);
              if (!detailedMode)
              {
                  await inspectionResultTypesGrid.InsertRow(inspectionResultType);
              }
          }
        */

    }

    async Task UpdateRow(InspectionResult inspectionResult)
    {

        if (await entitiesService.UpdateEntityAsync(inspectionResult))
        {
            await inspectionResultsGrid.UpdateRow(inspectionResult);
        }

    }

    void OnResize(RadzenSplitterResizeEventArgs args)
    {
        ScrollHeight = (400 * args.NewSize).ToString() + "px";
        StateHasChanged();
    }




    void RowSelect(InspectionResult inspectionResult)
    {
        selectedInspectionResult = inspectionResult;

    }

            }
