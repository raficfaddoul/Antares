@page "/defects/{ElementID:guid}"
@using AliantWebS.Models
@using AliantWebS.Data
@inject AliantWebS.Data.AppData AppData
@inject EntitiesService entitiesService
@inject NavigationManager navigationManager
@inject IStringLocalizer<Languages> L


<Div style="white-space: nowrap; ">
    <label Style="display: inline">@L["Include Descendants"]</label>
    <RadzenSwitch @bind-Value=@includeDescendants Style="display: inline-flex; margin-left:20px" />

</Div>

<EditForm Model="@element">
    <DataAnnotationsValidator />

    <RadzenSplitter Orientation="Radzen.Orientation.Horizontal" style="height: 100%; border: 1px solid rgba(0,0,0,.08);">
        <RadzenSplitterPane Style="height:100%" Size="75%">
            <div style="height:auto">
            <MediaComponent selectedObject="element" ElementsToDispay="subDescendants" DefectSelectedElement="selectedDescendant" SelectedDefect="SelectedDefect" DefectList="DefectListSubmittedToMediaComponent"
                            OnNewTagForNewDefect="OnNewTagForNewDefectHandler" OnTagClicked="OnTagClickedHandler"></MediaComponent>
            </div>
                        </RadzenSplitterPane>
        <RadzenSplitterPane Size="auto">

            <div class="form-group">
                <label class="control-label">@L["Child Elements"]</label>
                <InputSelect class="form-control" @bind-Value=SelectedDescendantID>
                    @foreach (var element in descendants)
                    {
                        <option value="@element.ElementId">@element.Name</option>
                    }
                </InputSelect>
            </div>


            <div class="form-group">
                <label class="control-label">@L["Defect Types"]</label>
                <InputSelect class="form-control" @bind-Value=SelectedDefectTypeID>
                    <option value=@Guid.Parse("9245fe4a-d402-451c-b9ed-9c1a04247482")>All types</option>
                    @foreach (var defectType in DefectTypesList)
                    {
                        <option value="@defectType.DefectTypeId">@defectType.Name</option>
                    }
                </InputSelect>
            </div>

            <div class="form-group">
                <label class="control-label">@L["Defects"]</label>
                <InputSelect class="form-control" @bind-Value=SelectedDefectID>
                    <option value=@Guid.Parse("9245fe4a-d402-451c-b9ed-9c1a04247482")>All Defects</option>
                    @if (SelectedDefectTypeID != Guid.Parse("9245fe4a-d402-451c-b9ed-9c1a04247482"))
                    {
                        <option value=@Guid.Parse("7c9e6679-7425-40de-944b-e07fc1f90ae7")>new Defect</option>
                    }
                    @foreach (var defect in DefectList)
                    {
                        <option value="@defect.DefectId">Element:  @defect.Element.Name,  Defect Type: @defect.DefectType.Name</option>
                    }
                </InputSelect>
            </div>

            @if (SelectedDefect != null)
            {
                <div class="form-group">
                    <label>@L["Short Description"] :</label>
                    <div>
                        <div class="form-group">
                            <textarea rows="10" value=@SelectedDefect.Description onchange=@HandleMyPropertyChange class="form-control"></textarea>
                        </div>
                        <ValidationMessage For="@(() => SelectedDefect.Description)" />
                    </div>
                </div>
                @if (!updating)
                {
                    <AttributesComponent Titem1="AttributeDefect" Titem2="Defect" Titem3="AttributeTypeDefectType" CallerIdName="DefectId"
                                 CallerTypeIdName="DefectTypeId" CallerTypeName="Defect" JunctionPropName="AttributeDefects"
                                 element="SelectedDefect"></AttributesComponent>
                }


            }




        </RadzenSplitterPane>
    </RadzenSplitter>
</EditForm>

@code {
    bool updating = false;

    [Parameter]
    public Guid ElementID { get; set; }

    Element element;

    List<DefectType> DefectTypesList = new List<DefectType>();

    private Guid selectedDescendantID;

    public Guid SelectedDescendantID
    {
        get => selectedDescendantID;
        set
        {
            if (selectedDescendantID == value) return;
            selectedDescendantID = value;
            selectedDescendant = descendants.Find(x => x.ElementId == selectedDescendantID);


            subDescendants.Clear();
            GetAllDescendants(selectedDescendant, subDescendants);

            List<Guid?> subDescendantsTypesIds = subDescendants.Select(x => x.ElementTypeId).ToList();

            GetDefectsTypes(subDescendantsTypesIds);

            //  DefectList = selectedDescendant.Defects;


        }
    }

    Element selectedDescendant;


    Guid selectedDefectTypeID;
    public Guid SelectedDefectTypeID
    {
        get => selectedDefectTypeID;
        set
        {
            //if (selectedDefectTypeID == value) return;
            selectedDefectTypeID = value;
            DefectList.Clear();
            foreach (Element des in subDescendants)
            {
                entitiesService.LoadCollection(des, "Defects");
                if (selectedDefectTypeID != Guid.Parse("9245fe4a-d402-451c-b9ed-9c1a04247482"))
                {
                    DefectList.AddRange(des.Defects.Where(x => (x.DefectTypeId == selectedDefectTypeID)));
                }
                else
                {
                    DefectList.AddRange(des.Defects);
                }

            }
            SelectedDefectID = Guid.Parse("9245fe4a-d402-451c-b9ed-9c1a04247482");

        }
    }




    bool includeDescendants = false;

    List<Element> descendants = new List<Element>();

    List<Element> subDescendants = new List<Element>();

    List<Defect> DefectList = new List<Defect>();
    List<Defect> DefectListSubmittedToMediaComponent = new List<Defect>();

    Defect SelectedDefect { get; set; }

    Guid selectedDefectID;
    public Guid SelectedDefectID
    {
        get => selectedDefectID;
        set
        {
            //if (selectedDefectTypeID == value) return;
            selectedDefectID = value;

            if (selectedDefectID == Guid.Parse("9245fe4a-d402-451c-b9ed-9c1a04247482"))
            {
                updating = true;
                SelectedDefect = null;
                DefectListSubmittedToMediaComponent = DefectList;
            }
            else if (selectedDefectID == Guid.Parse("7c9e6679-7425-40de-944b-e07fc1f90ae7"))
            {
                updating = true;
                SelectedDefect = new Defect();
                SelectedDefect.ElementId = SelectedDescendantID;
                SelectedDefect.DefectTypeId = SelectedDefectTypeID;
                SelectedDefect.DefectType = DefectTypesList.Find(x => x.DefectTypeId == SelectedDefectTypeID);
                SelectedDefect.Date = DateTime.Now;
                SelectedDefect.DefectId = Guid.Parse("7c9e6679-7425-40de-944b-e07fc1f90ae7");


            }
            else
            {

                SelectedDefect = DefectList.Find(x => x.DefectId == selectedDefectID);
                DefectListSubmittedToMediaComponent = new List<Defect>() { SelectedDefect };
                updating = false;
            }


        }
    }



    protected override async Task OnInitializedAsync()
    {
        element = (Element)AppData.obj;

        if (element == null) navigationManager.NavigateTo("/Structures");

        GetAllDescendants(element, descendants);


        SelectedDescendantID = descendants[0].ElementId;



    }

    async void HandleMyPropertyChange(ChangeEventArgs evt)
    {
        SelectedDefect.Description = evt.Value.ToString();
        updating = true;
        await entitiesService.UpdateEntityAsync(SelectedDefect);
        updating = false;
    }

    private void GetAllDescendants(Element el, List<Element> listElements)
    {
        listElements.Add(el);
        var descendants = el.InverseParent;

        foreach (Element e in descendants)
        {
            GetAllDescendants(e, listElements);
        }
    }

    private async Task OnNewTagForNewDefectHandler(Guid l)
    {
        if (l == Guid.Parse("7c9e6679-7425-40de-944b-e07fc1f90ae7"))
        {

            SelectedDefect.DefectId = Guid.Empty;
            updating = true;
            await AddAttributes(SelectedDefect);
            SelectedDefect = await entitiesService.InsertEntityAsync(SelectedDefect);
           // selectedDescendant.Defects.Add(SelectedDefect);
            DefectList.Add(SelectedDefect);
            updating = false;

            SelectedDefectID = SelectedDefect.DefectId;
        }
    }

    private async Task AddAttributes(Defect defect)
    {
        var defectTypeID = defect.DefectTypeId;

        List<AttributeTypeDefectType> atet = await entitiesService.GetFilteredEntitiesAsync<AttributeTypeDefectType>(a => a.DefectTypeId == defect.DefectTypeId, "AttributeType");

        var attributeTypesList = atet.Select(x => x.AttributeType);

        foreach (var v in attributeTypesList)
        {
            AttributeDefect ae = new AttributeDefect();
            ae.DefectId = defect.DefectId;
            ae.AttributeTypeId = v.AttributeTypeId;
            defect.AttributeDefects.Add(ae);

        }
    }



    private async Task OnTagClickedHandler(Guid l)
    {
        SelectedDefectID = l;
    }



    private async Task GetDefectsTypes(List<Guid?> subDescendantsTypesIds)
    {
        await Task.WhenAll(entitiesService.tasksList);
        IEnumerable<ElementTypeDefectType> etdt = await entitiesService.GetFilteredEntitiesAsync<ElementTypeDefectType>(a => subDescendantsTypesIds.Contains(a.ElementTypeId), "DefectType");

        DefectTypesList = etdt.Select(x => x.DefectType).Distinct().ToList();

        SelectedDefectTypeID = Guid.Parse("9245fe4a-d402-451c-b9ed-9c1a04247482");
    }

}
