@inject IJSRuntime js
@inject AliantWebS.Data.AppData appData

@if (IsVisible)
{
    <div class="modal" style="display:block;">
        <div class="modal-content">
            <h3>Confirm Delete</h3>
            <p>Are you sure you want to delete this collection? Please enter your password to confirm.</p>
            <EditForm Model="@this" OnValidSubmit="@ConfirmDel">
                <DataAnnotationsValidator />
               @*  <ValidationSummary/> *@
                <InputText id="password" type="password" @bind-Value="Password" />
                <button type="submit" class="btn btn-danger">Confirm</button>
                <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
            </EditForm>
        </div>
    </div>

    <style>
        .modal {
            position: fixed;
            z-index: 999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgb(0,0,0);
            background-color: rgba(0,0,0,0.4);
        }

        .modal-content {
            background-color: #fefefe;
            margin: 15% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 80%;
        }
    </style>
}

@code {
    public bool IsVisible { get; set; }
    private string Password { get; set; } = string.Empty;

    public void Show() => IsVisible = true;
    public void Hide() => IsVisible = false;

    private async Task ConfirmDel()
    {
        Hide();
        var b = await appData.ValidateUserPasswordAsync(Password);
        if (b)
        {
            // Password was confirmed, trigger the confirmed event.
            await Confirmed.InvokeAsync(null);
        }
        else
        {
            await js.InvokeVoidAsync("alert", "Password incorrect or confirmation failed.");
        }
    }

    private void Cancel()
    {
        Hide();
        Cancelled.InvokeAsync(null);
    }

    [Parameter]
    public EventCallback Confirmed { get; set; }

    [Parameter]
    public EventCallback Cancelled { get; set; }


}
